    skos:definition "This U.S. industry comprises establishments primarily engaged in (1) farm raising finfish (e.g., catfish, trout, goldfish, tropical fish, minnows) and/or (2) hatching fish of any kind." .

<50b1bpyJS5i-jl5gANQdew> a owl:Class ;
    rdfs:label "Plastics Bottle Manufacturing" ;
