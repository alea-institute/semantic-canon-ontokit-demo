    skos:definition "The New Jersey Superior Court - Camden County is a court of general jurisdiction within the New Jersey state court system, located in Camden County and serving the surrounding area." .

<R3TZludg4KJtTjPW1T2J9c> a owl:Class ;
    rdfs:label "Visa Waived" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R86jPmGuwTs8kyeJw0atFjh> ],
        [ a owl:Restriction ;
