<Riu7KFtjL04HtrAlMuymaB> a owl:Class ;
    rdfs:label "Sin" ;
    rdfs:subClassOf <RCuw9Co5aqGGoEIUhnvjRXK> ;
    skos:altLabel "Moral Fault"^^xsd:string,
        "Moral Offense"^^xsd:string,
        "Personal Moral Evil"^^xsd:string,
        "Transgression"^^xsd:string ;
    skos:definition "Sin is a morally evil act, thought, word, or omission freely committed in violation of divine law and right reason. Sin wounds the relationship between the human person and God, harms communion with others, and distorts the moral order."^^xsd:string ;
    skos:example "Sin calls for repentance, conversion, and reconciliation."^^xsd:string,
        "Sin can be mortal when it involves grave matter, full knowledge, and deliberate consent."^^xsd:string,
        "Sin damages communion with God and neighbor."^^xsd:string,
        "Sin includes failing to act when justice or charity clearly requires action."^^xsd:string,
        "Sin occurs when a person freely chooses an action known to be gravely wrong."^^xsd:string .

<RlNFgB3TQfMzV26V4V7u4E> a owl:Class ;
    rdfs:label "Legal Objectives" ;
