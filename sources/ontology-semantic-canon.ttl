<RDAqVINTtXdI1W6rtk5B6L> a owl:Class ;
    rdfs:label "Panic Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RDKGeTDagCQ714D5C4sASPP> ;
    skos:altLabel "Acute Panic Condition",
        "Panic Attack Disorder" ;
    skos:definition "Panic Disorder is a mental health condition characterized by recurrent and unexpected panic attacks, which are sudden periods of intense fear or discomfort that peak within minutes. These attacks are often accompanied by physical symptoms such as heart palpitations, sweating, trembling, shortness of breath, chest pain, and feelings of impending doom or loss of control." ;
    skos:prefLabel "Anxiety Attack Disorder" .

