    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9L7kPrkn8q0VbbyH4lv1VJ> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RD3CNG3ecVo2oIloP4lYFoX> ],
        <RBLodGElBPA4tNq7xpjKA5l> ;
    skos:altLabel "Election Management Body",
        "Electoral Authority",
        "Electoral Commission" ;
    skos:definition "An Election Commission is an official body responsible for organizing, overseeing, and ensuring the integrity of elections within a specific jurisdiction. This independent agency is typically charged with administering electoral processes, enforcing election laws, and maintaining the fairness and transparency of democratic voting procedures." ;
    skos:prefLabel "Election Board" .

