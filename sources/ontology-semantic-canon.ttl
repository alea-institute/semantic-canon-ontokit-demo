    rdfs:subClassOf <rjaaDbt8RO65Jhr9DNSzNw> ;
    skos:definition "This industry comprises establishments primarily engaged in providing one or more of the following: (1) financial transaction processing (except central bank); (2) reserve and liquidity services (except central bank); and/or (3) check or other financial instrument clearinghouse services (except central bank)." ;
    skos:example "Automated clearinghouses, bank or check (except central bank)",
        "Check clearing services (except central bank)",
        "Credit card processing services",
        "Electronic funds transfer services, including peer-to-peer payment services" .

<yOKqXQQ4Slmg_mO_t3yCyw> a owl:Class ;
    rdfs:label "Painting and Wall Covering Contractors" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=238320> ;
