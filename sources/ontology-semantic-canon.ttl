        "Total Amount - Fee or Expense"@en-gb,
        "Cantidad total - Tarifa o gasto"@es-es,
        "Monto total - Tarifa o gasto"@es-mx,
        "Montant total - Frais ou dépenses"@fr-fr,
        "סכום כולל - עמלה או הוצאה"@he-il,
        "कुल राशि - शुल्क या व्यय"@hi-in,
        "総額 - 手数料または費用"@ja-jp,
        "Valor total - Taxa ou despesa"@pt-br,
        "总金额 - 费用或支出"@zh-cn ;
    skos:definition "Total, cumulative amount paid — in fees and/or expenses." .

<R8u7CAB2KmMvx0wpzJ73n97> a owl:Class ;
    rdfs:label "Audit" ;
    rdfs:subClassOf <RdfKnWpXsG2eBmnS3oJNTF> ;
    skos:definition "An audit is a systematic examination and verification of an organization's financial and non-financial records, operational procedures, or a system's compliance with regulatory standards, usually carried out by an independent body." .

<R8voMwZ00WaA8Z9QZbJBQnS> a owl:Class ;
    rdfs:label "Joint Defense Group" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rfl9CBKZ5O5PlWd0mq9GKH> ],
        <R8xoAbLw9cOhM7q4iRXRmXu>,
        <RCFgxBbypUKKsDDOJ1iOk36> ;
    skos:altLabel "Gemeinsame Verteidigungsgruppe"@de-de,
        "Joint Defence Group"@en-gb,
        "Grupo de Defensa Conjunta"@es-es,
        "Grupo de Defensa Conjunta"@es-mx,
        "Groupe de défense conjoint"@fr-fr,
        "קבוצת הגנה משותפת"@he-il,
        "संयुक्त रक्षा समूह"@hi-in,
        "共同防衛グループ"@ja-jp,
        "Grupo de Defesa Conjunta"@pt-br,
        "联合防御组"@zh-cn ;
    skos:definition "A group of parties who participate in a Joint Defense Agreement, usually separate parties (though in a similar position) who are defendants in a civil lawsuit." .

<R8wOITiPftK5xTRvzn957oX> a owl:Class ;
    rdfs:label "Entity Registration Document" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RKKRGOkIme6pnG2BSePt1Z> ],
        <RBCzyIAi2Hjl80hfQr8wAMR> ;
    skos:altLabel "Certificate" ;
    skos:definition "An entity registration document is a formal document issued by a governmental or authorized body, confirming that an individual, organization, or product meets specific standards or regulations. This certificate serves as legal evidence of compliance and may be required for certain professional practices, business operations, or product distributions." .

<R8xSzwRnuQy4kqrATCJ6awq> a owl:Class ;
    rdfs:label "Drug Test" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RzyeWKhoAOFwQhI2R5PxYf> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RB0QemTkd6XZOLDEO42pdIw> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCPRLx0shv6uO5vmBtHKGYO> ],
        <R7qicnAOVCTYIaiJHt9KmIy> ;
    skos:altLabel "Toxicology Test" ;
    skos:definition "A drug test is a technical analysis of a biological specimen, such as urine, hair, blood, breath, sweat, or oral fluid/saliva, to determine the presence or absence of specified drugs or their metabolites. These tests are often used by employers, sports organizations, legal and law enforcement agencies, and in healthcare settings." ;
    skos:prefLabel "Substance Screening" .

<R8zVfJ5cgX7pYsgGOQESam7> a owl:Class ;
    rdfs:label "Prisoners' Rights" ;
    rdfs:subClassOf <RBJlYzE4ZY14dTEghzbbMHg> ;
    skos:definition "Prisoners' rights are legal protections afforded to individuals who are incarcerated, ensuring that they are treated with dignity and have access to basic human rights while serving their sentences. These rights include access to medical care, protection from cruel and unusual punishment, and the ability to challenge their confinement through legal processes." .

<R90rPz0ItLncGp6GL7Dh1KR> a owl:Class ;
    rdfs:label "Down Syndrome" ;
    rdfs:subClassOf <RnmmbswQcOryRPEoDnHIbC> ;
    skos:definition "Down Syndrome is a genetic disorder caused by the presence of an extra chromosome 21, known as Trisomy 21. This condition leads to developmental delays, intellectual disability, and characteristic physical features." ;
    skos:prefLabel "Down's Syndrome" .

<R91xCHHoE9fXDZudkrKfPQj> a owl:Class ;
    rdfs:label "Court Commissioner" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R75wIdBtRQSlsPO5SBZ21oT> ],
        <RDSYPGgBlFz5eWNtwoMA2c5> ;
    skos:altLabel "Gerichtskommissar"@de-de,
        "Court Commissioner"@en-gb,
        "Comisionado Judicial"@es-es,
        "Comisionado de la Corte"@es-mx,
        "Commissaire de justice"@fr-fr,
        "ממלא משרדי בית משפט"@he-il,
        "कोर्ट आयुक्त"@hi-in,
        "裁判所委員"@ja-jp,
        "Comissário de Justiça"@pt-br,
        "法院专员"@zh-cn ;
    skos:definition "A Court Commissioner is a legal decision maker who is appointed by a court to perform certain duties, such as conducting hearings, making recommendations, and issuing orders." .

<R92S2HIVThaRnO0lgcFKgIw> a owl:Class ;
    rdfs:label "Break Violation Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RGK6KYY8XqLTyeigvEAIOg> ],
        <R9UYGSnWQz2MvNsWUofGb6J> ;
    skos:altLabel "Verstoß gegen die Pause-Regelung"@de-de,
        "Break Violation Claim"@en-gb,
        "Reclamación por violación de descanso"@es-es,
        "Reclamación por violación de descanso"@es-mx,
        "Réclamation de violation de pause"@fr-fr,
        "תביעה על הפרת מנוחה"@he-il,
        "विश्राम उल्लंघन दावा"@hi-in,
        "休憩違反請求"@ja-jp,
        "Reivindicação de violação de intervalo"@pt-br,
        "违反休息规定索赔"@zh-cn ;
    skos:definition "A break violation claim is a legal action initiated by an employee against their employer relating to the legal requirement to provide breaks during the workday. These breaks can include rest breaks and meal breaks, and the claim typically arises when an employer either denies or interrupts breaks or does not provide them in accordance with applicable labor laws. In some cases, employers may also be liable for break violations if they do not compensate employees for certain types of work performed during breaks." .

<R92zfYLbJJuyDTDnDtJOrLx> a owl:Class ;
    rdfs:label "Ejectment" ;
    rdfs:subClassOf <RDSBerlLWg1ntpLqDQn1eVn> ;
    skos:altLabel "Räumungsklage"@de-de,
        "Ejectment"@en-gb,
        "Desahucio"@es-es,
        "Desalojo"@es-mx,
        "Expulsion"@fr-fr,
        "פינוי דירה"@he-il,
        "उन्मुखीकरण"@hi-in,
        "立ち退き"@ja-jp,
        "Despejo"@pt-br,
        "驱逐"@zh-cn ;
    skos:definition "A legal action to remove a person or entity from a property they wrongfully possess, typically involving a claim of ownership by the plaintiff." .

<R95dRrDW7uDqVtDc9vR9ZUM> a owl:Class ;
    rdfs:label "Clergy & Religious" ;
    rdfs:subClassOf <RBCWax7xWlrjx6Ni9AAFoE8> ;
    skos:altLabel "Clergy and Consecrated Religious"^^xsd:string,
        "Ordained and Consecrated Persons"^^xsd:string,
        "Sacred Ministers and Religious"^^xsd:string ;
    skos:definition "Clergy & Religious denotes ordained ministers and members of institutes of consecrated life who publicly serve the Church through sacramental ministry or vowed life. The category groups distinct but related ecclesial states defined by ordination or public profession of evangelical counsels."^^xsd:string ;
    skos:example "A diocesan priest belongs to the clergy but not to religious life."^^xsd:string,
        "Clergy and religious serve distinct but complementary roles in the Church."^^xsd:string,
        "Some priests are both clergy and religious."^^xsd:string,
        "The Church relies on clergy and religious for sacramental and pastoral ministry."^^xsd:string .

<R9847SXyPLJAgrYHCLthP56> a owl:Class ;
    rdfs:label "Malicious Prosecution" ;
    rdfs:subClassOf <RDqSn32zsjxExcBFzIYxT2D>,
        <RSRxb9psAJdqf8rppoiYI8> ;
    skos:altLabel "Malicious Abuse of Legal Process",
        "Böswillige Strafverfolgung"@de-de,
        "Malicious Prosecution"@en-gb,
        "Procedimiento Malicioso"@es-es,
        "Proceso Malicioso"@es-mx,
        "Poursuite malveillante"@fr-fr,
        "תביעה מתועבת"@he-il,
        "दुर्व्यवहारपूर्ण अभियोग"@hi-in,
        "悪質な起訴"@ja-jp,
        "Persecução Maliciosa"@pt-br,
        "恶意起诉"@zh-cn ;
    skos:definition "The concept of Malicious Prosecution refers to the intentional and wrongful use of legal process against another person, without probable cause and with malice, resulting in damages to the victim." .

<R9BC2mdYLFmSyLcCkV4odRX> a owl:Class ;
    rdfs:label "Nature Reserve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RB66KavQ9akLTya7pGnGqVH> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCXo6eQMlbZx9milrSaYo1v> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBeZkopwGsxt3K5BXOgNBNF> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RKqxeuifrYkNfCxyHq59hz> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8FLbODQd9k85hPERve6IN7> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RChhcQCDBa1uy1Bh7EJHlwO> ],
        <RBU1z7AUARMHEr7RMR6feWY> ;
    skos:altLabel "Conservation Area",
        "Ecological Protection Zone",
        "Natural Sanctuary" ;
    skos:definition "A Nature Reserve is a designated area of land set aside for the protection and conservation of biodiversity, natural resources, and/or specific species. This type of real estate asset typically falls under specific environmental regulations and is often managed by government bodies or non-profit organizations" ;
    skos:prefLabel "Wildlife Reserve" .

<R9DCJMzRXnPZMWQqQuPLECx> a owl:Class ;
    rdfs:label "Gender-Based Market Segment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <t52Vl9l4Rpeu1FviQezxZQ> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <PfSj5GuQSG2Apk5yNyy8oQ> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <q9RvnO_yRIOItX7BVivMHQ> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8lpuELvxz47gLtnJQsIzqx> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RB346aEGSIAnyLfbt0Pf8qi> ],
        <R7KxYUBMSAuzPHdBhWfPSv7> ;
    skos:definition "Gender-based market segments refer to divisions of the market that are categorized based on the gender of consumers. These segments allow businesses to tailor their products, services, and marketing strategies to cater to the specific needs, preferences, and behaviors of different gender groups, such as men, women, and non-binary individuals." ;
    skos:prefLabel "Sex-Based Market Segment" .

<R9FMAbfEYARhk9Z0a5Fvij1> a owl:Class ;
    rdfs:label "Fractional Ownership Assets" ;
    rdfs:subClassOf <RbvEeHm8jkxY6SgfxEoC0i> ;
    skos:definition "Fractional Ownership Assets, such as timeshares, are assets that are owned by multiple individuals or entities, each holding a fraction of the ownership and entitled to use or benefit from the asset for a specific period. In the case of timeshares, owners typically have the right to use a vacation property for a set number of weeks each year, while sharing the costs and responsibilities of ownership and maintenance." .

<R9G7d3XzmmtzTlQIdMFMWGa> a owl:Class ;
    rdfs:label "Credit and Loan Agreement" ;
    rdfs:subClassOf <RVoyN9hN3m5gy3So01ZEZ8> ;
    skos:definition "A Credit and Loan Agreement is a legally binding contract between a lender and a borrower that outlines the terms and conditions for the provision of credit or a loan. The agreement specifies key details such as the amount borrowed, interest rate, repayment schedule, and any collateral required, among other terms." .

<R9H8B4LW9PpywsdO2cXejL9> a owl:Class ;
    rdfs:label "Broadcast Timing Attributes" ;
    rdfs:subClassOf <R8mCB7w7tqtq6yOWvTxdMJI> ;
    skos:definition "Broadcast Timing Attributes refer to the characteristics that define the timing of broadcast transmissions, distinguishing between content that is delivered in real-time and content that is pre-recorded and scheduled for later playback. These attributes categorize broadcasts into synchronous (live) and asynchronous (pre-recorded) transmissions." ;
    skos:prefLabel "Broadcast Temporal Characteristics" .

<R9HYiwtnrCegkpzpKHbJSRW> a owl:Class ;
    rdfs:label "Estate, Inheritance, and Gift Tax Payment" ;
    rdfs:subClassOf <RBVCwr551O94R7T2y8aKsPS> ;
    skos:altLabel "Death and Gift Tax Payment",
        "Inheritance and Gift Tax Payment",
        "Transfer Tax Payment",
        "Wealth Transfer Tax Payment" ;
    skos:definition "Estate, Inheritance, and Gift Taxes are levies imposed on the transfer of wealth through various means, either during a person's life or upon their death. Estate taxes are applied to the total value of a deceased person's estate before distribution to heirs, inheritance taxes are imposed on beneficiaries receiving assets, and gift taxes are applied to transfers of wealth during an individual's lifetime that exceed certain thresholds.",
        "Taxes on estates and inheritances (4310) and taxes on gifts. Estate taxes are charged on the amount of the total estate whereas inheritance taxes are charged on the shares of the individual recipients; in addition the latter may take into account the relationship of the individual recipients to the deceased." .

<R9I2QOa7u8LwCRqKo4FKdPd> a owl:Class ;
    rdfs:label "Timberland Real Estate Asset" ;
    rdfs:subClassOf <RUhSbbDJZa8Crs3tIWcIfV> ;
    skos:altLabel "Timberland",
        "Woodland" ;
    skos:definition "In the context of legal services, Timberland refers to a parcel of land with specific legal considerations surrounding the growth, management, and harvesting of timber. Legal issues may include property rights, environmental regulations, and contractual obligations between parties involved." ;
    skos:prefLabel "Forest" .

<R9JJWlci2GwDGSMqF9e5IiW> a owl:Class ;
    rdfs:label "Vehicle Equipment Violation Claim" ;
    rdfs:subClassOf <R7hDCTMLoPZrFgIFAMlNHvf> ;
    skos:altLabel "Car Equipment Infraction Claim",
        "Vehicle Compliance Violation Claim" ;
    skos:definition "A Vehicle Equipment Violation Claim involves allegations that a vehicle's equipment does not meet the regulatory standards required by law, which may include issues with lighting, brakes, tires, or emissions controls. These claims are crucial for ensuring road safety and environmental compliance, and they can result in mandatory repairs, fines, or other enforcement actions." .

<R9LBsMo1i6vrjdqZMZJ3mmq> a owl:Class ;
    rdfs:label "Esophagus or Stomach Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_16> ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Upper GI Tract Cancer",
        "Upper Gastrointestinal Cancer" ;
    skos:definition "Esophagus or stomach cancer refers to malignant tumors that originate in the esophagus or stomach, significantly impacting the digestive system. These cancers can affect swallowing, digestion, and nutrient absorption, often requiring a combination of treatments such as surgery, chemotherapy, and radiation therapy." ;
    skos:prefLabel "Gastroesophageal Cancer" .

<R9Ldp07MuEzCYqYViCbvmsI> a owl:Class ;
    rdfs:label "Fishing, Hunting and Trapping Industry" ;
    dc:identifier "AGR-FISH" ;
    rdfs:subClassOf <R92xsHpdHu6BJjtepuRu> ;
    skos:altLabel "Fishing, Hunting and Trapping",
        "Fischerei-, Jagd- und Fallenstellungsbranche"@de-de,
        "Fishing, Hunting and Trapping Industry"@en-gb,
        "Industria de la pesca, caza y captura"@es-es,
        "Industria de la pesca, caza y captura"@es-mx,
        "Industrie de la pêche, de la chasse et du piégeage"@fr-fr,
        "תעשיית דייג, ציד ותפיסת חיות פראי"@he-il,
        "मछली पकड़ने, शिकार और फंसाने की उद्योग"@hi-in,
        "漁業、狩猟および罠業"@ja-jp,
        "Indústria de Pesca, Caça e Armadilhas"@pt-br,
        "渔业、狩猎和捕捉行业"@zh-cn ;
    skos:definition "Industries in this group harvest fish and other wild animals from their natural habitats and are dependent upon a continued supply of the natural resource." ;
    skos:hiddenLabel "FISH" .

<R9MYE9royNkdydgCkQkCwkN> a owl:Class ;
