            owl:someValuesFrom <RF0Ed48CCDeff3A690616f64> ],
        <R1F4dbe4CD17b3B2a7f15b97> ;
    skos:definition "Maine State Courts are the judicial system of the state of Maine, consisting of the Maine Superior Court and the Maine Supreme Court." ;
    skos:hiddenLabel "ME" ;
    skos:prefLabel "Maine State Courts" .

<R7I291Cta585JlhpZvxV48y> a owl:Class ;
    rdfs:label "Educational Record" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDeZlellOVEkUBkTSbLgxUC> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC6b9qx6IeaqNoLfaLBJCwU> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RB7IaNyshrHiqug0LlmK6J2> ],
        <RBCzyIAi2Hjl80hfQr8wAMR> ;
    skos:definition "An Educational Record is a compilation of a student's academic history, documenting various academic achievements and activities throughout their educational journey. This record typically includes details such as courses completed, grades received, diplomas and degrees conferred, and other pertinent academic information, serving as a comprehensive account of a student's educational progression." ;
    skos:prefLabel "Educational Document" .

<R7Ii0y3ouva1y6sqrwWACBl> a owl:Class ;
    rdfs:label "Human Law" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RlNFgB3TQfMzV26V4V7u4E> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBQGborh1CfXanGZipDL0Qo> ],
        <R8LCVHYfxA8Lri3uDg3TTsF> ;
    skos:altLabel "Civil Law"^^xsd:string,
        "Positive Human Law"^^xsd:string,
        "Lex Humana"@la ;
    skos:definition "Human Law (Lex Humana) consists of determinations made by human reason that apply Natural Law’s general principles to particular social circumstances. It binds in conscience when it accords with reason and the common good, and it lacks moral authority when it contradicts Natural Law."^^xsd:string ;
    skos:example "A human law loses moral authority if it contradicts natural law."^^xsd:string,
        "Human law specifies penalties to protect the common good."^^xsd:string,
        "Legislators seek to exercise practical reason when crafting human law."^^xsd:string,
        "Speed limits represent human law applying natural law’s concern for safety."^^xsd:string .

<R7Jo1aujvVXJf6e9d3XoIVp> a owl:Class ;
    rdfs:label "Periodical" ;
    rdfs:subClassOf <RCqEOIQE7piF24rITlbKn6q> ;
    skos:altLabel "Regular Publication",
        "Serial Publication" ;
    skos:definition "A Periodical is a regularly published work that includes a collection of articles, stories, photographs, and advertisements, typically focusing on specific subjects or areas of interest." .

<R7KGGhirGUj2y81W5Kp7TT2> a owl:Class ;
    rdfs:label "Warrant Claim" ;
    rdfs:subClassOf <R8GqVQ7wf48MBB7IuqjSfOk> ;
    skos:altLabel "Garantieanspruch"@de-de,
        "Warrant Claim"@en-gb,
        "Reclamación de garantía"@es-es,
        "Reclamo de garantía"@es-mx,
        "Réclamation de garantie"@fr-fr,
        "תביעת אחריות"@he-il,
        "वारंट क्लेम"@hi-in,
        "保証請求"@ja-jp,
        "Reivindicação de garantia"@pt-br,
        "担保索赔"@zh-cn ;
    skos:definition "A warrant claim refers to a legal assertion involving the issuance, execution, or validity of a warrant, which is an official document issued by a judicial officer that authorizes law enforcement to perform certain acts, such as an arrest, a search, or a seizure. A warrant claim can take many forms, including claims that a warrant was improperly issued, executed, or lacked sufficient cause." .

<R7KhT61HReh3D93SOceH8I3> a owl:Class ;
    rdfs:label "Incarnation" ;
    rdfs:comment "In a worldwide Catholic ontology, the Incarnation represents the singular mystery of the union of the divine and human natures in the person of Jesus Christ. It is the foundational event of the New Covenant, where the Word of God became flesh to effect the salvation of the world."^^xsd:string ;
    rdfs:subClassOf <R7oT3qg4wZmB5K3qC79EVID> ;
    skos:altLabel "Divine Assumption of Humanity"^^xsd:string,
        "Enshrinement of the Word"^^xsd:string,
        "Word Made Flesh"^^xsd:string ;
    skos:definition "Incarnation is the mystery and the dogma of the Word becoming flesh in the womb of the Virgin Mary through the power of the Holy Spirit. This event signifies that the second person of the Holy Trinity assumed a human nature without losing his divinity, becoming truly man while remaining truly God."^^xsd:string ;
    skos:example "Celebrating the Solemnity of the Annunciation as the moment the Incarnation occurred."^^xsd:string,
        "Reciting the Angelus daily to commemorate the mystery of the Incarnation."^^xsd:string .

<R7M4dFUNY2TqtFocZDZHld> a owl:Class ;
    rdfs:label "Personal Sin" ;
    rdfs:subClassOf <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Individual Sin"^^xsd:string,
        "Personal Transgression"^^xsd:string ;
    skos:definition "Personal Sin is sin freely committed by an individual through thought, word, deed, or omission. Personal Sin involves personal moral responsibility and directly affects the individual’s relationship with God and others."^^xsd:string ;
    skos:example "A person freely chooses an action known to be morally wrong."^^xsd:string,
        "Personal sin damages the individual’s moral character and relationships."^^xsd:string .

<R7N71UJvQpaL7vVEjmFExh6> a owl:Class ;
    rdfs:label "Civil Battery" ;
    rdfs:subClassOf <R8alUnZrt8GVEzHYhh1KTva> ;
    skos:altLabel "Zivilbatterie"@de-de,
        "Civil Battery"@en-gb,
        "Batería Civil"@es-es,
        "Batería Civil"@es-mx,
        "Batterie civile"@fr-fr,
        "סוללת אזרחית"@he-il,
        "नागरिक बैटरी"@hi-in,
        "民事バッテリー"@ja-jp,
        "Bateria civil"@pt-br,
        "民事电池"@zh-cn ;
    skos:definition "The intentional and harmful physical contact with another person without their consent, resulting in injury or harm, which can be the basis for a personal injury claim." .

<R7NkdM8YhcmzfiWmRifZdxG> a owl:Class ;
    rdfs:label "Director’s Liability to Shareholders" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9dPGGL1IRXLLjb1323qtj6> ],
        [ a owl:Restriction ;
