    skos:example "A family prepares meals for neighbors facing temporary hardship."^^xsd:string,
        "A parish operates a soup kitchen that serves hot meals to people in need."^^xsd:string,
        "A relief organization delivers food to communities affected by disaster."^^xsd:string,
        "A school collects donations to support a hunger relief program."^^xsd:string,
        "Volunteers distribute groceries through a local food pantry."^^xsd:string .

<RUVEwmd3pCcUnVACz4seC> a owl:Class ;
    rdfs:label "Divine Law" ;
    rdfs:subClassOf <R8LCVHYfxA8Lri3uDg3TTsF> ;
    skos:altLabel "Law of Revelation"^^xsd:string,
        "Revealed Law"^^xsd:string,
        "Lex Divina"@la ;
    skos:definition "Divine Law (Lex Divina) is God’s law made known through divine revelation, chiefly in Sacred Scripture and authentically interpreted by the Church. It directs humanity toward supernatural beatitude and clarifies moral truths that human reason alone cannot fully attain."^^xsd:string ;
    skos:example "Catholic moral teaching interprets divine law through scripture and tradition."^^xsd:string,
        "Divine law forbids murder through the commandment “You shall not kill.”"^^xsd:string,
        "Divine law reveals humanity’s supernatural end in communion with God."^^xsd:string,
        "The new law perfects divine law through Christ’s teaching and grace."^^xsd:string .

