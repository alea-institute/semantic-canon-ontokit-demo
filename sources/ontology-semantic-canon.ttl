    rdfs:subClassOf <WE8R2zm6TZ6Et7qfPN-BvQ> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in manufacturing softwood veneer and/or softwood plywood." .

<jTdAhZgRRcWdD765w8aB4A> a owl:Class ;
