<R87IsLNsN3gE0fGxMCQ2E4n> a owl:Class ;
    rdfs:label "The Presentation"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9SopVNnOp9zwSj4fwxAofC> ],
        <R8Q2ik3utpYM1LNPjwbkF4A>,
        <RBcdN3ccRk1SftZVzCrFRw0> ;
    skos:altLabel "Circumcision of Christ"^^xsd:string,
        "Circumcision of Jesus"^^xsd:string,
        "Circumcision of the Lord",
        "Holy Circumcision"^^xsd:string ;
    skos:definition "Circumcision of the Lord means the ritual circumcision of Jesus on the eighth day after his birth, in accordance with the Mosaic Law. Circumcision of the Lord signifies Christ’s submission to the Law and his incorporation into the covenant of Israel."^^xsd:string ;
    skos:example "Christian tradition recognizes the circumcision of the Lord as the moment Jesus received his name."^^xsd:string,
        "The Gospel of Luke records that Jesus was circumcised on the eighth day after his birth."^^xsd:string,
        """When the day came to purify them according to the law of Moses, the couple brought Him up to Jerusalem so that He could be presented to the Lord, for it is written in the law of the Lord, “Every first-born male shall be consecrated to the Lord.”
(Luke 2:22-23)"""^^xsd:string ;
    skos:prefLabel "Naming of Jesus"^^xsd:string .

<R87MDAJj8ZL7SprFAEqipk2> a owl:Class ;
