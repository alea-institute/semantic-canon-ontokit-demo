<R8njSjKgQVHq391ox3scPr0> a owl:Class ;
    rdfs:label "Mortal Sin" ;
    rdfs:subClassOf <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Deadly Sin"^^xsd:string,
        "Grave Sin"^^xsd:string,
        "Sin unto Death"^^xsd:string ;
    skos:definition "Mortal Sin is a grave moral act that destroys charity in the heart of the human person and ruptures communion with God. Mortal Sin occurs when grave matter is chosen with full knowledge and deliberate consent."^^xsd:string ;
    skos:example "A person knowingly and freely commits an act that the Church teaches is gravely immoral."^^xsd:string,
        "Mortal sin occurs when grave matter is chosen with full awareness of its seriousness."^^xsd:string,
        "Mortal sin requires sacramental confession before reception of the Eucharist."^^xsd:string,
        "Mortal sin ruptures communion with God until repentance and absolution restore grace."^^xsd:string .

<R8o0lzPUMDOV8nWAfYHXpEK> a owl:Class ;
