<R9uEXLXGu0ly7TVvw4trhzs> a owl:Class ;
    rdfs:label "Commandment 05: You shall not kill." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBY6ZBEYa2Y7NOxChUaInA2> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7Ttdyo4FsvaupPKT35Qry0> ],
        <RDJPdWE32ZF0O3QeYJi5uc> ;
    skos:altLabel "No Murder Decree"^^xsd:string,
        "Prohibition Against Murder"^^xsd:string ;
    skos:definition "You Shall Not Kill represents the fifth commandment prohibiting the unlawful taking of human life, establishing life's sacred inviolability as made in God's image. This decree protects human dignity from murder while traditional interpretation permits capital punishment, just war, and legitimate self-defense, distinguishing wrongful killing from authorized life-taking."^^xsd:string ;
    skos:example "Pacifist Christians have interpreted this commandment as absolute prohibition against all killing, including warfare and capital punishment."^^xsd:string,
        "Some translators have rendered this commandment as \"you shall not murder\" to clarify it prohibits wrongful killing rather than all life-taking."^^xsd:string,
        "Suicide prevention advocates have extend this commandment to self-killing, emphasizing life belongs to God alone."^^xsd:string ;
    skos:note """Prohibition Statement (Exodus 20:13)
Deuteronomic Restatement (Deuteronomy 5:17)
Cain's Murder Condemnation (Genesis 4:8-12)
Blood Vengeance Regulations (Numbers 35:9-34)
Cities of Refuge Provision (Deuteronomy 19:1-13)
Premeditated vs. Accidental Killing Distinction (Exodus 21:12-14)
Jesus's Anger Intensification (Matthew 5:21-22)
Capital Punishment Allowances (Genesis 9:6)"""^^xsd:string ;
    skos:prefLabel "Fifth Commandment"^^xsd:string .

<R9uH78GN3iChz8tjK5EI01Q> a owl:Class ;
    rdfs:label "Carrying of the Cross"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9auCu5af3YRnpebdBnsVkv> ],
        <RD0JfBltrTwUJkeYjw8iN1P>,
        <RDxAHb6WWxvwiBtuiLOfgfr> ;
    skos:altLabel "Via Crucis"^^xsd:string,
        "Way of Sorrows"^^xsd:string,
        "Way of the Cross" ;
    skos:definition "Way of the Cross means the journey of Jesus Christ carrying the cross from his condemnation to his crucifixion at Calvary. Way of the Cross reveals Christ’s willing endurance of suffering and forms a central meditation on redemptive sacrifice."^^xsd:string ;
    skos:example """… carrying the cross by Himself, He went out to what is called the Place of the Skull (in Hebrew, Golgotha)
(John 19:17)"""^^xsd:string ;
    skos:prefLabel "Stations of the Cross"^^xsd:string .

