        "ट्रेडमार्क उल्लंघन"@hi-in,
        "商標侵害"@ja-jp,
        "Violação de marca registrada"@pt-br,
        "商标侵权"@zh-cn ;
    skos:definition "The unauthorized use of a trademark or service mark, including the trafficking of counterfeit marks, which violates the rights of the owner and may result in legal action under unfair competition or intellectual property claims." .

<RBRPjYycc1QcWOn4irY0BW9> a owl:Class ;
    rdfs:label "Residential Real Estate Asset" ;
    dc:identifier "REALA-RESIDL" ;
