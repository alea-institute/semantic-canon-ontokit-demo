<R95oUOrfr6FrxqtY2X1zXWT> a owl:Class ;
    rdfs:label "Commandment 04: Honor your father and mother." ;
    rdfs:subClassOf <RDJPdWE32ZF0O3QeYJi5uc> ;
    skos:altLabel "Filial Piety Command"^^xsd:string,
        "Parental Honor Commandment"^^xsd:string ;
    skos:definition "Honor Your Father and Mother represents the fourth commandment requiring reverent respect, obedience, and care toward parents throughout their lives. This decree establishes family authority structure as foundational to social order, promising long life and prosperity to those who fulfill this obligation while extending the principle to all legitimate authority."^^xsd:string ;
    skos:example "Contemporary bioethicists invoked this commandment when discussing adult children's obligations regarding elderly parent care decisions."^^xsd:string,
        "Medieval theologians debated whether this commandment permitted disobedience when parents commanded sinful acts."^^xsd:string,
        "Renaissance humanists interpreted this commandment as requiring adult children to support aging parents materially and emotionally."^^xsd:string ;
    skos:note """Honor Command (Exodus 20:12)
Long Life Promise (Exodus 20:12)
Land Possession Blessing (Exodus 20:12)
Deuteronomic Restatement (Deuteronomy 5:16)
Death Penalty for Striking Parents (Exodus 21:15)
Death Penalty for Cursing Parents (Exodus 21:17, Leviticus 20:9)
Stubborn Son Execution Law (Deuteronomy 21:18-21)
Levitical Fear and Reverence Command (Leviticus 19:3)
Jesus's Corban Criticism (Mark 7:9-13)
Jesus's Cross Care for Mary (John 19:26-27)
Paul's Obedience Teaching (Ephesians 6:1-3)
Timothy's Widow Care Instructions (1 Timothy 5:4, 8)"""^^xsd:string ;
    skos:prefLabel "Fourth Commandment"^^xsd:string .

