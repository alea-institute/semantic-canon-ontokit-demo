    rdfs:subClassOf <LBITt66NR96SvbXg8EurZQ> ;
    skos:definition "This industry comprises establishments primarily engaged in retailing used merchandise, antiques, and secondhand goods (except motor vehicles, such as automobiles, RVs, motorcycles, and boats; motor vehicle parts; tires; and mobile homes). This industry includes establishments retailing used merchandise on an auction basis." ;
    skos:example "Antique retailers",
        "Used book retailers",
        "Used clothing retailers",
        "Used household appliance retailers",
        "Used merchandise thrift shops",
        "Used sporting goods retailers" .

<Hhi551X6RHWwv8lKMoe1ow> a owl:Class ;
