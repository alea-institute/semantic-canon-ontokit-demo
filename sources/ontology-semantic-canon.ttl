<R74TUaDuXhtfgwnBtY34zgP> a owl:Class ;
    rdfs:label "Event Due Date" ;
    rdfs:subClassOf <Rs2T4JXRBzxyj3hNAMRsoT> ;
    skos:definition "A Due Date Event refers to the specified deadline by which a particular task, action, or submission is required to be completed. In immigration contexts, it could pertain to the submission of documents, responses to inquiries, or meeting other requirements within the prescribed timeframe set by immigration authorities or relevant parties." .

<R74fiWrDWHFdnzcHB1hETEv> a owl:Class ;
    rdfs:label "Mortgagor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <s7-eJGGYSoaQIrtyJagrOg> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RhceZsFaOSAIBa7BX1vpbF> ],
        <RC27xIi05f9TBUDgpjVvuCg> ;
    skos:definition "A Mortgagor is an individual or entity that borrows money to purchase property, securing the loan with the property itself as collateral. In this arrangement, the mortgagor holds ownership of the property but the lender (mortgagee) has the right to take possession if the loan is not repaid according to the agreed terms." .

