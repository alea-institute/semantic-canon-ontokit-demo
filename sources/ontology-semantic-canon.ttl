<R9GHNEldQkw0cY65ZzkeI6x> a owl:Class ;
    rdfs:label "Aphonia" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/2.00-SpecialSensesandSpeech-Adult.htm#2_09> ;
