    skos:altLabel "Fahrlässige Ausübung der behaltenen Kontrolle"@de-de,
        "Negligent Exercise of Retained Control"@en-gb,
        "Ejercicio negligente del control retenido"@es-es,
        "Ejercicio negligente del control retenido"@es-mx,
        "Exercice négligent du contrôle conservé"@fr-fr,
        "תרגיל שליטה שלילי של שליטה שנשמרה"@he-il,
        "रखी गई नियंत्रण के अनुरूप लापरवाही"@hi-in,
        "保留された制御の不注意な行使"@ja-jp,
        "Exercício negligente do controle retido"@pt-br,
        "保留控制的疏忽行使"@zh-cn ;
    skos:definition "On a multi-employer work site, a person or entity may be civilly liable if it negligently exercised control so as to have \"affirmatively contributed in any way\" to the injury." .

<RcKu6XW304hK2ONeNuXgkS> a owl:Class ;
    rdfs:label "Pueblo" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<RcLuFIVZBrM4AhteZ4Jqkq> a owl:Class ;
    rdfs:label "Travel Document Issuing Country" ;
    rdfs:subClassOf <ROEhQluRR7rfqDyDYvJ3Dd> ;
    skos:definition "The Travel Document Issuing Country refers to the country that has issued the travel document or other identification suitable for international travel. This country is usually responsible for the traveler's consular needs and is the authority to which foreign governments will refer for identification and verification purposes" .

<RcMZgiwSAaHpqXMO4nq3sU> a owl:Class ;
    rdfs:label "Implied Indemnification" ;
    rdfs:subClassOf <RLNlm7nXyJQLJmk8qYnaPQ>,
        <RoKNrz23ylFaWAaoPC3ECY> ;
    skos:altLabel "Implizite Entschädigung"@de-de,
        "Implied Indemnification"@en-gb,
        "Indemnización implícita"@es-es,
        "Indemnización implícita"@es-mx,
        "Indemnisation implicite"@fr-fr,
        "פיצויים משוחררים"@he-il,
        "अनुमति द्वारा भरपाई"@hi-in,
        "暗黙の補償"@ja-jp,
        "Indenização implícita"@pt-br,
        "默示赔偿"@zh-cn ;
    skos:definition "A legal concept where one party is obligated to compensate another party for damages or losses, even if there is no explicit agreement to do so, due to actions or statements that created a reasonable expectation of indemnification." .

<RcNOyJszNQ5uDl1st0SLL5> a owl:Class ;
    rdfs:label "Organized Village of Kake" ;
    rdfs:subClassOf <R7N6wsHsNyqgPE4xFK8wKJx> .

<RcNTXUIeabR8yZj0GiomxT> a owl:Class ;
    rdfs:label "Nonacquiescence" ;
    rdfs:comment "From LIST: Legal Issues Taxonomy — https://taxonomy.legal/" ;
    rdfs:subClassOf <RCDwLiS22z6MzQaQHS08hvk> ;
    skos:definition "Nonacquiescence refers to the practice where a government agency chooses not to follow or implement a court ruling that directly affects the agency's actions or policies. This may happen when the agency disagrees with the decision or believes that it only applies to the specific case and not to its general procedures or regulations." .

<RcPCCRQUx0nlNBGvI8Keh0> a owl:Class ;
    rdfs:label "Obviousness" ;
    rdfs:subClassOf <RDV2029Q3Zi4LQ1ehMJNj3w> ;
    skos:definition "Obviousness in legal terms refers to the lack of novelty and inventiveness in an invention, making it ineligible for a patent. An invention is considered obvious if a person with ordinary skill in the field would find the invention predictable based on prior art." .

<RcR2xKteHARvohhigcdAjx> a owl:Class ;
    rdfs:label "Seating Claim" ;
    rdfs:subClassOf <R9UYGSnWQz2MvNsWUofGb6J> ;
    skos:altLabel "Sitzplatzanspruch"@de-de,
        "Seating Claim"@en-gb,
        "Reclamación de asientos"@es-es,
        "Reclamo de asientos"@es-mx,
        "Réclamation de siège"@fr-fr,
        "תביעת מושבים"@he-il,
        "बैठक का दावा"@hi-in,
        "座席請求"@ja-jp,
        "Reivindicação de assento"@pt-br,
        "座位索赔"@zh-cn ;
    skos:definition "A seating claim is a legal action initiated by an employee against their employer for not providing reasonable seating to employees who perform tasks that can be done while seated. The claim typically arises when an employer does not comply with applicable laws, which require employers to provide seating to employees when the nature of their work reasonably permits the use of seats. Employers can face liability for failing to provide seating when required, which can result in physical discomfort or injury to employees who are required to stand for long periods of time." .

<RcR3bv1hvkJ6eLZsLcmaFY> a owl:Class ;
    rdfs:label "Closing Arguments / Summation" ;
    rdfs:subClassOf <Rchny3YFXoQyenv6XUbyo0> ;
    skos:altLabel "Closing Argument",
        "Summation",
        "Schlussplädoyer / Zusammenfassung"@de-de,
        "Closing Arguments / Summation"@en-gb,
        "Alegatos de cierre / Resumen"@es-es,
        "Alegatos de clausura / Resumen"@es-mx,
        "Plaidoirie finale / Résumé"@fr-fr,
        "סיכום טענות / סיכום"@he-il,
        "अंतिम बयान / सारांश"@hi-in,
        "クロージングアーギュメント/サマリー"@ja-jp,
        "Alegações Finais / Sumário"@pt-br,
        "结案陈词 / 总结陈词"@zh-cn ;
    skos:definition "Closing Arguments/Summation is a trial event where each party presents their final arguments to the jury or judge before a verdict is reached." .

