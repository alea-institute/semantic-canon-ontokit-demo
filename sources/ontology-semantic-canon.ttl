<RDWn66DRoabJ8uDfGxuuKEQ> a owl:Class ;
    rdfs:label "Chronic Hyperglycemia" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm> ;
    rdfs:subClassOf <RDo00CLlnwYJISZbyYUTXTA> ;
    skos:altLabel "Persistent Hyperglycemia" ;
    skos:definition "Chronic Hyperglycemia refers to longstanding abnormally high levels of blood glucose, which leads to long-term diabetic complications by disrupting nerve and blood vessel functioning. This disruption affects multiple body systems, resulting in various complications such as diabetic peripheral neurovascular disease, diabetic retinopathy, coronary artery disease, peripheral vascular disease, diabetic gastroparesis, diabetic nephropathy, poorly healing skin infections, diabetic neuropathies, and cognitive impairments, including depression and anxiety." ;
    skos:prefLabel "Long-Term Hyperglycemia" .

<RDWsk2jmra9UZRcNfWukhuI> a owl:Class ;
