    skos:definition "Substantial Prejudice: A legal concept used in appellate standards of review that refers to an error or action that had a significant impact on the outcome of a case and resulted in an unfair disadvantage to one of the parties involved." .

<R8YpmuUZmn3o9FoTaw5XYwP> a owl:Class ;
    rdfs:label "Punitive Damages" ;
    rdfs:subClassOf <RB2CEA5hNfHnNl8DMKIfK5F> ;
