    dc:identifier "NAM-US-US+HI" ;
    rdfs:subClassOf <R1E70ce4D699e90144cB32b8> ;
    skos:hiddenLabel "US+HI" ;
    skos:prefLabel "Hawaii" .

<RAF0fd61D454941A401EEce1> a owl:Class ;
    rdfs:label "Wisconsin State Courts" ;
    dc:identifier "USCTS-STCOUS-WI" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:locatedIn ;
            owl:someValuesFrom <R54082109F7ff5BEe15CBa9f> ],
        <R1F4dbe4CD17b3B2a7f15b97> ;
    skos:definition "Wisconsin State Courts are the judicial branch of the government of the state of Wisconsin, responsible for interpreting and enforcing the laws of the state." ;
    skos:hiddenLabel "WI" ;
    skos:prefLabel "Wisconsin State Courts" .

<RB00C43eWpZ3eGhqNnziJXg> a owl:Class ;
    rdfs:label "Sermon on the Mount" ;
    rdfs:subClassOf <R9VpyiXQxLbATS2mPSOlbqT> ;
    skos:altLabel "Matthean Sermon on the Mount"^^xsd:string,
        "Mount Sermon"^^xsd:string ;
    skos:definition "Sermon on the Mount means the extended teaching of Jesus Christ delivered on a mountain, presenting the core moral and spiritual demands of the Kingdom of God. Sermon on the Mount articulates Christ’s authoritative interpretation of the Law and forms a foundational summary of Christian ethics."^^xsd:string ;
    skos:example "Christian moral theology treats the sermon on the mount as a comprehensive guide to life in the Kingdom of God."^^xsd:string,
        "The Gospel of Matthew presents Jesus teaching the Beatitudes during the sermon on the mount."^^xsd:string .

<RB2K2E9rftRKciKOqkr1BeV> a owl:Class ;
    rdfs:label "Winner-Take-All - Single-Winner System" ;
    rdfs:subClassOf <R9Sn2rwvFp1q6oYORzblWjv> ;
    skos:altLabel "Dominance Voting in Single Districts",
        "Majoritarian Single-Winner System",
        "Single-Member District System",
        "Single-Member Plurality",
        "Single-Winner Plurality",
        "Single-Winner Voting System" ;
    skos:definition "A winner-take-all system in single-winner districts is an electoral method where one candidate with the most votes in a district wins the sole available seat. This system often leads to a significant representation of the majority party and can marginalize minority party voters within the district." .

<RB3ZDkOj3NY83VeYDOB98XR> a owl:Class ;
    rdfs:label "Criminal Legal Determination" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RijIqw1HEfQF4ctjWUlgnq> ],
        <R8AUKvbXRK8jOHSQaqxcAtD> ;
    skos:definition "A \"criminal legal determination\" pertains to the verdict or decision made by a court in a criminal case. It typically involves determining whether the defendant is found \"guilty\" or \"not guilty\" of the criminal charges brought against them. This determination has significant consequences, including potential penalties such as imprisonment, fines, probation, or other forms of punishment, depending on the verdict." .

<RB9WPZAmqztZGzX1qXk6gXv> a owl:ObjectProperty ;
    rdfs:label "folio:respondedTo" ;
    rdfs:domain <RDt4vQCYDfY0R9fZ5FNnTbj> ;
    rdfs:range <RDt4vQCYDfY0R9fZ5FNnTbj> ;
    skos:altLabel "replied to",
        "responded to" ;
    skos:definition "\"Responded To\" in legal contexts refers to the action of replying or reacting to a legal action, request, or communication. This includes formal legal responses such as answering a lawsuit, replying to a legal notice, or reacting to a court's order, and is crucial for the continuation and progression of legal processes." ;
    skos:prefLabel "folio:repliedTo" .

<RB9nahq2xaGnFjLrP4TCfdV> a owl:Class ;
    rdfs:label "Baptism by Water" ;
    rdfs:subClassOf <Rf3vlNVG6AT99vTWHcqcws> ;
    skos:altLabel "Ritual Baptism"^^xsd:string,
        "Sacramental Baptism"^^xsd:string,
        "Water Baptism"^^xsd:string ;
    skos:definition "Baptism by Water is the ordinary form of baptism in which natural water is poured or the person is immersed while the Trinitarian formula is pronounced. Through this rite, Christ effects forgiveness of sins, rebirth in the Holy Spirit, and incorporation into the Church."^^xsd:string ;
    skos:example "Baptism by water is ordinarily celebrated during the Church’s liturgy."^^xsd:string,
        "Immersion and pouring are valid forms of water baptism."^^xsd:string,
        "The minister pours water while invoking the Trinity."^^xsd:string .

<RBAHGQZblh8cggdiTJggZfv> a owl:Class ;
    rdfs:label "Moral Virtues" ;
    rdfs:subClassOf <Rgp2p1OFbXqI1lBJieonvK> ;
    skos:altLabel "Habitual Moral Dispositions"^^xsd:string,
        "Virtues of Character"^^xsd:string ;
    skos:definition "Moral Virtues are stable dispositions of character that dispose a person to choose the good and act according to right reason. Moral Virtues shape habitual conduct by ordering passions, intentions, and actions toward authentic human flourishing."^^xsd:string ;
    skos:example "Moral virtues develop through repeated good actions and moral formation."^^xsd:string,
        "Moral virtues enable consistent good action through formed habit rather than impulse."^^xsd:string,
        "Moral virtues guide passions so they serve reason and the good."^^xsd:string,
        "Moral virtues strengthen character in daily decisions and relationships."^^xsd:string .

<RBArQMGGQsqMjU7hWmLA0y2> a owl:Class ;
    rdfs:label "Contact Prior Name" ;
    rdfs:subClassOf <R8zrphg3yY4ZZzvj2CAu6hN> ;
    skos:definition "Contact Prior Name refers to any previous full name used by an individual before it was legally changed. This could be due to reasons like marriage, divorce, or a personal decision to change one's name. When applicable, the prior name may be included in formal documentation or databases for complete identification or historical tracking." .

<RBCV26gN63NNAmGIxsKVAi7> a owl:Class ;
    rdfs:label "Asylee" ;
    rdfs:subClassOf <R8GuYn7yMmfL0coiNQ0OE8f>,
        <R8N4pMIOhTNbqcmDczSephq> ;
    skos:definition "An asylee is an individual who has been granted asylum, a form of international protection, after proving a well-founded fear of persecution in their home country due to race, religion, nationality, membership in a particular social group, or political opinion. Once granted asylum, the asylee has the right to remain in the host country and may be eligible for certain benefits like work authorization." .

<RBCWax7xWlrjx6Ni9AAFoE8> a owl:Class ;
    rdfs:label "Human Actor"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDCkFrEclhipkoHPgckuFY6> ],
        <R8CdMpOM0RmyrgCCvbpiLS0> ;
    skos:altLabel "Human Person"^^xsd:string,
        "Moral Agent"^^xsd:string ;
    skos:definition "A Human Actor is a human person who acts, participates, or bears responsibility within salvation history, ecclesial life, or moral and sacramental contexts. The term encompasses individuals whose actions, roles, or vocations carry theological, canonical, liturgical, or pastoral significance."^^xsd:string .

<RBEigCQdiTQxEXHnVObMk2u> a owl:Class ;
    rdfs:label "Management, Scientific, and Technical Consulting Services Industry" ;
    dc:identifier "PRS-TCHC" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=5416> ;
    rdfs:subClassOf <RBFLYkta0F7DwegW1FnUX52> ;
    skos:altLabel "Technical Consulting",
        "Technische Beratungsbranche"@de-de,
        "Technical Consulting Industry"@en-gb,
        "Industria de Consultoría Técnica"@es-es,
        "Industria de Consultoría Técnica"@es-mx,
        "Industrie du conseil technique"@fr-fr,
        "תעשיית ייעוץ טכני"@he-il,
        "तकनीकी परामर्श उद्योग"@hi-in,
        "技術コンサルティング業界"@ja-jp,
        "Indústria de consultoria técnica"@pt-br,
        "技术咨询行业"@zh-cn ;
    skos:definition "This industry group comprises establishments primarily engaged in providing advice and assistance to businesses and other organizations on management, environmental, scientific, and technical issues." ;
    skos:hiddenLabel "TCHC" .

<RBHI06ZAbtF2eveFVFadYwb> a owl:Class ;
    rdfs:label "Valuation Metrics" ;
    rdfs:subClassOf <RhBgnef56iLBXYfPqWQE41> ;
    skos:definition "Valuation Metrics are quantifiable measures and methodologies used to assess the economic worth of an asset, business, or investment. These metrics serve as the basis for informed decision-making in activities such as acquisitions, investments, and financial reporting" .

<RBHsUy15guQC3jWrIYrwRsH> a owl:Class ;
    rdfs:label "Regulatory Risk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCDwLiS22z6MzQaQHS08hvk> ],
        <RDsWDLg5JUKHPw6my6QzmoU> ;
    skos:definition "Regulatory Risk refers to the potential for negative consequences arising from an organization's noncompliance with laws, regulations, or industry standards that govern its operations, products, or services. These risks can stem from various sources, such as changes in regulatory requirements, lack of clarity on compliance obligations, or failure to implement adequate controls, potentially leading to legal penalties, reputational damage, or operational disruptions, ultimately impacting the organization's overall performance and sustainability." .

<RBIF8SqULlcUju99hpRYHBh> a owl:Class ;
    rdfs:label "Death of Jesus" ;
    rdfs:subClassOf <RDevm5enL8lHCY9bEjZUsd5> ;
    skos:altLabel "Death of Christ"^^xsd:string ;
    skos:definition "Death of Jesus means the moment Jesus Christ expired on the cross at Calvary, completing his voluntary self-sacrifice for the redemption of humanity. Death of Jesus fulfills the Paschal sacrifice and seals the New Covenant through the shedding of Christ’s blood."^^xsd:string ;
    skos:example "Christian theology understands the death of Jesus as the definitive atoning sacrifice for sin."^^xsd:string,
        "The Gospels record that Jesus cried out and gave up his spirit while hanging on the cross."^^xsd:string .

<RBOczjtsHXQh2ojzTubbrxI> a owl:Class ;
    rdfs:label "Remedies in Family Law" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCUXzL8Z4Ddh2CK6TBhofjU> ],
        <RDbz1PVc6y57oOb9jAIl0eN> ;
    skos:altLabel "Support Orders" ;
    skos:definition "Ancillary Relief refers to additional financial orders made by a court in the context of divorce or separation proceedings, including maintenance payments, division of assets, and financial support. These orders are intended to ensure fair financial arrangements between the parties involved." ;
    skos:prefLabel "Ancillary Relief" .

<RBPD5CT0qSBTNnFlNAZ6kln> a owl:Class ;
    rdfs:label "Medical Form" ;
    rdfs:subClassOf <RBOz1UXsX4cnOePooNnJ6Xc> ;
    skos:altLabel "Clinical Data Sheet",
        "Patient Form" ;
    skos:definition "A Medical Form is a standardized document used within healthcare settings for collecting, storing, or conveying information related to a patient's medical history, condition, or treatment. Examples include consent forms, referral forms, and records release forms." ;
    skos:prefLabel "Health Form" .

<RBQCFqSF0Q0sCqCcEwv2pgz> a owl:Class ;
