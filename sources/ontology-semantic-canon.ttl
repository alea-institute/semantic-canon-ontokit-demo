<RCUshq33YKYbi0RQdiJPytd> a owl:Class ;
    rdfs:label "Craniofacial Bone Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_11> ;
    rdfs:subClassOf <RC9hKRPbfUdQjXfAQBLwpGO> ;
    skos:altLabel "Orbital Cancer",
        "Temporal Bone Cancer",
        "Upper Jaw Cancer" ;
    skos:definition "Maxilla, orbit, or temporal fossa cancer refers to malignant tumors originating in the bones and surrounding structures of the upper jaw (maxilla), eye socket (orbit), and the temporal fossa, which is located at the side of the skull. These cancers can significantly impact functions such as vision, chewing, and facial symmetry and often require complex, multidisciplinary treatment approaches." ;
    skos:prefLabel "Maxilla, Orbit, or Temporal Fossa Cancer" .

