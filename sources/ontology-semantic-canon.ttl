    skos:definition "This U.S. industry comprises establishments primarily engaged in manufacturing fabricated wire products (except springs) made from purchased wire." ;
    skos:example "Barbed wire made from purchased wire",
        "Chain link fencing and fence gates made from purchased wire",
        "Metal baskets made from purchased wire",
        "Nails, brads, and staples made from purchased wire",
        "Noninsulated wire cable made from purchased wire",
        "Paper clips made from purchased wire",
        "Woven wire cloth made from purchased wire" .

<MO0J1d6kRG-_HGhYUIM_JA> a owl:Class ;
    rdfs:label "Rope, Cordage, Twine, Tire Cord, and Tire Fabric Mills" ;
