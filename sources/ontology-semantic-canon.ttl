<Rpu7r6Eo5r9kcLYmrhIMfN> a owl:Class ;
    rdfs:label "Dear God" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RyTfHxUQPVMUQrtIt1Mycz> ;
    skos:definition "Dear God is a brief contemplative prayer that addresses God directly with intimacy and trust, seeking revelation of divine beauty and freedom from fear. It expresses longing for encounter with God’s loving presence and nearness."^^xsd:string ;
    skos:example """Dear God, 
please reveal to us your sublime beauty
that is everywhere, everywhere, everywhere,
so that we will never again feel frightened.
My divine love, my love,
please let us touch
your face."""^^xsd:string,
        "During a retreat, the group reflected on Dear God as a prayer of intimacy with God’s presence."^^xsd:string,
        "In a moment of anxiety, he whispered Dear God to ask for courage and trust."^^xsd:string,
        "In silent meditation, she prayed Dear God to seek peace and freedom from fear."^^xsd:string .

