<R79GSWs8c28RQSp0lCLI5x9> a owl:Class ;
    rdfs:label "Compassion" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Active Mercy"^^xsd:string,
        "Charitable Sensitivity"^^xsd:string,
        "Empathic Care"^^xsd:string,
        "Humaneness"^^xsd:string,
        "Merciful Concern"^^xsd:string ;
    skos:definition "Compassion is the ethical principle that moves a person to recognize another’s suffering and to respond with merciful concern and assistance. Compassion unites empathy with action, directing moral response toward healing, accompaniment, and relief of distress."^^xsd:string ;
    skos:example "A caregiver responds patiently to a person experiencing chronic pain."^^xsd:string,
        "A community organizes assistance for families affected by disaster."^^xsd:string,
        "A counselor accompanies a person in grief with presence and practical support."^^xsd:string,
        "A judge considers mitigating circumstances when imposing a sentence."^^xsd:string,
        "A physician listens attentively to a patient’s fears before recommending treatment."^^xsd:string .

