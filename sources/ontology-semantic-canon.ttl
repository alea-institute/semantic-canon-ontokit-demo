    skos:hiddenLabel "LESR" .

<R8rXgwTd3apGR5L4IJxYLc1> a owl:Class ;
    rdfs:label "Human Places"^^xsd:string ;
    rdfs:subClassOf <R890rqgnX4R6holH0er0DWQ> ;
    skos:altLabel "Human-Organized Places"^^xsd:string,
        "Societal Places"^^xsd:string,
        "Societally Organized Places"^^xsd:string ;
    skos:definition "Human Places are locations constituted by human activity, organization, or presence, and defined by social, legal, economic, or cultural meaning. Human Places derive their significance from how persons gather, work, govern, or interact within them."^^xsd:string ;
    skos:example "A city functions as a geographic human place shaped by governance and culture."^^xsd:string,
        "A courtroom serves as a human place where legal disputes are adjudicated."^^xsd:string,
        "A marketplace acts as a human place for exchange of goods and services."^^xsd:string,
        "A mediation center provides a human place for conflict resolution."^^xsd:string,
        "A workplace operates as a human place of economic activity and collaboration."^^xsd:string .

<R8t0srL2xeL3TDoobUUFnvC> a owl:Class ;
    rdfs:label "Sacred Places" ;
    rdfs:subClassOf <RnE0B1i5s6VPGXFOeVsfcy> ;
    skos:altLabel "Consecrated Places"^^xsd:string,
        "Holy Places"^^xsd:string,
        "Places Set Apart for Worship"^^xsd:string,
        "Sacred Locations"^^xsd:string ;
    skos:definition "Sacred Places are locations set apart and designated for divine worship, prayer, or religious significance by consecration, blessing, or established sacred use. Sacred Places serve the sanctification of the faithful by providing spaces ordered toward encounter with God."^^xsd:string .

<R8vAEBB4vqpklciwq0MiMSa> a owl:Class ;
    rdfs:label "Political Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBrs0FH5hpFyVnTb3mbSz60> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCeKmVl4PL78uA2J5r53a2C> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7nCzcmx7E2irmj7iF0N1Uk> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RQCyNdB6QvP6zcWKkpQQ1q> ],
        <R0TZk2qCI4HPwDl3e9FoOo> ;
    skos:definition "Political rights are the rights that enable individuals to freely participate in the civic and political life of a society, including voting, running for public office, and engaging in public discourse. These rights are typically guaranteed by a country's constitution or laws and are essential for the functioning of a democratic system." .

<R8xzICx2jmaNf0lhp5OGKx> a owl:Class ;
    rdfs:label "Copyright Infringement" ;
    rdfs:subClassOf <RJL4HDUmZp1VEEZ7lCwSSF> ;
    skos:altLabel "Urheberrechtsverletzung"@de-de,
        "Copyright Infringement"@en-gb,
        "Infracción de derechos de autor"@es-es,
        "Infracción de derechos de autor"@es-mx,
        "Violation de droit d'auteur"@fr-fr,
        "הפרת זכויות יוצרים"@he-il,
        "कॉपीराइट उल्लंघन"@hi-in,
        "著作権侵害"@ja-jp,
        "Violação de direitos autorais"@pt-br,
        "侵犯版权"@zh-cn ;
    skos:definition "The unauthorized use or reproduction of a copyrighted work, without the permission of the owner, which may include copying, distributing, displaying, or performing the work." .

<R91WteSiOiemLkdvKMPFwld> a owl:Class ;
