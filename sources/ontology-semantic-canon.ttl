<R8Xsh0edX6LShguy9V77LGD> a owl:Class ;
    rdfs:label "Prudence" ;
    rdfs:subClassOf <R7QF58SulRGe1zlQ8gCzVSF> ;
    skos:altLabel "Deliberation"^^xsd:string,
        "Judgment"^^xsd:string,
        "Practical Discernment"^^xsd:string,
        "Practical Wisdom"^^xsd:string,
        "Right Reason in Action"^^xsd:string,
        "Sound Judgment"^^xsd:string ;
    skos:definition "Prudence is the cardinal virtue that disposes practical reason to discern the true good in every circumstance and to choose the right means to achieve it. Prudence governs moral decision-making by applying universal principles to concrete situations."^^xsd:string ;
    skos:example "Prudence directs moral action in complex or ambiguous situations."^^xsd:string,
        "Prudence guides a leader to weigh consequences before making a decision."^^xsd:string,
        "Prudence helps a person choose appropriate means to pursue a good end."^^xsd:string ;
    skos:prefLabel "Moral Discernment"^^xsd:string .

