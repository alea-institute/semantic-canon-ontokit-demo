<R83cWaRd5UP59KOlvvFWPXP> a owl:Class ;
    rdfs:label "Schizophrenia" ;
    rdfs:subClassOf <RBOBgLFktExGekPrKF5oWmr> ;
    skos:altLabel "Paranoid Schizophrenia",
        "Psychotic Disorder",
        "Schizophrenic Disorder" ;
    skos:definition "Schizophrenia is a chronic and severe mental health disorder characterized by disturbances in thought processes, perceptions, emotional responsiveness, and social interactions. Symptoms include hallucinations, delusions, disorganized thinking, and impaired functioning, which can significantly affect daily life and require long-term treatment and support." ;
    skos:prefLabel "Schizophrenic Condition" .

<R83p0RbC6qaA2IK7dGerjye> a owl:Class ;
