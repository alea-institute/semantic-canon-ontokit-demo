<R9HN1HMLtV6RSkhBj8zjD7Y> a owl:Class ;
    rdfs:label "Love of God" ;
    rdfs:subClassOf <R50fTKExGPGTyoyWAZDkk5> ;
    skos:altLabel "Adoration"^^xsd:string,
        "Adoration of God"^^xsd:string,
        "Desire for Union with God"^^xsd:string,
        "Devotion"^^xsd:string,
        "Love of the Lord"^^xsd:string,
        "Obedience of Love"^^xsd:string,
        "Worship"^^xsd:string ;
    skos:definition "Love of God is the act and disposition by which a person loves God above all things for God’s own sake. Love of God directs the whole person—intellect, will, and action—toward adoration, obedience, and communion with God."^^xsd:string ;
    skos:example "Love of God deepens through prayer, sacramental life, and contemplation."^^xsd:string,
        "Love of God inspires obedience to God’s commandments even at personal cost."^^xsd:string,
        "Love of God leads a person to seek God’s will above personal preference."^^xsd:string,
        "Love of God moves a believer to adore God in prayer and worship."^^xsd:string,
        "Love of God shapes daily actions as offerings directed toward God."^^xsd:string .

<R9HPub0PMW2GODvjQ2PttbM> a owl:Class ;
    rdfs:label "Leasehold Estate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8RfDzMtuMPdmNTonmhBxu> ],
        <R8cjnXHiv1wNe6nzPvWnhQw> ;
    skos:definition "A Leasehold is an estate in real property where a lessee is granted the exclusive right to occupy and use a property for a predetermined period, typically in exchange for rent or other consideration. Unlike fee simple ownership, leasehold interests are temporary and revert back to the lessor at the end of the lease term" .

