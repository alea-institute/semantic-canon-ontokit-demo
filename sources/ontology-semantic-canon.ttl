<R7TMXUE0nBJ2a4RL8LbordW> a owl:Class ;
    rdfs:label "Devisee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9FMAbfEYARhk9Z0a5Fvij1> ],
        [ a owl:Restriction ;
