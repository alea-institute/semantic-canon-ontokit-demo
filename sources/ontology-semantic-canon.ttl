    dc:source <https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm> ;
    rdfs:subClassOf <RDAtMRi4dBGNW1PytkqmH4t> ;
    skos:altLabel "Elevated Blood Sugar",
        "High Blood Glucose" ;
    skos:definition "Hyperglycemia is an abnormally high level of blood glucose that can result from inadequate insulin production or insulin resistance. It may produce both acute and long-term complications affecting various body systems." ;
    skos:prefLabel "High Blood Sugar" .

