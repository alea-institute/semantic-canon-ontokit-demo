        "Confidential Investment Memorandum",
        "Confidential Offering Memorandum",
        "Investment Proposal Document",
        "OM",
        "PPM",
        "Reg D Offering" ;
    skos:definition "An Offering Memorandum is a legal document outlining the objectives, risks, and terms of an investment involved in a private offering. It is not registered with public securities regulators and is intended for accredited or sophisticated investors." ;
    skos:prefLabel "Offering Memorandum" .

<RDkLJ6mPMkvoXudc5ms5yza> a owl:Class ;
