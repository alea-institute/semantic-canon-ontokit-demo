<RCE0Yra7ugHR8DmISUDu3qp> a owl:Class ;
    rdfs:label "Statement Against Interest" ;
    dc:source "Fed. R. Evid. 804(b)(3)" ;
    rdfs:subClassOf <Rxtm6yCTUcImGngCzkPcx0> ;
    skos:altLabel "Admission Against Interest",
        "Declaration Against Interest" ;
    skos:definition "A Statement Against Interest is a hearsay exception that allows the admission of statements that, at the time they were made, were contrary to the declarant's pecuniary, proprietary, or penal interest, or subjected the declarant to civil or criminal liability. This exception is based on the assumption that a person is unlikely to make a statement that goes against their own interests unless they believe it to be true." .

