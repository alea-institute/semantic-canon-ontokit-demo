    skos:hiddenLabel "MULFAM" .

<RV8mJWGZnQhe2gDARKvAiF> a owl:Class ;
    rdfs:label "Winner-Take-All - Multi-Winner System" ;
    rdfs:subClassOf <R9Sn2rwvFp1q6oYORzblWjv> ;
    skos:altLabel "Block Voting",
        "Multi-Winner Voting",
        "Multiple-Winner Voting System",
        "Plurality-at-Large Voting" ;
    skos:definition "A winner-take-all multi-winner system is an electoral method where multiple candidates are elected from a single district, and the candidates with the highest number of votes win the available seats. This system can lead to one party or group dominating the representation, often marginalizing minority party voters." ;
    skos:prefLabel "Multi-Winner Plurality System" .

<RWN8gXg8mMconiOdy9rV7p> a owl:Class ;
    rdfs:label "Ohio Court of Common Pleas" ;
    rdfs:subClassOf <R7D81edCD2d848A515dCCe2f> ;
    skos:definition "The Ohio Court of Common Pleas is a specific court within the Ohio State Courts system that has jurisdiction over civil and criminal cases at the county level." .

<RX4IL0dBTdT6NybOqieEPR> a owl:Class ;
    rdfs:label "Overtime Violation Claim" ;
    rdfs:subClassOf <R9UYGSnWQz2MvNsWUofGb6J> ;
    skos:altLabel "Überstundenverletzungsklage"@de-de,
        "Overtime Violation Claim"@en-gb,
        "Reclamación por violación de horas extras"@es-es,
        "Reclamo por violación de horas extra"@es-mx,
        "Réclamation de violation des heures supplémentaires"@fr-fr,
        "תביעה על הפרת שעות נוספות"@he-il,
        "ओवरटाइम उल्लंघन दावा"@hi-in,
        "時間外勤務違反請求"@ja-jp,
        "Reclamação de violação de horas extras"@pt-br,
        "加班违规索赔"@zh-cn ;
    skos:definition "An overtime violation claim is a legal action initiated by an employee against their employer for not properly compensating them for overtime work. The claim typically arises when an employer does not comply with applicable federal, state, or local overtime laws, which require employers to pay eligible employees at a higher rate for any hours worked beyond a certain number per week or per day. The claim can include allegations of employers failing to pay the required overtime rate, miscalculating the employee's overtime pay, or not properly tracking the employee's overtime hours." .

<RXEKEEEApoXTYB4DbjUJui> a owl:Class ;
