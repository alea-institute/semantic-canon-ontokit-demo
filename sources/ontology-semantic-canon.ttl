<RWd966Up5VVRxKPkv1PPBZ> a owl:ObjectProperty ;
    rdfs:label "folio:certified" ;
    rdfs:subPropertyOf <R9OgtSm35ykpUSi7mgiCW> ;
    skos:altLabel "certified" ;
    skos:definition "In a legal context, \"certified\" refers to the formal declaration or confirmation by a competent authority that a document, process, or individual meets established standards or criteria. This certification process is crucial for establishing the authenticity, accuracy, or qualification of the subject matter, often required for legal compliance, recognition, or enforcement." .

<RWfEue5vU0JonqIFdJOnWM> a owl:Class ;
    rdfs:label "Insurgency" ;
    rdfs:comment "In a global Catholic ontology, Insurgency represents a condition of internal revolt where a group seeks to overthrow or resist established civil authority through subversive and armed means. The Church evaluates such movements with a focus on the common good, the legitimacy of the authority being challenged, and the strict conditions under which active resistance to a public power is morally permissible."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9uSx85K0E4Hiq1ZA5AtdjX> ],
        <R9mTGKaFostHJfLRPz7vsst> ;
    skos:altLabel "Armed Rebellion"^^xsd:string,
        "Civil Uprising"^^xsd:string,
        "Guerrilla Warfare"^^xsd:string,
        "Revolutionary Movement"^^xsd:string ;
    skos:definition "Insurgency is an organized movement aimed at the overthrow of a constituted government through the use of subversion and armed conflict. It necessitates an ethical assessment of the insurgents' grievances against the state's duty to maintain the \"tranquillity of order\" and the protection of the civilian population."^^xsd:string .

<RWgCqlNHf4u64L3sIGJtdj> a owl:Class ;
