        "Demonstrative Conclusion"^^xsd:string,
        "Logical Conclusion"^^xsd:string,
        "Necessary Conclusion"^^xsd:string ;
    skos:definition "Deductive Conclusion is a conclusion that follows with logical necessity from its premises if the reasoning is valid. If the premises are true, the conclusion cannot be false."^^xsd:string ;
    skos:example "Therefore, God exists."^^xsd:string,
        "Therefore, Socrates is mortal."^^xsd:string,
        "Therefore, the action must not be performed."^^xsd:string,
        "Therefore, this act is intrinsically evil."^^xsd:string .

