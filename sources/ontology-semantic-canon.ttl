<RBVQj7fYsBw67yNXs4WI6RX> a owl:Class ;
    rdfs:label "Investment Assets" ;
    rdfs:subClassOf <RxkTKgYqWS0WBHnJgrn27Y> ;
    skos:altLabel "Financial Instruments" ;
    skos:definition "Investment assets are financial instruments or physical assets acquired with the expectation that they will generate returns or appreciate in value over time. These can include stocks, bonds, real estate, mutual funds, and other forms of financial or tangible properties." ;
    skos:prefLabel "Securities Assets" .

<RBY4j5UKZ7L8gp0q9Wrxyge> a owl:Class ;
    rdfs:label "Employment Classification" ;
    rdfs:subClassOf <RGOU62BPz1QTVsWRE2Nodz> ;
    skos:altLabel "Worker Classification" ;
    skos:definition "Worker Classification refers to the categorization of an employee's work status within an organization, often defined as full-time, part-time, or contractor. These classifications dictate the terms of employment, including benefits eligibility, tax implications, and legal obligations between the employer and employee." .

<RBdfRQ5rUdtTOqtJMbgLqSh> a owl:Class ;
    rdfs:label "Fiber Crops" ;
    rdfs:subClassOf <R70EVLsDqbyH67OcMFU5d1p> ;
    skos:altLabel "Plant Fiber Crops" ;
    skos:definition "Fiber crops are plants grown specifically for their fibers, which are used in the production of textiles, ropes, and other materials. These crops are cultivated for their natural fibers, which are harvested and processed into usable products for industrial and consumer purposes." ;
    skos:prefLabel "Textile Crops" .

<RBjHwNNG2ASVmasLFU42otk> a owl:Class ;
    rdfs:label "Dispute Forums and Venues"^^xsd:string ;
    rdfs:subClassOf <R8rXgwTd3apGR5L4IJxYLc1> ;
    skos:altLabel "Foren und Veranstaltungsorte"@de-de,
        "Forums and Venues"@en-gb,
        "Foros y lugares"@es-es,
        "Foros y lugares"@es-mx,
        "Forums et lieux"@fr-fr,
        "פורומים ומקומות"@he-il,
        "फोरम और स्थान"@hi-in,
        "フォーラムと会場"@ja-jp,
        "Fóruns e locais"@pt-br,
        "论坛和场馆"@zh-cn ;
    skos:definition "Forums and Venues refer to organizational or governmental entities where proceedings occur, either as disputes or as transactions. For disputes, the term \"Forum\" describes the jurisdiction or court type, while \"Venue\" refers to the actual location, such as the courthouse, jurisdiction, or judicial district. For equities and securities, this category also includes Stock Exchanges." .

