<RDOAweZ1akvV83E2LxCynEG> a owl:Class ;
    rdfs:label "Grand Jury Privilege" ;
    rdfs:subClassOf <Rxkyjui3De88JNN2ZCqKrt> ;
    skos:altLabel "Geheimhaltungspflicht der Geschworenenjury"@de-de,
        "Grand Jury Privilege"@en-gb,
        "Privilegio del Gran Jurado"@es-es,
        "Privilegio del Gran Jurado"@es-mx,
        "Le privilège du grand jury"@fr-fr,
        "פרטיות חקירת הג'ורי הגדול"@he-il,
        "ग्रैंड ज्यूरी विशेषाधिकार"@hi-in,
        "大陪審特権"@ja-jp,
        "Privilégio do Grande Júri"@pt-br,
        "大陪审团特权"@zh-cn ;
    skos:definition "The Grand Jury Privilege is a legal protection that allows a grand jury to keep their proceedings and deliberations confidential, even from the court and the public." .

<RDOtom7nYG8Lf6j7zErueuC> a owl:Class ;
    rdfs:label "Common-Law Marriage Creation Event" ;
    rdfs:subClassOf <RDoDkMeyyv3wWo719J2yo3f> ;
    skos:definition "Common-law marriage refers to a type of informal marriage where two individuals cohabit and present themselves as a married couple without having undergone a formal legal marriage ceremony. For a common-law marriage to be recognized, certain conditions, which vary by jurisdiction, must be met, including cohabitation for a specified period and a mutual intent to be regarded as husband and wife." .

<RDQ4H6Mofyz6JJD4n1ASHIZ> a owl:Class ;
    rdfs:label "Seed Investor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBStwQIMfdzqv8MhastPnDX> ],
        <R8hWq9dSn0Su2Y59JE48V3H> ;
    skos:definition "A Seed Investor provides initial capital to a startup or early-stage business in exchange for equity or convertible debt, often taking significant risks with the expectation of high returns. This funding typically supports product development, market research, and initial operations before larger investments are secured." .

<RDQKIyqoXbr8tQZdgClywRf> a owl:Class ;
    rdfs:label "Employment Discrimination Claims" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
