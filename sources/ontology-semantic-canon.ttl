<RC8BK9fHGecveQFEpm25DhN> a owl:Class ;
    rdfs:label "Visit the Sick" ;
    rdfs:subClassOf <RBlfLOh5T3hwTWxMPyHfXBx>,
        <Ru9TAhxYKI0ZIOxJGezsYK> ;
    skos:altLabel "Attend the Ill"^^xsd:string,
        "Care for the Elderly and Infirm"^^xsd:string,
        "Care for the Sick"^^xsd:string,
        "Companionship for the Ill"^^xsd:string,
        "Compassionate Care of the Ill"^^xsd:string,
        "Homebound Visitation"^^xsd:string,
        "Hospital Visitation"^^xsd:string,
        "Ministry to the Sick"^^xsd:string,
        "Pastoral Care of the Sick"^^xsd:string ;
    skos:definition "Visit the Sick is a corporal work of mercy that consists in attending to those who suffer from illness through presence, care, and compassion. Visit the Sick affirms human dignity by accompanying the suffering and responding to bodily and spiritual need."^^xsd:string ;
    skos:example "A community organizes visits to care facilities to support residents who are sick."^^xsd:string,
        "A family member sits with an elderly relative to ease loneliness during illness."^^xsd:string,
        "A parishioner visits a hospitalized person to offer prayer and companionship."^^xsd:string,
        "A pastoral minister accompanies a patient before surgery."^^xsd:string,
        "A volunteer regularly checks on a homebound neighbor who is chronically ill."^^xsd:string,
        "Anointing Support Presence"^^xsd:string .

