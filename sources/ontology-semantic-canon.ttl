    skos:altLabel "E-2 Visa"@en-us ;
    skos:definition "The Treaty Investor Visa is a type of visa offered by various countries to foreign nationals who intend to invest a significant amount of capital in the host country's economy. The visa is usually part of bilateral treaties between the host country and the investor's home country, aimed at encouraging economic cooperation and foreign investment." .

<Rt7y5QJoXmShB4OEPQ8Ysl> a owl:Class ;
    rdfs:label "Nutrition Market Segment" ;
    rdfs:subClassOf <RBXoCwCeY64Ow60nWKSZCC> ;
    skos:definition "The nutrition market segment refers to a division of the market that is specifically targeted towards consumers who are interested in dietary and nutritional health. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek to maintain or improve their health through balanced and healthy eating habits, dietary supplements, and nutrition-focused products." ;
    skos:example "Allergy-Friendly Foods",
        "Dietary Supplements",
        "Gluten-Free Products",
        "Health Food Stores",
        "Nutrition Counseling Programs" ;
    skos:prefLabel "Dietary Health Market" .

<RtGO7nVUVQhovRrhewzPBk> a owl:Class ;
