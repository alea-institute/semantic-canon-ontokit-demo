<RDmAzNoJRoidxwyYb090VpP> a owl:Class ;
    rdfs:label "Virgin Birth" ;
    rdfs:subClassOf <R7KhT61HReh3D93SOceH8I3> ;
    skos:altLabel "Birth of Jesus by the Virgin Mary"^^xsd:string,
        "Conception of Jesus by the Holy Spirit"^^xsd:string,
        "Miraculous Birth of Christ"^^xsd:string ;
    skos:definition "Virgin Birth means the conception and birth of Jesus Christ by the Virgin Mary through the power of the Holy Spirit, without human sexual relations. Virgin Birth affirms both Christ’s true humanity and divine origin as revealed in Sacred Scripture and defined by Catholic doctrine."^^xsd:string ;
    skos:example "The Gospel of Luke presents the virgin birth as the fulfillment of God’s promise announced at the annunciation."^^xsd:string,
        "The Gospel of Matthew affirms that Mary conceived Jesus through the Holy Spirit while remaining a virgin."^^xsd:string,
        "The Nicene Creed professes belief that Jesus was born of the Virgin Mary."^^xsd:string .

