    skos:definition "The concept of \"Married (Marital Status)\" refers to the legal status of being married, indicating that an individual has entered into a legally recognized union with another person." .

<R8pWV2DWpkvqZRwPnnFcCzA> a owl:Class ;
    rdfs:label "Last Supper" ;
    rdfs:subClassOf <R8tHlzW74n3nwtE4NF4vaB9> ;
    skos:altLabel "Institution of the Eucharist"^^xsd:string,
        "Institution of the Ministerial Priesthood"^^xsd:string,
        "Paschal Meal of Jesus"^^xsd:string ;
    skos:definition "Last Supper means the final meal Jesus shared with his apostles on the night before his Passion, during which he instituted the Eucharist and the ministerial priesthood. Last Supper inaugurates the Paschal Mystery and establishes the sacramental memorial of Christ’s sacrifice."^^xsd:string ;
    skos:example "Christian liturgy commemorates the Last Supper on Holy Thursday."^^xsd:string,
        "The Gospels describe Jesus blessing bread and wine and giving them to his apostles at the Last Supper."^^xsd:string ;
    skos:prefLabel "Lord’s Supper"^^xsd:string .

<R8qOFsKkZMT4pf5DZrmzLEX> a owl:Class ;
    rdfs:label "Trees" ;
    rdfs:subClassOf <RB9zzoSs7UGZstS4ptLmvxR> ;
    skos:altLabel "Arboreal Plants",
        "Ligneous Plants" ;
    skos:definition "Trees are perennial woody plants characterized by a single main stem or trunk, supporting branches and leaves. They play a critical role in ecosystems by providing oxygen, habitats, and food for various species, and are essential for maintaining environmental balance." ;
    skos:prefLabel "Timber" .

<R8qQX2zUgLXmU92ShX5azyn> a owl:Class ;
    rdfs:label "Eucharistic Adoration" ;
    rdfs:subClassOf <R8ZoCkJhvFXilc4nMQUQffJ> ;
    skos:altLabel "Adoration of the Blessed Sacrament"^^xsd:string,
        "Blessed Sacrament Adoration"^^xsd:string ;
    skos:definition "Eucharistic Adoration is a Christ-centered devotional practice in which the faithful adore Jesus Christ truly present in the Eucharist outside of Mass. It expresses worship, reverence, and contemplative prayer before the Blessed Sacrament."^^xsd:string ;
    skos:example "Perpetual adoration provides continuous prayer before the Eucharist."^^xsd:string,
        "The faithful gather for eucharistic adoration before the Blessed Sacrament."^^xsd:string .

<R8sf2WxI32nduJxQLmrUXTq> a owl:Class ;
