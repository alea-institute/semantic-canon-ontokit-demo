<RjStlt32laPl5Ltjzk1IN9> a owl:Class ;
    rdfs:label "De Fide Catholica" ;
    rdfs:subClassOf <RDP0MNg4nhXIoLECmq0OQrq> ;
    skos:altLabel "Catholic Dogma"^^xsd:string,
        "Definitive Dogmatic Teaching"^^xsd:string,
        "Dogma Of Catholic Faith"^^xsd:string,
        "Infallibly Taught Doctrine"^^xsd:string ;
    skos:definition "De Fide Catholica designates a truth definitively proposed by the Church as requiring belief with divine and Catholic faith, even if the mode of its revelation is known through the Church’s infallible teaching rather than explicit scriptural expression. It is irreformable and admits no legitimate dissent among the faithful."^^xsd:string .

<RjT7upiPt7T4Pp0jalP7Cu> a owl:Class ;
    rdfs:label "Options - Assets" ;
    dc:identifier "EQTYA-OPTION",
        "OPTION" ;
    rdfs:subClassOf <ROT1GuNtl9h4QU8jrvAVO9> ;
    skos:altLabel "Optionen - Vermögenswerte"@de-de,
        "Options - Assets"@en-gb,
        "Opciones - Activos"@es-es,
        "Opciones - Activos"@es-mx,
        "Options - Actifs"@fr-fr,
        "אפשרויות - נכסים"@he-il,
        "विकल्प - संपत्ति"@hi-in,
        "オプション - 資産"@ja-jp,
        "Opções - Ativos"@pt-br,
        "期权 - 资产"@zh-cn ;
    skos:definition "Options are financial instruments that are derivatives based on the value of underlying securities such as stocks. An options contract offers the buyer the opportunity to buy or sell-depending on the type of contract they hold-the underlying asset. Unlike futures, the holder is not required to buy or sell the asset if they choose not to." ;
    skos:hiddenLabel "OPTION" ;
    skos:prefLabel "Options" .

<RjTeQwFB9k2FjOWJuUBhrZ> a owl:Class ;
