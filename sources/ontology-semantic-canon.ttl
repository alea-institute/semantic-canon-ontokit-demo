<RDsHuOZBuSJTT5GSU6jNkCh> a owl:Class ;
    rdfs:label "Solomon's Temple Dedication"^^xsd:string ;
    rdfs:subClassOf <RHNptBYphjt7FzVYMvbY6D> ;
    skos:altLabel "Dedication of Solomon's Temple"^^xsd:string,
        "First Temple Consecration"^^xsd:string,
        "Temple Dedication Ceremony"^^xsd:string ;
    skos:definition "The ceremonial consecration of the First Temple in Jerusalem, where Solomon formally dedicated the building to God and the Ark of the Covenant was placed in the Holy of Holies. This event marked the establishment of the central sanctuary for Israelite worship and the visible dwelling place of God's presence among His people."^^xsd:string ;
    skos:example "Priests carried the sacred ark into the newly completed sanctuary."^^xsd:string,
        "The king gathered all Israel for the temple dedication ceremony."^^xsd:string,
        "The ruler offered a lengthy prayer dedicating the building to divine worship."^^xsd:string .

<RDsKpwzMbtWv0rHSNo4dYKc> a owl:Class ;
    rdfs:label "Stuttering" ;
    rdfs:subClassOf <R7RTOi3HJBujhrMQbvqgmBZ> ;
    skos:altLabel "Fluency Disorder",
        "Speech Dysfluency" ;
    skos:definition "Stuttering, also known as stammering, is a speech disorder characterized by disruptions in the normal flow of speech, including repetitions of sounds, syllables, or words, prolongations of sounds, and involuntary pauses or blocks. These disruptions can vary in frequency and severity and often cause significant communication challenges and anxiety." ;
    skos:prefLabel "Stammering" .

<RDsLdP95vXQr6eGcsPp15zd> a owl:Class ;
