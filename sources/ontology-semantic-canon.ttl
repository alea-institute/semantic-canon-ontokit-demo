<RBuTEIGtnRtDRIUgtUfxTLS> a owl:Class ;
    rdfs:label "Payable-on-Death Account" ;
    dc:source "From LIST: Legal Issues Taxonomy — https://taxonomy.legal/" ;
    rdfs:subClassOf <R8Ahr1iRMkczkHNvcrZ3KOG> ;
    skos:altLabel "POD" ;
    skos:definition "A Payable-on-Death (POD) Account is a financial account, such as a bank account or a certificate of deposit, that allows the account holder to designate a specific beneficiary who will receive the funds in the account upon the account holder's death. This designation operates outside of the probate process, making it a straightforward way to transfer assets to a chosen beneficiary without the need for a will or going through the probate court." .

<RBug6VPbPI6xzKl0BnjypN4> a owl:Class ;
    rdfs:label "Resurrection" ;
    rdfs:comment "In a worldwide Catholic ontology, Resurrection serves as the central pivot of salvation history. It bridges the gap between historical event and eternal reality, functioning both as the foundational miracle of the Faith and the ultimate hope for all humanity."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9SopVNnOp9zwSj4fwxAofC> ],
        <R78g2Psn6TygAlkIoCnXqdd>,
        <R7oT3qg4wZmB5K3qC79EVID>,
        <R8tHlzW74n3nwtE4NF4vaB9> ;
    skos:altLabel "Anastasis"^^xsd:string,
        "Paschal Victory"^^xsd:string,
        "Rising of Christ"^^xsd:string ;
    skos:definition "Resurrection is the rising of the dead, including Jesus Christ from the dead on the third day after his death and burial, signifying his victory over sin and the grave. This concept also encompasses the future rising of all the dead at the end of time, when the soul will be reunited with a glorified body for eternal life."^^xsd:string ;
    skos:example "Celebrating the liturgical feast of Easter as the highest solemnity in the Church year."^^xsd:string,
        "Proclaiming the truth of the rising of the dead during the recitation of the Nicene Creed."^^xsd:string,
        "Witnessing to the hope of eternal life during a Christian funeral rite."^^xsd:string,
        """You need not be amazed! You are looking for Jesus of Nazareth, the one who was crucified. He has been raised up; He is not here. See the place where they laid Him.
(Mark 16:6)"""^^xsd:string .

