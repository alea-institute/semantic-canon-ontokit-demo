<R3GjmYvsSb652grTsofkjK> a owl:Class ;
    rdfs:label "Thyroid Gland Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_09> ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Endocrine Cancer",
        "Thyroid Carcinoma" ;
    skos:definition "Thyroid cancer is a type of cancer that originates in the thyroid gland, which is located at the base of the neck and produces hormones that regulate metabolism. It is typically treatable and often requires treatments such as surgery, radioactive iodine therapy, and hormone therapy." ;
    skos:prefLabel "Thyroid Cancer" .

