        "Cita a jurisprudencia"@es-mx,
        "Citation de la jurisprudence"@fr-fr,
        "ציטוט למשפטי תיקים"@he-il,
        "केसलॉ को उद्धरण"@hi-in,
        "判例引用"@ja-jp,
        "Citação de jurisprudência"@pt-br,
        "引用案例法"@zh-cn ;
    skos:definition "A document's citations to caselaw" .

<RCeKmVl4PL78uA2J5r53a2C> a owl:Class ;
    rdfs:label "Political Questions" ;
    rdfs:subClassOf <RB7BB00LuJawNLM8CZW6z7U> ;
    skos:definition "Political questions refer to issues that courts deem inappropriate for judicial review because they involve decisions best made by the legislative or executive branches of government. In such cases, the judiciary typically refrains from ruling, citing a lack of judicially manageable standards and the need to respect the separation of powers." .

<RCgnG0My1ZvdTFzwkWaOObk> a owl:Class ;
    rdfs:label "Canonical Dispute" ;
    rdfs:comment "In a global Catholic ontology, a Canonical Dispute involves a formal legal disagreement regarding the application or interpretation of the Code of Canon Law. The Church utilizes these proceedings to ensure that justice remains active within the ecclesiastical structure and that the rights of all the faithful are protected according to the \"tranquillity of order.\""^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9HoOEFkLqTzYCpeYoLCNo8> ],
        <RDlItdnVxvODqT0Waa9XBcg> ;
    skos:altLabel "Canon Law Dispute"^^xsd:string,
        "Canonical Controversy"^^xsd:string,
        "Juridical Conflict"^^xsd:string ;
    skos:definition "A Canonical Dispute is a formal legal contest conducted within the Church’s judicial system to resolve conflicts regarding ecclesiastical rights, duties, or penalties. It ensures that the administration of the Church adheres to the prescribed norms of Canon Law to maintain the common good and the salvation of souls."^^xsd:string ;
    skos:example "Conducting a penal process to determine the appropriate canonical sanctions for a violation of ecclesiastical discipline."^^xsd:string,
        "Initiating an administrative recourse to challenge the suppression of a parish by a local ordinary.e"^^xsd:string,
        "Petitioning a dynamic ecclesiastical tribunal to review a declaration of matrimonial nullity."^^xsd:string .

<RCi7RfKkkmw6lGMEMbhezRG> a owl:Class ;
    rdfs:label "Conflict of Interest" ;
    rdfs:subClassOf <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Interessenkonflikt"@de-de,
        "Conflict of Interest"@en-gb,
        "Conflicto de Intereses"@es-es,
        "Conflicto de Interés"@es-mx,
        "Conflit d'intérêts"@fr-fr,
        "סכסוך עניינים"@he-il,
        "हित विरोध"@hi-in,
        "利益相反"@ja-jp,
        "Conflito de interesses"@pt-br,
        "利益冲突"@zh-cn ;
    skos:definition "A conflict of interest is a situation where a person or entity has competing interests or loyalties that may interfere with their ability to act impartially or in the best interest of another party, particularly in the context of civil claims." .

<RCjQi6hoLhejtuG9ZYEjovi> a owl:Class ;
    rdfs:label "State Judicial Branch" ;
    rdfs:subClassOf <RDpdutTNI2rbLZMnb9oqlOc> .

<RCkHgZZUeGJAIkC1UrRqIoG> a owl:Class ;
    rdfs:label "General Contractor" ;
