<RBBLQeg8yAtpo9HzVHp1wJK> a owl:Class ;
    rdfs:label "Give Drink to the Thirsty" ;
    rdfs:subClassOf <RBlfLOh5T3hwTWxMPyHfXBx>,
        <Ru9TAhxYKI0ZIOxJGezsYK> ;
    skos:altLabel "Access to Clean Water"^^xsd:string,
        "Access to Safe Drinking Water"^^xsd:string,
        "Clean Water Provision"^^xsd:string,
        "Emergency Hydration Relief"^^xsd:string,
        "Provide Water to the Thirsty"^^xsd:string,
        "Water Relief"^^xsd:string ;
    skos:definition "Give Drink to the Thirsty is a corporal work of mercy that consists in providing water or other necessary drink to those who lack access to it. Give Drink to the Thirsty responds to basic human need as an act of charity, justice, and respect for human dignity."^^xsd:string ;
    skos:example "A community provides drinking water to migrants traveling in extreme conditions."^^xsd:string,
        "A parish funds the construction of a well in a community without clean water."^^xsd:string,
        "A school supports projects that expand access to safe drinking water."^^xsd:string,
        "An aid organization installs water purification systems in disaster zones."^^xsd:string,
        "Volunteers distribute bottled water during a heat emergency."^^xsd:string .

<RBBPUm7CnQzgT9OtoXsLexU> a owl:Class ;
    rdfs:label "Right to Compulsory Process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9tZFXPrXQJWHbqSgtCQxJF> ],
        <RBlWM6X0yqMrb4z4JQYaEP2> ;
    skos:altLabel "Compulsory Process Clause Claim",
        "Recht auf Zwangsvorladung"@de-de,
        "Right to Compulsory Process"@en-gb,
        "Derecho a un Proceso Compulsivo"@es-es,
        "Derecho a un Proceso Compulsorio"@es-mx,
        "Droit à une procédure obligatoire"@fr-fr,
        "זכות לתהליך חזק"@he-il,
        "अधिकृत प्रक्रिया का अधिकार"@hi-in,
        "強制的証拠開示権"@ja-jp,
        "Direito a processo compulsório"@pt-br,
        "强制程序权利"@zh-cn ;
    skos:definition "The right to compulsory process is a legal principle that grants individuals involved in a criminal trial the ability to obtain witnesses or evidence in their favor through the power of the court. This right, protected by the Sixth Amendment of the United States Constitution, ensures that defendants have a fair opportunity to present their case and gather supporting testimony or materials, even if it requires compelling unwilling witnesses to appear in court or obtaining documents that may be difficult to acquire voluntarily." .

