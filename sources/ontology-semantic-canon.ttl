<RKj3panTdxsJ7nFn11CPGT> a owl:Class ;
    rdfs:label "8th Amendment Claim" ;
    rdfs:subClassOf <R7MGQ9xUx0PxGLp5yxprdpZ> ;
    skos:altLabel "8. Änderungsantrag Anspruch"@de-de,
        "8th Amendment Claim"@en-gb,
        "Reclamo de la Octava Enmienda"@es-es,
        "Reclamo de la Octava Enmienda"@es-mx,
        "Réclamation de 8ème amendement"@fr-fr,
        "תביעה על התיקון השמיני"@he-il,
        "8वीं संशोधन दावा"@hi-in,
        "第8修正案の主張"@ja-jp,
        "Reivindicação da 8ª Emenda"@pt-br,
        "第八修正案索赔"@zh-cn ;
    skos:definition "An Eighth Amendment claim is a legal argument asserting that an individual's constitutional protection against cruel and unusual punishment, as guaranteed by the Eighth Amendment of the United States Constitution, has been violated. Such claims typically involve disputes over the conditions of confinement, the use of excessive force, or the imposition of excessive fines or bail, and aim to protect the basic human rights and dignity of individuals subject to punishment or detention." ;
    skos:prefLabel "Eighth Amendment Claim" .

<RKqxeuifrYkNfCxyHq59hz> a owl:Class ;
    rdfs:label "Administration of Environmental Quality Programs Industry" ;
    dc:identifier "PUB-EQPR" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=924> ;
    rdfs:subClassOf <RC2P0YZS5Ku67wmSwN4OxWs> ;
