<R9hsczNJLFb3o5wl4i8eMAw> a owl:Class ;
    rdfs:label "Evil" ;
    rdfs:subClassOf <RCuw9Co5aqGGoEIUhnvjRXK> ;
    skos:altLabel "Disorder of the Good"^^xsd:string,
        "Intentional Evil"^^xsd:string,
        "Malice"^^xsd:string,
        "Moral Evil"^^xsd:string,
        "Physical Evil"^^xsd:string,
        "Structural Evil"^^xsd:string,
        "Wrongdoing"^^xsd:string ;
    skos:definition "Evil is the moral concept that names the privation or corruption of the good that ought to be present in a person, act, or state of affairs. Evil arises through disordered will, unjust action, or structural conditions that oppose right reason and moral order."^^xsd:string ;
    skos:example "Evil appears in acts of deception that undermine trust and truth."^^xsd:string,
        "Evil calls for moral judgment, repentance, and restoration of right order."^^xsd:string,
        "Evil distorts human freedom by turning the will away from the good."^^xsd:string,
        "Evil manifests in social structures that perpetuate injustice and exploitation."^^xsd:string,
        "Evil occurs when a person knowingly chooses to harm an innocent person."^^xsd:string .

