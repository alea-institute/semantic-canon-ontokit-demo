    skos:definition "For a given dispute, a description of the assets that are potentially exposed or subject to recovery." .

<RDJCVxMdg9nG7TJxLsDHfRB> a owl:Class ;
    rdfs:label "Religious Authority Level" ;
    rdfs:subClassOf <http://webprotege.stanford.edu/RBTE2mUxX4WZjAu5EkKF4MA> ;
    skos:altLabel "Church Authority Level"^^xsd:string,
        "Ecclesiastical Authority Level"^^xsd:string,
        "Pastoral Authority Level"^^xsd:string,
        "Sacred Authority Level"^^xsd:string ;
    skos:definition "Religious Authority Level is the authority exercised within the Church to teach, sanctify, and govern in matters ordered to faith, morals, worship, and ecclesial life. Religious Authority Level derives from divine institution and ecclesial mission, and it binds conscience according to its proper scope and form."^^xsd:string ;
    skos:example "A bishop governs a diocese according to canon law and apostolic mandate."^^xsd:string,
        "A deacon exercises ministry according to authority received through ordination."^^xsd:string,
        "A parish priest exercises pastoral authority over a parish community."^^xsd:string,
        "The Church recognizes certain charisms as authentic for the good of the faithful."^^xsd:string,
        "The pope teaches authoritatively on matters of faith and morals."^^xsd:string .

<RDJYLQ3woaBs6FkT7wMbB4U> a owl:Class ;
