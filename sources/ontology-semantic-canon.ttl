<R76ZXX5F2U3ZNFiP1HqoAae> a owl:Class ;
    rdfs:label "Compilation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RNJR37ek3zONvzTVH9PxqS> ],
        <R7mMPoEuA9Ja4rODr1LGXcR> ;
    skos:definition "Compilation in copyright law is a work formed by assembling, selecting, or organizing pre-existing material or data, creating a unique intellectual creation through this process. It requires that the compilation's arrangement or selection of contents be original, even if the individual elements are not." .

<R76ZlnhoJvqxs7byZOMfScw> a owl:Class ;
    rdfs:label "Not in Destination Country" ;
    rdfs:subClassOf <R8N4pMIOhTNbqcmDczSephq> ;
    skos:altLabel "Not in U.S." ;
    skos:definition "In the context of immigration law, \"Not in Destination Country\" refers to an individual who is not in the United States but may be in the process of seeking admission or has intentions to travel there. This term is commonly used to distinguish individuals who are abroad and may be subject to different legal procedures or criteria for entering the U.S., as opposed to those already within the country." .

<R76fJBLOFeuJb0LJlnFAuKF> a owl:Class ;
