<RBrp8nIb4N9CLyWAauqUAM> a owl:Class ;
    rdfs:label "Primary Source" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7ju2C0HxoDqBL5XSpENfiR> ],
        <RBgvM3CLfhaoq2TagoUDUBG> ;
    skos:altLabel "Authoritative Text"^^xsd:string,
        "Contemporaneous Record"^^xsd:string,
        "Eyewitness Account"^^xsd:string,
        "Original Dataset"^^xsd:string,
        "Original Document"^^xsd:string,
        "Original Manuscript"^^xsd:string,
        "Original Source"^^xsd:string,
        "Primary Material"^^xsd:string,
        "Source of First Instance"^^xsd:string ;
    skos:definition "Primary Source is an original work or artifact that constitutes direct evidence of an event, teaching, decision, or creative act. A Primary Source derives authority from its immediacy to the subject rather than later interpretation or synthesis."^^xsd:string ;
    skos:example "A biblical manuscript serves as a primary source for scriptural study."^^xsd:string,
        "A contemporaneous diary provides a primary source account of historical events."^^xsd:string,
        "A council decree functions as a primary source of ecclesial law and doctrine."^^xsd:string,
        "A papal encyclical is a primary source for Catholic teaching."^^xsd:string,
        "A signed contract constitutes a primary source in legal analysis."^^xsd:string .

