    skos:altLabel "Defence of Habitation Claim",
        "Domestic Self-Defense Claim" ;
    skos:definition "A Castle Doctrine Claim refers to a legal principle that allows a person to use force, including deadly force, in defense of their home or dwelling without the duty to retreat. This doctrine is based on the premise that one's home is their castle, and they have the right to protect it and its occupants from intruders or attackers." ;
    skos:prefLabel "Home Defense Claim" .

<R9GgZWuLOPjDMH0v2bPfltu> a owl:Class ;
    rdfs:label "Paraplegia" ;
    rdfs:subClassOf <R9eX3Auj16MgFGGYWRmhns8> ;
    skos:altLabel "Lower Body Paralysis" ;
    skos:definition "Paraplegia is a type of mobility disability characterized by the partial or complete paralysis of the lower half of the body, including both legs. This condition typically results from spinal cord injuries or diseases affecting the thoracic, lumbar, or sacral regions of the spine, leading to loss of motor and sensory function below the level of injury." ;
    skos:prefLabel "Paraplegic Condition" .

<R9GhYhVpQcfACzLmyST872w> a owl:Class ;
    rdfs:label "International Annual Report" ;
    rdfs:subClassOf <RmCERXtzdqIJcW9mdbk0Bb> ;
    skos:definition "An International Annual Report is an annual report of a foreign company listed on a domestic stock exchange. In the United States, Form 40-F is an annual report filed with the U.S. Securities and Exchange Commission by Canadian issuers to register securities under the Securities Exchange Act of 1934. The 40-F serves as a combined annual report and registration statement, providing key financial statements, management discussion and analysis, and detailed business information. It helps meet SEC disclosure requirements for foreign private issuers accessing U.S. capital markets." ;
    skos:prefLabel "40-F" .

<R9Git6fvqGuGe2U4QMFH4nR> a owl:Class ;
    rdfs:label "Georgia District Court - Walker County" ;
    rdfs:subClassOf <RBxw7BF15bDA0Ifn2vOrC8h> ;
    skos:definition "Georgia District Court - Walker County: A specific court within the Georgia District Court system that has jurisdiction over legal matters within Walker County." .

<R9Gl11ci9eu3hIdRBW6tY4C> a owl:Class ;
    rdfs:label "Limited Conservatorship of Adult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8YEKFiYkowitD7dlvVs9Dj> ],
        <RCLhlWbP1bW4sRAflunmrrz> ;
    skos:altLabel "Begrenzte Vormundschaft für Erwachsene"@de-de,
        "Limited Conservatorship of Adult"@en-gb,
        "Tutela limitada de adultos"@es-es,
        "Tutela limitada de adultos"@es-mx,
        "Tutelle limitée des adultes"@fr-fr,
        "הגבלת הוטלת על מבוגר"@he-il,
        "वयस्क की सीमित संरक्षण"@hi-in,
        "成年後見の限定"@ja-jp,
        "Curatela limitada de adultos"@pt-br,
        "成年人有限监护"@zh-cn ;
    skos:definition "A Limited Conservatorship of Adult is a legal arrangement in which a conservator is appointed to manage the personal and/or financial affairs of an adult with developmental disabilities who is unable to fully care for themselves, but only to the extent necessary to provide for their basic needs and protect them from harm." .

<R9GlpqwbSHbb3h7XFMgWUyM> a owl:Class ;
    rdfs:label "The Fragrance of Christ" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RyTfHxUQPVMUQrtIt1Mycz> ;
    skos:altLabel "Prayer for Evangelization by Example"^^xsd:string,
        "Prayer of Christian Witness"^^xsd:string,
        "Prayer of Lived Discipleship"^^xsd:string ;
    skos:definition "The Fragrance of Christ is a devotional prayer that asks for grace to witness to Christ through actions, presence, and love rather than words alone. It emphasizes evangelization by example, allowing charity and holiness to draw others to Christ."^^xsd:string ;
    skos:example "Before beginning the workday, she prayed The Fragrance of Christ to witness through patience and kindness."^^xsd:string,
        "During a retreat on discipleship, the group reflected on The Fragrance of Christ as a model of silent evangelization."^^xsd:string,
        "Help me to spread your fragrance everywhere I go - let me preach you without preaching, not by words but by my example - by the catching force, the sympathetic influence of what I do, the evident fullness of the love my heart bears to you."^^xsd:string,
        "In spiritual direction, he used The Fragrance of Christ to examine how actions reflect love of Christ."^^xsd:string .

<R9GtnnG2Zuj1r0ZVPnVl0Js> a owl:Class ;
    rdfs:label "Conversion of Saint Paul" ;
    rdfs:subClassOf <R9eJYLpE8tqxZQwMcMzWXkl> ;
    skos:altLabel "Call of Saint Paul"^^xsd:string,
        "Damascus Road Conversion"^^xsd:string ;
    skos:definition "Conversion of Saint Paul means the event in which Saul of Tarsus encountered the risen Jesus Christ on the road to Damascus and was radically transformed from persecutor to apostle. Conversion of Saint Paul reveals the power of divine grace and establishes Paul’s vocation as the apostle to the Gentiles."^^xsd:string ;
    skos:example "Christian theology interprets the conversion of Saint Paul as a decisive moment in the Church’s mission to the Gentile world."^^xsd:string,
        "The Acts of the Apostles recount Saul’s encounter with the risen Christ on the road to Damascus."^^xsd:string ;
    skos:prefLabel "Conversion of Saul"^^xsd:string .

<R9GyZHycC6BBiKe9DBhAUej> a owl:Class ;
    rdfs:label "Investor Questionnaire" ;
    rdfs:subClassOf <RmqysGFQ1RYW3F9lv5u3hu> ;
    skos:definition "An Investor Questionnaire in a legal and financial context is a structured document consisting of a series of questions designed to gather specific information from the respondent. It is often used for due diligence purposes, like in Bad Actor Questionnaires to assess regulatory compliance, or FINRA Questionnaires to evaluate suitability for financial industry roles." ;
    skos:example "Bad Actor Questionnaire",
        "FINRA Questionnaire" .

<R9H2moSYZ56RmnlXQ06F6gY> a owl:Class ;
