<R8R7UAZpzIQTdqNtctKj3XY> a owl:Class ;
    rdfs:label "Unfair Prejudice Objection" ;
    dc:source "Fed. R. Evid. 403" ;
    rdfs:subClassOf <R9Bk5v9AAJmhb4WcgIQjy29> ;
    skos:altLabel "Bias-Inducing Evidence Objection",
        "Objection to Bias-Causing Evidence",
        "Prejudicial Impact Objection" ;
    skos:definition "An Unfair Prejudice Objection is raised when a party in a legal proceeding believes that evidence being presented is more likely to cause bias or unfair harm to one side than to contribute meaningfully to the resolution of the case. In other words, the evidence's probative value doesn't outweigh its unfairly prejudicial impact. This objection seeks to prevent evidence that might unfairly influence the decision-maker's judgment, ensuring that the trial remains fair and impartial." ;
    skos:prefLabel "Unfairly Prejudicial Objection" .

<R8arYcuKOmoupgBeekNim0e> a owl:Class ;
    rdfs:label "Laity" ;
    rdfs:subClassOf <RBCWax7xWlrjx6Ni9AAFoE8> ;
    skos:altLabel "Christian Faithful"^^xsd:string,
        "Lay Faithful"^^xsd:string,
        "Lay Members Of The Faithful"^^xsd:string,
        "Lay Minister"^^xsd:string,
        "Lay Person"^^xsd:string,
        "Layperson"^^xsd:string,
        "Christifideles Laici"@la,
        "Laici"@la ;
    skos:definition "The Laity are the baptized members of the Christian faithful who are not ordained clergy and are not members of institutes of consecrated life. By baptism and confirmation, the laity share in Christ’s priestly, prophetic, and kingly mission and carry out the Church’s mission primarily within secular life."^^xsd:string ;
    skos:example "A layperson participates fully in the Church’s mission while remaining rooted in secular society."^^xsd:string,
        "Lay faithful may serve as catechists, pastoral assistants, or leaders of ecclesial movements."^^xsd:string,
        "The Christifideles laici are called to sanctify the world from within."^^xsd:string,
        "The laity collaborate with clergy and religious in parish and diocesan ministries."^^xsd:string,
        "The laity live out their Christian vocation through family life, professional work, and civic responsibility."^^xsd:string .

<R8ldDGTh6RHzt0IDL7p597U> a owl:Class ;
    rdfs:label "Crimes Against Property" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
