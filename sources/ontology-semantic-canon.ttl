<R8c8MlYRtZt7rIsLsBfSY2y> a owl:Class ;
    rdfs:label "Lay Ecclesial Minister" ;
    rdfs:subClassOf <R8arYcuKOmoupgBeekNim0e> ;
    skos:altLabel "Ecclesial Lay Minister"^^xsd:string,
        "Lay Minister"^^xsd:string,
        "Pastoral Associate"^^xsd:string ;
    skos:definition "A Lay Ecclesial Minister is a lay member of the Christian faithful who serves the Church in a stable, formally recognized ministry under ecclesial authority. This role involves leadership, pastoral service, or specialized ministry in support of the Church’s mission, while the person remains in the lay state."^^xsd:string ;
    skos:example "A lay ecclesial minister coordinates pastoral care and faith formation in a parish."^^xsd:string,
        "A lay ecclesial minister receives formation and authorization according to diocesan norms."^^xsd:string,
        "Lay ecclesial ministers collaborate closely with clergy in parish leadership."^^xsd:string,
        "Many lay ecclesial ministers serve full time in education, pastoral, or administrative roles."^^xsd:string,
        "The diocese commissions a lay ecclesial minister for service in campus ministry."^^xsd:string ;
    skos:prefLabel "Lay Pastoral Minister"^^xsd:string .

<R8cAUGCD26l2F8qRw3OKFLc> a owl:Class ;
    rdfs:label "God's Promise Never to Destroy Earth by Water Again"^^xsd:string ;
    rdfs:subClassOf <RCBLX9kRgt1l471LVzI5N7P> ;
    skos:altLabel "Divine Preservation Vow"^^xsd:string ;
    skos:definition "God's Promise Never to Destroy Earth by Water Again represents the divine oath that God declared to Noah, his descendants, and all living creatures following the flood. This unconditional promise establishes God's commitment to preserve creation despite human sinfulness, marking a fundamental shift in divine-human relations from judgment to mercy."^^xsd:string ;
    skos:example "Environmental encyclicals sometimes reference God's promise never to destroy earth by water again when addressing climate change and humanity's responsibility toward creation."^^xsd:string,
        "Liturgical prayers invoked God's promise never to destroy earth by water again as assurance of divine mercy during natural disasters."^^xsd:string,
        "Some theologians interpret God's promise never to destroy earth by water again as establishing the theological foundation for God's patient endurance of human sin."^^xsd:string .

