        <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Auto Dealership Liability",
        "Haftung von Autohändlern"@de-de,
        "Motor Vehicle Dealership Liability"@en-gb,
        "Responsabilidad del Concesionario de Vehículos Motorizados"@es-es,
        "Responsabilidad del Distribuidor de Vehículos Motorizados"@es-mx,
