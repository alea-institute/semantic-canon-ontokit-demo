<Rn2wqpEjRoMJbdJK3ymCcW> a owl:Class ;
    rdfs:label "Roman Curia Office" ;
    rdfs:subClassOf <RDMsL8T3t9qIU3TOdiJvQBN> ;
    skos:altLabel "Curial Office"^^xsd:string,
        "Holy See Office"^^xsd:string,
        "Roman Curia Department"^^xsd:string ;
    skos:definition "A Roman Curia Office is an administrative or coordinating body of the Holy See that supports the Roman Pontiff in the exercise of his universal pastoral mission. It provides services, coordination, or specialized functions distinct from doctrinal dicasteries and judicial tribunals."^^xsd:string ;
    skos:example "A Roman Curia office coordinates the daily governance of the Holy See."^^xsd:string,
        "Curia offices support diplomatic, economic, and administrative operations."^^xsd:string,
        "The Secretariat of State functions as the central coordinating office of the Roman Curia."^^xsd:string .

<Rn4hADXgSZ71CoPmwZAnr1> a owl:Class ;
    rdfs:label "Coadjutor Bishop"@en ;
    rdfs:subClassOf <RLdgWVNya1F84PAUEqTftE> ;
    skos:altLabel "Bishop Coadjutor"@en,
        "Coadjutor Ordinary"@en ;
    skos:definition "A Coadjutor Bishop is a bishop appointed to assist the diocesan bishop and who possesses the right of succession to the diocese. Upon the diocesan bishop’s resignation, transfer, or death, the coadjutor automatically becomes the diocesan bishop."@en ;
    skos:example "A coadjutor bishop assists the diocesan bishop and holds the right of succession."@en,
        "The Holy See appoints a coadjutor bishop when continuity of governance is needed."@en,
        "Upon the ordinary’s retirement, the coadjutor becomes diocesan bishop immediately."@en .

