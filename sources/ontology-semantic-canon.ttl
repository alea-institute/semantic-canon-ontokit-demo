        <R7MbuFEaL6NyU9tM2AXk7lk> ;
    skos:altLabel "Körperverletzung"@de-de,
        "Criminal Battery"@en-gb,
        "Agresión Criminal"@es-es,
        "Batería Criminal"@es-mx,
        "Batterie criminelle"@fr-fr,
        "סולם פלילי"@he-il,
        "आपराधिक बैटरी"@hi-in,
        "暴行罪"@ja-jp,
        "Lesão corporal dolosa"@pt-br,
        "刑事电池"@zh-cn ;
    skos:definition "The intentional and unlawful use of force against another person, resulting in harmful or offensive contact, without that person's consent." .

<R7m7hUozBtx7JODLD9VRxlY> a owl:Class ;
    rdfs:label "Motorcyclist" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7r8FeqnphadygvNP0XHj84> ],
        <R8bNzp6lTyATfctRVnXr5rl> ;
    skos:altLabel "Biker" ;
    skos:definition "A motorcycle driver is an individual who operates a motorcycle, controlling its mechanisms to navigate roads and other environments. This role entails a distinct set of skills and adherence to specific traffic laws to ensure the safety of the driver and other road users." ;
    skos:prefLabel "Motorcycle Driver" .

<R7n9rAWIq1fi7qGb3xRynWG> a owl:Class ;
    rdfs:label "Blasphemous Material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RHqthPE9sVZoY4ohq1VaN1> ],
        <R7fCP2EQY8XQ5fxqiYaKPQA> ;
    skos:altLabel "Anti-Religious Material",
        "Profane Material",
        "Religious Offense Content" ;
    skos:definition "Blasphemous Material refers to content that shows disrespect or irreverence toward religious beliefs, figures, deities, or sacred symbols. This type of material often leads to significant controversy and legal actions in jurisdictions where blasphemy laws are enforced." ;
    skos:prefLabel "Sacrilegious Content" .

<R7ngAC5KMKiOazWcp35APHI> a owl:Class ;
    rdfs:label "Immigration Arrival in Country" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RyNiu4sHJoI3Rc5VGodCvc> ],
        <RBEXxc9B6kR2p0BMwGjhWGW> ;
    skos:altLabel "Border Crossing" ;
    skos:definition "Arrival In Country refers to the act of entering a nation, commonly documented and regulated through immigration control points like airports, seaports, and land borders. The process usually involves inspection and verification of travel documents, visas, and other entry requirements, after which the individual is granted or denied permission to enter the country." ;
    skos:prefLabel "Entry Date" .

<R7nn3Ecr1ZswWh3I6hweei7> a owl:Class ;
    rdfs:label "Oil and Gas Extraction Industry" ;
    dc:identifier "NRS-OGEX" ;
    rdfs:subClassOf <ROWsW3Tkpc2YQmbHQehntm> ;
    skos:altLabel "Oil and Gas Extraction",
        "Öl- und Gasförderindustrie"@de-de,
        "Oil and Gas Extraction Industry"@en-gb,
        "Industria de extracción de petróleo y gas"@es-es,
        "Industria de extracción de petróleo y gas"@es-mx,
        "Industrie d'extraction de pétrole et de gaz"@fr-fr,
        "תעשיית חילוץ נפט וגז"@he-il,
        "तेल और गैस निष्कर्षण उद्योग"@hi-in,
        "石油・ガス採掘産業"@ja-jp,
        "Indústria de extração de petróleo e gás"@pt-br,
        "石油和天然气开采行业"@zh-cn ;
    skos:definition "Industries in this group operate and/or develop oil and gas field properties. Such activities may include exploration for crude petroleum and natural gas; drilling, completing, and equipping wells; operating separators, emulsion breakers, desilting equipment, and field gathering lines for crude petroleum and natural gas; and all other activities in the preparation of oil and gas up to the point of shipment from the producing property. This subsector includes the production of crude petroleum, the mining and extraction of oil from oil shale and oil sands, and the production of natural gas, sulfur recovery from natural gas, and recovery of hydrocarbon liquids." ;
    skos:hiddenLabel "OGEX" .

<R7oAOOGrsnzhH7VlWXpLtAc> a owl:Class ;
    rdfs:label "Legislative Immunity" ;
    rdfs:subClassOf <RBvhPeoPwTNYsc19VBpYjSV> ;
    skos:altLabel "Legislativer Immunität"@de-de,
        "Legislative Immunity"@en-gb,
        "Inmunidad legislativa"@es-es,
        "Inmunidad legislativa"@es-mx,
        "Immunité législative"@fr-fr,
        "חסינות חקיקתית"@he-il,
        "विधायी निषेध"@hi-in,
        "立法免除"@ja-jp,
        "Imunidade legislativa"@pt-br,
        "立法豁免"@zh-cn ;
    skos:definition "Legislative Immunity refers to the legal protection granted to legislators from being held liable for their actions or statements made in the course of their legislative duties." .

<R7pahpml2WPENJk6Hj3KqcY> a owl:Class ;
    rdfs:label "Denial Event" ;
    rdfs:subClassOf <ReoekaIFkvXuZDtiEVwWPe> ;
    skos:definition "A Regulatory Denial Event refers to the situation where an application, request, or submission made to a regulatory authority is declined or denied, often due to not meeting the specified criteria or requirements. In immigration, this could entail the rejection of an immigration application, visa request, or other related matters based on assessment by the relevant authorities" .

<R7q90spH4wsRFATpgyr6hx0> a owl:Class ;
    rdfs:label "International Ethics" ;
    rdfs:comment "In a global Catholic ontology, International Ethics addresses the justice, peace, and cooperation governing the relationships between nations and peoples. It draws heavily from the tradition of jus gentium (the law of nations) and modern encyclicals like Fratelli tutti, emphasizing that the human family transcends political borders."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBsiX2FSnOKhxvLGKoU9x1> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <cUYwHflZSzWd6WAHDBe2Rw> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RtGO7nVUVQhovRrhewzPBk> ],
        <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Diplomacy and Peacemaking"^^xsd:string,
        "Ethics of International Relations"^^xsd:string,
        "Global Ethics"^^xsd:string,
        "Global Justice and Equity"^^xsd:string,
        "Transnational Ethics"^^xsd:string,
        "Universal Common Good"^^xsd:string,
        "World Order Ethics"^^xsd:string ;
    skos:definition "International Ethics evaluates the conduct of sovereign states and global institutions according to the principles of solidarity and the universal common good. It provides the ethical framework for diplomacy, international law, and the pursuit of global peace through the lens of human dignity."^^xsd:string ;
    skos:example "Advocating for the fair distribution of medical supplies between wealthy and developing nations during a global crisis."^^xsd:string,
        "Developing international environmental policies that recognize the shared responsibility of all nations to care for the earth."^^xsd:string,
        "Negotiating peace treaties that prioritize the restoration of justice and the protection of civilian lives over territorial gain.e"^^xsd:string .

<R7qEZ5Y9qpwrPabAFeVeGku> a owl:Class ;
    rdfs:label "International Swaps and Derivatives Association Agreement" ;
    rdfs:subClassOf <R7p3ZBGzc1BxDrCwYJnsTo> ;
    skos:definition "An ISDA Agreement is a standardized contract established by the International Swaps and Derivatives Association to regulate over-the-counter derivatives transactions. It standardizes terms, reduces risk, and clarifies mutual responsibilities between parties." ;
    skos:prefLabel "ISDA Agreement" .

<R7qfDUdV0uQYPGsrjTf3QDf> a owl:Class ;
    rdfs:label "Involuntary Employment Termination Event" ;
    rdfs:subClassOf <RCy69ZSLkXNMIWCj0nv9qzO> ;
    skos:definition "Involuntary employment termination event refers to the act of an employer initiating the separation of an employee from their job. Reasons can range from downsizing and organizational restructuring to performance issues or misconduct." .

<R7r8FeqnphadygvNP0XHj84> a owl:Class ;
    rdfs:label "Motorcycle" ;
    rdfs:subClassOf <R1okJKMvv4mMHv7m4TzwBe> ;
    skos:definition "A motorcycle is a two-wheeled motorized vehicle typically powered by an internal combustion engine. Motorcycles are designed for personal transportation and come in various styles, including sport bikes, cruisers, touring bikes, and off-road motorcycles." .

<R7t2Hg7cfHArl1MVLOotjPG> a owl:Class ;
    rdfs:label "Timber Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8qOFsKkZMT4pf5DZrmzLEX> ],
        <RCkPc0XIMxDInzRipCUUZ1q> ;
    skos:definition "Timber rights provide the holder with the authority to harvest trees from a designated area of land. These rights can be sold or leased independently of the land itself." .

<R7wjSxFeGSnGHBA4sop8v3G> a owl:Class ;
    rdfs:label "Jail" ;
    rdfs:subClassOf <R8ibMTtrBCWGIGOeFjTLtL0> ;
    skos:altLabel "Detention Center",
        "Holding Facility" ;
    skos:definition "A Jail is a local government-run facility designed to detain individuals who are awaiting trial, sentencing, or serving short-term sentences typically for minor offenses. It serves as a temporary holding place for pretrial detainees and inmates convicted of misdemeanors, emphasizing security, custody, and limited rehabilitation services." ;
    skos:prefLabel "Short-Term Detention Facility" .

<R7x6g9iAXmUiJlXphvLtQcO> a owl:Class ;
    rdfs:label "Additur" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8A4jLWkG2KpI6wfAznsSCx> ],
        <RDbz1PVc6y57oOb9jAIl0eN> ;
    skos:altLabel "Court-Ordered Damages Increase",
        "Enhanced Damages Award",
        "Judicial Increase In Damages" ;
    skos:definition "Additur refers to a court's power to increase the amount of damages awarded by a jury if the judge finds the award insufficient. This practice is primarily used in the United States and is not recognized in federal courts due to constitutional concerns regarding the Seventh Amendment." .

<R7yZIgA7OiFZCN0zGIsguvf> a owl:Class ;
    rdfs:label "Probate Court" ;
    rdfs:subClassOf <R9sbuHkJC9aqDlHAgw58VSB> ;
    skos:definition "A Probate Court is a specialized court that deals with the administration of estates and the distribution of assets after a person's death." .

