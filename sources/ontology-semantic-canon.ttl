<R93lAFBMFDYR1Cwfl4yeimP> a owl:Class ;
    rdfs:label "Finding the Child Jesus in the Temple" ;
    rdfs:subClassOf <R8Q2ik3utpYM1LNPjwbkF4A>,
        <RBsvz4pgTzoSsHozyIMUdrv> ;
    skos:altLabel "Finding of Jesus in the Temple"^^xsd:string,
        "Jesus Among the Teachers"^^xsd:string ;
    skos:definition "The Finding of the Child Jesus in the Temple is the event in which Mary and Joseph discovered Jesus in the Jerusalem temple after three days, engaged in dialogue with the teachers. It reveals Jesus’s early awareness of his mission and his relationship to God, while remaining within the context of family obedience."^^xsd:string ;
    skos:example "A homily reflected on the Finding of the Child Jesus in the Temple as revealing early signs of his mission."^^xsd:string,
        """On the third day they came upon Him in the temple sitting in the midst of the teachers, listening to them and asking them questions.
(Luke 2:46)"""^^xsd:string,
        "The Gospel of Luke recounts the Finding of the Child Jesus in the Temple during the family’s pilgrimage to Jerusalem."^^xsd:string ;
    skos:prefLabel "The Boy Jesus in the Temple"^^xsd:string .

