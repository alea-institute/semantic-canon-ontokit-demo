<R73cUH079dsK0pNRJiV7Jps> a owl:Class ;
    rdfs:label "Business Interruption Insurance Policy" ;
    rdfs:subClassOf <Rq6neiK9deZLSfSa41jylg> ;
    skos:definition "Business interruption insurance compensates for lost income and operating expenses when a business is unable to operate due to a covered event, such as a natural disaster, fire, or other insurable occurrences. This coverage helps to maintain financial stability during periods when normal business operations are adversely affected." .

<R73dveMt11oYotWVGR1ST2F> a owl:Class ;
    rdfs:label "Cherries" ;
    rdfs:subClassOf <R8WhsyEOse5TvMLfnHDYfTY> ;
    skos:altLabel "Prunus Fruit" ;
    skos:definition "Cherries are small, round stone fruits from the Prunus genus, characterized by their juicy flesh, smooth skin, and varying flavors from sweet to tart. They are widely consumed fresh, dried, or processed into products like jams, pies, and beverages, valued for their rich antioxidant content, vitamins, and dietary fiber." .

<R73e7MvslVKhXMpvW8lfJbB> a owl:Class ;
    rdfs:label "Status - Approved" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCyX1ukzdCGh1AZ9GHAVTMB> ],
        <RdOK7keDYcH1kYilffkkjr> ;
    skos:altLabel "Approved" ;
    skos:definition "Status of \"Approved\" indicates that an application or request has been reviewed and granted approval by the relevant authority, confirming that the individual's request or application has met the necessary criteria and legal requirements, allowing them to proceed with the intended action, status change, or benefit. This tag is particularly relevant to regulatory agencies (e.g., immigration, patent, trademark)." .

<R73jCDNZO71858YRbQG6iRA> a owl:Class ;
    rdfs:label "Freedom from Slavery" ;
    dc:source "International Bill of Human Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RpiGkhd21dqeqzY6R5l2tN> ],
        <RBJlYzE4ZY14dTEghzbbMHg> ;
    skos:definition "Freedom from slavery is a basic human right that prohibits all forms of slavery, servitude, and forced or compulsory labor. This right is enshrined in various international instruments, such as the Universal Declaration of Human Rights and the United Nations Slavery Convention, and is considered a non-derogable right, meaning it cannot be suspended for any reason." .

<R73l5ieLA2jBChIQidqru7F> a owl:Class ;
    rdfs:label "Cluttering" ;
    rdfs:subClassOf <R7RTOi3HJBujhrMQbvqgmBZ> ;
    skos:altLabel "Disorganized Speech Pattern",
        "Rapid Speech Disorder" ;
    skos:definition "Cluttering is a speech disorder characterized by a rapid or irregular speech rate, which often results in disorganized speech patterns, including omitting or collapsing syllables and words. This disorder affects the clarity and fluency of speech, making it difficult for listeners to understand." ;
    skos:prefLabel "Tachylalia" .

