    skos:definition "A Debt Agreement is a legally binding contract between a debtor and creditor(s) that outlines the terms and conditions for repayment of a debt, including any interest or fees." ;
    skos:prefLabel "Debt Related Agreement" .

<RWS7oVs9s2563KGt41Lsta> a owl:Class ;
