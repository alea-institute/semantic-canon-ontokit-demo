    rdfs:subClassOf <Do81p7GqTVSWefgMOcuJzw> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in growing and/or producing floriculture products (e.g., cut flowers and roses, cut cultivated greens, potted flowering and foliage plants, and flower seeds) under cover and in open fields." .

<O2uxsJDHRoWW0VDtau7I3g> a owl:Class ;
