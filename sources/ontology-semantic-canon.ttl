<RWYR2MYY5JsW5YkzH1kx0M> a owl:Class ;
    rdfs:label "Chronic Soft Tissue Surgical Intervention" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/1.00-Musculoskeletal-Adult.htm#1_21> ;
    rdfs:subClassOf <RpiyvcnyPAZ5hygNt0zO3j> ;
    skos:definition "A soft tissue injury or abnormality under continuing surgical management involves damage or dysfunction affecting non-bone structures such as muscles, tendons, ligaments, or skin that requires ongoing surgical intervention. This management is aimed at repairing or reconstructing the damaged soft tissues and addressing any related complications or functional impairments." ;
    skos:prefLabel "Soft Tissue Injury or Abnormality Under Continuing Surgical Management" .

