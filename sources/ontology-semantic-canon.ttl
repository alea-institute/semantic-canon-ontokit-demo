    rdfs:subClassOf <R3OI7nrib1LEPtUfn5G5CH> ;
    skos:altLabel "Fund-Designated Bequest",
        "Source-Specified Bequest" ;
    skos:definition "A Demonstrative Bequest is a provision in a will or trust that designates a specific monetary amount or asset to be paid or distributed from a particular source within the estate. This type of bequest combines elements of both specific and general bequests, specifying the source while also ensuring a fixed amount is given to the beneficiary." .

<RBgiL6PdrY9bOrLxYGwehSV> a owl:Class ;
    rdfs:label "Autism Spectrum Disorder with Language Impairment" ;
