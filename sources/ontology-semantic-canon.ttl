<RdKXPa1Bf7wDG4aNs4UgHx> a owl:Class ;
    rdfs:label "Jesus' Healing of the Blind" ;
    rdfs:subClassOf <RBpseS3fO7sq2jPuFJjJRzq> ;
    skos:altLabel "Healing of the Blind by Jesus"^^xsd:string,
        "Restoration of Sight by Christ"^^xsd:string ;
    skos:definition "Jesus’ Healing of the Blind means the miraculous acts by which Jesus Christ restored sight to those who were blind during his public ministry. Jesus’ Healing of the Blind reveals Christ’s divine authority, compassion, and identity as the light who brings both physical sight and spiritual illumination."^^xsd:string ;
    skos:example "Healing of Bartimaeus"^^xsd:string,
        "Healing of Two Blind Men"^^xsd:string,
        "Healing of the Man Born Blind"^^xsd:string,
        "The Gospel of John describes Jesus healing a man born blind and revealing himself as the light of the world."^^xsd:string,
        "The Gospel of Mark recounts Jesus restoring sight to Bartimaeus near Jericho."^^xsd:string .

