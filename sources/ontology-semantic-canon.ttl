<R94FfrqudVbl9AjAEIp8iSo> a owl:Class ;
    rdfs:label "Transfiguration" ;
    rdfs:subClassOf <R7oT3qg4wZmB5K3qC79EVID>,
        <R9VpyiXQxLbATS2mPSOlbqT>,
        <RPq5X7NPLuzbWzt3kLIhkw> ;
    skos:altLabel "Glorious Manifestation of Christ"^^xsd:string,
        "Theophany on the Mountain"^^xsd:string,
        "Transfiguration of the Lord"^^xsd:string ;
    skos:definition "Transfiguration means the event in which Jesus was revealed in glory on a mountain before Peter, James, and John, with Moses and Elijah appearing beside him. Transfiguration discloses Christ’s divine nature and anticipates the glory of the Resurrection."^^xsd:string ;
    skos:example """And as He was praying, the appearance of His countenance was altered and His raiment become dazzling white. And a voice came out of the cloud saying, "This is My Son, My chosen; listen to Him!"
(Luke 9:29, 35)"""^^xsd:string,
        "The Gospels describe the transfiguration of Jesus before Peter, James, and John."^^xsd:string,
        "The transfiguration reveals Christ’s glory and strengthens the disciples before his passion."^^xsd:string .

