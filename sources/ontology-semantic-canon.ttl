<RC7lPEWMGP3nYZ7PhzT6nbD> a owl:Class ;
    rdfs:label "Party-List Proportional Representation System - Closed List" ;
    dc:source <https://en.wikipedia.org/wiki/Closed_list> ;
    rdfs:subClassOf <RCMZqt2BD3qRRYlj61ssnIZ> ;
    skos:definition "A Closed List Party-List Proportional Representation System is an electoral method where voters cast their ballots for a party, and the party determines the order of candidates on its list. Seats are allocated to each party based on the proportion of votes received, and candidates are selected in the predetermined order." ;
    skos:example "National Closed List: Spain's Congreso de los Diputados elections",
        "Regional Closed List: South Africa's National Assembly elections" ;
    skos:prefLabel "Party-Determined List System" .

