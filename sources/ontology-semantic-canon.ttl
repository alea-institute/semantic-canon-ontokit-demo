<RETApN40i66n71uaD9a6dv> a owl:Class ;
    rdfs:label "Baptism of Blood" ;
    rdfs:subClassOf <Rf3vlNVG6AT99vTWHcqcws> ;
    skos:altLabel "Baptism Through Martyrdom"^^xsd:string,
        "Blood Baptism"^^xsd:string,
        "Martyr’s Baptism"^^xsd:string ;
    skos:definition "Baptism of Blood is the reception of the grace of baptism through martyrdom suffered for Christ before sacramental baptism. It brings forgiveness of sins and union with Christ without the sacramental rite or character."^^xsd:string ;
    skos:example "Baptism of blood manifests the supreme witness of faith."^^xsd:string,
        "Baptism of blood remits sins through union with Christ’s sacrifice."^^xsd:string,
        "Early Christian martyrs received baptism of blood before water baptism."^^xsd:string,
        "Martyrs share in Christ’s death without sacramental baptism."^^xsd:string,
        "The Church recognizes martyrdom as baptism of blood."^^xsd:string .

