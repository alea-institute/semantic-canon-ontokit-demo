    rdfs:subClassOf <RCBP9N5ER7Y6inNQdjggrKt> ;
    skos:altLabel "Movable Property",
        "Personal Property",
        "Personalty" ;
    skos:definition "Chattels are personal property items that are movable and do not include land or interests in land. This legal term encompasses tangible and intangible assets that a person owns, which can be physically relocated or transferred from one place to another, as opposed to real property or immovable assets." ;
    skos:prefLabel "Transferable Personal Possessions" .

<RBFV1dXu2aXDzaGfasJbnsa> a owl:Class ;
