<RCT9Ji3xwVRmaAm7oP74vvB> a owl:Class ;
    rdfs:label "International Organization Visa - Diplomats" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9HlxYOQb4WGC3goxZENvJs> ],
        <RD1oQDMlC6FytjOndhJTMy8> ;
    skos:altLabel "G-1 Visa"@en-us ;
    skos:definition "An International Organization Visa for diplomats refers to a specialized visa category that allows foreign diplomats representing their countries at international organizations to enter and reside in a host country for the duration of their diplomatic assignment. This visa comes with specific diplomatic privileges and immunities in accordance with international law to facilitate their diplomatic duties and interactions within the international organization's context." .

<RCVJpXd6K04j2x2KVeWj1pv> a owl:Class ;
    rdfs:label "Coup d'État" ;
    rdfs:comment "In a global Catholic ontology, a Coup d'État represents a sudden, often violent disruption of the legitimate political order by a faction within the state apparatus. The Church evaluates such events through the lens of political ethics and the requirements for legitimate authority, emphasizing that power must always serve the common good rather than the interests of a specific group."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9p6OUjgt1II1cDFTjv0kIF> ],
        <R9uSx85K0E4Hiq1ZA5AtdjX> ;
    skos:altLabel "Military Junta"^^xsd:string,
        "Overthrow"^^xsd:string,
        "Political Usurpation"^^xsd:string,
        "Regime Change"^^xsd:string ;
    skos:definition "A Coup d'État is the overt seizure of government powers by a political faction, military group, or internal state actors. This event challenges the ethical foundations of social stability and requires a moral assessment of the previous regime's legitimacy versus the potential for chaos or injustice introduced by the usurpers."^^xsd:string ;
    skos:example "Arresting high-ranking civil officials to consolidate power under a self-appointed revolutionary council."^^xsd:string,
        "Seizing the national broadcasting station and presidential palace to declare a change in government leadership."^^xsd:string,
        "Suspending the existing constitution following a military takeover of the legislative assembly."^^xsd:string ;
    skos:prefLabel "Putsch"^^xsd:string .

<RCVTMxVNrsAdKOruCSm37WV> a owl:Class ;
    rdfs:label "Pharmaceutical and Medicine Manufacturing" ;
    dc:identifier "PHA" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=3254> ;
    rdfs:subClassOf <RBrBYbsaP35Zqr9ZrYFHMda> ;
    skos:altLabel "Pharmaceuticals",
        "Pharmaindustrie"@de-de,
        "Pharmaceuticals Industry"@en-gb,
        "Industria Farmacéutica"@es-es,
        "Industria Farmacéutica"@es-mx,
        "Industrie pharmaceutique"@fr-fr,
        "תעשיית תרופות"@he-il,
        "फार्मास्यूटिकल उद्योग"@hi-in,
        "製薬産業"@ja-jp,
        "Indústria farmacêutica"@pt-br,
        "制药工业"@zh-cn ;
    skos:definition "This industry comprises establishments primarily engaged in one or more of the following: (1) manufacturing biological and medicinal products; (2) processing (i.e., grading, grinding, and milling) botanical drugs and herbs; (3) isolating active medicinal principals from botanical drugs and herbs; and (4) manufacturing pharmaceutical products intended for internal and external consumption in such forms as ampoules, tablets, capsules, vials, ointments, powders, solutions, and suspensions." ;
    skos:hiddenLabel "PHA" .

<RCWM4pmyVkeUjv5iE82Lp2a> a owl:Class ;
    rdfs:label "Visa Bulletin" ;
    dc:description "The Visa Bulletin is a monthly publication by the U.S. Department of State that provides updated information on the availability of immigrant visa numbers. It is used to determine when applicants for permanent residency can file their Adjustment of Status applications or schedule their immigrant visa interviews, based on their priority date." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7MxkTvcb7ueuW8WviDGm7p> ],
        <R7gKTQpOKfQ2tOdPu6cLN3w> .

<RCX3HwOMFSz6vLwgDSWfkvt> a owl:Class ;
    rdfs:label "Off-the-Clock Claim" ;
    rdfs:subClassOf <R9UYGSnWQz2MvNsWUofGb6J> ;
    skos:altLabel "Off the Clock Claim",
        "Anspruch außerhalb der Arbeitszeit"@de-de,
        "Off-the-Clock Claim"@en-gb,
        "Reclamación fuera de horario"@es-es,
        "Reclamación fuera de horario"@es-mx,
        "Réclamation hors temps de travail"@fr-fr,
        "תביעה מחוץ לשעות העבודה"@he-il,
        "ऑफ-द-क्लॉक दावा"@hi-in,
        "業務外時間請求"@ja-jp,
        "Reivindicação fora do horário de trabalho"@pt-br,
        "下班后索赔"@zh-cn ;
    skos:definition "An off-the-clock claim is a legal action initiated by an employee who alleges that their employer required them to perform work-related tasks outside of their normal working hours without providing appropriate compensation, such as overtime pay. These tasks can include checking work emails or taking work-related phone calls outside of work hours, or completing work assignments after clocking out for the day. The claim typically arises when an employer does not comply with applicable wage and hour laws, which require employers to compensate employees for all hours worked, including overtime." .

<RCXorl2fj2P6I15SoL42ybA> a owl:Class ;
    rdfs:label "Partnership Liability for Debts" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC27xIi05f9TBUDgpjVvuCg> ],
        <R9JkfZIjkVSa5ud1tJ14w3i> ;
    skos:altLabel "Haftung der Partner für Schulden"@de-de,
        "Partnership Liability for Debts"@en-gb,
        "Responsabilidad de la sociedad por deudas"@es-es,
        "Responsabilidad de la sociedad por deudas"@es-mx,
        "Responsabilité des partenaires pour les dettes"@fr-fr,
        "אחריות שותפות עבור חובות"@he-il,
        "ऋणों के लिए साझेदारी दायित्व"@hi-in,
        "パートナーシップの債務責任"@ja-jp,
        "Responsabilidade dos sócios pelas dívidas"@pt-br,
        "合伙责任债务"@zh-cn ;
    skos:definition "The concept of Partnership Liability for Debts refers to the legal responsibility of partners in a partnership to pay off any debts incurred by the partnership, even if it means using their personal assets to do so." .

<RCYPQ7RrHYodALUh9zixyk2> a owl:Class ;
    rdfs:label "Heresy" ;
    rdfs:comment "In a global Catholic ontology, Heresy represents a formal and post-baptismal opposition to the truths of the faith. While Schism involves a rupture in authority and communion, Heresy targets the intellectual and theological integrity of the Church by denying or doubting a truth that must be believed with divine and catholic faith."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBJTAn05NRo2Qu9uwRcjmsA> ],
        <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Doctrinal Error"^^xsd:string,
        "False Doctrine"^^xsd:string,
        "Heterodoxy"^^xsd:string ;
    skos:definition "Heresy is the obstinate post-baptismal denial or doubt of a truth that must be believed with divine faith. Legal systems influenced by religious law treat heresy as a deviation from authoritative doctrine rather than mere error or dissent."^^xsd:string ;
    skos:example "A baptized teacher publicly denied a defined article of faith and incurred heresy under applicable doctrine."^^xsd:string,
        "A cleric persisted in doctrinal denial after correction and was treated as a formal heretic."^^xsd:string,
        "A person unknowingly held an erroneous belief contrary to doctrine and committed material heresy."^^xsd:string,
        "A religious court applied sanctions after a finding of public heresy."^^xsd:string .

<RCZKHTsfA7SC5yhl8xy8fXh> a owl:Class ;
    rdfs:label "Criminal Stalking" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7MbuFEaL6NyU9tM2AXk7lk> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDyuiajPgpJaNFF1R0ncApX> ],
        <R9KcDahapJG8vbCxXh6JDwm>,
        <RCqBiJAwLT5iG2nvk12tNKW> ;
    skos:altLabel "Strafverfolgung bei Stalking"@de-de,
        "Criminal Stalking"@en-gb,
        "Acoso Criminal"@es-es,
        "Acoso Criminal"@es-mx,
        "Harcèlement criminel"@fr-fr,
        "ציד פלילי"@he-il,
        "अपराधिक स्टॉकिंग"@hi-in,
        "犯罪的ストーカー行為"@ja-jp,
        "Perseguição criminal"@pt-br,
        "刑事跟踪"@zh-cn ;
    skos:definition "Criminal Stalking is a criminal offense that involves a pattern of behavior that causes fear or distress to another person, including following, harassing, or threatening them." .

<RCZwssbqfmu0Lds0LPDV34F> a owl:Class ;
    rdfs:label "Compliance" ;
    rdfs:subClassOf <RClhbl4E1TJp9LygIXewIhn> ;
    skos:altLabel "Legal Compliance" ;
    skos:definition "Deontic compliance refers to the conformity in action, behavior, or attitude to a set of rules or standards, as prescribed by laws, regulations, or ethical principles." .

<RCaLazi1IqFwhZAygqTUf0n> a owl:Class ;
    rdfs:label "Third-Party Employment Placement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9N6MlkHZnisbVNptDAgnF9> ],
        <RDAy5MQTYwrACj2yao4MGbA> ;
    skos:definition "Third-Party Employment Placement refers to a work arrangement where an employee is hired through an external agency or organization but performs work for a different, client company. In this setup, the agency typically handles administrative tasks like payroll and benefits, while the employee works under the direction of the client company." .

<RCb88Obc8Qsh6J0JJ3hy8Gj> a owl:Class ;
    rdfs:label "Breach of Implied Warranty of Good & Workmanlike Services - Home Construction" ;
    rdfs:subClassOf <RCh6Oc8mbSkrdPsFW4zrL6F> ;
    skos:altLabel "Verletzung der stillschweigenden Gewährleistung für gute und fachgerechte Dienstleistungen - Hausbau"@de-de,
        "Breach of Implied Warranty of Good & Workmanlike Services - Home Construction"@en-gb,
        "Incumplimiento de la garantía implícita de servicios buenos y bien ejecutados - Construcción de viviendas"@es-es,
        "Incumplimiento de la garantía implícita de servicios buenos y bien ejecutados - Construcción de viviendas"@es-mx,
        "Violation de la garantie implicite de services bons et de qualité - Construction de maison"@fr-fr,
        "הפרת האחריות המשתלמת המשתלמת והמקצועית - בניית בית"@he-il,
        "अच्छी और कुशल सेवाओं की निहित वारंटी का उल्लंघन - होम कंस्ट्रक्शन"@hi-in,
