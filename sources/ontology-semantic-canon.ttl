    dc:identifier "US-FD-DOC-NOAA" ;
    rdfs:subClassOf <R6DF75e5A843432213037833> ;
    skos:altLabel "National Oceanic and Atmospheric Administration"@de-de,
        "National Oceanic and Atmospheric Administration"@en-gb,
        "Administración Nacional Oceánica y Atmosférica"@es-es,
        "Administración Nacional Oceánica y Atmosférica"@es-mx,
        "Administration nationale océanique et atmosphérique"@fr-fr,
        "המנהלה הלאומית לאוקיאנוגרפיה ולאטמוספירה"@he-il,
