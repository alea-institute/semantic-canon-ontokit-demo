<R7OM23yAFBywKVmUN7pAksz> a owl:Class ;
    rdfs:label "Ovarian Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_23> ;
    rdfs:subClassOf <RWuBs7zey8BVg86iZuFUNk> ;
    skos:altLabel "Ovarian Carcinoma" ;
    skos:definition "Ovarian cancer is a type of cancer that begins in the ovaries, the female reproductive glands responsible for producing eggs. It is often diagnosed at an advanced stage and typically requires treatments such as surgery, chemotherapy, and targeted therapy." .

<R7OQGIV07yTmUJLm6I1jgRB> a owl:Class ;
    rdfs:label "Blue Sky Filing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R24Fe8aF4D15b46F6031E543> ],
        <RmCERXtzdqIJcW9mdbk0Bb> ;
    skos:altLabel "Provincial Securities Filing",
        "State Securities Filing" ;
    skos:definition "A Blue Sky Filing is a state-level or province-level regulatory filing required for the sale of securities to ensure compliance with securities laws, commonly referred to as \"Blue Sky Laws.\" These filings are necessary to protect investors from fraudulent sales practices and ensure that securities offered or sold within a state meet specific disclosure and registration requirements." .

