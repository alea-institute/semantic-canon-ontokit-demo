<RDUGVt1vbpSSIVTdHlaSUPU> a owl:Class ;
    rdfs:label "Progressive Muscular Atrophy" ;
    rdfs:subClassOf <RKBlQ2mgZn3CTwBfUYIM7s> ;
    skos:definition "Progressive muscular atrophy (PMA) is a neurodegenerative condition characterized by the gradual degeneration and atrophy of lower motor neurons, leading to progressive muscle weakness and wasting. Unlike Amyotrophic Lateral Sclerosis (ALS), PMA primarily affects lower motor neurons and often has a slower progression." .

<RDUUR3q3F6elIpt8yOlZYCv> a owl:Class ;
    rdfs:label "Parable of the Sower" ;
