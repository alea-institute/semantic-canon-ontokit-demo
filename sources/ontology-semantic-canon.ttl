<RDVFemXaqT513UrGRVhWDSH> a owl:ObjectProperty ;
    rdfs:label "folio:hasNext" ;
    owl:inverseOf "folio:precededBy" ;
    skos:altLabel "folio:precedes",
        "is followed by",
        "precedes" ;
    skos:definition "In the context of legal ontologies and processes, \"has next\" refers to the sequential relationship where a specific legal event or task is followed by another predetermined event or task. This concept denotes the procedural order or chronology within legal proceedings. For example, \"jury selection has next trial\" implies that the jury selection phase in a trial precedes the actual commencement of the trial proceedings." ;
    skos:example "Jury Selection hasNext Trial" ;
    skos:prefLabel "folio:followedBy" .

