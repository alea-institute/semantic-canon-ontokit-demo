    rdfs:subClassOf <Rfw7NfMHyrhfFQj8ob4M4U> ;
    skos:altLabel "Wage Discrimination Claim" ;
    skos:definition "An Gender Pay Equality Claim is a legal action alleging violation of a law requiring that men and women in the same workplace be given equal pay for equal work. The claim typically involves issues of gender-based wage discrimination." ;
    skos:prefLabel "Gender Pay Equality Claim" .

<R7lxeVIOck43eKAMJhZmyXL> a owl:Class ;
