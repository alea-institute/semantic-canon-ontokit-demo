        <R8N4pMIOhTNbqcmDczSephq> ;
    skos:altLabel "VWP",
        "Visa Waiver" ;
    skos:definition "The Visa Waiver Program (VWP) allows citizens of participating countries to travel to the destination country for tourism or business purposes without obtaining a visa. In the United States, travel under the VWP is permitted for up to 90 days and does not allow for a change of status or an extension of stay" .

<R3TtiS3gxiA1y6P4bIeoRl> a owl:Class ;
