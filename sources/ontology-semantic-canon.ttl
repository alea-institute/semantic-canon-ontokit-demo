<R8dg62MjLTQnUX9VOs20LYJ> a owl:Class ;
    rdfs:label "Freedom of the Press" ;
    rdfs:subClassOf <R7UZkDXz7Wg2AtyHFQEeySC>,
        <RBJlYzE4ZY14dTEghzbbMHg> ;
    skos:altLabel "Pressefreiheitsanspruch"@de-de,
        "Freedom of the Press Claim"@en-gb,
        "Reclamo de Libertad de Prensa"@es-es,
        "Reclamo de Libertad de Prensa"@es-mx,
        "Revendication de la liberté de la presse"@fr-fr,
        "תביעת חופש העיתונות"@he-il,
        "प्रेस की स्वतंत्रता का दावा"@hi-in,
        "報道の自由主張"@ja-jp,
        "Reivindicação da liberdade de imprensa"@pt-br,
        "新闻自由要求"@zh-cn ;
    skos:definition "A freedom of the press claim is a legal action initiated by a journalist, news organization, or other entity alleging that their right to freedom of the press, as protected by the First Amendment of the United States Constitution, has been violated by the government or a government actor. A freedom-of-the-press claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts press freedom, when a journalist is punished or threatened for their reporting, or when access to public information or events is improperly denied." .

<R8dxOsfM0gsVdvh1SKyl4ub> a owl:Class ;
    rdfs:label "Forgery" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9Zpw6W6vllQC97Xj87kMAX> ],
        <RFjY2mO804t9gJNy5Dn4P1> ;
    skos:altLabel "Fälschung"@de-de,
        "Forgery"@en-gb,
        "Falsificación"@es-es,
        "Falsificación"@es-mx,
        "Faux"@fr-fr,
        "זיוף"@he-il,
        "जालसाज़ी"@hi-in,
        "偽造"@ja-jp,
        "Falsificação"@pt-br,
        "伪造"@zh-cn ;
    skos:definition "(Definition of \"Counterfeiting/Forgery\") The altering, copying, or imitation of something, without authority or right, with the intent to deceive or defraud by passing the copy or thing altered or imitated as that which is original or genuine; or the selling, buying, or possession of an altered, copied, or imitated thing with the intent to deceive or defraud." .

<R8eLjBdBZvFAiSkedoY0xen> a owl:Class ;
    rdfs:label "Experts Expense" ;
    rdfs:subClassOf <R8KRPJpptKbBzyQalWni4Zv> ;
