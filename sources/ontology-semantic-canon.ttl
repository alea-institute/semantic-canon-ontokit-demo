<RYS2M2cunzcjtIHPdPzmUy> a owl:Class ;
    rdfs:label "Toxic Tort Claims" ;
    rdfs:subClassOf <RDqSn32zsjxExcBFzIYxT2D> ;
    skos:altLabel "Chemical Injury Claims",
        "Environmental Tort Claims",
        "Hazardous Substance Claims",
        "Toxic Exposure Claims" ;
    skos:definition "A toxic tort claim arises when an individual alleges harm due to exposure to a toxic substance. This claim seeks compensation for injuries caused by chemicals, pollutants, or other hazardous materials." ;
    skos:prefLabel "Toxic Exposure Claims" .

<RcqrMBmLwAweHAkomaAaNq> a owl:Class ;
    rdfs:label "Respiratory Disorder" ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Respiratory Condition",
        "Respiratory Illness" ;
    skos:definition "Respiratory disorders are a group of conditions that affect the respiratory system, including the lungs and airways, leading to symptoms such as difficulty breathing, chronic cough, and reduced oxygen intake. These disorders can range from acute conditions like asthma attacks to chronic diseases like cystic fibrosis, requiring varied treatments and management strategies to improve respiratory function and quality of life." ;
    skos:prefLabel "Pulmonary Disorder" .

<RfBdQ771UMEZMpb5zTUXAZ> a owl:Class ;
    rdfs:label "Amount in Controversy / Dispute" ;
    rdfs:isDefinedBy "National Open Court Data Standards (NODS) https://www.ncsc.org/services-and-experts/areas-of-expertise/court-statistics/national-open-court-data-standards-nods" ;
    rdfs:subClassOf <RsJ6DupkWKlUlCHH0Ycxvp> ;
    skos:altLabel "Amount in Controversy",
        "Amount in Dispute",
