<R9XZ7K8HJWXLILivJp6es7a> a owl:Class ;
    rdfs:label "Vulva or Vagina Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_23> ;
    rdfs:subClassOf <RWuBs7zey8BVg86iZuFUNk> ;
    skos:altLabel "Vaginal Cancer",
        "Vulvar Cancer" ;
    skos:definition "Vulva or vagina cancer refers to malignant tumors originating in the external female genitalia (vulva) or the vaginal canal. These cancers can cause symptoms such as abnormal bleeding, itching, and pain, and often require a combination of treatments including surgery, radiation, and chemotherapy." .

<R9XayAvlI8SegCPZ5PeeQ9V> a owl:Class ;
    rdfs:label "Early Christian Persecutions" ;
    rdfs:subClassOf <R9eJYLpE8tqxZQwMcMzWXkl> ;
    skos:altLabel "Persecution of the First Christians"^^xsd:string,
        "Persecutions of the Early Church"^^xsd:string ;
    skos:definition "Early Christian Persecutions means the periods of social, legal, and violent repression endured by early Christians because of their faith and refusal to conform to pagan religious practices. Early Christian Persecutions reveal the cost of discipleship and the Church’s witness through suffering and martyrdom."^^xsd:string ;
    skos:example "Early Christian communities faced imprisonment and execution for refusing to worship Roman gods."^^xsd:string,
        "The Acts of the Apostles records the martyrdom of Saint Stephen during early persecution in Jerusalem."^^xsd:string .

