    rdfs:label "John_1_14" .

<R8XAQoyqCZvUawGZUsBxFOG> a owl:Class ;
    rdfs:label "Workplace Safety Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R5DE425E15b8c8CE8fb6Eecf> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R765fdd1D03d3269330E964e> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R01E1a02E74a0235f7022f40> ],
        <Rfw7NfMHyrhfFQj8ob4M4U> ;
    skos:altLabel "Arbeitssicherheitsanspruch"@de-de,
        "Workplace Safety Claim"@en-gb,
        "Reclamación de seguridad en el lugar de trabajo"@es-es,
        "Reclamo de seguridad en el lugar de trabajo"@es-mx,
        "Réclamation de sécurité sur le lieu de travail"@fr-fr,
        "תביעת בטיחות במקום העבודה"@he-il,
        "कार्यस्थल सुरक्षा दावा"@hi-in,
        "職場安全請求"@ja-jp,
        "Reivindicação de segurança no local de trabalho"@pt-br,
        "工作场所安全索赔"@zh-cn ;
    skos:definition "A workplace safety claim is a legal action initiated by an employee against their employer for not providing a safe working environment. The claim typically arises when an employer does not comply with applicable safety regulations, which can result in dangerous or hazardous working conditions for employees. Workplace safety claims can involve issues such as inadequate safety equipment, lack of proper training, or unsafe working conditions. Employees may bring workplace safety claims for injuries or illnesses suffered as a result of their employer's failure to provide a safe working environment." .

<R8YBf8Plir549jdl8lkxO00> a owl:Class ;
    rdfs:label "Treaty Skilled Worker Visa" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBDggRpYzbIC7NOvN4KsvUv> ],
        <RD1oQDMlC6FytjOndhJTMy8> ;
    skos:altLabel "NAFTA Professional Visa",
        "TN-1 Visa (Canada)",
        "TN-2 Visa (Mexico)",
        "USMCA Professional Visa" ;
    skos:definition "This visa category (in the U.S., TN-2 Visa) applies to skilled professionals in treaty-signatory countries. In the United States, this non-immigrant visa allows the individual to work in the U.S. under the provisions of the North American Free Trade Agreement (NAFTA), which was replaced by the United States-Mexico-Canada Agreement (USMCA). The initial period of stay is up to three years, but extensions can be granted in three-year increments" .

<R8YpJBaF5zesoc0jtaNESdQ> a owl:Class ;
    rdfs:label "Precedent" ;
    rdfs:subClassOf <RC1CZydjfH8oiM4W3rCkma3> ;
    skos:definition "Precedent refers to a legal decision or judgment passed in a previous case, used as an authoritative rule or example in subsequent similar cases. It serves as a guiding principle, helping courts decide future cases with similar issues or facts." .

<R8cAniiiBonXRUaslS04fix> a owl:Class ;
    rdfs:label "Birth" ;
    rdfs:subClassOf <R8lhhP1c4Hm9RruhEpWMrJW> ;
    skos:definition "Birth, in a legal context, refers to the moment when an individual comes into existence, typically at the moment of delivery from the mother's womb. It marks the beginning of a person's legal identity and carries various legal implications, including citizenship and inheritance rights." .

<R8f4qGdjxuiQary8OBpq8W9> a owl:Class ;
    rdfs:label "Industry and Market" ;
    rdfs:subClassOf <R8rXgwTd3apGR5L4IJxYLc1> ;
    skos:definition "Industry and markets refer to the collective sectors and segments within an economy that produce, distribute, and sell goods and services. This encompasses various industries such as agriculture, technology, and finance, as well as different market segments like luxury goods, budget services, and regional businesses" ;
    skos:prefLabel "Economic Sectors" .

<R8hdJfF8TO1kOvUijgwk9k> a owl:Class ;
    rdfs:label "Trial Type: Bench or Jury" ;
    rdfs:subClassOf <Rchny3YFXoQyenv6XUbyo0> ;
    skos:altLabel "Trial Type",
        "Prozessart: Richter oder Jury"@de-de,
        "Trial Type: Bench or Jury"@en-gb,
        "Tipo de juicio: con juez o con jurado"@es-es,
        "Tipo de juicio: con juez o con jurado"@es-mx,
        "Type de procès : banc ou jury"@fr-fr,
        "סוג המשפט: בית משפט או חברתי"@he-il,
        "ट्रायल प्रकार: बेंच या ज्यूरी"@hi-in,
        "裁判の種類：裁判官または陪審員"@ja-jp,
        "Tipo de julgamento: Juiz ou Júri"@pt-br,
        "审判类型：法官或陪审团"@zh-cn ;
    skos:definition "Trial Type is a subcategory of Trial Events and refers to the type of trial, which can be either Bench or Jury." .

<R8iqvgE2NjybgksTeqsGhr3> a owl:Class ;
    rdfs:label "Concert of Action Crimes" ;
    rdfs:subClassOf <R5jFFdAx82IJWPe4JDkFqg>,
        <R7u1GstOpfAmZ3mI7yFcbgU>,
        <RSRxb9psAJdqf8rppoiYI8> ;
    skos:altLabel "Konzertierte Aktion Verbrechen"@de-de,
        "Concert of Action Crimes"@en-gb,
        "Delitos de Concierto"@es-es,
        "Delitos de Concierto"@es-mx,
        "Crimes de concertation"@fr-fr,
        "פשעי קונצרט של פעולה"@he-il,
        "कार्यवाही के अनुयोज्य अपराध"@hi-in,
        "行動コンサート犯罪"@ja-jp,
        "Crimes de concerto de ação"@pt-br,
        "行动演唱会罪"@zh-cn ;
    skos:definition "Concert of Action Crimes refer to a group of criminal offenses where two or more individuals work together to commit a crime, and each member of the group is held responsible for the actions of the others." .

<R8ks4EFK3G3kUjRP4Fu5gtK> a owl:Class ;
    rdfs:label "Death" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9GrBYx6nWx1AZRaEDNMBaO> ],
        <R8lhhP1c4Hm9RruhEpWMrJW>,
        <RuDAbRiNW105SQoqb1XZ4c> ;
    skos:definition "Death, in a legal context, marks the end of a person's life, as well as the termination of an individual's legal rights and duties. It initiates the probate process, where a deceased's estate is settled, debts are paid, and assets are distributed to heirs or beneficiaries according to a will or intestate laws." .

<R8lTElgBPTd9PMgsa2t3u3y> a owl:Class ;
    rdfs:label "Sacred Ground" ;
    rdfs:subClassOf <R8t0srL2xeL3TDoobUUFnvC> ;
    skos:altLabel "Blessed Land"^^xsd:string,
        "Consecrated Ground"^^xsd:string,
        "Holy Ground"^^xsd:string,
        "Sacred Land"^^xsd:string ;
    skos:definition "Sacred Ground is land set apart and blessed or consecrated for religious purposes, especially burial, memorial, or devotional use. Sacred Ground signifies reverence for holy realities and the sanctification of space through prayer and ecclesial designation."^^xsd:string ;
    skos:example "Pilgrims gather on sacred ground for outdoor liturgical celebrations."^^xsd:string,
        "Sacred ground is treated with respect and protected from profane use."^^xsd:string,
        "Sacred ground surrounds a church as a sign of reverence and separation for holy use."^^xsd:string .

<R8ly82UzT3qEXtZR0pcZq8L> a owl:Class ;
    rdfs:label "Depressive, Bipolar and Related Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1>,
        <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_04> ;
    rdfs:subClassOf <RN3TubQIlusDFnPgrNAk8D> ;
    skos:definition "Depressive, Bipolar, and Related Disorders encompass a range of mental health conditions characterized by significant mood disturbances. These disorders are characterized by an irritable, depressed, elevated, or expansive mood, or by a loss of interest or pleasure in all or almost all activities, causing a clinically significant decline in functioning. Symptoms and signs may include, but are not limited to, feelings of hopelessness or guilt, suicidal ideation, a clinically significant change in body weight or appetite, sleep disturbances, an increase or decrease in energy, psychomotor abnormalities, disturbed concentration, pressured speech, grandiosity, reduced impulse control, sadness, euphoria, and social withdrawal." .

<R8o77OqyndqK7R237rr61yE> a owl:Class ;
    rdfs:label "Unconscionability Permitting Contract Rescission" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBF5KuECPEHv8VWSLweEKTH> ],
        <RDP2t75tSvlsq1GCrOZlInL>,
        <RZ1dOPJ6HH6lMJGSLNxfwV> ;
    skos:altLabel "Unangemessenheitserlaubnis zur Vertragsaufhebung"@de-de,
        "Unconscionability Permitting Contract Rescission"@en-gb,
        "La iniquidad que permite la rescisión del contrato"@es-es,
        "La iniquidad que permite la rescisión del contrato"@es-mx,
        "Permettre la résiliation du contrat pour iniquité"@fr-fr,
        "אי הגיון מאפשר ביטול חוזה"@he-il,
        "अयोग्यता अनुबंध रद्दीकरण की अनुमति देना"@hi-in,
        "不合理性による契約解除の許可"@ja-jp,
        "Permitir a rescisão do contrato por iniquidade"@pt-br,
        "允许合同撤销的不合理性"@zh-cn ;
    skos:definition "Unconscionability Permitting Contract Rescission refers to the legal concept that allows a contract to be cancelled or voided due to the presence of unfair or oppressive terms or circumstances that make it impossible for one party to fully understand or consent to the agreement." .

<R8oVqWGVPjAgl133D0pNL7g> a owl:ObjectProperty ;
    rdfs:label "folio:examined" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:altLabel "deposed",
        "examined",
        "folio:inspected",
        "folio:interviewed",
        "folio:questioned",
        "inspected",
        "interviewed" ;
    skos:definition "In legal terms, \"examined\" refers to the thorough and systematic investigation or inspection of evidence, documents, or facts relevant to a legal case or issue. This process is crucial for lawyers, judges, and legal staff in assessing the validity, relevance, and implications of the materials at hand, often to establish the foundation for arguments or judgments." ;
    skos:prefLabel "folio:deposed" .

<R8pRJGAJiNSZ8h4pbZQEEy1> a owl:Class ;
    rdfs:label "Deacon" ;
    rdfs:subClassOf <RChKPk9K152BirrIYgAREsY> ;
    skos:altLabel "Diaconal Minister"^^xsd:string,
        "Minister of Service"^^xsd:string,
        "Ordained Deacon"^^xsd:string ;
    skos:definition "A Deacon is an ordained minister who has received the first degree of the sacrament of Holy Orders and is configured to Christ the Servant. A Deacon exercises a ministry of Word, Liturgy, and Charity in communion with the bishop and presbyterate, according to canon law."^^xsd:string ;
    skos:example "A deacon may preside at baptisms, witness marriages, and conduct funeral rites."^^xsd:string,
        "A deacon proclaims the Gospel and assists at the altar during Mass."^^xsd:string,
        "A permanent deacon serves the Church through preaching, charity, and pastoral outreach."^^xsd:string,
        "A transitional deacon prepares for priestly ordination through further formation."^^xsd:string .

<R8paNAt8rFPV0BKzwRBKnQ4> a owl:Class ;
    rdfs:label "Disorders of Thrombosis and Hemostasis" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_08> ;
    rdfs:subClassOf <R7O2ClQ73HLZZLgFgtNbVTF> ;
    skos:altLabel "Clotting Disorders" ;
    skos:definition "Disorders of thrombosis and hemostasis are conditions affecting the body's ability to form and dissolve blood clots. These disorders include both excessive clotting (thrombosis) and problems with blood clotting (hemorrhage), leading to an increased risk of either unwanted clot formation or bleeding." ;
    skos:prefLabel "Hemostatic Disorders" .

<R8pesdANKPwJOgurnU1XzV> a owl:Class ;
    rdfs:label "Budget" ;
    rdfs:subClassOf <RTPFix1eiYqgdushRunICo> ;
    skos:definition "A Budget is a financial plan that outlines expected income and expenditures for a specific period, usually a month or a year. It serves as a tool for managing finances by allocating resources to various categories such as housing, food, transportation, and savings." .

<R8pf9ONP6CajS4BilFsvW0l> a owl:Class ;
    rdfs:label "Total Amount - Fee or Expense" ;
