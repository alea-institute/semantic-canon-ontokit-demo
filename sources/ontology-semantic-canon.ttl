            owl:someValuesFrom <RLoMwtVZOH407TSzI4gtgp> ],
        <RC24OimNdswbhSF7tIQRmqR> ;
    skos:definition "Time-off benefits encompass policies or perks that allow employees to take time away from work for various reasons, such as vacation, illness, or personal needs, often with pay." .

<R7sMdOVdcVJ90TomMNzEkuC> a owl:Class ;
    rdfs:label "Land Contract Foreclosure" ;
    rdfs:subClassOf <RsCr2ffuxk4pqU5CQ8SAxq> ;
    skos:definition "Land Contract Foreclosure is the legal process initiated by a seller to reclaim property when a buyer defaults on payments under a land contract, also known as an \"installment sale agreement.\" Unlike mortgage foreclosures, the process and rights of the parties involved may differ significantly, depending on state laws and the terms of the land contract itself. In states that recognize land contracts as a form of property ownership, failure to meet the terms of the land contract can result in foreclosure." .

<R7sOCk4O8iF1inWxArtnFY2> a owl:Class ;
    rdfs:label "Governmental Dispute" ;
    rdfs:subClassOf <R7O9EXc5CO83M0CzT8VzNFT> ;
    skos:altLabel "Intergovernmental Dispute"^^xsd:string,
        "Political Conflict"^^xsd:string,
        "Political Crisis"^^xsd:string,
        "State Authority Dispute"^^xsd:string ;
    skos:definition "Governmental Dispute means a sustained disagreement among public authorities, political actors, or governing institutions concerning power, authority, policy, legitimacy, or constitutional order, pursued without organized armed force. Governmental Dispute raises moral questions about justice, the common good, subsidiarity, solidarity, and the lawful exercise of authority."^^xsd:string ;
    skos:example "A constitutional court resolved a governmental dispute about the limits of presidential authority."^^xsd:string,
        "A governmental dispute arose when the legislature and executive disagreed over emergency powers during a public health crisis."^^xsd:string,
        "Bishops urged dialogue and restraint during a governmental dispute following a contested national election."^^xsd:string,
        "Diplomatic negotiations addressed a governmental dispute concerning the interpretation of an international treaty."^^xsd:string ;
    skos:prefLabel "Political Dispute"^^xsd:string .

