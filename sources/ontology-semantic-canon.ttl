        "Long-distance bulk liquid trucking",
        "Long-distance hazardous material trucking",
        "Long-distance refrigerated product trucking",
        "Long-distance trucking of waste" .

<kdlpY0RtSFq1KzyPx48fCw> a owl:Class ;
