    rdfs:subClassOf <R94yxXVadPVTE4IW7iABVRc> ;
    skos:altLabel "Berufungen gemäß Gerichtsregel"@de-de,
        "Appeals Under Court Rule"@en-gb,
        "Apelaciones bajo la regla del tribunal"@es-es,
        "Apelaciones bajo la regla del tribunal"@es-mx,
        "Appels en vertu de la règle de cour"@fr-fr,
        "ערעורים על פי כללי בית המשפט"@he-il,
