<Rqg6sTGTlUkadiYTIFBF17> a owl:Class ;
    rdfs:label "Prayer of St. Dominic" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RyTfHxUQPVMUQrtIt1Mycz> ;
    skos:altLabel "Dominican Prayer for Preaching"^^xsd:string,
        "Prayer Attributed to St. Dominic"^^xsd:string,
        "Trinitarian Prayer of St. Dominic"^^xsd:string ;
    skos:definition "Prayer of St. Dominic is a Trinitarian blessing that asks for healing, illumination, and strength to preach God’s word. It expresses the Dominican charism of contemplation leading to proclamation and trust in God’s guidance toward the Kingdom."^^xsd:string ;
    skos:example "Before preaching, the friars prayed the Prayer of St. Dominic for clarity and fidelity to the Gospel."^^xsd:string,
        "During a retreat on evangelization, the group reflected on the Prayer of St. Dominic."^^xsd:string,
        "In communal prayer, the parish used the Prayer of St. Dominic to ask for healing and mission."^^xsd:string,
        """May God the Father who made us bless us.
May God the Son send his healing among us.
May God the Holy Spirit move within us and
give us eyes to see with, ears to hear with,
and hands that your work might be done.
May we walk and preach the word of
God to all.
May the angel of peace watch over us and
lead us at last by God's grace to the
Kingdom."""^^xsd:string .

