        <RCqBiJAwLT5iG2nvk12tNKW>,
        <Rj1p7FbFSLxlWfUlSPZxhX> ;
    skos:altLabel "Fahren mit einem suspendierten oder widerrufenen Führerschein"@de-de,
        "Driving on a Suspended or Revoked License"@en-gb,
        "Conducir con una licencia suspendida o revocada"@es-es,
        "Conducir con una licencia suspendida o revocada"@es-mx,
        "Conduite avec un permis suspendu ou révoqué"@fr-fr,
        "נהיגה על רישיון מושעה או שגוי"@he-il,
        "सस्पेंड या रद्द लाइसेंस पर गाड़ी चलाना"@hi-in,
        "停止または取り消しの免許での運転"@ja-jp,
        "Dirigir com uma licença suspensa ou revogada"@pt-br,
        "持暂扣或吊销驾照驾驶"@zh-cn ;
    skos:definition "Driving on a Suspended or Revoked License: Operating a motor vehicle while one's driver's license has been temporarily or permanently revoked or suspended by the state due to a prior traffic offense or violation." ;
    skos:prefLabel "Driving with a Revoked License" .

<RBF276c77Fedc1BEce8371a9> a owl:Class ;
    rdfs:label "Gibraltar" ;
