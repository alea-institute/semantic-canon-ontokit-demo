    skos:altLabel "Consecrated Building"^^xsd:string,
        "Ecclesiastical Building"^^xsd:string,
        "Holy Building"^^xsd:string ;
    skos:definition "Sacred Building is a structure dedicated or blessed for divine worship, prayer, or sacred use according to the norms of the Church. A Sacred Building serves the sanctification of the faithful by providing a stable, ordered space oriented toward encounter with God."^^xsd:string .

<RhUwaBjg0AFfnJkZgYorpG> a owl:Class ;
