        "Devedor solidário"@pt-br,
        "共同债务人"@zh-cn ;
    skos:definition "From U.S. Bankruptcy Court PACER",
        "Two or more debtors who are jointly liable for a single debt (e.g., cosigners on a loan)" .

<R8Wfz2mTFwxxmbtobaQ5NU9> a owl:Class ;
    rdfs:label "Visa for Dependent of Intended Spouse of Citizen" ;
