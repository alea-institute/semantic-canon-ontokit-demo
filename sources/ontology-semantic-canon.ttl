    rdfs:subClassOf <R5E0c679BE29e3F86383A5bc> ;
    skos:hiddenLabel "GI" ;
    skos:prefLabel "Gibraltar" .

<RBF5KuECPEHv8VWSLweEKTH> a owl:Class ;
    rdfs:label "Consumer Goods Leased Under Unconscionable Circumstances" ;
    rdfs:subClassOf <R7n6xn6CbnvekygNrB5DsJM> ;
    skos:altLabel "Verbrauchsgüter, die unter unangemessenen Umständen geleast wurden"@de-de,
        "Consumer Goods Leased Under Unconscionable Circumstances"@en-gb,
        "Bienes de consumo arrendados en circunstancias abusivas"@es-es,
        "Bienes de consumo arrendados en circunstancias abusivas"@es-mx,
        "Biens de consommation loués dans des circonstances abusives"@fr-fr,
        "סחורות לצרכן שהושכרו בנסיבות לא הוגנות"@he-il,
        "अन्यायपूर्ण परिस्थितियों के तहत लीजे गए उपभोक्ता वस्तु"@hi-in,
        "不当な状況下でリースされた消費財"@ja-jp,
        "Bens de consumo alugados em circunstâncias abusivas"@pt-br,
        "在不公平情况下租赁的消费品"@zh-cn ;
    skos:definition "Consumer Goods Leased Under Unconscionable Circumstances refers to the situation where a consumer leases goods from a party who has taken advantage of the consumer's vulnerability, lack of bargaining power, or inability to understand the terms of the lease agreement, resulting in an unfair and unreasonable contract." .

<RBFFfSWsg811UlPoeFkEsZY> a owl:Class ;
    rdfs:label "Visa for Nurses and Medical Professionals" ;
    rdfs:subClassOf <RD1oQDMlC6FytjOndhJTMy8> ;
    skos:altLabel "H-1A"@en-us ;
    skos:definition "A visa for nurses and medical professionals is a specialized visa category that may be offered by certain countries to healthcare workers who wish to enter for the purpose of employment in the medical field. These visas often have specific requirements, including proof of qualifications, job offers from recognized healthcare institutions, and sometimes a need to address shortages of medical professionals in the host country." .

<RBFOZ6k0p0FnZyMzuijRYdU> a owl:Class ;
    rdfs:label "Non-Hodgkin Lymphoma" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_05> ;
    rdfs:subClassOf <RCkVEfL4H41pColicGhkXJb> ;
    skos:definition "Non-Hodgkin lymphoma (NHL) is a diverse group of blood cancers that originate in the lymphatic system, which is part of the body's immune system. It includes various subtypes that differ in their aggressiveness and treatment protocols, commonly requiring chemotherapy, radiation therapy, immunotherapy, or stem cell transplantation." .

<RBFvWlZEViQihmHUpd1MPCF> a owl:Class ;
    rdfs:label "Court Administrator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R91xCHHoE9fXDZudkrKfPQj> ],
        <RDSYPGgBlFz5eWNtwoMA2c5> ;
    skos:altLabel "Court Administrator"@en-gb,
        "Administrador de la Corte"@es-es,
        "Administrador del Tribunal"@es-mx,
        "מנהל בית המשפט"@he-il,
        "अदालत प्रशासक"@hi-in ;
    skos:definition "A person who serves a clerical, administrative function for a court. In some jurisdictions, this can include the Clerk of Court, and in other jurisdictions these roles are distinct." .

<RBG9uiYhwntrBh3nO4nqsWX> a owl:Class ;
    rdfs:label "Condominium Right" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R83rG2F2Gwg1Tptjt4tnm5M> ],
        <R8cjnXHiv1wNe6nzPvWnhQw> ;
    skos:altLabel "Horizontal Property Right",
        "Strata Title Right",
        "Commonhold"@en-gb ;
    skos:definition "Condominium Right, also known as Horizontal Property Right, refers to the legal structure that allows individual ownership of a unit within a multi-unit building, along with a shared ownership interest in common areas like hallways, elevators, and amenities. This right enables the individual unit owner to sell, lease, or mortgage their unit independently, while being subject to the rules and governance of a homeowners' association or similar entity." .

<RBGPkZ1oRgcP05LWQBGLEne> a owl:Class ;
    rdfs:label "Admiralty Court" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RqHLQbqYW16CtZ6TSKOZPz> ],
        <R9sbuHkJC9aqDlHAgw58VSB> ;
    skos:definition "Admiralty Court refers to a specialized court that has jurisdiction over maritime disputes and offenses, including those related to shipping, navigation, and marine commerce." .

<RBGd796pNg5ltGWhkyk2ifm> a owl:Class ;
    rdfs:label "Asset-Backed Securities" ;
    rdfs:subClassOf <RBTvzt8uobb19tFbNSYQkFA> ;
    skos:altLabel "ABS",
        "Asset-Backed Bonds",
        "Securitized Assets" ;
    skos:definition "Asset-Backed Securities (ABS) are financial instruments backed by a pool of assets, typically loans or receivables, that generate cash flows to pay interest and principal to investors. ABS allow lenders to transfer the risk of the underlying assets to investors and are commonly used to improve liquidity and raise capital." ;
    skos:prefLabel "Collateralized Securities" .

<RBH1NIeHTs7myQf1RgQXCWy> a owl:Class ;
    rdfs:label "Insurance Fraud" ;
    rdfs:subClassOf <R8GyyJdxlZtc7PsW9vLAKfE>,
        <R9q0hyYnNxQC475BKXOxjbm> ;
    skos:altLabel "Versicherungsbetrug"@de-de,
        "Insurance Fraud"@en-gb,
        "Fraude de Seguros"@es-es,
        "Fraude de Seguros"@es-mx,
        "Fraude à l'assurance"@fr-fr,
        "הונאת ביטוחים"@he-il,
        "बीमा धोखाधड़ी"@hi-in,
        "保険詐欺"@ja-jp,
        "Fraude de seguro"@pt-br,
        "保险欺诈"@zh-cn ;
    skos:definition "The concept of Insurance Fraud refers to the intentional deception or misrepresentation made by an individual or entity to an insurance company for the purpose of obtaining benefits or compensation to which they are not entitled, including the fraudulent acquisition of life or health insurance policies." .

<RBH54tIgUv3NHcHH7pgwdaL> a owl:Class ;
    rdfs:label "Assignee" ;
