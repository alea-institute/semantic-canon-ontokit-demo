    skos:example "A cathedral basilica holds both cathedral and basilica status."^^xsd:string,
        "A cathedral houses the bishop’s cathedra as a sign of teaching authority."^^xsd:string,
        "A metropolitan cathedral is the principal church of an ecclesiastical province."^^xsd:string,
        "The diocesan cathedral serves as the center of liturgical life for the local Church."^^xsd:string,
        "The faithful gather at the cathedral for major diocesan celebrations."^^xsd:string .

