<RBv2bn1JJxCl4qKmDI15sID> a owl:Class ;
    rdfs:label "Chastity" ;
    rdfs:subClassOf <RBAHGQZblh8cggdiTJggZfv> ;
    skos:altLabel "Chaste Living"^^xsd:string,
        "Ordered Sexuality"^^xsd:string,
        "Purity"^^xsd:string,
        "Respect for the Body"^^xsd:string,
        "Sexual Integrity"^^xsd:string ;
    skos:definition "Chastity is the moral virtue that orders sexual desire and expression according to one’s state of life and the demands of love and truth. Chastity integrates sexuality within the person, directing it toward authentic self-gift and respect for human dignity."^^xsd:string ;
    skos:example "Chastity fosters self-mastery and freedom from compulsive desire."^^xsd:string,
        "Chastity guides spouses to faithful and respectful expression of marital love."^^xsd:string,
        "Chastity integrates sexuality into a life ordered toward love and holiness."^^xsd:string,
        "Chastity protects the dignity of others by rejecting exploitation or objectification."^^xsd:string .

