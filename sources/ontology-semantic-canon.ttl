    rdfs:subClassOf <R9JkfZIjkVSa5ud1tJ14w3i> ;
    skos:altLabel "Auflösung wegen Unterdrückung"@de-de,
        "Dissolution for Oppression"@en-gb,
        "Disolución por opresión"@es-es,
        "Disolución por opresión"@es-mx,
        "Dissolution pour oppression"@fr-fr,
        "פירוק עקב לחץ"@he-il,
        "अत्याचार के लिए विघटन"@hi-in,
        "抑圧解消"@ja-jp,
        "Dissolução por opressão"@pt-br,
        "压制解散"@zh-cn ;
    skos:definition "The concept of \"Dissolution for Oppression\" refers to a legal claim made by shareholders or partners against a corporation or partnership alleging that the majority shareholders or partners have acted oppressively towards the minority, resulting in the dissolution of the entity." .

<RZBGdq2Y9YEuAvMqpgUbGy> a owl:Class ;
    rdfs:label "Secured Creditor" ;
    dc:identifier "CRED-SCRD" ;
    rdfs:subClassOf <R7PHFZzZmVmczzNQl6iZKsa> ;
    skos:altLabel "Secured Creditor",
        "Secured Lender",
