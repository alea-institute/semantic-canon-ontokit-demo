<RDCadS09OTz19xBozuEqYIb> a owl:Class ;
    rdfs:label "Soft Tissue Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_04> ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Malignant Soft Tissue Tumor",
        "Sarcoma of Soft Tissue" ;
    skos:definition "Soft tissue sarcoma refers to a group of malignant tumors that originate in the soft tissues of the body, including muscles, fat, blood vessels, nerves, tendons, and the lining of joints. These cancers can occur in any part of the body and often require complex treatment due to their aggressive nature and potential to spread." ;
    skos:prefLabel "Soft Tissue Sarcoma" .

