        <RmqysGFQ1RYW3F9lv5u3hu> ;
    skos:altLabel "Public Offering Statement" ;
    skos:definition "A Prospectus is a formal document filed with securities regulators that provides details about an investment offering for sale to the public. It usually includes the terms of the offering, risks, and financial statements among other critical information." .

<R8TcoZums6Bey9dc1v7qDZc> a owl:Class ;
    rdfs:label "Right of Sepulcher" ;
