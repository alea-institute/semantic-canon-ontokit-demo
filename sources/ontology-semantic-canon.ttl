    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Prostatic Carcinoma" ;
    skos:definition "Prostate cancer is a type of cancer that develops in the prostate gland, a small gland in men that produces seminal fluid. It can range from slow-growing tumors that may need minimal treatment to aggressive cancers that require surgery, radiation, and hormone therapy." ;
    skos:prefLabel "Prostate Gland Cancer" .

