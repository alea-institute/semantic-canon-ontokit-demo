    rdfs:subClassOf <sdtUDJUnSnaex6TM9E5nYg> ;
    skos:definition "This industry comprises establishments primarily engaged in raising horses, mules, donkeys, and other equines." .

<ivTF0hnNQFSu96DVaLrdlA> a owl:Class ;
