<R7hBC2pePnUMRnaYOfOMsWc> a owl:Class ;
    rdfs:label "Other Recurrent Use and Permission Tax Payment" ;
    rdfs:subClassOf <RByl0iNSHBNmfLanOSBWLSx> ;
    skos:altLabel "Continuous License Tax Payment",
        "Other recurrent taxes",
        "Periodic License Fee Payment",
        "Professional License Tax Payment",
        "Recurring Business License Tax Payment",
        "Regular Permission Fee Payment" ;
    skos:definition "Other Recurrent Use and Permission Tax Payment covers taxes levied on a recurring basis for business and professional licenses required to carry on particular types of businesses or professions. This includes licenses such as those for taxis and casinos, as well as dog licenses and recurrent general licenses for hunting, shooting, and fishing. Broadcast license fees are included when the payer cannot opt out from making payments for public broadcasting, even if they do not consume such services. Specific exemptions do not alter the compulsory nature of these payments." ;
    skos:example "Casino Tax",
        "Dog License Tax",
        "Fishing License Tax",
        "Hunting License Tax",
        "Shooting License Tax",
        "Taxi Tax" .

