<RDJPdWE32ZF0O3QeYJi5uc> a owl:Class ;
    rdfs:label "The Ten Commandments"^^xsd:string ;
    rdfs:subClassOf <R7IpkmsG5ugeP6FKhN6nYGU> ;
    skos:altLabel "Decalogue"^^xsd:string,
        "Sinaitic Decalogue"^^xsd:string,
        "Tablets of the Law"^^xsd:string,
        "Ten Commandments"^^xsd:string ;
    skos:definition "The Ten Commandments represents the core moral and religious decalogue that God spoke directly to Israel from Mount Sinai and inscribed on stone tablets, establishing fundamental covenant obligations. These commandments form the essential covenant stipulations governing Israel's relationship with God and neighbor, serving as the foundational ethical framework for biblical law."^^xsd:string ;
    skos:example "Aquinas integrated the ten commandments into his natural law theory, arguing they reflected universal moral principles."^^xsd:string,
        "Catechists throughout medieval Europe taught the ten commandments as the basic moral framework for examining conscience."^^xsd:string,
        "Contemporary legal scholars debated whether displaying the ten commandments in courthouses violated church-state separation principles."^^xsd:string .

<RDMsL8T3t9qIU3TOdiJvQBN> a owl:Class ;
    rdfs:label "Church Actor" ;
    rdfs:subClassOf <RJwPJFKAy0EJgBB6jTyhhk> ;
    skos:altLabel "Body of the Church"^^xsd:string,
        "Canonical Juridic Person"^^xsd:string,
        "Church Body"^^xsd:string,
        "Church Entity"^^xsd:string,
        "Ecclesiastical Entity"^^xsd:string ;
    skos:definition "A Church Actor is an organizational entity within the Catholic Church that exercises ecclesial authority, mission, or ministry through stable structures recognized by canon law. It acts corporately rather than personally, carrying rights and obligations ordered to worship, governance, teaching, or service."^^xsd:string ;
    skos:example "A diocese functions as a church actor responsible for pastoral oversight."^^xsd:string,
        "A parish operates as a local church actor serving the faithful."^^xsd:string,
        "The Holy See acts as a church actor in global governance and diplomacy."^^xsd:string ;
    skos:prefLabel "Ecclesial Actor"^^xsd:string .

