        "Social stationery merchant wholesalers",
        "Writing pens merchant wholesalers" .

<NRM6lbGUQD6vi5OR3TecPw> a owl:Class ;
    rdfs:label "Brick, Stone, and Related Construction Material Merchant Wholesalers" ;
