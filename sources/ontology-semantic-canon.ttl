    skos:definition "Afar (Language) is a structured system of communication that consists of grammar and vocabulary, and is a member of the Language class." .

<RBh4IihdHcd5SdGt2qH2qIx> a owl:Class ;
    rdfs:label "Dyslexia" ;
    rdfs:subClassOf <RCHYAaMF4QRHH9QwmNKGN8Y> ;
    skos:altLabel "Reading Disability",
        "Reading Disorder" ;
    skos:definition "Dyslexia is a specific learning disability that affects an individual's ability to read, spell, write, and sometimes speak, due to difficulties in recognizing and processing written words and symbols. It is a neurological condition that is often hereditary and varies in severity, requiring tailored educational strategies and interventions." ;
    skos:prefLabel "Reading Impairment" .

<RBhEKAIRXGRj45kY7Z6eg0y> a owl:Class ;
    rdfs:label "Landlord Insurance Policy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDqvWcvBcUV4cKSUqlFKc4k> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R872e3e5kIyoshDoSHVM94B> ],
        <R75X7YZe3jw77Sogk8Vz8NT> ;
    skos:definition "Landlord insurance is designed to provide coverage for property owners who rent out one or more residential homes, apartments, or condos. It generally covers the building structure, and it may also provide coverage for loss of rental income and liability protection. It typically does not cover the personal belongings of the tenants." ;
    skos:prefLabel "Rental Property Insurance" .

<RBhEtV3NzVBd8sWbfF4Wifc> a owl:Class ;
    rdfs:label "Medical Ethics" ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Clinical Ethics"^^xsd:string,
        "Ethics of Medical Practice"^^xsd:string,
        "Healing Professions Ethics"^^xsd:string,
        "Healthcare Ethics"^^xsd:string,
        "Physician Ethics"^^xsd:string ;
    skos:definition "Medical Ethics is the field of applied ethics that governs moral decision-making in the practice of medicine and healthcare. Medical Ethics orders clinical judgment toward healing, respect for human dignity, and faithful stewardship of life and health."^^xsd:string ;
    skos:example "Medical ethics directs end-of-life care toward comfort without intentionally causing death."^^xsd:string,
        "Medical ethics evaluates whether a proposed treatment is proportionate to its burdens."^^xsd:string,
        "Medical ethics guides physicians in obtaining informed consent before treatment."^^xsd:string,
        "Medical ethics protects patient confidentiality within clinical practice."^^xsd:string,
        "Medical ethics supports clinicians who refuse participation in immoral procedures."^^xsd:string .

<RBhFi0XLvhq8d4QdZMZ42x9> a owl:ObjectProperty ;
    rdfs:label "folio:registered" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:altLabel "enrolled",
        "folio:enrolled",
        "registered" ;
    skos:definition "\"Registered\" refers to the official recording or enrollment of an item, entity, or individual in a formal registry by an authoritative body. This process provides legal recognition and may confer certain rights, responsibilities, or status, such as intellectual property protection for patents or legal authority to practice for attorneys" ;
    skos:example "Bar Association Registered Attorney",
        "Copyright Office Registered Copyright Registration",
        "DMV Registered Vehicle",
        "Patent Office Registered Patent",
        "Secretary of State Registered Business",
        "Stock Exchange Registered Company" .

<RBhHJWd8ULOE4VrZ2MtGqdH> a owl:Class ;
    rdfs:label "Holy War" ;
    rdfs:comment "In a global Catholic ontology, Holy War is a concept primarily used in historical and theological analysis rather than a contemporary call to arms. The Church has largely moved away from this paradigm in favor of the Just War tradition, emphasizing that religion should never be used to justify violence or the forced conversion of others."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCqqI0SLTxsE8Z2rCu7KOXm> ],
        <R79CBFMSwUZjwKG9qV6AfQb> ;
    skos:altLabel "Crusade"^^xsd:string,
        "Sacralized Conflict"^^xsd:string ;
    skos:definition "Holy War is a conflict initiated or supported by religious authority, often pursued for a perceived divine purpose or the defense of the faith. It differs from a Just War by shifting the primary justification from secular justice and self-defense to the advancement or protection of a religious mandate."^^xsd:string ;
    skos:example "Analyzing the historical crusades to understand the evolution of the Church's teaching on peace and violence."^^xsd:string,
        "Developing theological arguments to counter contemporary claims that divine will mandates the destruction of religious rivals."^^xsd:string,
        "Identifying the misuse of religious rhetoric to mobilize populations for political or territorial gain."^^xsd:string ;
    skos:prefLabel "Religious War"^^xsd:string .

<RBhOGxYh9EijLWWwCV5Exce> a owl:Class ;
