<R9k6fCcFUIbJ8aE6Tk6jLnA> a owl:Class ;
    rdfs:label "Union Certification Election" ;
    rdfs:subClassOf <RDkKltCs6qv3E5GLBaSJ8H4> ;
    skos:altLabel "Employee Representative Election Certification",
        "NLRB Representation Certification" ;
    skos:definition "A formal process by which the regulator (e.g., National Labor Relations Board (NLRB)) certifies a union or other employee organization as the official representative of a group of employees, typically after an election. Certification occurs when the union wins the majority of votes cast in a secret-ballot election overseen by the regulator (e.g., NLRB)." ;
    skos:prefLabel "Employee Representative Certification" .

<R9kBMgFiDWZAo2HfU17C0Vh> a owl:Class ;
    rdfs:label "Gallbladder Cancer" ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Biliary Cancer",
        "Gallbladder Carcinoma" ;
    skos:definition "Gallbladder cancer is a type of cancer that originates in the gallbladder, a small organ beneath the liver that stores bile. It is often diagnosed at an advanced stage due to its asymptomatic nature in early stages, and typically requires treatments such as surgery, chemotherapy, and radiation therapy." .

