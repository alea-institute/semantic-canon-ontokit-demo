            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R83UGZWX9KH0aZfhtRQ4jCJ> ],
        <RVRrqw2QfVD6UcPQLUMxaq> ;
    skos:altLabel "A Lawful Permanent Resident (LPR) is an individual who has been legally granted the right to live and work indefinitely within the destination country (e.g., United States). LPR status provides many of the same benefits as citizenship, such as the ability to work and travel freely, but unlike citizens, LPRs may lose their status under certain conditions like committing serious crimes or abandoning their destination-country residence (e.g., U.S. residence).",
        "LPR" .

<R8wln21w2Ro3XIXYz539Nh6> a owl:Class ;
    rdfs:label "Values and Ethics Risk" ;
    rdfs:isDefinedBy <https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html> ;
    rdfs:subClassOf <RxTxaN981tLTsN82qPBcp> ;
    skos:definition "Values and Ethics Risk refers to the potential for negative consequences arising from an organization's failure to adhere to its stated values, principles, or ethical standards in its operations, decision-making, or behaviors. This can result from unethical practices, inadequate oversight, or cultural issues, potentially leading to reputational damage, legal liabilities, or loss of stakeholder trust, ultimately impacting the organization's overall performance, credibility, and sustainability" .

