            owl:someValuesFrom <R9eRaHXUh5Kv605aMyZLhOt> ],
        <R85Datx36zz4sBBoEYxCByw>,
        <RDSYPGgBlFz5eWNtwoMA2c5> ;
    skos:altLabel "Judge",
        "Richter"@de-de,
        "Judge"@en-gb,
        "Juez"@es-es,
        "Juez"@es-mx,
        "Juge"@fr-fr,
        "שופט"@he-il,
        "न्यायाधीश"@hi-in,
        "裁判官"@ja-jp,
        "Juiz"@pt-br,
        "法官"@zh-cn ;
    skos:definition "A judge is a public official appointed to decide cases in a court of law." ;
    skos:hiddenLabel "JUDG" .

<RDqvWcvBcUV4cKSUqlFKc4k> a owl:Class ;
    rdfs:label "Rental and Leasing Services Industry" ;
    dc:identifier "RRL-RELS" ;
    rdfs:subClassOf <RjKL1UdfWL1FCPVhnbIFSF> ;
    skos:altLabel "Rental and Leasing Services",
        "Miet- und Leasingdienstleistungsbranche"@de-de,
        "Rental and Leasing Services Industry"@en-gb,
        "Industria de servicios de alquiler y arrendamiento"@es-es,
        "Industria de servicios de renta y arrendamiento"@es-mx,
        "Industrie des services de location et de leasing"@fr-fr,
        "תעשיית שירותי השכרה וליסינג"@he-il,
        "किराए और लीज़िंग सेवा उद्योग"@hi-in,
        "レンタルおよびリースサービス業界"@ja-jp,
        "Indústria de serviços de locação e leasing"@pt-br,
        "租赁服务行业"@zh-cn ;
    skos:definition "Industries in this group include establishments that provide a wide array of tangible goods, such as automobiles, computers, consumer goods, and industrial machinery and equipment, to customers in return for a periodic rental or lease payment. thee include those that are engaged in renting consumer goods and equipment and those that are engaged in leasing machinery and equipment often used for business operations." ;
    skos:hiddenLabel "RELS" .

<RDrCSeuostMVOEldU6FRk7O> a owl:Class ;
    rdfs:label "Child Support Guidelines" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9JcsdtYN2CUc5CfCTULHYC> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8v0eP8PnMAaTYALLghTkzk> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBOwCCBkhg24geD2foAgBOB> ],
        <RrECTdM9f5ml4sac9MFrSC> ;
    skos:definition "Child Support Guidelines are legal regulations or guidelines established by a government authority to determine the amount of financial support that a non-custodial parent is required to provide for their child or children. These guidelines take into account factors such as the parents' incomes, the child's needs, and the cost of living. They provide a standardized method for calculating child support payments, ensuring fairness and consistency in support orders." .

<RDu2iPpQAdciNSirAd52mw4> a owl:Class ;
    rdfs:label "Endocrine Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm> ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Endocrinopathy" ;
    skos:definition "Endocrine disorders involve conditions that affect the endocrine glands, which produce hormones regulating various physiological processes in the body, including metabolism, growth, and reproduction. These disorders can disrupt hormonal balance, leading to a wide range of symptoms and health issues." ;
    skos:prefLabel "Hormonal Disorders" .

<RDwajUPdKVdK5tlwiUjmNzG> a owl:Class ;
    rdfs:label "Eminent Domain" ;
    rdfs:subClassOf <RCvD6VheGrBYqJhgQDfMbrV>,
        <RDSBerlLWg1ntpLqDQn1eVn>,
        <RDr6DXAcukDYZgOiiRN8qtf> ;
    skos:altLabel "Fifth Amendment Takings Claim",
        "Taking",
        "Takings Claim",
        "Unlawful Taking",
        "Enteignung"@de-de,
        "Compulsory Purchase"@en-gb,
        "Dominio eminente"@es-es,
        "Dominio eminente"@es-mx,
        "Domaine éminent"@fr-fr,
        "רשות חקלאית"@he-il,
        "प्रतिष्ठित डोमेन"@hi-in,
        "公有化"@ja-jp,
        "Desapropriação"@pt-br,
        "征用"@zh-cn ;
    skos:definition "The concept of Eminent Domain (Taking) refers to the power of the government to take private property for public use, with just compensation to the owner, as authorized by the Constitution." .

<RDxAHb6WWxvwiBtuiLOfgfr> a owl:Class ;
    rdfs:label "Rosary's Sorrowful Mysteries" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RfIUmrXFSaK6jqyfB1cypX> ;
    skos:altLabel "Sorrowful Mysteries"^^xsd:string,
        "Sorrowful Mysteries of the Rosary"^^xsd:string ;
    skos:definition "Rosary’s Sorrowful Mysteries are a set of five mysteries of the Holy Rosary that contemplate the Passion and death of Jesus Christ. They invite meditation on Christ’s suffering, obedience to the Father, and redemptive sacrifice for humanity."^^xsd:string ;
    skos:example "During Lent, families often emphasize the Rosary’s Sorrowful Mysteries in daily prayer."^^xsd:string,
        "The homily connected the Rosary’s Sorrowful Mysteries to the liturgy of Good Friday."^^xsd:string,
        "While meditating on the Agony in the Garden, she reflected on Christ’s obedience within the Rosary’s Sorrowful Mysteries."^^xsd:string .

<RE14c938A941aD356d56E936> a owl:Class ;
    rdfs:label "Greenland" ;
    dc:identifier "NAM-GL" ;
    rdfs:subClassOf <RE001ab376fa25C94f1244be> ;
    skos:hiddenLabel "GL" ;
    skos:prefLabel "Greenland" .

