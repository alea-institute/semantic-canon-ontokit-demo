<R9VJEx0PM1iHEYZHwuFlkWy> a owl:Class ;
    rdfs:label "Jesus' Raising of Lazarus" ;
    rdfs:subClassOf <RBpseS3fO7sq2jPuFJjJRzq> ;
    skos:altLabel "Miracle at Bethany"^^xsd:string,
        "Resurrection of Lazarus"^^xsd:string ;
    skos:definition "Jesus’ Raising of Lazarus means the miraculous act by which Jesus Christ called Lazarus of Bethany out of the tomb after four days, restoring him to life. Jesus’ Raising of Lazarus reveals Christ’s authority over death and serves as the culminating sign pointing toward his own Resurrection."^^xsd:string ;
    skos:example "Calling of Lazarus from the Tomb"^^xsd:string,
        "Christian theology interprets the raising of Lazarus as a sign that anticipates Christ’s Resurrection."^^xsd:string,
        "The Gospel of John narrates Jesus calling Lazarus out of the tomb in Bethany."^^xsd:string,
        "Unbinding of Lazarus"^^xsd:string ;
    skos:prefLabel "Raising of Lazarus"^^xsd:string .

