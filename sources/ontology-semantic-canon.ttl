        <RtmRdqzdG4lddVrtCToiL1> ;
    skos:altLabel "Verletzung der Treuepflicht durch den Treuhänder"@de-de,
        "Breach of Fiduciary Duty by Trustee"@en-gb,
        "Incumplimiento del deber fiduciario por parte del fiduciario"@es-es,
        "Incumplimiento del deber fiduciario por parte del fiduciario"@es-mx,
        "Violation du devoir de fiduciaire par le fiduciaire"@fr-fr,
        "הפרת חובת האמון על ידי הנאמן"@he-il,
        "विश्वासवार्ता के द्वारा न्यायाधीश का उल्लंघन"@hi-in,
        "受託者による信託義務違反"@ja-jp,
        "Violação do dever fiduciário pelo fiduciário"@pt-br,
        "受托人违反信托责任"@zh-cn ;
    skos:definition "The breach of fiduciary duty by trustee refers to a situation where a trustee fails to act in the best interest of the beneficiaries of a trust, violating their legal obligation to manage the trust assets and affairs with loyalty, honesty, and good faith." .

<RBiyqyxHBwXcOgyglGnTPw3> a owl:Class ;
    rdfs:label "Doctrine" ;
    rdfs:subClassOf <RB3kSReNB4kis0pHfnZeHCa> ;
    skos:altLabel "Authoritative Teaching"^^xsd:string,
        "Church Teaching"^^xsd:string,
        "Doctrinal Teaching"^^xsd:string,
        "Teaching of the Church"^^xsd:string ;
    skos:definition "Doctrine refers to a principle, policy, or position established through authoritative decisions or official statements that guide future interpretations and applications. Courts and government bodies create doctrine through repeated application of legal reasoning to similar factual situations. Church doctrines are authoritative teachings that expresse the Church’s understanding of divine revelation, faith, or morals. Doctrine binds belief to varying degrees depending on its source, formulation, and relation to revelation."^^xsd:string ;
    skos:example "Catholic doctrine affirms the real presence of Christ in the eucharist."^^xsd:string,
        "Doctrine teaches that grace is necessary for salvation."^^xsd:string .

<RBizcuAme8glPLFlQSQLCq5> a owl:Class ;
    rdfs:label "Forcible Fondling" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf <R8TvbewYypS9Uy4y5JGIwEH> ;
    skos:altLabel "Gewaltsames Betatschen"@de-de,
        "Forcible Fondling"@en-gb,
        "Manoseo Forzado"@es-es,
        "Manoseo Forzado"@es-mx,
        "Attouchements forcés"@fr-fr,
        "גירופים בכוח"@he-il,
        "बलात्कारी झपटना"@hi-in,
        "強制わいせつ行為"@ja-jp,
        "Apalpação forçada"@pt-br,
        "强制猥亵"@zh-cn ;
    skos:definition "The touching of the private body parts of another person for the purpose of sexual gratification, forcibly and/or against that person’s will or not forcibly or against the person’s will in instances where the victim is incapable of giving consent because of his/her youth or because of his/her temporary or permanent mental or physical incapacity." .

<RBj2e4nY2AmnsQBhrcGTf8K> a owl:Class ;
    rdfs:label "Jesus' Raising Others from the Dead" ;
    rdfs:subClassOf <RBpseS3fO7sq2jPuFJjJRzq> ;
    skos:altLabel "Miracles of Restoration to Life"^^xsd:string,
        "Raising of the Dead by Jesus"^^xsd:string,
        "Resuscitations Performed by Christ"^^xsd:string ;
    skos:definition "Jesus’ Raising Others from the Dead means the miraculous acts by which Jesus Christ restored deceased individuals to bodily life during his public ministry. Jesus’ Raising Others from the Dead reveals Christ’s authority over death and anticipates his own Resurrection."^^xsd:string ;
    skos:example "Raising of Jairus’ Daughter"^^xsd:string,
        "Raising of Lazarus"^^xsd:string,
        "Raising of the Widow’s Son at Nain"^^xsd:string,
        "The Gospel of John narrates Jesus calling Lazarus forth from the tomb."^^xsd:string,
        "The Gospel of Luke describes Jesus raising the son of the widow of Nain."^^xsd:string,
        "The Gospels recount Jesus raising Jairus’ daughter and restoring her to life."^^xsd:string .

<RBjGQJGYoSe1qFvjvtP4w5> a owl:Class ;
    rdfs:label "Collision Auto Insurance Coverage Policy" ;
    rdfs:subClassOf <RCx52UAWgVQUnCDTQXlxMgU> ;
    skos:definition "Collision auto insurance covers damage to the insured's own vehicle resulting from a collision with another vehicle or object, or from flipping over. It is generally an optional coverage but may be required if the vehicle is leased or financed. A deductible usually applies." ;
    skos:prefLabel "Collision Coverage" .

<RBjGhGTbPYSLXYuV7eG4CsV> a owl:Class ;
