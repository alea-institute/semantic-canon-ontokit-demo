    rdfs:subClassOf <Hr1GdAc9QTWWHoLmBNYy-w> ;
    skos:definition "This industry comprises establishments primarily engaged in manufacturing textile bags (except luggage) or other canvas and canvas-like products, such as awnings, sails, tarpaulins, and tents from purchased textile fabrics or yarns." ;
