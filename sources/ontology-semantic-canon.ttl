        <R80nTp0xPWvxkJonwMOIvBA> ;
    skos:definition "Cisgender describes an individual whose gender identity aligns with the sex they were assigned at birth. It is used to differentiate from transgender individuals, whose gender identity does not align with their assigned sex." ;
    skos:prefLabel "Cis" .

<RCJElSi1iqsNDc4FSWySKZO> a owl:Class ;
    rdfs:label "Pancreatic Gland Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm> ;
    rdfs:subClassOf <RDu2iPpQAdciNSirAd52mw4> ;
    skos:definition "Pancreatic gland disorders disrupt the production of hormones, including insulin, affecting metabolism and digestion. These disorders can lead to conditions such as diabetes mellitus and digestive enzyme insufficiency." ;
    skos:prefLabel "Pancreatic Dysfunction" .

<RCJWm2dFjUplXz5eRhdcD2k> a owl:Class ;
