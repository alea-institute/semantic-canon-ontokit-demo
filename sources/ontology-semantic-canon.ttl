<R92PQmXDZqnPGQ9Q6n3fLix> a owl:Class ;
    rdfs:label "Translation Source" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rb1mDAxtz3ATD5BGqdp2Qm> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9eIiLHT0vej9GgZzxXl8kP> ],
        <RBgvM3CLfhaoq2TagoUDUBG> ;
    skos:altLabel "Language Translation"^^xsd:string,
        "Translated Text"^^xsd:string,
        "Vernacular Translation"^^xsd:string ;
    skos:definition "Translation Source is a text that renders an original-language work into another language according to a defined translation philosophy and methodology. A Translation Source mediates access to an authoritative original by conveying meaning, structure, and nuance rather than creating new substantive content."^^xsd:string ;
    skos:example "A liturgical translation source supports proclamation of Scripture in worship."^^xsd:string,
        "The King James Bible serves as a historic translation source widely used in Christian tradition."^^xsd:string,
        "The New American Bible functions as a translation source for Sacred Scripture in English."^^xsd:string .

