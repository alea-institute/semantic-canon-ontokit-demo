    skos:hiddenLabel "INCO" .

<R7MXUsspwVFhBmhwbAGdnil> a owl:Class ;
    rdfs:label "Notary Public Officer Liability for Negligent Acknowledgment" ;
    rdfs:subClassOf <RGm7jrTspmRi606c5XWZ1z>,
        <RSRxb9psAJdqf8rppoiYI8> ;
    skos:altLabel "Haftung des Notarbeamten für fahrlässige Anerkennung"@de-de,
        "Notary Public Officer Liability for Negligent Acknowledgment"@en-gb,
        "Responsabilidad del Notario Público por Reconocimiento Negligente"@es-es,
        "Responsabilidad del Notario Público por Reconocimiento Negligente"@es-mx,
        "Responsabilité de l'officier public de notaire pour reconnaissance négligente"@fr-fr,
        "אחריות עו\"ד רשמי עבור הכרה שגויה"@he-il,
        "गैर-सावधान अधिकारी के लिए नोटरी पब्लिक जिम्मेदारी"@hi-in,
