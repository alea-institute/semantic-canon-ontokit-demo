    skos:prefLabel "Holiday" .

<R9ot3yMAPdqNMAQCqnfHJdv> a owl:Class ;
    rdfs:label "Parable of the Hidden Treasure" ;
    rdfs:subClassOf <R9UCFdrDU3BruofWcw9xAr5> ;
    skos:altLabel "Hidden Treasure Parable"^^xsd:string,
        "Parable of the Buried Treasure"^^xsd:string,
        "Treasure in the Field"^^xsd:string ;
    skos:definition "Parable of the Hidden Treasure means the teaching in which Jesus Christ compares the Kingdom of God to a treasure hidden in a field, discovered by one who sells all he has to obtain it. Parable of the Hidden Treasure reveals the incomparable value of the Kingdom and the total commitment required to possess it."^^xsd:string ;
    skos:example "Christian theology interprets the parable of the hidden treasure as a call to radical commitment to the Kingdom of God."^^xsd:string,
        "The Gospel of Matthew records Jesus describing a man who sells all he has to buy the field containing the hidden treasure."^^xsd:string .

