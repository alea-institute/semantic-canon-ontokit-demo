    rdfs:subClassOf <F0ZuOpBBQameXhSNJBFSaQ> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in manufacturing dental equipment and supplies used by dental laboratories and offices of dentists, such as dental chairs, dental instrument delivery systems, dental hand instruments, dental impression material, and dental cements." .

<ja-hvScyTASkdlrklkEc9w> a owl:Class ;
    rdfs:label "Crop Harvesting, Primarily by Machine" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=115113> ;
    rdfs:subClassOf <a-WMSGfvSDCXHFqyHRYryg> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in mechanical harvesting, picking, and combining of crops, and related activities. The machinery used is provided by the servicing establishment." .

<jgjsC1tRSeaotz9lSA-7Vw> a owl:Class ;
    rdfs:label "Office Equipment Merchant Wholesalers" ;
