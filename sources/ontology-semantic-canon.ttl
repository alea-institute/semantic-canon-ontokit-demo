<RBZ8f5KaaHNeK96eZAkycPX> a owl:Class ;
    rdfs:label "Engineering Ethics" ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Ethical Infrastructure Development"^^xsd:string,
        "Structural Responsibility"^^xsd:string ;
    skos:definition "Engineering Ethics governs the professional conduct and decision-making processes of those who design, build, and maintain technical systems. It ensures that technological advancements serve the common good and prioritize the safety and well-being of the human person over mere efficiency or profit."^^xsd:string ;
    skos:example "Designing manufacturing systems that minimize the release of harmful pollutants into the local water supply."^^xsd:string,
        "Prioritizing the structural integrity of a low-income housing project to ensure the safety of its residents."^^xsd:string,
        "Refusing to compromise safety standards in a bridge design despite significant pressure to reduce construction costs."^^xsd:string .

