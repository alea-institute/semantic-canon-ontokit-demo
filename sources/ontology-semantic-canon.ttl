        <R9b5fs8QJuliSZYeaJLJU2t> ;
    skos:altLabel "Verletzung der Treuepflicht"@de-de,
        "Breach of Fiduciary Duty"@en-gb,
        "Incumplimiento del deber fiduciario"@es-es,
        "Incumplimiento del deber fiduciario"@es-mx,
        "Violation du devoir de fidélité"@fr-fr,
        "הפרת חובת נאמנות"@he-il,
        "विश्वासदाता कर्तव्य का उल्लंघन"@hi-in,
        "信託義務違反"@ja-jp,
        "Violação do dever fiduciário"@pt-br,
        "违反信托责任"@zh-cn ;
    skos:definition "Breach of Fiduciary Duty refers to a situation where a person in a position of trust and confidence, such as a trustee, agent, or business partner, fails to act in the best interests of the other party and instead acts in their own self-interest, resulting in harm or loss to the other party." .

<Ru9TAhxYKI0ZIOxJGezsYK> a owl:Class ;
    rdfs:label "Corporal Works of Mercy" ;
    dc:description "Corporal Works of Mercy are acts of charity that attend to the bodily needs of others. Corporal Works of Mercy express love of neighbor through concrete service to human vulnerability and material necessity."^^xsd:string ;
