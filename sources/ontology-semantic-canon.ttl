<RBAE2arDUR1a9EQLKBsLyff> a owl:Class ;
    rdfs:label "Research Ethics" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCuw9Co5aqGGoEIUhnvjRXK> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBVRWCqwvw5wwVjVNAmPMup> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Ra3Zq5bHGGG3OhZhxSNyk4> ],
        <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Ethical Research Conduct"^^xsd:string,
        "Ethics of Research"^^xsd:string,
        "Human-Subject Research Ethics"^^xsd:string,
        "Research Integrity"^^xsd:string ;
    skos:definition "Research ethics is a moral framework that governs how people plan, conduct, review, and report research involving human persons, animals, or creation, so research serves truth and the common good. It requires respect for human dignity, avoidance of harm, integrity in methods and reporting, and special protection for vulnerable persons and communities."^^xsd:string ;
    skos:example "A research ethics committee required stronger safeguards for a vulnerable population, then approved the project only after revisions."^^xsd:string,
        "A research team refused a sponsor’s request to suppress negative results, then published complete findings with transparent methods."^^xsd:string,
        "A study design minimized harm by reducing invasive procedures and using the least risky protocol consistent with the research aims."^^xsd:string,
        "An investigator obtained informed consent, explained foreseeable risks, and respected each participant’s right to withdraw at any time."^^xsd:string,
        "Avoidance of Research Misconduct"^^xsd:string,
        "Conflict of Interest in Research"^^xsd:string,
        "Ethics Review and Oversight"^^xsd:string,
        "Ethics of Research Involving Human Biological Material"^^xsd:string,
        "Informed Consent in Research"^^xsd:string,
        "Privacy and Confidentiality in Research"^^xsd:string,
        "Protection of Vulnerable Research Participants"^^xsd:string,
        "Publication and Reporting Ethics"^^xsd:string,
        "Research Risk–Benefit Analysis"^^xsd:string .

<RBAE67488D5fcDE0b34929d2> a owl:Class ;
    rdfs:label "Treasury Inspector General for Tax Administration" ;
    dc:identifier "US-FD-TREAS-TIGTA" ;
    rdfs:subClassOf <RAA299e70Ea01E3Ba1dBAe8f> ;
