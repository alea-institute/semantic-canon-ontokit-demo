<R9ihoRPcnCIxjpGoNYzMi2Y> a owl:Class ;
    rdfs:label "Public Health Insurance Policy" ;
    rdfs:subClassOf <RCjgFvO2VxpIklnhZMbSD9k> ;
    skos:definition "Public health insurance is a government-sponsored program designed to provide healthcare coverage to eligible individuals or populations. Examples in the United States include Medicare, for older adults, and Medicaid, for low-income individuals. Coverage and eligibility criteria are determined by the government." .

<R9qtOzWmov77zTz4rUCNAKr> a owl:Class ;
