<RDbOOduNCNzIwuYNhT9ubH4> a owl:Class ;
    rdfs:label "Fairness" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Equity"^^xsd:string,
        "Evenhandedness"^^xsd:string,
        "Impartiality"^^xsd:string ;
    skos:definition "Fairness is the ethical principle that requires impartial and reasonable treatment of persons in comparable situations. Fairness directs decision-making to avoid arbitrariness, favoritism, and unjust discrimination."^^xsd:string ;
    skos:example "Fairness demands consistent grading standards for all students."^^xsd:string,
        "Fairness guides impartial evaluation of evidence in legal proceedings."^^xsd:string,
        "Fairness prohibits favoritism in hiring or promotion decisions."^^xsd:string,
        "Fairness requires applying the same rules to all parties in a dispute."^^xsd:string,
        "Fairness supports transparent processes for allocating limited resources."^^xsd:string .

<RDbPkac12BNESLyUsRjPpwv> a owl:Class ;
