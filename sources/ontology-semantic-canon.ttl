<RDIudNXEZj4Sm88RLHbKaPm> a owl:Class ;
    rdfs:label "God the Father" ;
    rdfs:subClassOf <R7xwsOkoji8EZRUrS511KGF> ;
    skos:altLabel "Father Almighty"^^xsd:string,
        "First Person of the Trinity"^^xsd:string,
        "God the Creator"^^xsd:string ;
    skos:definition "God the Father is the first Person of the Holy Trinity, unbegotten and the eternal source of the Son and the Holy Spirit. He is Creator of heaven and earth, who reveals himself as Father through the Son and draws humanity into divine life."^^xsd:string ;
    skos:example "Christian prayer often begins by addressing God the Father."^^xsd:string,
        "God the Father sent the Son for the salvation of the world."^^xsd:string,
        "Jesus reveals God the Father through his words and actions."^^xsd:string,
        "The Nicene Creed professes belief in God the Father almighty."^^xsd:string ;
    skos:prefLabel "Heavenly Father"^^xsd:string .

