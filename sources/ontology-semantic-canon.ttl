<R82DCY9wpy8RlxYrwn0NIya> a owl:Class ;
    rdfs:label "Non-Hearsay Evidentiary Objective" ;
    dc:source "Fed. R. Evid. 801(d)" ;
    rdfs:subClassOf <R9yi9EljTLvrh7N74L460ye> ;
    skos:definition "A Non-Hearsay Evidentiary Objective refers to a purpose for admitting an out-of-court statement that is specifically exempted from the hearsay rule due to its inherent reliability or fairness in the context of the adversarial process. These objectives include party admissions, prior statements by witnesses under oath, and prior identifications made by witnesses." .

<R83qv1lc6haj7YdVbcf75oC> a owl:Class ;
    rdfs:label "Institution of the Eucharist" ;
    dc:source <https://marian.org/mary/rosary/luminous-mysteries> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8qQX2zUgLXmU92ShX5azyn> ],
        <R8pWV2DWpkvqZRwPnnFcCzA>,
        <RB0StvDeQfMH6zc3UucLKXt>,
        <RPq5X7NPLuzbWzt3kLIhkw> ;
    skos:altLabel "Establishment of the Eucharist"^^xsd:string,
        "Institution of Holy Communion"^^xsd:string,
        "Institution of the Lord’s Supper"^^xsd:string,
        "Institution of the Sacrament of the Eucharist"^^xsd:string ;
    skos:definition "The Institution of the Eucharist is the event in which Jesus, at the Last Supper, gave bread and wine to his disciples and identified them with his body and blood. It establishes the Eucharist as a perpetual rite of remembrance and participation in his self-giving."^^xsd:string ;
    skos:example "A catechism class connected the Institution of the Eucharist with the sacrifice of the Cross."^^xsd:string,
        "A theology lecture explained the Institution of the Eucharist as the foundation of Christian sacramental worship."^^xsd:string,
        """And He took bread, and when He had given thanks He broke it and gave it to them, saying, "This is My body which is given for you." … And likewise the cup after supper, saying, "This cup which is poured out for you is the new covenant in My blood."
(Luke 22:19-20)"""^^xsd:string,
        "Sacred art portrays the Institution of the Eucharist with Jesus offering bread and wine to the apostles."^^xsd:string,
        "The Gospel accounts describe the Institution of the Eucharist during the Last Supper."^^xsd:string,
        "The liturgy recounts the Institution of the Eucharist through the words spoken over bread and wine."^^xsd:string .

<R85BLSakJPEy7c7KvxZyOe> a owl:Class ;
    rdfs:label "Administrative Proceeding Forum" ;
    rdfs:subClassOf <R85OMPBjCJJv2cpg2RCwYim> ;
    skos:definition "An Administrative Proceeding Forum is a type of Dispute Forum that is responsible for overseeing legal proceedings related to administrative law, such as tax, workers' compensation, and immigration cases." .

<R85Imx70Iv0XY38PT8gfM6z> a owl:Class ;
    rdfs:label "Intracompany Transferee Petition" ;
    rdfs:subClassOf <RKY2B2HNSx5K82dgVN6Qn7> ;
    skos:definition "An Intracompany Transferee Petition, also known as an L Petition in the U.S., allows a U.S. employer to transfer an executive, manager, or employee with specialized knowledge from one of its affiliated foreign offices to an office in the U.S. This petition facilitates the entry of qualified employees under the L-1 visa category for intracompany transfers." ;
    skos:prefLabel "L Petition" .

<R85OMPBjCJJv2cpg2RCwYim> a owl:Class ;
    rdfs:label "Dispute Forum" ;
    rdfs:subClassOf <RBjHwNNG2ASVmasLFU42otk> ;
    skos:definition "A Dispute Forum is a type of organization or government entity that oversees legal proceedings related to conflicts or disagreements between parties." .

<R872e3e5kIyoshDoSHVM94B> a owl:Class ;
