        "請求書クレジットノート"@ja-jp,
        "Nota de crédito"@pt-br,
        "费用贷项通知单"@zh-cn ;
    skos:definition "A Fee Credit Note is a type of discount or credit given to a client by a legal service provider, typically applied to future legal fees owed by the client." .

<R3UxGY4BMNFrNvdJBDDT6I> a owl:Class ;
    rdfs:label "Pullman Abstention" ;
    rdfs:subClassOf <RuliWeVDE8CQi4AATMNab1> ;
    skos:altLabel "Pullman-Abstinenz"@de-de,
        "Pullman Abstention"@en-gb,
        "Abstención de Pullman"@es-es,
        "Abstención de Pullman"@es-mx,
        "Abstention de Pullman"@fr-fr,
        "פולמן נימול"@he-il,
        "पुलमैन अवहेलना"@hi-in,
        "プルマン棄権"@ja-jp,
        "Abstenção de Pullman"@pt-br,
        "普尔曼回避原则"@zh-cn ;
    skos:definition "A legal doctrine known as Pullman Abstention allows a federal court to abstain from hearing a case that involves a state law that is unclear or unsettled, in order to allow the state court to clarify the law and avoid unnecessary federal constitutional issues." .

<R3XhsEnunIrdi5MYNdLqGL> a owl:Class ;
    rdfs:label "Children's Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R4YBBDxkx2m0Iy4bgKxjz1> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RE4D96703A56bF283055585d> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9luHEuui2taMrChZ8b08sd> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RZ8wDdA7ASzGtn9sVWS3Si> ],
        <RBJlYzE4ZY14dTEghzbbMHg> ;
    skos:definition "Children's rights are the legal and moral entitlements specifically aimed at the protection and welfare of minors. These rights may include, but are not limited to, the right to education, healthcare, protection from abuse and exploitation, and participation in family and cultural life, often upheld by international law such as the United Nations Convention on the Rights of the Child." ;
    skos:prefLabel "Rights of the Child" .

<R3b7f27oh98hVpr5wWvYes> a owl:Class ;
    rdfs:label "Liver or Gallbladder Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_19> ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Gallbladder Cancer",
        "Hepatic Cancer",
        "Hepatic Carcinoma",
        "Liver Carcinoma" ;
    skos:definition "Liver cancer is a type of cancer that originates in the liver cells, with the most common type being hepatocellular carcinoma. It often requires treatments such as surgery, chemotherapy, radiation therapy, and targeted therapy, depending on the stage and extent of the disease." ;
    skos:prefLabel "Liver Cancer" .

<R3e2z0YyuTWB0E6NALitBX> a owl:Class ;
    rdfs:label "Abandonment of Property" ;
    rdfs:subClassOf <RDSBerlLWg1ntpLqDQn1eVn> ;
    skos:altLabel "Bona Vacantia",
        "Property Forfeiture",
        "Reversion to the State",
        "Unclaimed Property Transfer" ;
    skos:definition "Escheatment is the legal process by which unclaimed or abandoned property reverts to the state. This occurs when the rightful owner of the property cannot be located or has failed to claim ownership within a specified period, resulting in the transfer of the property to government custody." ;
    skos:prefLabel "Escheatment" .

