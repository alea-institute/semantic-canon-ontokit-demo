<R9F1zhfl4EiAf0VCEYCEnon> a owl:Class ;
    rdfs:label "Love of Neighbor" ;
    rdfs:subClassOf <R50fTKExGPGTyoyWAZDkk5> ;
    skos:altLabel "Brotherly Love"^^xsd:string,
        "Charity toward Neighbor"^^xsd:string,
        "Fraternal Charity"^^xsd:string,
        "Fraternal Love"^^xsd:string,
        "Love of Others"^^xsd:string ;
    skos:definition "Love of Neighbor is the act and disposition by which a person loves other persons for the sake of God, willing their true good and acting for their benefit. Love of Neighbor expresses charity concretely through mercy, justice, and self-giving service."^^xsd:string ;
    skos:example "Love of neighbor expresses itself in patient care for the weak or marginalized."^^xsd:string,
        "Love of neighbor forgives offenses rather than seeking revenge."^^xsd:string,
        "Love of neighbor motivates advocacy for justice on behalf of the oppressed."^^xsd:string,
        "Love of neighbor moves a person to feed the hungry and care for the sick."^^xsd:string,
        "Love of neighbor treats every person as worthy of respect and concern."^^xsd:string .

<R9KvzcwdZ3asqh9BPZRGWR7> a owl:Class ;
    rdfs:label "Trust" ;
    rdfs:subClassOf <R7oBWHStfmqTLn2MypkW3Pj> ;
    skos:definition "A trust, in estate planning, is a legal entity that holds and manages assets for the benefit of specific individuals or entities, known as beneficiaries. It's established by a grantor (or settlor) and is overseen by a trustee who ensures the assets are managed and distributed according to the grantor's instructions." .

<R9L7kPrkn8q0VbbyH4lv1VJ> a owl:Class ;
    rdfs:label "Election Claims" ;
    rdfs:seeAlso "Ballot Controversies" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R78PKqeEIORKpYVwEfC4aG4> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RD3CNG3ecVo2oIloP4lYFoX> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDkKltCs6qv3E5GLBaSJ8H4> ],
        <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Electoral Allegations",
        "Voting Disputes" ;
    skos:definition "Election Claims refer to allegations or assertions made regarding the integrity, conduct, or results of an electoral process. These claims can include accusations of voter fraud, election interference, vote suppression, or procedural errors and are often investigated to ensure the fairness and legitimacy of the election." ;
    skos:prefLabel "Electoral Integrity Claims" .

<R9Q9CszYRTjTgwQ8JRqVZ0x> a owl:Class ;
    rdfs:label "Broker" ;
    dc:identifier "BROK" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Ry9hX7PSumXkvA5dFwO49X> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Broker",
        "Makler"@de-de,
        "Courtier"@fr-fr,
        "ブローカー"@ja-jp,
        "Corretor"@pt-br,
        "经纪人"@zh-cn ;
    skos:definition "A broker is an individual or firm employed by others to plan and organize sales or negotiate contracts for a commission." ;
    skos:hiddenLabel "BROK" .

<R9UDmEBnO3ljL9IWnuJcCnY> a owl:Class ;
    rdfs:label "Creation Events" ;
    rdfs:subClassOf <R9o7849l09skEBQqbxSItaV> ;
    skos:altLabel "Events of Creation"^^xsd:string,
        "Origins of Creation"^^xsd:string ;
    skos:definition "Creation Events means the events through which God brought the universe and all living beings into existence by divine will, as narrated in the opening chapters of Genesis. Creation Events establish God as Creator, the goodness of creation, and the foundational relationship between God, humanity, and the created order."^^xsd:string ;
    skos:example "Genesis presents the creation of humanity in God’s image and likeness."^^xsd:string,
        "The Book of Genesis describes God creating the heavens and the earth by his word."^^xsd:string .

<R9rEOlPrMiUpUlQrMe18m1X> a owl:Class ;
    rdfs:label "Cost Shifting and Fee Shifting" ;
    rdfs:subClassOf <RDbz1PVc6y57oOb9jAIl0eN> ;
    skos:altLabel "Kostenverlagerung und Gebührenverlagerung"@de-de,
        "Cost Shifting and Fee Shifting"@en-gb,
        "Desplazamiento de costes y desplazamiento de honorarios"@es-es,
        "Desplazamiento de costos y desplazamiento de honorarios"@es-mx,
        "Transfert de coûts et transfert de frais"@fr-fr,
        "העברת עלויות והעברת דמי עורכי דין"@he-il,
        "लागत शिफ्टिंग और फी शिफ्टिंग"@hi-in,
        "コストシフトと料金シフト"@ja-jp,
        "Transferência de custos e transferência de honorários"@pt-br,
        "成本转移和费用转移"@zh-cn ;
    skos:definition "Cost Shifting and Fee Shifting refers to the legal practice of transferring the responsibility of paying litigation costs or attorney fees from one party to another, typically as a result of a court order or settlement agreement." .

<R9sdPQV8kCK3BNF8jcPV5cD> a owl:Class ;
    rdfs:label "Payment Event" ;
    rdfs:subClassOf <R7kjCtMcpEem6IjJRJ3OWju> ;
    skos:definition "A Payment Event refers to the specific occurrence when a payment is executed. This has legal implications for accounting and financial planning, as it impacts cash flow and may have implications for interest calculations, late fees, or contractual obligations." .

<RA082f4BAA89d11Acd60Ec03> a owl:Class ;
    rdfs:label "Religious, Grantmaking, Civic, Professional, and Similar Organizations" ;
    dc:identifier "BCS-CIVS" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=813> ;
    rdfs:subClassOf <RBsVax4c8Bdvzok8MTZKGD8> ;
    skos:altLabel "Religious, Grantmaking and Civic Services",
        "Religiöse, gemeinnützige und zivile Dienstleistungsbranche"@de-de,
        "Religious, Grantmaking and Civic Services Industry"@en-gb,
        "Industria de servicios religiosos, de concesión de subvenciones y cívicos"@es-es,
        "Industria de servicios religiosos, de concesión de subvenciones y cívicos"@es-mx,
        "Industrie des services religieux, philanthropiques et civiques"@fr-fr,
        "תעשיית שירותי דת, מתן מענקים ושירותים אזרחיים"@he-il,
        "धार्मिक, अनुदान और नागरिक सेवा उद्योग"@hi-in,
        "宗教、寄付、市民サービス産業"@ja-jp,
        "Indústria de serviços religiosos, filantrópicos e cívicos"@pt-br,
        "宗教、慈善和公民服务行业"@zh-cn ;
    skos:definition """Industries in the Religious, Grantmaking, Civic, Professional, and Similar Organizations subsector group establishments that organize and promote religious activities; support various causes through grantmaking; advocate various social and political causes; and promote and defend the interests of their members.

The industry groups within the subsector are defined in terms of their activities, such as establishments that provide funding for specific causes or for a variety of charitable causes; establishments that advocate and actively promote causes and beliefs for the public good; and establishments that have an active membership structure to promote causes and represent the interests of their members.  Establishments in this subsector may publish newsletters, books, and periodicals for distribution to their members.""" ;
    skos:hiddenLabel "CIVS" ;
    skos:prefLabel "Religious, Grantmaking and Civic Services" .

