        "Dental hygienists' offices",
        "Denturists' offices",
        "Dietitians' offices",
        "Homeopaths' offices",
        "Hypnotherapists' offices",
        "Inhalation or respiratory therapists' offices",
        "Midwives' offices",
        "Naturopaths' offices",
        "Registered or licensed practical nurses' offices" .

<MyYW-tXUQDSLGibJTLAGAQ> a owl:Class ;
    rdfs:label "Motor Vehicle Body Manufacturing" ;
