<RBBo7LrufcJPANNOwnbIYo1> a owl:Class ;
    rdfs:label "Ex Post Facto Clause Claim" ;
    rdfs:subClassOf <RDkqXQLaqeFlhG4isnkHJuv> ;
    skos:altLabel "Anspruch auf Klausel ex post facto"@de-de,
        "Ex Post Facto Clause Claim"@en-gb,
        "Reclamo de Cláusula Ex Post Facto"@es-es,
        "Reclamo de Cláusula Ex Post Facto"@es-mx,
        "Réclamation de clause ex post facto"@fr-fr,
