<RBebp8K1tyXtYFyAmphDCaX> a owl:Class ;
    rdfs:label "Exempt Securities Notification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R24Fe8aF4D15b46F6031E543> ],
        <RmCERXtzdqIJcW9mdbk0Bb> ;
    skos:definition "An Exempt Securities Notification is a notice of exempt offering of securities filed with the financial regulator (e.g., U.S. Securities and Exchange Commission (SEC)) by companies that have sold securities without registration, in reliance on an exemption (e.g., provided by Regulation D or Section 4(a)(5) of the Act). The form provides information about the issuer, the offering, and the investors, and is used to inform regulators and the public about the exempt offering." ;
    skos:prefLabel "Form D" .

