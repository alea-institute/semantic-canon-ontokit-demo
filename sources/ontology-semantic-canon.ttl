    skos:altLabel "High-end Market",
        "Luxury",
        "Premium Market Segment" ;
    skos:definition "The luxury segment refers to a specific portion of the market that is characterized by consumers who seek high-end, premium products and services. This segment is associated with luxury goods that offer exclusivity, superior quality, and a high level of craftsmanship, catering to consumers who are willing to pay a premium for these attributes." ;
    skos:example "Gourmet Foods",
        "Private Jet Services",
        "Yacht Manufacturer" ;
    skos:prefLabel "Premium Market" .

<RBgw1iuKW0MTO2I9OFJHv6g> a owl:Class ;
