    skos:example "A parish church anchors the pastoral and sacramental life of a local Catholic community."^^xsd:string,
        "A parish church gathers the faithful of a neighborhood or community for worship and formation."^^xsd:string,
        "A parish church serves as the regular location for Sunday Mass and sacramental celebrations."^^xsd:string .

