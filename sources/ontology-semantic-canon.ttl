<RC6xzNNhsMkchuMHEJO73JE> a owl:Class ;
    rdfs:label "Intermittent Explosive Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RCnCHWsREqpfQAAfaN2lRPV> ;
    skos:definition "Intermittent Explosive Disorder is characterized by recurrent, impulsive outbursts of aggression or violent behavior that are out of proportion to any external provocation or psychosocial stressors. These outbursts can result in significant damage to property, injury to others, or legal problems and are not attributable to another mental disorder or substance abuse." ;
    skos:prefLabel "Explosive Personality Disorder" .

