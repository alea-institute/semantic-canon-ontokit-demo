<RB5gf73BI6veb6i7yvZa472> a owl:Class ;
    rdfs:label "Two Round Electoral System" ;
    dc:source <https://en.wikipedia.org/wiki/Two-round_system> ;
    rdfs:subClassOf <RB2K2E9rftRKciKOqkr1BeV> ;
    skos:altLabel "Double Ballot",
        "Majority Runoff",
        "Majority Runoff System",
        "Runoff Voting",
        "Second Round Voting",
        "Two-Round Voting",
        "Two-Stage Voting" ;
    skos:definition "A two-round electoral system, also known as runoff voting, is a voting method where if no candidate achieves a required majority in the first round, a second round is held between the top candidates. This system ensures that the winner has broad support, typically requiring a majority of votes in the final round." ;
    skos:example "Double Ballot: Brazilian presidential elections",
        "Majority Runoff: French presidential elections",
        "Second Round Voting: Russian gubernatorial elections" .

<RB5gqaWropAnzq8l6tvaMTp> a owl:Class ;
    rdfs:label "Property Air Right" ;
    rdfs:subClassOf <RCkPc0XIMxDInzRipCUUZ1q> ;
    skos:altLabel "Development Air Rights",
        "Overhead Space Rights" ;
    skos:definition "Property Air Rights refer to the legal entitlement to use, develop, or control the space above a piece of real property. This concept extends the traditional notion of property ownership vertically, allowing landowners or developers to potentially construct buildings, sell the rights for development, or otherwise utilize the airspace above their land." ;
    skos:prefLabel "Aerial Rights" .

<RB5h94dR21FHDtOstJhcELR> a owl:Class ;
    rdfs:label "Lay Member of an Association of the Faithful" ;
    rdfs:subClassOf <R8arYcuKOmoupgBeekNim0e> ;
    skos:definition "A Lay Member of an Association of the Faithful is a layperson who belongs to a Church-recognized association established to foster a common apostolic purpose, devotion, or work of charity. He or she participates in the Church’s mission through shared spiritual life and coordinated action while remaining in the lay state."^^xsd:string ;
    skos:example "A lay member participates in an association dedicated to charitable works."^^xsd:string,
        "Members of associations of the faithful commit to shared prayer and mission."^^xsd:string,
        "Some associations of the faithful receive formal recognition from the bishop."^^xsd:string .

<RB5hOpDeyzNdQ2cnGYCTsir> a owl:Class ;
