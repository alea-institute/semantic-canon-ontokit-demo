<R7g7orVXBD7PBoQArPcDYsz> a owl:Class ;
    rdfs:label "Organic Products Market Segment" ;
    rdfs:subClassOf <Rt7y5QJoXmShB4OEPQ8Ysl> ;
    skos:altLabel "Organic Foods Market Segment" ;
    skos:definition "The organic foods market segment refers to a division of the market that is specifically targeted towards consumers who are interested in foods that are produced using methods that do not involve synthetic pesticides, fertilizers, genetically modified organisms (GMOs), or irradiation. This segment encompasses products and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek natural, environmentally friendly, and health-conscious food options." ;
    skos:example "Organic Dairy Products",
        "Organic Fruits and Vegetables",
        "Organic Meat and Poultry" ;
    skos:prefLabel "Natural Foods Market Segment" .

