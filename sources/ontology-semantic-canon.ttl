<RBbmAr7UZlvBSjbTLZeA5I9> a owl:Class ;
    rdfs:label "Unlawful Wage Garnishment Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7OJQHant3Dx172WXuPbWgx> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <ROjlFsq58MnIV2nxc0IvNu> ],
        <RB5irrjea9ZzesLNnhYPQ1D> ;
    skos:altLabel "Anspruch auf unrechtmäßige Lohnpfändung"@de-de,
        "Unlawful Wage Garnishment Claim"@en-gb,
        "Reclamación de embargo de salario ilegal"@es-es,
        "Reclamación de embargo de salario ilegal"@es-mx,
        "Réclamation de saisie de salaire illégale"@fr-fr,
        "תביעה למחיקת שכר עבודה בלתי חוקי"@he-il,
        "अवैध वेतन गार्निशमेंट दावा"@hi-in,
        "違法な賃金差し押さえ請求"@ja-jp,
        "Reivindicação de penhora de salário ilegal"@pt-br,
        "非法工资扣押索赔"@zh-cn ;
    skos:definition "An unlawful wage garnishment claim is a legal action initiated by an employee against their employer for not complying with the legal requirements for wage garnishment. Wage garnishment occurs when a creditor obtains a court order to deduct a portion of an employee's wages to satisfy a debt. The claim typically arises when an employer improperly withholds too much of an employee's wages or does not follow the proper legal procedures for wage garnishment, which can result in financial harm to the employee. Employers can also face liability for not protecting employees from unlawful garnishment orders." .

<RBbyx9pMV1DwmhvAgWCdn0W> a owl:Class ;
    rdfs:label "Laying of Hands" ;
    rdfs:subClassOf <RDIlcywwSJazWLKcbP7QyIE> ;
    skos:altLabel "Imposition of Hands"^^xsd:string,
        "Laying on of Hands"^^xsd:string,
        "Manual Imposition"^^xsd:string ;
    skos:definition "Laying of Hands is a ritual action in which a minister places hands upon a person to invoke the Holy Spirit and confer grace, authority, or blessing. It serves as sacramental matter in certain sacraments and as a significant liturgical sign in other rites."^^xsd:string ;
    skos:example "Laying of hands appears throughout Scripture and liturgy."^^xsd:string,
        "Laying of hands invokes the Holy Spirit in confirmation."^^xsd:string,
        "Priests lay hands on the sick while praying for healing."^^xsd:string,
        "The bishop lays hands on the ordinand during holy orders."^^xsd:string .

