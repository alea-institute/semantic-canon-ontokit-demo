    skos:altLabel "Dwelling Unit",
        "Housing Asset",
        "Residential",
        "Wohnimmobilienvermögen"@de-de,
        "Residential Real Estate Asset"@en-gb,
        "Activo inmobiliario residencial"@es-es,
