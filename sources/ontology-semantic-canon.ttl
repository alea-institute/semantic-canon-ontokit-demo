    rdfs:subClassOf <R7gKTQpOKfQ2tOdPu6cLN3w> .

<ROaU08jUOgsbTbTXXNTIXX> a owl:Class ;
    rdfs:label "Ecclesial Foundational Events" ;
    rdfs:subClassOf <REYZrQdidTmIiJf5n7mz2B> ;
    skos:altLabel "Church-Forming Events"^^xsd:string,
        "Ecclesial Origin Events"^^xsd:string,
        "Foundational Events of the Church"^^xsd:string ;
    skos:definition "Ecclesial Foundational Events means the events in Sacred Scripture and early Christian history that establish, constitute, and define the Church’s identity, mission, and structure. Ecclesial Foundational Events mark the transition from Christ’s earthly ministry to the life and governance of the apostolic Church."^^xsd:string ;
    skos:example "The Acts of the Apostles records Pentecost as the event marking the public birth of the Church."^^xsd:string,
        "The mission of the apostles establishes the Church’s universal proclamation of the Gospel."^^xsd:string .

<RPq5X7NPLuzbWzt3kLIhkw> a owl:Class ;
    rdfs:label "Rosary's Mysteries of Light" ;
    dc:source <https://marian.org/mary/rosary/luminous-mysteries>,
        <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RfIUmrXFSaK6jqyfB1cypX> ;
    skos:altLabel "Rosary's Luminous Mysteries"^^xsd:string ;
    skos:definition "Rosary’s Mysteries of Light are a set of five mysteries of the Holy Rosary that contemplate key events from Jesus Christ’s public ministry that reveal his divine identity and the coming of the Kingdom of God. They focus on Christ as the light of the world through his baptism, teaching, signs, and self-gift."^^xsd:string ;
    skos:example "The catechist explained that the Rosary’s Mysteries of Light illuminate Christ’s public ministry."^^xsd:string,
        "While meditating on the Baptism of the Lord, he reflected on Christ’s revelation as the beloved Son within the Rosary’s Mysteries of Light."^^xsd:string ;
    skos:prefLabel "Luminous Mysteries"^^xsd:string .

<RTHm2BxeaziDbm5655G1ki> a owl:Class ;
