    rdfs:subClassOf <RDkqXQLaqeFlhG4isnkHJuv> ;
    skos:altLabel "Anspruch aus der Emolument Clause"@de-de,
        "Emolument Clause Claim"@en-gb,
        "Reclamo de la Cláusula de Emolumentos"@es-es,
        "Reclamo de la Cláusula de Emolumentos"@es-mx,
        "Réclamation de la clause des émoluments"@fr-fr,
        "תביעת סעיף האמולומנט"@he-il,
        "एमोल्यूमेंट क्लॉज क्लेम"@hi-in,
