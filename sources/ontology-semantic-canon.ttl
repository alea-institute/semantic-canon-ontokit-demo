        "Objetivos de Asentamiento"@es-mx,
        "Objectifs d'établissement"@fr-fr,
        "מטרות התיישבות"@he-il,
        "निवास स्थापना के उद्देश्य"@hi-in,
        "入植目標"@ja-jp,
        "Objetivos de assentamento"@pt-br,
        "定居目标"@zh-cn .

<RBFuGRXSksUz7DZ9ryC7C1F> a owl:Class ;
    rdfs:label "Traffic Court" ;
    rdfs:subClassOf <R9sbuHkJC9aqDlHAgw58VSB> ;
    skos:definition "Traffic Court is a specialized court that deals with traffic violations and related offenses." .

<RBIgSt9tTBIIgOibr6v8RDz> a owl:Class ;
    rdfs:label "Goods and Services Tax Payment" ;
    rdfs:subClassOf <RWNHtgqXOWSnS2m1dFK5L0> ;
    skos:altLabel "Consumption Tax Payment",
        "Payment of Tax on Goods and Services" ;
    skos:definition "Goods and Services Tax Payment encompasses all taxes and duties levied on the production, extraction, sale, transfer, leasing, or delivery of goods, as well as the rendering of services. This also includes taxes on the use of goods or permissions to use goods or perform activities, ensuring comprehensive taxation of economic activities related to goods and services." .

<RBJKz2efB8oGem9X7vJ672s> a owl:Class ;
    rdfs:label "Sacraments at the Service of Communion and Mission" ;
    rdfs:subClassOf <RB91Ir5bSOsoHyaGccORDpQ> ;
    skos:altLabel "Sacraments of Mission"^^xsd:string,
        "Sacraments of Service"^^xsd:string ;
    skos:definition "Sacraments at the Service of Communion and Mission are the sacraments through which the faithful are ordered toward the building up of the Church and the service of others. They confer grace for a permanent state of life dedicated to ecclesial communion and apostolic mission."^^xsd:string ;
    skos:example "Sacraments of service orient the faithful toward others."^^xsd:string,
        "The Church’s mission relies on these sacraments."^^xsd:string,
        "These sacraments build up communion within the Church."^^xsd:string .

<RBJX0FzWzDirAGzjMvOdfte> a owl:Class ;
    rdfs:label "Cargo" ;
    rdfs:subClassOf <RDS8DPtuFReTFfJ5nGCczD5> ;
    skos:altLabel "Shipment" ;
    skos:definition "Cargo refers to goods or merchandise conveyed in a vessel, airplane, or vehicle. It encompasses all types of freight, excluding passengers' baggage, transported for commercial gain or military purposes." ;
    skos:prefLabel "Freight" .

<RBLAHsgfwEzyP8N8VTMdgmM> a owl:Class ;
    rdfs:label "Autism Spectrum Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1>,
        <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_10> ;
    rdfs:subClassOf <RN3TubQIlusDFnPgrNAk8D> ;
    skos:altLabel "ASD",
        "Asperger Syndrome",
        "Pervasive Developmental Disorder" ;
    skos:definition "Autism Spectrum Disorder (ASD) is a neurodevelopmental disorder characterized by persistent difficulties in social communication and interaction, along with restricted, repetitive patterns of behavior, interests, or activities. The severity and manifestations of symptoms vary widely among individuals, making it a spectrum disorder." ;
    skos:prefLabel "Autism" .

<RBLodGElBPA4tNq7xpjKA5l> a owl:Class ;
    rdfs:label "Commission" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCoOnTANPIS6LCYx2SVkLJL> ],
        <R8xoAbLw9cOhM7q4iRXRmXu> ;
    skos:definition "A commission is an authoritative body formed by a government or other organization to oversee, manage, and regulate specific activities or issues. Commissions can vary widely in scope, such as city commissions for local governance, the European Commission for regional policy and law, or commissions on human rights to oversee and promote human rights protections." ;
    skos:example "City Commission: City of Los Angeles Planning Commission",
        "Commission on Human Rights: United Nations Human Rights Commission",
        "EU Commission: European Commission" .

<RBNZsqQC9ryG9xpmKm812lV> a owl:Class ;
    rdfs:label "Purchase Agreement" ;
    rdfs:subClassOf <Agreements> ;
    skos:altLabel "Kaufvertrag"@de-de,
        "Purchase Agreement"@en-gb,
        "Contrato de Compra"@es-es,
        "Contrato de Compra"@es-mx,
        "Contrat d'achat"@fr-fr,
        "הסכם רכישה"@he-il,
        "खरीद अनुबंध"@hi-in,
        "購入契約"@ja-jp,
        "Contrato de compra"@pt-br,
        "购买协议"@zh-cn ;
    skos:definition "A Purchase Agreement is a legally binding contract between two or more parties that outlines the terms and conditions of a transaction involving the sale of goods or services." .

<RBOz1UXsX4cnOePooNnJ6Xc> a owl:Class ;
    rdfs:label "Medical Record" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCSG4k3ah1Pu5YgPexPgOmL> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCidddiy9X9fqxmBCyYguuE> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8lpuELvxz47gLtnJQsIzqx> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC1HsTyFjh3rUPc4r8jOu5w> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8X3VQ45MijCh9tDdajbchl> ],
        <RBCzyIAi2Hjl80hfQr8wAMR> ;
    skos:altLabel "Medical Documentation" ;
    skos:definition "A medical record is a comprehensive and confidential document that contains a patient's medical history, including information about their medical conditions, diagnoses, treatments, prescriptions, and interactions with healthcare providers. These records are typically maintained by healthcare institutions and practitioners to track and manage a patient's health and treatment over time, and they are essential for providing continuity of care and ensuring accurate medical documentation." ;
    skos:prefLabel "Health Care Record" .

<RBU1MPZclWmAITpDAoWCKm1> a owl:Class ;
    rdfs:label "Confidential" ;
    dc:source <https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf#page=401&zoom=100,124,477> ;
    rdfs:subClassOf <R89ziIl0nXs5c4ONtS7qXTP> ;
    skos:altLabel "Protected Data",
        "Restricted Information",
        "Sensitive Information" ;
    skos:definition "Confidential is a security classification level used for information that requires protection because its unauthorized disclosure could cause damage to the organization (e.g., company, nation). Access to confidential information is restricted to individuals with the appropriate security clearance and a demonstrated need to know." ;
    skos:prefLabel "Secure Information" .

<RBU1z7AUARMHEr7RMR6feWY> a owl:Class ;
    rdfs:label "Undeveloped - Real Estate Asset" ;
    rdfs:subClassOf <RUhSbbDJZa8Crs3tIWcIfV> ;
    skos:altLabel "Raw Land",
        "Undeveloped",
        "Vacant Land" ;
    skos:definition "An \"Undeveloped Real Estate Asset\" refers to parcels of land that have not yet been altered or improved for specific use. The associated legal matters typically involve zoning laws, land use rights, environmental assessments, and property taxation." ;
    skos:prefLabel "Unimproved Property" .

<RBULYMym4JpJmgkW3Q4Exdd> a owl:Class ;
    rdfs:label "Residence" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9aSzp9cEiBCzObnP92jYFX> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rx7CkM9fjahTS5lZtG21ZR> ],
        <R8nREeU6lB0zs0dt9N339nm> ;
    skos:definition "Residence refers to a specific place where an individual or entity lives or operates. It can include a personal residence where someone lives, or a business residence where a company operates its activities. This aspect is important for several legal analyses (e.g., personal jurisdiction, bankruptcy law, tax law). Residence refers to a person's fixed, permanent, and principal home, often with legal implications and the intention to remain for an extended period, in contrast to \"occupancy,\" which refers to the physical act of living in or using a property, which can be temporary or intermittent," .

<RBUPYY4wgW05EfNJ6kDq8mb> a owl:Class ;
    rdfs:label "Currently Operative Law" ;
    rdfs:subClassOf <RtSews3LsWL6xdoibt5V5R> ;
    skos:altLabel "Good Law",
        "Geltendes Recht"@de-de,
        "Droit en vigueur"@fr-fr,
        "現行法"@ja-jp,
        "Lei atualmente em vigor"@pt-br,
        "现行法律"@zh-cn ;
    skos:definition "The law appears to have legal efficacy, operating effectively." ;
    skos:prefLabel "Citator - Green Flag" .

<RBW19bsnBOwINS8K601XYsz> a owl:ObjectProperty ;
    rdfs:label "folio:attended" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:altLabel "attended" ;
    skos:definition "In a legal context, \"attended\" refers to the act of being present at a legal event, such as a court hearing, meeting, or negotiation. This presence, whether physical or virtual, signifies participation or observation in legal proceedings or discussions, which is often crucial for understanding, contributing to, or complying with legal processes." .

<RBZsudYglnckzDiIt6LK2fk> a owl:Class ;
    rdfs:label "Customs and Import Duty Payment" ;
    rdfs:subClassOf <R9L4OY7QCBEVJpav2Da6Gef> ;
    skos:altLabel "Border Tax Payment",
        "Customs Levy Payment",
        "Customs Tax Payment",
        "Customs and Import Duties",
        "Import Duty Payment",
        "Import Surcharge Payment" ;
    skos:definition "Customs and Import Duty Payment refers to taxes, stamp duties, and surcharges levied exclusively on imported products. This includes specific levies on agricultural imports in European Union member countries and payments under the Monetary Compensation Accounts (MCA) system. Customs duties collected by EU member states on behalf of the European Union are also reported under this heading. These taxes are distinct from general goods and services taxes or excises that apply to both imported and domestically produced goods." ;
    skos:prefLabel "Import Tariff Payment" .

<RBbKQavNM8iQqNfPu2byT6X> a owl:Class ;
    rdfs:label "Animal Domestication Type" ;
    rdfs:subClassOf <R9ax95LqcYtqPK458D1g7aP> ;
    skos:definition "Animal Domestication Type refers to the classification of animals based on their relationship and dependence on humans, distinguishing between those that have been domesticated for companionship, labor, or product provision, and those that live and thrive in the wild without human intervention." ;
    skos:prefLabel "Animal Domestication Classification" .

<RBbuxyUe808Ck5B7a7kfDQJ> a owl:Class ;
    rdfs:label "Priest" ;
    rdfs:subClassOf <RChKPk9K152BirrIYgAREsY> ;
    skos:altLabel "Catholic Priest"^^xsd:string,
        "Ministerial Priest"^^xsd:string,
        "Ordained Priest"^^xsd:string ;
    skos:definition "Priest is an ordained minister who shares in the ministerial priesthood and acts in the person of Christ the Head to proclaim the Gospel, celebrate the sacraments, and shepherd the faithful. He exercises this office through sacred ordination and in communion with his bishop."^^xsd:string .

<RBcSS6JJPoCbbKqlNnoIQJB> a owl:Class ;
    rdfs:label "Privacy Risk" ;
    rdfs:isDefinedBy <https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rd7uelGFqCTWSgf9lWki5N> ],
        <R7xla5mpMCkDl1t6YAR0Eoh>,
        <RBHsUy15guQC3jWrIYrwRsH> ;
    skos:altLabel "Information Stewardship Risk" ;
    skos:definition "Privacy Risk refers to the potential for negative consequences arising from an organization's failure to protect the privacy and confidentiality of personal or sensitive information entrusted to it by individuals or other organizations. These risks can result from inadequate data security measures, cyber attacks, or noncompliance with privacy regulations, potentially leading to data breaches, loss of trust, or legal liabilities, ultimately impacting the organization's overall performance, reputation, and sustainability." .

<RBe9qlr1zTrQ59S23u1iMKZ> a owl:Class ;
    rdfs:label "Class Action Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCg7sZurj0WriXwfKokeRyD> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9cd2WZCsfwJiHkhJ4VKbVM> ],
        <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Sammelklageanspruch"@de-de,
        "Group Litigation Claim"@en-gb,
        "Demanda Colectiva"@es-es,
        "Demanda Colectiva"@es-mx,
        "Action collective en justice"@fr-fr,
        "תביעה קבוצתית"@he-il,
        "क्लास एक्शन दावा"@hi-in,
        "集団訴訟請求"@ja-jp,
        "Reivindicação de ação coletiva"@pt-br,
        "集体诉讼索赔"@zh-cn ;
    skos:definition "A Class Action Claim is a type of civil claim where a group of individuals collectively bring a lawsuit against a defendant, typically seeking compensation for damages or harm caused by the defendant's actions." .

<RBeOt3YZjlGxyEqD6VfyKrj> a owl:Class ;
    rdfs:label "Musical Work" ;
    rdfs:subClassOf <RVaHiNBU68DENmeHicnzro> ;
    skos:definition "A Musical Work is a composition that consists of a combination of melodies, harmonies, rhythms, and lyrics (if any), intended to be performed or recorded. Protected under copyright law, musical works grant composers and lyricists exclusive rights to reproduce, distribute, perform, and display the composition." ;
    skos:prefLabel "Song" .

<RBeoJWbaxdluSMB3WNTMg6z> a owl:Class ;
    rdfs:label "Local Governmental Representative" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RwOMSIjx2yx6LoJwtVc8Yt> ],
        <R85Datx36zz4sBBoEYxCByw> ;
    skos:altLabel "Community Leader",
        "Local Authority Representative",
        "Local Official",
        "Town Government Officer" ;
    skos:definition "A Local Governmental Representative is an elected or appointed official who serves in a governmental capacity at the municipal or community level. This individual is responsible for making decisions, implementing policies, and representing the interests of their constituents within a specific local jurisdiction, such as a city, town, county, or school district." ;
    skos:prefLabel "Municipal Representative" .

<RBgYGQPsuNuXWjQrcusV25t> a owl:ObjectProperty ;
    rdfs:label "oasis:deonticRule" .

<RBiZ9niDrCJlY0UyvdZ1v3m> a owl:Class ;
    rdfs:label "Classes of Goods and Services" ;
