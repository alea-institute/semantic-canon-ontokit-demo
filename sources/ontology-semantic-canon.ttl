    rdfs:subClassOf <RJEhNjPDXIeJRMwifVraDk> ;
    skos:altLabel "Einseitiger Irrtum im Vertrag"@de-de,
        "Unilateral Mistake in Contract"@en-gb,
        "Error unilateral en el contrato"@es-es,
