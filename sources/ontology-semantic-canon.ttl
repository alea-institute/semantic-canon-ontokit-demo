<RB3kSReNB4kis0pHfnZeHCa> a owl:Class ;
    rdfs:label "Argument" ;
    rdfs:subClassOf <RDQC6BrYjcS3V0gZcYzqc8O>,
        <RDmbgHQXJxEvx3QYfR6qWAn> ;
    skos:definition "Argument is a structured set of claims and reasons offered to support a conclusion through rational inference. In Catholic contexts, an argument may draw on philosophy, theology, morality, ethics, or empirical facts to justify belief, interpretation, or action."^^xsd:string ;
    skos:example "Argument Against Intrinsically Evil Acts"^^xsd:string,
        "Argument From Divine Revelation"^^xsd:string,
        "Argument From First Cause"^^xsd:string,
        "Argument From Human Flourishing"^^xsd:string,
        "Pauline Argument From Scripture"^^xsd:string .

<RB3vkqIG4fsRfjNZyWvQk6U> a owl:Class ;
    rdfs:label "Spiritual Works of Mercy" ;
    rdfs:subClassOf <R7P2d6Z7m3cNjxzfx9zPjhe> ;
    skos:altLabel "Merciful Care of the Soul"^^xsd:string,
        "Spiritual Acts of Mercy"^^xsd:string,
        "Works of Spiritual Charity"^^xsd:string ;
    skos:definition "Spiritual Works of Mercy are acts of charity that attend to the spiritual and moral needs of others. Spiritual Works of Mercy express love of neighbor by guiding, consoling, correcting, and praying for others in a manner ordered to truth and charity."^^xsd:string .

<RB6mSyWb19Cp3OSqsOqM4dr> a owl:Class ;
