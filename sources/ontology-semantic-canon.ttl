    dc:source "Fed. R. Evid. 613" ;
    rdfs:subClassOf <RBMlUtTtbQUQxrZrkeF8Fpm> ;
    skos:altLabel "Inadmissible Impeachment Objection",
        "Objection to Unauthorized Witness Attack",
        "Unlawful Discrediting Objection" ;
    skos:definition "An Improper Impeachment Objection is raised when a party in a legal proceeding believes that the opposing counsel is attempting to discredit a witness in a manner that is not allowed by the rules of evidence. This objection aims to protect the integrity of the witness's testimony and ensure that any challenge to their credibility is conducted appropriately." ;
    skos:prefLabel "Collateral Issue Objection" .

