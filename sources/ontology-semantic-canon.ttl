            owl:someValuesFrom <RClFNLrDawcQ4HuRbzm6JJI> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Promisee" ;
    skos:definition "An obligee is the party in a legal contract or relationship who is entitled to receive a specified performance or payment from another party, known as the obligor. In various contexts such as contract law, bonds, or loans, the obligee holds the right to claim the fulfillment of the obligation set forth in the agreement." ;
    skos:prefLabel "Covenantee" .

