        "譲受人"@ja-jp,
        "Cessionário"@pt-br,
        "受让人"@zh-cn ;
    skos:definition "An assignee is a person, company or entity who receives the transfer of property, title or rights from a contract. The assignee receives the transfer from the assignor." ;
    skos:hiddenLabel "ASGE" .

<RBHMgwmtjROHhYECWGFYTQU> a owl:Class ;
