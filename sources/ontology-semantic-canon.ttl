<RDS4ZvoTuxk7hu7zuyJRyoR> a owl:Class ;
    rdfs:label "Beatitudes" ;
    rdfs:subClassOf <RB00C43eWpZ3eGhqNnziJXg> ;
    skos:definition "Beatitudes means the solemn blessings proclaimed by Jesus Christ that describe the dispositions and promises of those who belong to the Kingdom of God. Beatitudes invert worldly values and reveal the path to true happiness through humility, mercy, purity, and fidelity amid suffering."^^xsd:string ;
    skos:example "Christian theology understands the Beatitudes as the heart of Christ’s moral teaching and a portrait of holiness."^^xsd:string,
        "The Gospel of Matthew records Jesus proclaiming the Beatitudes at the beginning of the sermon on the mount."^^xsd:string ;
    skos:prefLabel "Beatific Sayings"^^xsd:string .

