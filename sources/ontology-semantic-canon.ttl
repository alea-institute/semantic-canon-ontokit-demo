    rdfs:subClassOf <RBSftPgkpTWJ4IzuvXyLBVG> ;
    skos:altLabel "Countrywide Segment" ;
    skos:definition "The national segment refers to a portion of the market that is focused on consumers and businesses within the entire geographical boundaries of a specific country. This segment encompasses products, services, and marketing strategies that are tailored to meet the needs and preferences of the national population, regardless of regional differences." ;
    skos:prefLabel "Nationwide Market Segment" .

