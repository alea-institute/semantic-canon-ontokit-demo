<R7tbcdDPcsMNHgeJlYsftWL> a owl:Class ;
    rdfs:label "Commandment 06: You shall not commit adultery." ;
    rdfs:subClassOf <RDJPdWE32ZF0O3QeYJi5uc> ;
    skos:altLabel "Adultery Prohibition Commandment"^^xsd:string,
        "Marital Fidelity Commandment"^^xsd:string,
        "Sexual Purity Commandment"^^xsd:string ;
    skos:definition "You Shall Not Commit Adultery represents the sixth commandment prohibiting sexual relations outside the marriage covenant, protecting marital fidelity and family integrity. This decree establishes exclusive sexual union between husband and wife as sacred boundary."^^xsd:string ;
    skos:example "Confessors have guided penitents to examine how this commandment applies to dating relationships and premarital sexual activity."^^xsd:string,
        "Moral theologians have extended this commandment beyond physical adultery to include emotional affairs and inappropriate intimacy with non-spouses."^^xsd:string,
        "Priests have connected this commandment to broader teachings about covenant loyalty, trust, and exclusive commitment in relationships."^^xsd:string ;
    skos:note """Prohibition Statement (Exodus 20:14)
Deuteronomic Restatement (Deuteronomy 5:18)
Death Penalty for Adultery (Leviticus 20:10, Deuteronomy 22:22)
Betrothed Virgin Protection (Deuteronomy 22:23-27)
Jesus's Lust Intensification (Matthew 5:27-28)
Woman Caught in Adultery (John 8:1-11)
Prophetic Adultery Metaphor for Idolatry (Hosea 1-3)
Paul's Sexual Immorality Warnings (1 Corinthians 6:9-20)"""^^xsd:string ;
    skos:prefLabel "Sixth Commandment"^^xsd:string .

