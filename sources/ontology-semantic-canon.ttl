    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDiVfYrNwYdmawA7b4v9WKg> ],
        <RFXc2NtinmfJhHDBnbVgVN>,
        <RqItoKI3H03BkiGTjwRYG3> ;
    skos:altLabel "Bestellung eines Insolvenzverwalters"@de-de,
        "Receivership Appointments"@en-gb,
        "Nombramientos de administrador judicial"@es-es,
        "Nombramientos de síndico"@es-mx,
        "Nomination d'un administrateur judiciaire"@fr-fr,
        "מינויי מקבל פקידות"@he-il,
        "מינויי מקבלי הנהלה"@he-il,
        "रिसीवरशिप नियुक्तियाँ"@hi-in,
        "受益者管理人の任命"@ja-jp,
        "Nomeação de administrador judicial"@pt-br,
        "接管任命"@zh-cn ;
    skos:definition "The concept of \"Receivership Appointments\" refers to the legal process of appointing a third-party receiver to manage and oversee the assets and affairs of a company or individual in financial distress, as a provisional remedy or appointment." .

<R981K5l1Ju5uHj4jVRSUCJQ> a owl:Class ;
    rdfs:label "Failure to Provide Employment Records Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCTnebwmInNgHYwFLgAOf0z> ],
        <R9UYGSnWQz2MvNsWUofGb6J> ;
    skos:altLabel "Anspruch auf Vorlage von Beschäftigungsunterlagen"@de-de,
        "Failure to Provide Employment Records Claim"@en-gb,
        "Reclamación por falta de entrega de registros de empleo"@es-es,
        "Reclamo por falta de entrega de registros de empleo"@es-mx,
        "Réclamation pour non-fourniture de dossiers d'emploi"@fr-fr,
        "תביעה על כשל בספק רשומות עסקיות של עובדים"@he-il,
        "रोजगार रिकॉर्ड प्रदान न करने का दावा फेल"@hi-in,
        "雇用記録提供不履行請求"@ja-jp,
        "Reivindicação de Falha em Fornecer Registros de Emprego"@pt-br,
        "未能提供就业记录索赔"@zh-cn ;
    skos:definition "A failure to provide employment records claim is a legal action initiated by an employee against their employer for not furnishing access to, or copies of, certain employment documents as required by law. These documents may include payroll records, timekeeping data, or personnel files, and the claim typically arises when an employer either refuses or neglects to provide the requested information within the specified time frame mandated by applicable laws." .

<R98E2kVwPFwTnP6oxYUt9HR> a owl:Class ;
    rdfs:label "Limited Liability Company" ;
    dc:identifier "ENTITY-LLC" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Ru4xTEglN22D9fpGWBZpgs> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7oBWHStfmqTLn2MypkW3Pj> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDdgYa5ZbqVnS9aGrOwQu5h> ],
        <R7oBWHStfmqTLn2MypkW3Pj> ;
    skos:altLabel "Limited Liability Company",
        "Gesellschaft mit beschränkter Haftung"@de-de,
        "Société à responsabilité limitée"@fr-fr,
        "有限責任会社"@ja-jp,
        "Empresa de responsabilidade limitada"@pt-br,
        "有限责任公司"@zh-cn ;
    skos:definition "A limited liability company (LLC) is a corporate structure in the United States whereby the owners are not personally liable for the company's debts or liabilities. Limited liability companies are hybrid entities that combine the characteristics of a corporation with those of a partnership or sole proprietorship." ;
    skos:prefLabel "LLC" .

<R98LwwW6Zozu5EHwFgpns7> a owl:Class ;
    rdfs:label "Fish" ;
    rdfs:subClassOf <R8sd4v04cEXnzbttN2gUEpV>,
        <RDfwCFFw23Fb7WhqmrYLBqS> ;
    skos:definition "Fish are aquatic vertebrate animals that are characterized by their gills, fins, and typically a streamlined body, allowing them to live and move efficiently in water. They inhabit both freshwater and ocean environments." .

<R996WtCH3h9VroTEbPc4hpS> a owl:Class ;
    rdfs:label "Suspension" ;
    rdfs:subClassOf <R6DLuG3VglXIci9EJ3MwAK> ;
    skos:definition "Suspension refers to the temporary removal of a person or entity from a position, privilege, or right as a disciplinary measure or precaution. This can occur in various contexts, including education, employment, and government contracts, often pending further investigation or resolution of an issue." .

<R9F95mfTrWVKPo393htsyq1> a owl:Class ;
    rdfs:label "Executive, Legislative, and Other General Government Support Industry" ;
    dc:identifier "PUB-EXEC" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=921> ;
    rdfs:subClassOf <RC2P0YZS5Ku67wmSwN4OxWs> ;
    skos:altLabel "Executive and Legislative Bodies",
        "Exekutive und Legislative Körperschaften Branche"@de-de,
        "Executive and Legislative Bodies Industry"@en-gb,
        "Industria de los Cuerpos Ejecutivo y Legislativo"@es-es,
        "Industria de los Cuerpos Ejecutivo y Legislativo"@es-mx,
        "Industrie des organes exécutifs et législatifs"@fr-fr,
        "תעשיית גופי הממשל והתקדמות"@he-il,
        "कार्यकारी और विधायी निकाय उद्योग"@hi-in,
        "行政・立法機関業界"@ja-jp,
        "Indústria de órgãos executivos e legislativos"@pt-br,
        "行政和立法机构行业"@zh-cn ;
    skos:definition "The Executive, Legislative, and Other General Government Support subsector groups offices of government executives, legislative bodies, public finance, and general government support." ;
    skos:hiddenLabel "EXEC" .

<R9GrBYx6nWx1AZRaEDNMBaO> a owl:Class ;
    rdfs:label "Dead" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8ks4EFK3G3kUjRP4Fu5gtK> ],
        <RtHkyQ5lSxRaJ9oaSOWbkx> ;
    skos:altLabel "Tot"@de-de,
        "Mort"@fr-fr,
        "死亡した"@ja-jp,
        "Morto"@pt-br,
        "死亡"@zh-cn ;
    skos:definition "Dead refers to the state of an individual who has ceased to live and has no vital signs or brain activity." ;
    skos:prefLabel "Deceased" .

<R9HlxYOQb4WGC3goxZENvJs> a owl:Class ;
    rdfs:label "Diplomat" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8gPVPSW76auMkhwuIg1CBc> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDeH9slXtJOmFPiZhIzsDUg> ],
        <RD0eI0kZbrRDzdWWH6WoOGN> ;
    skos:definition "A diplomat is an individual appointed by a state to conduct negotiations, represent interests, and maintain diplomatic relations with other states or international organizations. Diplomats often enjoy certain privileges and immunities under international law, which allow them to perform their duties more effectively while residing in a foreign country" .

<R9ICeOg6A95qwBlvRoew3Br> a owl:Class ;
    rdfs:label "Moral Rights" ;
    rdfs:subClassOf <R8O3PoolmgHAy2hrZsguhqy> ;
    skos:definition "Moral Rights in copyright law refer to the rights of creators to protect the personal and reputational value of their works. These rights typically include the right to claim authorship, the right to prevent distortion or mutilation, and the right to withdraw or alter the work." ;
    skos:prefLabel "Droit Moral" .

<R9Idcfy3k3uRwC4XohbcMAg> a owl:Class ;
    rdfs:label "Evidentiary Objection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7PPywVywQYcT4GloerUeuh> ],
        <RrwKWn7PQLCSscgstTNLqf> ;
    skos:altLabel "Admissibility challenge" ;
    skos:definition "An evidentiary objection is a formal protest raised by a party in a legal proceeding, challenging the admissibility of specific evidence. Common grounds for such objections include lack of foundation, hearsay, irrelevance, and prejudicial nature." ;
    skos:prefLabel "Evidence Challenge" .

<R9NZCdiuP6ppUF91dFlyMF5> a owl:Class ;
    rdfs:label "Payment from Employer-Sponsored Retirement Account" ;
    rdfs:subClassOf <RCrOThiq2BioEVHnqev8KdQ> .

<R9OgtSm35ykpUSi7mgiCW> a owl:ObjectProperty ;
    rdfs:label "folio:authenticated" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:altLabel "attested",
        "authenticated",
        "folio:ratified",
        "ratified" ;
    skos:definition "\"Authenticated\" in a legal setting refers to the process of verifying the genuineness and validity of a document or signature, typically by an authorized person or entity. This verification establishes the document's legitimacy, ensuring it has not been altered and is what it purports to be, often a prerequisite for legal recognition and enforceability." ;
    skos:prefLabel "folio:attested" .

<R9PTSzG1blsjX3xn1PTSdIk> a owl:Class ;
    rdfs:label "Boat" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8XiN2fWrOwJ5UIfnG2XJH> ],
        <RBIVr7LJ5wZmSxEONjW4YvL> ;
    skos:altLabel "Dinghy" ;
    skos:definition "A Boat is a small to medium-sized watercraft designed for travel on water, commonly used for personal recreation, fishing, or short-distance transportation. Boats vary in size and type, including motorboats, sailboats, and rowboats, each serving specific purposes and environments." ;
    skos:example "Motorboat" ;
    skos:prefLabel "Small Vessel" .

<R9Ssnolzs98skM2RcQkIjkY> a owl:Class ;
    rdfs:label "Governmental Entity" ;
    dc:identifier "ENTITY-GOVT" ;
    dc:source <https://uscode.house.gov/view.xhtml?path=/prelim@title11/chapter1&edition=prelim#:~:text=(27)%20The%20term%20%22governmental,a%20Commonwealth%2C%20a%20District%2C%20a> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBQGborh1CfXanGZipDL0Qo> ],
        <R7oBWHStfmqTLn2MypkW3Pj> ;
    skos:altLabel "Governmental Entity",
        "Regierungsbehörde"@de-de,
        "Entité gouvernementale"@fr-fr,
        "政府機関"@ja-jp,
        "Entidade governamental"@pt-br,
        "政府实体"@zh-cn ;
    skos:definition "Any government or any governmental agency, semi-governmental or judicial entity or authority (including, without limitation, any stock exchange or any self-regulatory organization established under statute)." ;
    skos:hiddenLabel "GOVT" ;
    skos:prefLabel "Governmental Unit" .

<R9VkHQ2TY9sCeZb1IcmHDLc> a owl:Class ;
    rdfs:label "Entity Formation Document" ;
    rdfs:subClassOf <RCBtDyjzrPbQyhvU5V64Irn> ;
    skos:definition "An Entity Formation Document is a legal document filed with a governmental authority, such as a state's Secretary of State, to officially establish a legal entity, such as a limited liability company (LLC), corporation, or limited partnership. It typically includes essential details like the entity's name, purpose, registered agent, and the names of its initial members, directors, or partners." .

<R9WUFEb3p0Ep21EQ8yBptxD> a owl:Class ;
    rdfs:label "Probation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RhBvOCNsTuHs1L1cRSwWuL> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RFKZXX9MKTuXedgtPWeU3i> ],
        <R0tJKDoGSixec7FgGKnAAl> ;
    skos:altLabel "Bewährung und Bewährungsaufsicht"@de-de,
        "Probation and Supervised Release"@en-gb,
        "Libertad condicional y libertad vigilada"@es-es,
        "Libertad condicional y libertad supervisada"@es-mx,
        "Libération conditionnelle et mise en liberté surveillée"@fr-fr,
        "שחרור תנאי ושחרור תחת פיקוח"@he-il,
        "परख और निगरानी वाली रिहाई"@hi-in,
        "保護観察及び執行猶予"@ja-jp,
        "Liberação Condicional e Supervisão"@pt-br,
        "缓刑和监管释放"@zh-cn ;
    skos:definition "Probation is a period of supervision over an offender in lieu of incarceration." .

<R9WYIrIeT3fTYMxfW0xZldF> a owl:Class ;
    rdfs:label "Holding Company" ;
    dc:source <https://en.wikipedia.org/wiki/Holding_company> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rt2AOEEvMbhpF3f4NlujBU> ],
        <RCua1MtzwNcjfYov8VFcoV3> ;
    skos:altLabel "Holding Corporation",
        "Holding Entity" ;
    skos:definition "A Holding Company is a business entity created to own and control the shares of other companies, thereby allowing it to exert influence or outright control over the management and policies of those companies. It does not typically engage in producing goods or services itself but generates revenue through dividends, interest, and capital gains from its subsidiaries." ;
    skos:editorialNote "Express parentage of Parent Company and Subsidiary Company through the folio:hasSubsidiary property." ;
    skos:example "Alphabet Inc.: The parent holding company of Google and various other subsidiaries in technology and research sectors.",
        "Berkshire Hathaway Inc.: A well-known holding company owning shares in various industries, including insurance, utilities, and manufacturing.",
        "General Electric Company: Historically acted as a holding company with diverse industrial subsidiaries, although it has refocused in recent years.",
        "Johnson & Johnson: A holding company with numerous subsidiaries focused on pharmaceuticals, medical devices, and consumer health products.",
        "SoftBank Group Corp.: A Japanese holding company that invests in and manages a diverse array of businesses worldwide." ;
    skos:prefLabel "Parent Company" .

<R9aAuY31Z3tgpR7hUAqTEmd> a owl:Class ;
    rdfs:label "Traumatic Brain Injury" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_18> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH>,
        <REFNhmFYG6yk3W0RPLFV6g> ;
    skos:altLabel "TBI" ;
    skos:definition "Traumatic brain injury (TBI) is a disruption in normal brain function caused by an external mechanical force, such as a blow or jolt to the head. TBI can result in temporary or permanent cognitive, physical, and psychological impairments, requiring immediate medical attention and often long-term rehabilitation." .

<R9aY60yvdEVudPss03CM1LF> a owl:Class ;
    rdfs:label "Formational Authority" ;
    rdfs:subClassOf <R8L6V5AA4I5wcDrZtJjGLRb> ;
    skos:altLabel "Authority of Formation"^^xsd:string,
        "Developmental Authority"^^xsd:string,
        "Formative Leadership"^^xsd:string,
        "Guidance Authority"^^xsd:string,
        "Instructional Authority"^^xsd:string ;
    skos:definition "Formational Authority is the moral authority exercised by a person entrusted with guiding another’s intellectual, moral, professional, or spiritual development. Formational Authority arises from recognized competence and voluntary submission, and it aims at growth in truth, virtue, and freedom."^^xsd:string ;
    skos:example "A coach corrects habits to improve discipline and character."^^xsd:string,
        "A mentor guides a younger colleague in professional judgment and ethics."^^xsd:string,
        "A spiritual director helps a directee discern God’s will through prayer and reflection."^^xsd:string,
        "A teacher evaluates a student’s work to promote intellectual growth."^^xsd:string .

<R9abezigCOxFsNH1QItgXgB> a owl:Class ;
    rdfs:label "Proposition" ;
    rdfs:subClassOf <RB3kSReNB4kis0pHfnZeHCa> ;
    skos:altLabel "Assertion"^^xsd:string,
        "Claim"^^xsd:string ;
    skos:definition "Proposition is a declarative statement that asserts something as true or false and can function as a premise or conclusion within an argument. In Catholic usage, a proposition often expresses a philosophical, theological, moral, or ethical claim subject to evaluation, assent, or rejection."^^xsd:string ;
    skos:example "Christ Is Truly Present In The Eucharist"^^xsd:string,
        "Every Contingent Being Requires A Cause"^^xsd:string,
        "God Is One In Essence And Three In Persons"^^xsd:string ;
    skos:prefLabel "Statement"^^xsd:string .

<R9ae7DEoQrCeEfzwnZbEK6X> a owl:Class ;
    rdfs:label "Fact Witness Interviews" ;
    rdfs:subClassOf <R83QdGrsILzbGVfk0bqF1kw> ;
    skos:altLabel "Befragung von Zeugen"@de-de,
        "Fact Witness Interviews"@en-gb,
        "Entrevistas a testigos de los hechos"@es-es,
        "Entrevistas a testigos de los hechos"@es-mx,
        "Entretiens avec des témoins de faits"@fr-fr,
        "ראיות עד מציגות"@he-il,
        "वास्तविक साक्षी साक्षात्कार"@hi-in,
        "事実証人へのインタビュー"@ja-jp,
        "Entrevistas com testemunhas de fatos"@pt-br,
        "事实证人采访"@zh-cn ;
    skos:definition "Fact Witness Interviews are conversations between an interviewer and a witness who has personal knowledge of the facts relevant to a legal case, and can be either friendly, unfriendly, or neutral in nature." .

<R9ax95LqcYtqPK458D1g7aP> a owl:Class ;
    rdfs:label "Animals" ;
    rdfs:subClassOf <RDS8DPtuFReTFfJ5nGCczD5> ;
    skos:definition "Domesticated animals that are bought, sold, or traded as commercial products. This category includes pets, livestock, and other animals considered personal property within the context of commercial transactions." .

<R9cd2WZCsfwJiHkhJ4VKbVM> a owl:Class ;
    rdfs:label "Class Action Certification Event" ;
    rdfs:subClassOf <R73Uo5x4VyfiOXt6i4R256t> ;
    skos:altLabel "Klassenaktionszertifizierungsereignis"@de-de,
        "Class Action Certification Event"@en-gb,
        "Evento de Certificación de Acción Colectiva"@es-es,
        "Evento de Certificación de Acción Colectiva"@es-mx,
        "Événement de certification d'action collective"@fr-fr,
        "אירוע אישור פעולת מחאה מחולקת"@he-il,
        "क्लास एक्शन प्रमाणीकरण घटना"@hi-in,
        "集団訴訟認定イベント"@ja-jp,
        "Evento de certificação de ação coletiva"@pt-br,
        "集体诉讼认证事件"@zh-cn ;
    skos:definition "A Class Action Certification Event is a specific event within the context of litigation where a court determines whether a lawsuit can proceed as a class action." .

<R9ce0e5pb4hAULGEtqlBCV8> a owl:Class ;
    rdfs:label "Financial Obligations" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8428LJEfCIiJBkESQPpEhQ> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8VN5tK4TtD0GqDw2NCbaLr> ],
        <RhBgnef56iLBXYfPqWQE41> ;
    skos:definition "Financial Obligations (Financial Liabilities) refer to any monetary commitments or liabilities an individual or entity is responsible for, such as paying off debts, fulfilling contract terms, or covering recurring expenses. These obligations can be short-term or long-term and failing to meet them could result in financial penalties or legal consequences" ;
    skos:prefLabel "Financial Liabilities" .

<R9fKvjVlII2PEtadGEDimB9> a owl:Class ;
    rdfs:label "Artistic Work" ;
    rdfs:subClassOf <RVaHiNBU68DENmeHicnzro> ;
    skos:altLabel "Artistic Composition",
        "Fine Art",
        "Visual Art" ;
    skos:definition "An Artistic Work is a creation that expresses artistic or aesthetic value through visual or audio mediums, protected under copyright law. This includes paintings, sculptures, photographs, and other visual arts, granting the creator exclusive rights to reproduce, distribute, and display their work." .

<R9fslqJlcJW7E5ey4lzHMF5> a owl:Class ;
    rdfs:label "Partnership Claim" ;
    rdfs:subClassOf <R9JkfZIjkVSa5ud1tJ14w3i> ;
    skos:altLabel "Partnerschaftsanspruch"@de-de,
        "Réclamation de partenariat"@fr-fr,
        "パートナーシップ請求"@ja-jp,
        "Reivindicação de parceria"@pt-br,
        "合伙索赔"@zh-cn ;
    skos:definition "A Partnership Claim is a legal action brought by one or more partners against the partnership or other partners for breach of partnership agreement or other wrongdoing." .

<R9hiZkJdEEmVQCWrwvpHIa9> a owl:Class ;
    rdfs:label "Pregnancy Status" ;
    rdfs:subClassOf <R7sHH7RvjZ6aZS7ZExDpYmR> ;
    skos:altLabel "Schwangerschaftsstatus"@de-de,
        "Statut de grossesse"@fr-fr,
        "妊娠状態"@ja-jp,
        "Status de gravidez"@pt-br,
        "怀孕状态"@zh-cn ;
    skos:definition "Pregnancy status refers to the condition of a woman being pregnant, which is the period during which she carries a developing fetus within her uterus. In many jurisdictions, including the United States, discrimination based on pregnancy status is unlawful in various contexts, such as employment, housing, and public services." .

<R9jhu7lDqKrv2ybkSS5mgxV> a owl:Class ;
    rdfs:label "Penance and Reconciliation" ;
    rdfs:subClassOf <Rmh26VkWP4ZFcOPX4XE3oA> ;
    skos:altLabel "Sacrament of Forgiveness"^^xsd:string ;
    skos:definition "Penance and Reconciliation is the sacrament by which the faithful receive God’s mercy through the forgiveness of sins committed after baptism. Through confession, absolution, and satisfaction, the penitent is reconciled with God and the Church."^^xsd:string ;
    skos:example "Penance and reconciliation restores the sinner to communion with God."^^xsd:string,
        "The Church encourages frequent reception of penance and reconciliation."^^xsd:string,
        "This sacrament strengthens the penitent to resist future sin."^^xsd:string ;
    skos:prefLabel "Confession"^^xsd:string .

<R9jx1uLGTrB6S8hwGcWVmlT> a owl:Class ;
