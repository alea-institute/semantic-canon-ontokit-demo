    skos:altLabel "Partnerschaft"@de-de,
        "Unlimited Partnership"@en-gb,
        "Partenariat"@fr-fr,
        "パートナーシップ"@ja-jp,
        "Parceria"@pt-br,
        "合作关系"@zh-cn ;
    skos:definition "A partnership is a type of legal entity where two or more individuals or entities come together to carry out a business venture, sharing profits and losses." ;
    skos:prefLabel "Unlimited Partnership" .

<RC5RK4Beoxturh6V8lBfWfZ> a owl:Class ;
    rdfs:label "Familial Role" ;
    dc:source "From LIST: Legal Issues Taxonomy — https://taxonomy.legal/" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RPxLPeiWGvmkHvdX9issjM> ],
        <RBz2aCAIZMshK7S6EKsCHmX>,
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:definition "A Familial Role defines an individual's position or relationship within a family structure based on genetic ties, marriage, or legal definitions. Examples include roles such as parent, child, grandparent, sibling, or spouse, each carrying specific relational dynamics, responsibilities, and societal expectations." .

<RC8JmK2y8Na9Itkk0MCtMS4> a owl:Class ;
    rdfs:label "Military Service" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9e1bYJPmM4lWEdGvWIxf6t> ],
        <RCvV18Mbbb9FYFXbHt1inuL> ;
    skos:definition "Military Service refers to the act of serving in the armed forces of a country, either voluntarily or through conscription. Military service involves a range of duties, from active combat to support roles, and is governed by a distinct set of laws and regulations separate from civilian law." .

<RCBYQBHCTDnnpanK0HJ0I7w> a owl:Class ;
    rdfs:label "Invertebrate Animal" ;
    rdfs:subClassOf <R79xLpY9gRRitoFR3T667If> ;
    skos:altLabel "Invertebrate",
        "Non-vertebrate Animal" ;
    skos:definition "An Invertebrate Animal is a member of the animal kingdom that lacks a backbone or spinal column. Invertebrates encompass a vast array of species including insects, mollusks, crustaceans, arachnids, and echinoderms, and they constitute the majority of animal diversity on Earth." .

<RCEE791AF6ea7152aafAA688> a owl:Class ;
    rdfs:label "Barbados" ;
    dc:identifier "NAM-BB" ;
    rdfs:subClassOf <RE001ab376fa25C94f1244be> ;
    skos:hiddenLabel "BB" ;
    skos:prefLabel "Barbados" .

<RCZQdKH230Tk1EJrtOxbvqm> a owl:Class ;
    rdfs:label "Massachusetts Trial Court" ;
    rdfs:subClassOf <R5403b7ED64ea54Ee25297c2> ;
    skos:definition "The Massachusetts Trial Court is a court system within the Massachusetts State Courts that handles cases related to housing, district, probate and family, juvenile, and land court matters, as well as the Boston Municipal Court and the Massachusetts Superior Court." .

<RCnCHWsREqpfQAAfaN2lRPV> a owl:Class ;
    rdfs:label "Personality and Impulse-Control Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1>,
        <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_08> ;
    rdfs:subClassOf <RN3TubQIlusDFnPgrNAk8D> ;
    skos:altLabel "Impulse-Control Disorders" ;
    skos:definition "These disorders are characterized by enduring, inflexible, maladaptive, and pervasive patterns of behavior. Onset typically occurs in adolescence or young adulthood. Symptoms and signs may include, but are not limited to, patterns of distrust, suspiciousness, and odd beliefs; social detachment, discomfort, or avoidance; hypersensitivity to negative evaluation; an excessive need to be taken care of; difficulty making independent decisions; a preoccupation with orderliness, perfectionism, and control; and inappropriate, intense, impulsive anger and behavioral expression grossly out of proportion to any external provocation or psychosocial stressors" ;
    skos:prefLabel "Personality Disorders" .

<RD22PX6hiObnrRSM3c6bXdR> a owl:Class ;
