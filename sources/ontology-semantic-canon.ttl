<RCBLX9kRgt1l471LVzI5N7P> a owl:Class ;
    rdfs:label "The Flood and Rainbow Sign"^^xsd:string ;
    rdfs:subClassOf <ROgocFufRBHZKkFfPDYyYh> ;
    skos:altLabel "Deluge and Rainbow Covenant"^^xsd:string,
        "Great Flood and Covenant Sign"^^xsd:string ;
    skos:definition "The Flood and Rainbow Sign encompasses the catastrophic deluge that God sent to cleanse the earth of wickedness and the subsequent rainbow that God established as the visible sign of the covenant promise. This dual event marks both divine judgment upon human corruption and God's merciful commitment never to destroy the earth by flood again."^^xsd:string ;
    skos:example "Baptismal theology connects the flood and rainbow sign to the waters of baptism that both destroy sin and bring new life."^^xsd:string,
        "Catholic hymnody frequently references the flood and rainbow sign to illustrate themes of divine judgment followed by mercy."^^xsd:string,
        "Children's catechesis uses the flood and rainbow sign to teach about consequences of sin and God's faithful promises."^^xsd:string .

<RCBWoYGa02bl7lhpJBBTzMV> a owl:Class ;
