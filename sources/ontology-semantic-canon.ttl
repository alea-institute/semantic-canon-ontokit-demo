        "Basque"@fr-fr,
        "バスク語"@ja-jp,
        "Basco"@pt-br,
        "巴斯克语"@zh-cn ;
    skos:definition "Basque is a written or spoken structured system of communication that consists of grammar and vocabulary, and is a member of the Language top-level class." .

<R8tnT9l9MwOJnd3la39bLMZ> a owl:Class ;
    rdfs:label "Provider Identifier" ;
    rdfs:subClassOf <R8EoZh39tWmXCkmP2Xzjl6E>,
        <RB6mSyWb19Cp3OSqsOqM4dr> ;
    skos:definition "Identifier (e.g., IRIs, UUIDs, GUIDs) of the ecclesial provider (e.g., parish, diocese, university, charitable institution) within the systems of Catholic stakeholders (e.g., lay individuals, clerics, ecclesiastical officials, parishes, dioceses or eparchies, episcopal bodies, and the Holy See)." .

<R8u0sYk2fhI7BjgIEpXsw1H> a owl:Class ;
    rdfs:label "Commandment 09: You shall not covet your neighbor’s wife." ;
    rdfs:subClassOf <RDJPdWE32ZF0O3QeYJi5uc> ;
    skos:altLabel "Heart Purity Commandment"^^xsd:string,
        "Interior Chastity Commandment"^^xsd:string,
        "Sexual Desire Commandment"^^xsd:string,
        "Spousal Covetousness Commandment"^^xsd:string ;
    skos:definition "You Shall Not Covet Your Neighbor's Wife represents the ninth commandment's prohibiting lustful desire for another man's wife, addressing interior dispositions rather than external actions. This decree penetrates beyond behavior to regulate heart attitudes, forbidding envious longing that would possess what belongs to another's marriage covenant and establishing thought-life purity as moral requirement."^^xsd:string ;
    skos:example "Confessors have explained how this commandment condemned lustful thoughts even when no external adultery occurred."^^xsd:string,
        "Spiritual directors have used this commandment to help directees examine fantasy life."^^xsd:string,
        "Youth ministers have taught this commandment as call to purity in dating relationships and social media interactions."^^xsd:string ;
    skos:note """Prohibition Statement (Exodus 20:17)
Deuteronomic Restatement (Deuteronomy 5:21)
David and Bathsheba Narrative (2 Samuel 11:2-4)
Job's Eye Covenant (Job 31:1)
Jesus's Lust Teaching (Matthew 5:28)
Paul's Covetousness Recognition (Romans 7:7-8)
James's Desire and Sin Process (James 1:14-15)"""^^xsd:string ;
    skos:prefLabel "Ninth Commandment"^^xsd:string .

<R8u4eipKZkVmT9acNJCHM1U> a owl:Class ;
    rdfs:label "Parkinson's Disease" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_06> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH>,
        <REFNhmFYG6yk3W0RPLFV6g> ;
    skos:altLabel "Neurodegenerative Motor Disorder",
        "Paralysis Agitans" ;
    skos:definition "Parkinson's disease is a progressive neurodegenerative disorder characterized by the loss of dopamine-producing neurons in the brain, leading to motor symptoms such as tremors, rigidity, bradykinesia (slowness of movement), and postural instability. It also includes non-motor symptoms like cognitive impairment, mood disorders, and autonomic dysfunction, requiring comprehensive medical and supportive care." ;
    skos:prefLabel "Parkinsonian Syndrome" .

<R8u8ZnC5K9DNlRCcMovmIML> a owl:Class ;
    rdfs:label "Pennsylvania Court of Common Pleas -  Lancaster County" ;
    rdfs:subClassOf <Rzg8mCIjXsMzEVnQwCTKIi> ;
    skos:definition "The Pennsylvania Court of Common Pleas - Lancaster County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering civil and criminal proceedings at the county level in Pennsylvania." .

<R8uAJcyShMr3VPNjqJL9vHp> a owl:Class ;
    rdfs:label "Native Village of Chitina" ;
    rdfs:subClassOf <R7N6wsHsNyqgPE4xFK8wKJx> .

<R8uBWMWwqnnRqkH4BibwCDr> a owl:Class ;
    rdfs:label "Fee Simple Determinable Interest" ;
    rdfs:subClassOf <R7y4MfRVjPqdQsxJpyGbD67> ;
    skos:definition "A fee simple determinable interest is a type of freehold estate in real property that automatically ends and reverts to the grantor upon the occurrence or non-occurrence of a specified event or condition. This estate is characterized by a possibility of reverter, where the original owner (or their heirs) has the right to reclaim ownership if the condition is breached." .

<R8uBsKVQDX9xAi6Pltit8dF> a owl:Class ;
