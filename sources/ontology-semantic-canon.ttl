    rdfs:subClassOf <RD1C77b5D46361ED0cbA4f20> ;
    skos:definition "This industry group comprises establishments primarily engaged in putting capital at risk in the process of underwriting securities issues or in making markets for securities and commodities; and those acting as agents and/or brokers between buyers and sellers of securities and commodities, usually charging a commission." .

<Fr7Djl5US9i-GPKMBW4K7g> a owl:Class ;
