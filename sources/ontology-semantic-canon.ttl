<RBXVQ8cnzCJi3hsyglfDHKz> a owl:Class ;
    rdfs:label "Conflict of Interest Risk" ;
    rdfs:isDefinedBy <https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCi7RfKkkmw6lGMEMbhezRG> ],
        <RxTxaN981tLTsN82qPBcp> ;
    skos:definition "Conflict of Interest Risk refers to the potential for ethical, legal, or reputational issues arising when an individual's personal interests, relationships, or obligations compromise their ability to make impartial decisions on behalf of their organization or role. These conflicts can lead to biased decision-making, decreased trust, or even regulatory penalties, ultimately impacting the organization's integrity and performance" .

<RBXVU4vw8lOn8Q1MVwyiBuM> a owl:Class ;
    rdfs:label "Runaway" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf <RCqBiJAwLT5iG2nvk12tNKW> ;
    skos:altLabel "Ausreißer"@de-de,
        "Runaway"@en-gb,
        "Fugitivo"@es-es,
        "Fugitivo"@es-mx,
        "Fugueur"@fr-fr,
        "ברחן"@he-il,
        "भगोड़ा"@hi-in,
        "家出少年"@ja-jp,
        "Fugitivo"@pt-br,
        "逃跑者"@zh-cn ;
    skos:definition "A person under 18 years of age who has left home without permission of his/her parent(s) or legal guardian" .

<RBXa7Zas4KaZjtUpwq0RHxv> a owl:Class ;
    rdfs:label "Natural Law System" ;
    rdfs:subClassOf <RVPwUkNgWhlwyYWWSPrLuZ> ;
    skos:altLabel "Jus Naturale",
        "Law of Nature",
        "Natural Law Theory" ;
    skos:definition "The Natural Law System is a legal philosophy asserting that laws are derived from a set of inherent moral principles and universal truths that govern human behavior, existing independently of human-made laws. It posits that these principles are discoverable through reason and are inherent to human nature, providing a basis for evaluating and guiding positive law." ;
    skos:example "Human Rights Charters often draw on principles from the Natural Law System, asserting rights that transcend national legal systems.",
        "The abolition of apartheid in South Africa was partly justified by appeals to the universal moral principles of the Natural Law System." ;
    skos:prefLabel "Universal Moral Law" .

<RBXe7jvdOMHWIvT93GSGUk0> a owl:Class ;
    rdfs:label "European Commission" ;
    rdfs:subClassOf <RVG1zLys64KOCQFR2MhzS7> ;
    skos:altLabel "Commission of the European Union" ;
    skos:definition "The European Commission is the executive branch of the European Union, responsible for proposing legislation, implementing decisions, and managing the day-to-day operations of the EU. It represents the interests of the EU as a whole, rather than individual member states." ;
    skos:prefLabel "EU Commission" .

<RBXeFnOtcGD1SnlKcTDDOAx> a owl:Class ;
    rdfs:label "Special Purpose Entity" ;
    dc:source <https://en.wikipedia.org/wiki/Special-purpose_entity>,
        <https://www.centralbank.ie/consumer-hub/explainers/what-is-a-special-purpose-entity#:~:text=A%20Special%20Purpose%20Entity%20(SPE,other%20entities%20or%20investor(s)> ;
    rdfs:subClassOf <RCua1MtzwNcjfYov8VFcoV3> ;
    skos:altLabel "Financial Vehicle Corporation",
        "SPE",
        "SPV" ;
    skos:definition "A Special Purpose Entity (SPE) is a legal entity created for a specific, limited purpose, particularly in financial transactions. This entity is often used to isolate financial risk by legally segregating certain activities, assets, or investments from the main organization, thereby facilitating transaction security and credit enhancement." ;
    skos:prefLabel "Special Purpose Vehicle" .

<RBXkndIfbrsY00eledcb9p4> a owl:Class ;
    rdfs:label "Modoc" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<RBXlobBYNwoSXUUh9hyG7YU> a owl:Class ;
    rdfs:label "Individual Contributor" ;
    rdfs:subClassOf <R72p6HAKCuvyIWvgxuoCM9R> ;
    skos:definition "An Individual Contributor is an employee who specializes in performing specific tasks or roles within an organization but does not have managerial responsibilities over a team. Individual Contributors focus on executing their specialized skill sets and are evaluated based on their own performance rather than the performance of a group." .

<RBXozjgPVMyJbstz1YtUOAu> a owl:Class ;
    rdfs:label "Small Intestine Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_17> ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Small Bowel Cancer",
        "Small Intestinal Carcinoma",
        "Small Intestinal Malignancy" ;
    skos:definition "Small intestine cancer is a malignant neoplasm originating in the small intestine, which includes the duodenum, jejunum, and ileum. This type of cancer can cause symptoms such as abdominal pain, weight loss, and bowel obstruction and may include various subtypes such as adenocarcinoma, carcinoid tumors, and gastrointestinal stromal tumors (GISTs)." .

<RBXpZKEtUb90P79zVvnHHsH> a owl:Class ;
    rdfs:label "Death on High Seas Act Claim" ;
    rdfs:subClassOf <R9LVBKjvGRuzwgtlhuLST36>,
        <RqHLQbqYW16CtZ6TSKOZPz> ;
    skos:altLabel "DOHSA Claim",
        "Anspruch nach dem Gesetz über Todesfälle auf hoher See"@de-de,
        "Death on High Seas Act Claim"@en-gb,
        "Reclamación por el Acta de Muerte en Alta Mar"@es-es,
        "Reclamación por la Ley de Muerte en Alta Mar"@es-mx,
        "Réclamation en vertu de la loi sur les décès en haute mer"@fr-fr,
        "תביעה על פי חוק מוות בים גבוה"@he-il,
        "ऊंची समुद्र में मृत्यु अधिनियम दावा"@hi-in,
        "高海上死亡法に基づく請求"@ja-jp,
        "Reivindicação de acordo com a Lei de Mortes no Alto Mar"@pt-br,
        "高海上死亡法案索赔"@zh-cn ;
    skos:definition "The Death on High Seas Act (DOHSA) is a legal concept that falls under the categories of Statutory and Regulatory Claims, as well as Admiralty and Maritime Claims. It provides a framework for compensation in cases of death that occur on the high seas." .

<RBXrokRoNHSUbxowFTkMH9p> a owl:Class ;
    rdfs:label "Schizoid Personality Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RCnCHWsREqpfQAAfaN2lRPV> ;
    skos:definition "Schizoid Personality Disorder is characterized by a pervasive pattern of detachment from social relationships and a restricted range of emotional expression. Individuals with this disorder often appear aloof, indifferent, and emotionally cold, and they typically have a limited desire for social interactions or engagement." .

