    rdfs:subClassOf <R8IG2xzz6DkWBumc1ZiMyx9> ;
    skos:altLabel "Chrismation"^^xsd:string,
        "Sacrament of Confirmation"^^xsd:string,
        "Sealing With the Holy Spirit"^^xsd:string ;
    skos:definition "Confirmation is the sacrament of initiation by which the baptized receive the fullness of the Holy Spirit and are more perfectly bound to the Church. It strengthens them with a special outpouring of the Spirit to witness to Christ in faith and action."^^xsd:string ;
    skos:example "Confirmation completes the grace of baptism."^^xsd:string,
        "Confirmation strengthens Christians for mission."^^xsd:string,
        "The anointing with chrism seals the confirmand."^^xsd:string,
        "The bishop ordinarily administers confirmation."^^xsd:string .

