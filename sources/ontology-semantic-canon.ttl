<R7fBgPMKM2CgXRYzs5jY323> a owl:Class ;
    rdfs:label "Lemons" ;
    rdfs:subClassOf <RIxZRp4UxyqiBeFnokFhrA> ;
    skos:altLabel "Citrus Limon" ;
    skos:definition "Lemons are small, yellow citrus fruits from the Citrus limon species, known for their tart, acidic juice and aromatic zest. They are widely used in culinary applications, beverages, and as a natural cleaning agent, valued for their high vitamin C content and refreshing flavor." .

<R7fEljbKu5LSpcpQObOCnDo> a owl:Class ;
    rdfs:label "Secondary Source" ;
    rdfs:subClassOf <RBgvM3CLfhaoq2TagoUDUBG> ;
    skos:altLabel "Analytical Source"^^xsd:string,
        "Commentary Source"^^xsd:string,
        "Critical Essay"^^xsd:string,
        "Historical Analysis"^^xsd:string,
        "Interpretive Source"^^xsd:string,
        "Legal Analysis"^^xsd:string,
        "Scholarly Analysis"^^xsd:string,
        "Scholarly Commentary"^^xsd:string,
        "Theological Interpretation"^^xsd:string ;
    skos:definition "Secondary Source is a work that analyzes, interprets, or critiques primary sources rather than constituting original evidence itself. A Secondary Source derives its value from explanation, contextualization, and evaluation of primary material."^^xsd:string ;
    skos:example "A commentary on Sacred Scripture is a secondary source for biblical study."^^xsd:string,
        "A historical monograph evaluating archival documents serves as a secondary source."^^xsd:string,
        "A legal treatise analyzing statutes and cases functions as a secondary source."^^xsd:string,
        "A theological journal article interpreting a papal encyclical is a secondary source."^^xsd:string .

<R7fFIQpFBTrvkmKLbzK30pY> a owl:Class ;
    rdfs:label "Voter Fraud Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8GyyJdxlZtc7PsW9vLAKfE> ],
        <R9L7kPrkn8q0VbbyH4lv1VJ> ;
    skos:altLabel "Ballot Fraud Allegation",
        "Electoral Fraud Allegation",
        "Voting Fraud Accusation" ;
    skos:definition "A Voter Fraud Claim refers to an allegation that illegal actions were taken to manipulate the outcome of an election, including activities such as voting more than once, casting ballots under false identities, tampering with vote counts, or falsifying voter registrations. These claims question the integrity of the voting process and require investigation to ensure electoral fairness." ;
    skos:prefLabel "Electoral Fraud Claim" .

<R7fGGaO3fruO5xNWT14tbky> a owl:Class ;
    rdfs:label "Hospice Negligence" ;
    rdfs:subClassOf <R7Zbqfhemxs6PR7r2Fk6NeY> ;
    skos:altLabel "Fahrlässigkeit im Hospiz"@de-de,
        "Hospice Negligence"@en-gb,
        "Negligencia en cuidados paliativos"@es-es,
        "Negligencia en hospicio"@es-mx,
        "Négligence en hospice"@fr-fr,
        "הפרת חובת זהירות במוסד סיעודי לסובלנות"@he-il,
        "हॉस्पिस लापरवाही"@hi-in,
        "ホスピスの過失"@ja-jp,
        "Negligência em hospice"@pt-br,
        "临终关怀疏忽"@zh-cn ;
    skos:definition "Hospice Negligence refers to a legal claim for damages resulting from the failure of a hospice provider to provide adequate care and treatment to a patient who is terminally ill or in need of end-of-life care." .

<R7fGyM4ugPeHr0PnydbVuMH> a owl:Class ;
    rdfs:label "Collection Limitation Principle" ;
    rdfs:isDefinedBy <http://oecdprivacy.org/> ;
    rdfs:subClassOf <R7xYDTzzTo7YiXeLN7zeBnw> ;
    skos:altLabel "Prinzip der Datensparsamkeit"@de-de,
        "Collection Limitation Principle"@en-gb,
        "Principio de Limitación de la Recopilación"@es-es,
        "Principio de Limitación de la Colección"@es-mx,
        "Principe de limitation de la collecte"@fr-fr,
        "עקרון ההגבלה באיסוף"@he-il,
        "संग्रह सीमा सिद्धांत"@hi-in,
        "収集制限原則"@ja-jp,
        "Princípio da limitação da coleta"@pt-br,
        "收集限制原则"@zh-cn ;
    skos:definition "Collection Limitation is the privacy principle that there should be limits to the collection of personal data and any such data should be obtained by lawful and fair means and, where appropriate, with the knowledge or consent of the data subject" .

