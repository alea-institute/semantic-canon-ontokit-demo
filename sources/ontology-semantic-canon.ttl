    rdfs:subClassOf <RDAtMRi4dBGNW1PytkqmH4t> ;
    skos:altLabel "Autoimmune Pancreatic Disease" ;
    skos:definition "Type 1 diabetes is a chronic autoimmune condition where the body's immune system attacks and destroys the insulin-producing beta cells in the pancreas, leading to high blood glucose levels. It typically develops in children and young adults and requires lifelong insulin therapy for management." ;
