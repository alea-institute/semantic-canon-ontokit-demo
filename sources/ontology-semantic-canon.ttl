<R7ktpZsNlvJzWq7eH4BVXIN> a owl:Class ;
    rdfs:label "Last Clear Chance Doctrine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rt4T1FlyWPLKcpZDSAspuG> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDwYaUfGBr5UZFb2zWldOBw> ],
        <RCzs34uEQI9f4cuWp3bQO0P> ;
    skos:definition "The Last Clear Chance Doctrine is a legal principle in tort law that allows a plaintiff to recover damages even if they were partially at fault, provided the defendant had the final opportunity to avoid the accident but failed to do so. This doctrine mitigates the harshness of contributory negligence by shifting the focus to the defendant's ability to prevent the harm." .

