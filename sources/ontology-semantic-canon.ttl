<R77Cad28AAf260122cc9B742> a owl:Class ;
    rdfs:label "U.S. Agency for Global Media" ;
    dc:identifier "US-FD-USAGM" ;
    rdfs:subClassOf <R22815eC3Af3bFF0d002Ca58> ;
    skos:altLabel "U.S. Agentur für globale Medien"@de-de,
        "U.S. Agency for Global Media"@en-gb,
        "Agencia de los Estados Unidos para los Medios Globales"@es-es,
        "Agencia de los Estados Unidos para los Medios Globales"@es-mx,
        "Agence américaine pour les médias mondiaux"@fr-fr,
        "סוכנות ארצות הברית למדיה גלובלית"@he-il,
        "यूएस एजेंसी फॉर ग्लोबल मीडिया"@hi-in,
