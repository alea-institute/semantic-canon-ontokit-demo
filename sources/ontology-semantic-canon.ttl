    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RCfOoWbuAOqLv617rVNcHYh> ;
    skos:altLabel "BED" ;
    skos:definition "Binge-Eating Disorder is an eating disorder characterized by recurrent episodes of eating large quantities of food in a short period, accompanied by feelings of loss of control during the binge and significant distress or impairment. Unlike Bulimia Nervosa, individuals with Binge-Eating Disorder do not regularly engage in compensatory behaviors such as vomiting or excessive exercise to offset the binge eating." ;
    skos:prefLabel "Compulsive Overeating" .

