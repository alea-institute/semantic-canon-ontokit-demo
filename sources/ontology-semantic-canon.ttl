<R8BjwtrONwHoExkoK8xYC1F> a owl:Class ;
    rdfs:label "Temperance" ;
    rdfs:subClassOf <R7QF58SulRGe1zlQ8gCzVSF> ;
    skos:altLabel "Discipline of Desire"^^xsd:string,
        "Measured Use of Pleasure"^^xsd:string,
