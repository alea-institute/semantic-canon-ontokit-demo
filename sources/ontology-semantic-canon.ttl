        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Wayfarer" ;
    skos:definition "A pedestrian refers to any person who is on foot, traveling on a surface intended for human passage. This includes individuals walking, running, hiking, or moving via other human-powered means on pathways, sidewalks, crosswalks, or similar public thoroughfares." ;
    skos:prefLabel "Walker" .

<R9T8KGJd3wcbSBjdX3K2mGy> a owl:Class ;
