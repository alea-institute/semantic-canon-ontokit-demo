        "Exegetical Commentary"^^xsd:string,
        "Interpretive Commentary"^^xsd:string,
        "Scholarly Commentary"^^xsd:string,
        "Theological Commentary"^^xsd:string ;
    skos:definition "Commentary is a non-magisterial interpretive work that explains, analyzes, or critiques a text, doctrine, or practice. It draws on historical, philosophical, theological, or pastoral reasoning without exercising teaching authority."^^xsd:string ;
    skos:example "A twentieth-century theological commentary on Vatican II."^^xsd:string,
        "Augustine’s commentary on the Psalms."^^xsd:string,
        "Thomas Aquinas’s commentary on the Sentences."^^xsd:string ;
    skos:prefLabel "Interpretation"^^xsd:string .

<R9szLiADV9YpQbQthSAE7bv> a owl:Class ;
