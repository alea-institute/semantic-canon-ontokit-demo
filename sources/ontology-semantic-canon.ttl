<R90wCkXErc0wstlKKLDoVvt> a owl:Class ;
    rdfs:label "Christ’s Ascension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RTUYPssMryBw6n3gCyegpE> ],
        <R78g2Psn6TygAlkIoCnXqdd>,
        <R8tHlzW74n3nwtE4NF4vaB9> ;
    skos:altLabel "Ascension of Christ"^^xsd:string,
        "Ascension of the Lord"^^xsd:string,
        "Exaltation of the Risen Lord"^^xsd:string ;
    skos:definition "Christ’s Ascension means the event in which the risen Jesus Christ ascended bodily into heaven forty days after his Resurrection. Christ’s Ascension signifies Christ’s exaltation at the right hand of the Father and the completion of his visible earthly mission."^^xsd:string ;
    skos:example "The Acts of the Apostles recounts Jesus ascending into heaven in the presence of his disciples."^^xsd:string,
        "The Church celebrates Christ’s Ascension forty days after Easter."^^xsd:string,
        """Then, after speaking to them, the Lord Jesus was taken up into Heaven and took His seat at God’s right hand.
(Mark 16:19)"""^^xsd:string .

