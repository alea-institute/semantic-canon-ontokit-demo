        "Pornographie et matériel obscène"@fr-fr,
        "פורנוגרפיה וחומר מגונה"@he-il,
        "पोर्नोग्राफी और अश्लील सामग्री"@hi-in,
        "ポルノグラフィーとわいせつ物"@ja-jp,
        "Pornografia e material obsceno"@pt-br,
        "色情和淫秽材料"@zh-cn ;
    skos:definition "The violation of laws or ordinances prohibiting the manufacture, publishing, sale, purchase, or possession of sexually explicit material, e.g., literature, photographs, etc." .

<R9mf4jHGk1EcEkyTBhfv6Zw> a owl:Class ;
    rdfs:label "Bail Payment Event" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rte2A8gY3vh8lVIpY5myli> ],
        <R9sdPQV8kCK3BNF8jcPV5cD> ;
    skos:definition "A Bail Payment is the financial transaction made to secure the temporary release of an accused individual from custody, usually in the form of cash, bond, or property, which is pledged to guarantee their appearance at future court dates. This payment acts as a surety that the defendant will return for trial and may be forfeited if the individual fails to appear in court." .

<R9oT1uDgFl2wSjoa358Wowx> a owl:Class ;
