<R7XgHu1mRjYD5pPdi12Hb6U> a owl:Class ;
    rdfs:label "Lack of Contractual Capacity Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RJEhNjPDXIeJRMwifVraDk> ],
        <RCzs34uEQI9f4cuWp3bQO0P>,
        <RZ1dOPJ6HH6lMJGSLNxfwV> ;
    skos:altLabel "Contracting Capacity" ;
    skos:definition "A Lack of Contractual Capacity Claim asserts that a party to a contract did not have the legal ability or competence to enter into the agreement, rendering the contract voidable. This claim typically arises due to factors such as minority, mental incapacity, or intoxication." ;
    skos:prefLabel "Incapacity Defense" .

<R7XggsCHhZxlgmBoni4LovZ> a owl:Class ;
    rdfs:label "Right of Publicity" ;
    rdfs:subClassOf <R7JKVOM2aFkvG1yiLzF7ndA> ;
    skos:altLabel "Recht am eigenen Bild"@de-de,
        "Right of Publicity"@en-gb,
        "Derecho a la imagen"@es-es,
        "Derecho de imagen"@es-mx,
        "Droit à l'image"@fr-fr,
        "זכות הציבוריות"@he-il,
        "पब्लिसिटी का अधिकार"@hi-in,
        "肖像権"@ja-jp,
        "Direito de Publicidade"@pt-br,
        "肖像权"@zh-cn ;
    skos:definition "The Right of Publicity is a legal concept that protects an individual's right to control the commercial use of their name, image, likeness, or other identifiable aspects of their persona, and prohibits others from using them without permission." .

<R7XjMoxjqIUftkOYtnzzbAu> a owl:Class ;
    rdfs:label "Disinheritance" ;
    rdfs:subClassOf <R8M0UJWeEVpeK5gMPLTQSl2>,
        <RDP2t75tSvlsq1GCrOZlInL> ;
    skos:altLabel "Estate Exclusion",
        "Exclusion from Inheritance",
        "Heir Exclusion" ;
    skos:definition "Disinheritance is the legal act of deliberately excluding an heir from receiving property or assets from a deceased person's estate, typically through the terms specified in a will or trust. This action can be taken for various personal, financial, or relational reasons, and must comply with legal statutes to be effective." ;
    skos:prefLabel "Disownment" .

<R7XjkX2t9nn1HNqmQ1Cu9Xx> a owl:Class ;
    rdfs:label "South Carolina Bar - Ethics Advisory Committee" ;
    rdfs:subClassOf <RE417c6578dfc77Ad721067c> ;
    skos:definition "A committee established by the South Carolina Bar to provide guidance on ethical issues related to the practice of law." .

<R7XkvVSRKmrHqQOASeKFZEv> a owl:Class ;
    rdfs:label "Material Witness" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7u1GstOpfAmZ3mI7yFcbgU> ],
        <R9tZFXPrXQJWHbqSgtCQxJF> ;
