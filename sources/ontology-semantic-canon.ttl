<RFjY2mO804t9gJNy5Dn4P1> a owl:Class ;
    rdfs:label "Impersonation / Identity Theft" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf <R5ks6eYBkfLh4Fgv1Zusal>,
        <Rd7uelGFqCTWSgf9lWki5N> ;
    skos:altLabel "Identity Theft",
        "Impersonation",
        "Theft of Personal Identifying Information",
        "Vortäuschung / Identitätsdiebstahl"@de-de,
        "Impersonation / Identity Theft"@en-gb,
        "Suplantación de identidad / Robo de identidad"@es-es,
        "Suplantación de identidad / Robo de identidad"@es-mx,
        "Usurpation d'identité / Vol d'identité"@fr-fr,
        "התחזות / גניבת זהות"@he-il,
        "अभिनय / पहचान चोरी"@hi-in,
        "なりすまし / ID盗難"@ja-jp,
        "Impersonação / Roubo de identidade"@pt-br,
        "冒充 / 身份盗窃"@zh-cn ;
    skos:definition "Falsely representing one’s identity or position, and acting in the character or position thus unlawfully assumed, to deceive others and thereby gain a profit or advantage, enjoy some right or privilege, or subject another person or entity to an expense, charge, or liability which would not have otherwise been incurred." .

<RGK6KYY8XqLTyeigvEAIOg> a owl:Class ;
    rdfs:label "Work Break" ;
    rdfs:subClassOf <RBila9ckW95W84Tk54tGfZO> ;
    skos:altLabel "Break Time" ;
    skos:definition "\"Work Break\" typically refers to a short period of rest or pause during the workday, allowing employees to recharge or relax briefly before resuming their tasks. It can vary in duration and purpose, such as a coffee break, lunch break, or a quick break to stretch and refocus." .

<RJ4c5efwPEoWH1XeoJxiB4> a owl:Class ;
    rdfs:label "Immigration Court" ;
    rdfs:subClassOf <R85BLSakJPEy7c7KvxZyOe> ;
    skos:definition "Immigration Court is an administrative forum that handles legal proceedings related to immigration matters." .

<RJEhNjPDXIeJRMwifVraDk> a owl:Class ;
    rdfs:label "Mistake in Contract" ;
    rdfs:subClassOf <RCzs34uEQI9f4cuWp3bQO0P>,
        <RZ1dOPJ6HH6lMJGSLNxfwV> ;
    skos:altLabel "Vertragsfehler"@de-de,
        "Mistake in Contract"@en-gb,
        "Error en el contrato"@es-es,
        "Error en el contrato"@es-mx,
        "Erreur de contrat"@fr-fr,
        "טעות בחוזה"@he-il,
        "अनुबंध में गलती"@hi-in,
        "契約上の誤り"@ja-jp,
        "Erro no contrato"@pt-br,
        "合同错误"@zh-cn ;
    skos:definition "A Mistake in Contract is a legal claim that arises when one or both parties to a contract make an error in the terms of the agreement, which can render the contract void or unenforceable." .

<RKKRGOkIme6pnG2BSePt1Z> a owl:Class ;
