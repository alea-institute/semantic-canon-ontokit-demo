<RL81V0ATCWzMgdSPue1pqZ> a owl:Class ;
    rdfs:label "Credit Card Agreement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <NSuHU9KfQAyMsU7Yjh1k1g> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9EPT10SufbUlTqTjD85mSZ> ],
        <RVoyN9hN3m5gy3So01ZEZ8> ;
    skos:altLabel "Cardholder Agreement",
        "Credit Card Contract" ;
    skos:definition "A Credit Card Agreement is a legally binding contract between a credit card issuer and a cardholder outlining the terms and conditions under which the cardholder may use the credit card. This agreement specifies the interest rates, fees, billing processes, and cardholder obligations associated with the card." .

<RL8upqvT6ptpt48fdkR7AP> a owl:Class ;
    rdfs:label "High School Diploma" ;
    rdfs:subClassOf <RyazUr0HwLdeSIiJjwsbgP> ;
    skos:definition "A High School Diploma is an academic credential awarded upon successful completion of a secondary education program. It signifies the completion of basic education requirements and prepares individuals for higher education or employment" .

<RLCgcyVpMJC9pO2jdogXYJ> a owl:Class ;
    rdfs:label "Turnover and Other General Goods and Services Tax Payment" ;
    rdfs:subClassOf <R7NkMt6XJKd4fSolKqqOy5B> ;
    skos:altLabel "Multi-Stage Tax Payment",
        "Turnover and other general taxes on goods and services" ;
    skos:definition "Turnover and Other General Goods and Services Tax Payment refers to multi-stage cumulative taxes and taxes where elements of consumption taxes are combined with multistage taxes. These taxes are levied each time a transaction takes place, without deduction for taxes paid on inputs. Multi-stage taxes can incorporate elements of value-added or sales taxes, leading to taxation at multiple points in the supply chain." ;
    skos:prefLabel "Multi-Stage Consumption Tax" .

<RLHydbKoAHpmxbjRTt3yw7> a owl:Class ;
    rdfs:label "African Union" ;
    rdfs:subClassOf <R9H0HvybK6M3RpFebn0SDLu> ;
    skos:definition "AU (African Union): A continental union consisting of 55 member states located in Africa, aimed at promoting economic, social, and political integration, and resolving conflicts among member states." ;
    skos:prefLabel "AU" .

<RLIUiQhEdVo5i68qgFNuJk> a owl:Class ;
    rdfs:label "STEM Training Plan" ;
    rdfs:subClassOf <RKY2B2HNSx5K82dgVN6Qn7> ;
    skos:altLabel "F-1 STEM Training Plan",
        "Form I-983" ;
    skos:definition "In United States immigration law, the F-1 STEM Training Plan refers to the plan developed by an international student pursuing studies in a Science, Technology, Engineering, or Mathematics (STEM) field in the U.S. This plan is a component of the Optional Practical Training (OPT) extension for F-1 students, which allows them to work in the U.S. for an additional 24 months after completing their degree. The STEM Training Plan outlines how the student's employment will be related to their field of study and how it will contribute to their practical training and skill development." .

<RLLg8Yazwudc8ePg2wA6bM> a owl:Class ;
    rdfs:label "Resume" ;
    rdfs:subClassOf <RCTnebwmInNgHYwFLgAOf0z> ;
    skos:altLabel "CV" ;
    skos:definition "A \"Resume,\" also known as a \"Curriculum Vitae (CV),\" is a concise and structured document that provides an overview of an individual's education, work experience, skills, achievements, and qualifications. It is typically used for job applications and serves as a summary of an individual's professional background." ;
    skos:prefLabel "Curriculum Vitae" .

<RLNViL3ql432ilGW2AesbL> a owl:Class ;
    rdfs:label "Pastoral Guidance" ;
    rdfs:subClassOf <RCq8YWUS1BXn0VEMPqX9g4i> ;
    skos:altLabel "Pastoral Direction"^^xsd:string,
        "Pastoral Instruction"^^xsd:string,
        "Pastoral Teaching"^^xsd:string ;
    skos:definition "Pastoral Guidance is non-definitive instruction or direction offered by Church authority to help the faithful apply doctrine and moral principles to concrete circumstances. It aims at spiritual care and practical discernment rather than binding doctrinal definition."^^xsd:string ;
    skos:example "A bishop issues pastoral guidance on receiving the sacraments."^^xsd:string,
        "Clergy rely on pastoral guidance to accompany the faithful prudently."^^xsd:string,
        "Pastoral guidance does not require definitive assent."^^xsd:string,
        "Pastoral guidance helps the faithful apply moral teaching in complex situations."^^xsd:string,
        "Such guidance may vary by time, place, or pastoral context."^^xsd:string .

<RLNc7gzywoZLESpwFH8Q7M> a owl:Class ;
    rdfs:label "Chiropractor Malpractice" ;
    rdfs:subClassOf <R8nVhrBlasGIc7jxw1D0vbm> ;
    skos:altLabel "Chiropraktiker-Malpractice"@de-de,
        "Chiropractor Malpractice"@en-gb,
        "Negligencia profesional de quiropráctico"@es-es,
        "Negligencia profesional de quiropráctico"@es-mx,
        "Faute professionnelle d'un chiropracteur"@fr-fr,
        "שגיאת מקצוע של כירופרקטיקאי"@he-il,
        "कायरोप्रैक्टर लापरवाही"@hi-in,
        "カイロプラクティック医療過誤"@ja-jp,
        "Negligência de quiropraxia"@pt-br,
        "脊医过失"@zh-cn ;
    skos:definition "Chiropractor Malpractice refers to a type of medical malpractice claim that arises from the negligent or intentional actions of a chiropractor, resulting in harm or injury to a patient." .

<RLPmAhvXkRsJVHOqXNP8GG> a owl:Class ;
    rdfs:label "Venial Sin" ;
    rdfs:subClassOf <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Lesser Sin"^^xsd:string,
        "Light Moral Fault"^^xsd:string,
        "Non-Grave Sin"^^xsd:string ;
    skos:definition "Venial Sin is a morally disordered act that wounds charity but does not destroy a person’s relationship with God. Venial Sin occurs when the matter is not grave or when full knowledge or deliberate consent is lacking."^^xsd:string ;
    skos:example "Venial sin calls for ongoing conversion and growth in virtue."^^xsd:string,
        "Venial sin disposes a person toward more serious sin if left unaddressed."^^xsd:string,
        "Venial sin occurs when a person speaks uncharitably without full deliberation."^^xsd:string,
        "Venial sin weakens charity but does not sever communion with God."^^xsd:string .

<RLQedrDmb0dGL0RqZmF1Xw> a owl:Class ;
    rdfs:label "Amputation" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/1.00-Musculoskeletal-Adult.htm#1_20> ;
    rdfs:subClassOf <RpiyvcnyPAZ5hygNt0zO3j> ;
    skos:altLabel "Amputative Surgery",
        "Extremity Removal",
        "Limb Amputation",
        "Limb Removal",
        "Surgical Limb Loss" ;
    skos:definition "Amputation is the surgical removal of a limb or extremity, such as an arm, leg, foot, hand, toe, or finger. This procedure is often performed to treat severe injuries, infections, diseases like diabetes or cancer, or as a result of traumatic accidents, leading to significant changes in mobility and functionality." .

<RLQhKk8z0rpekZczxDuAZI> a owl:Class ;
