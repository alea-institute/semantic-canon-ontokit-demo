<RDLeSDzQUi4xoWgfoqI3aHe> a owl:Class ;
    rdfs:label "Principle of Double Effect" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Doctrine of Double Effect"^^xsd:string,
        "Double Effect Principle"^^xsd:string ;
    skos:definition "The Principle of Double Effect is a moral principle used to evaluate actions that produce both good and bad effects. It permits such actions when the act is morally good or neutral, the good effect is intended, the bad effect is not intended though foreseen, and there is a proportionately grave reason."^^xsd:string ;
    skos:example "A surgical procedure that saves a mother’s life while unintentionally harming a fetus invokes the principle of double effect."^^xsd:string,
        "Administering high-dose pain relief that may foreseeably shorten life can satisfy the principle of double effect."^^xsd:string,
        "Just war analysis applies the principle of double effect to civilian harm."^^xsd:string,
        "Moral theologians use the principle of double effect to distinguish intention from foreseen effects."^^xsd:string .

