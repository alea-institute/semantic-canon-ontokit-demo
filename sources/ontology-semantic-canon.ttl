<RTsdgkD9nXC6H2pDb2uvFe> a owl:Class ;
    rdfs:label "Flight of the Disciples" ;
    rdfs:subClassOf <R8hw8N5f6CCS519HZccaPdl> ;
    skos:altLabel "Abandonment of Jesus by the Disciples"^^xsd:string,
        "Disciples’ Flight"^^xsd:string,
        "Fulfillment of Jesus’ Prophecy of Scattering"^^xsd:string ;
    skos:definition "Flight of the Disciples means the scattering and abandonment of Jesus by his disciples at the time of his arrest. Flight of the Disciples reveals human fear and weakness in contrast to Christ’s faithful obedience during the Passion."^^xsd:string ;
    skos:example "Christian reflection views the flight of the disciples as a moment that exposes human frailty and the need for divine grace."^^xsd:string,
        "The Gospels recount that all the disciples fled when Jesus was arrested."^^xsd:string ;
    skos:prefLabel "Scattering of the Disciples"^^xsd:string .

