    skos:definition "A Tailgating Claim involves allegations that a driver has followed another vehicle too closely, violating safe following distance regulations and potentially causing a safety hazard. This type of claim is typically addressed in traffic courts and can lead to penalties, including fines and driving record points, depending on the jurisdiction." ;
    skos:prefLabel "Following Too Closely Claim" .

<R7NbFVMmNBqSIc3izA5Yf1N> a owl:Class ;
    rdfs:label "Lead Underwriter" ;
    rdfs:subClassOf <RDVtW9pxx7DVUlXOsBrOUEO> ;
    skos:altLabel "Arranger",
        "Lead Manager",
        "Managing Underwriter" ;
    skos:definition "A bookrunner, also known as a lead underwriter or lead manager, is a financial institution or investment bank responsible for managing the issuance of new securities, such as bonds or stocks, in a public offering. The bookrunner coordinates the syndicate of underwriters, sets the price of the securities, and allocates them to investors, playing a crucial role in the success of the offering." ;
    skos:prefLabel "Bookrunner" .

<R7NbWQfdIKgNd43XLIu6RHe> a owl:ObjectProperty ;
    rdfs:label "folio:received" ;
    rdfs:domain <R8CdMpOM0RmyrgCCvbpiLS0> ;
    rdfs:range <RDt4vQCYDfY0R9fZ5FNnTbj> ;
    rdfs:subPropertyOf <RB0hju1karAVIAsSqkf1Pza> ;
    skos:altLabel "folio:isBestowed",
        "folio:isGranted",
        "is awarded",
        "is bestowed",
        "is granted",
        "received",
        "was awarded",
        "was bestowed",
        "was granted" ;
    skos:definition "In various contexts, \"received\" denotes the act of being given or awarded something, such as a degree, license, or parole. This implies that the recipient has met certain criteria or conditions and has been formally granted a particular item, status, or privilege by an authoritative body or institution." ;
    skos:example "Applicant Received License",
        "Prisoner Received Parole",
        "Student Received Degree" ;
    skos:prefLabel "folio:isAwarded" .

