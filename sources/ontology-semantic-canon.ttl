<R9OQgWwumb1SAaSfzauESQ1> a owl:Class ;
    rdfs:label "Friendly Co-Party" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7TzyLcZq0lELm4qq9pU6ru> ],
        <RCEDL3kMYgjFUEOhOyGp3IE>,
        <RCFgxBbypUKKsDDOJ1iOk36> ;
    skos:altLabel "Aligned Counterparty",
        "Allied Co-Party",
        "Cooperative Co-Party",
        "Supportive Co-Party" ;
    skos:definition "A co-party in a legal or transactional matter whose interests and actions align with those of a specific client, even though they may be formally independent. Friendly co-parties generally cooperate and collaborate to achieve shared or mutually supportive outcomes within the matter." .

<R9OVtNYUqPXyvuaZmEggp6w> a owl:Class ;
    rdfs:label "Security Deposit" ;
    rdfs:subClassOf <RDT9HdGssfLC6RPAX15qHr7> ;
    skos:altLabel "Damage Deposit",
        "Lease Deposit",
        "Rental Deposit",
        "Tenancy Deposit" ;
    skos:definition "A security deposit is a sum of money held by a landlord or lessor as collateral to cover potential damages or unpaid rent by a tenant or lessee. It is typically refundable if the terms of the lease are met and no damages occur." .

<R9OYNKT7pIr4gnoZODD39wJ> a owl:Class ;
