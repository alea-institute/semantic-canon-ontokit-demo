<RBw3WR4CSREciBCYef3H9wI> a owl:Class ;
    rdfs:label "Ethical Principle" ;
    dc:source <https://github.com/kracr/applied-ethics-ontology/blob/main/ApplE%20Ontology/apple.owl> ;
    rdfs:subClassOf <RCruZXlq2qqJ1radTwtBG4o> ;
    skos:altLabel "Ethical Norm"^^xsd:string,
        "Moral Principle"^^xsd:string,
        "Moral Standard"^^xsd:string,
        "Normative Principle"^^xsd:string,
        "Principle of Ethical Reasoning"^^xsd:string ;
    skos:definition "Ethical Principle is a foundational normative standard that guides moral judgment about right and wrong action. An Ethical Principle articulates a general moral requirement that applies across contexts and informs more specific ethical rules and practices."^^xsd:string ;
    skos:example "Beneficence directs action toward promoting the good of others."^^xsd:string,
        "Justice requires giving each person what is due to them."^^xsd:string,
        "Nonmaleficence restrains actions that would cause unjustified harm."^^xsd:string,
        "Respect for dignity forbids treating persons merely as means to an end."^^xsd:string,
        "Solidarity calls persons and communities to responsibility for one another."^^xsd:string .

