    rdfs:subClassOf <JCIrz7g3SPCsw1TVxFKW7g> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in drawing wire from purchased steel." .

<MKOCKcY9TAibChdaB0hPrA> a owl:Class ;
