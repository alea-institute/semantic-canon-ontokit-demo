        <RBIVr7LJ5wZmSxEONjW4YvL> ;
    skos:altLabel "Maritime Vessel",
        "Ocean Liner",
        "Sea Vessel" ;
    skos:definition "A Ship is a large watercraft designed for deep-water navigation, typically used for transporting goods, passengers, or military personnel over long distances. Ships are equipped with various facilities and systems for navigation, safety, and cargo handling." ;
    skos:example "Cargo Ship",
        "Container Ship",
        "Cruise Ship",
        "Passenger Ship",
        "Tanker",
        "Warship" ;
    skos:prefLabel "Ocean-Going Vessel" .

