        "Secured Creditor"@en-gb,
        "Acreedor Garantizado"@es-es,
        "Acreedor Garantizado"@es-mx,
        "Créancier garanti"@fr-fr,
        "גורם מאובטח"@he-il,
        "सुरक्षित ऋणदाता"@hi-in,
        "担保債権者"@ja-jp,
        "Credor garantido"@pt-br,
        "担保债权人"@zh-cn ;
    skos:definition "A secured creditor is any creditor or lender associated with an investment in or issuance of a credit product backed by collateral. Secured creditors have a first-order claim on the payouts of a distressed credit investment." ;
    skos:hiddenLabel "SCRD" .

<RZEqJK4a9m78r45Opn703C> a owl:Class ;
    rdfs:label "Forcible Entry and Detainer" ;
