<RDcuchgTocD4ty3TubgvfLl> a owl:Class ;
    rdfs:label "Vague and Ambiguous Objection" ;
    dc:source "Fed. R. Evid. 611" ;
    rdfs:subClassOf <R7NB9WJzAFK6tIIGmfIj5Ay>,
        <RBMlUtTtbQUQxrZrkeF8Fpm> ;
