<RB91Ir5bSOsoHyaGccORDpQ> a owl:Class ;
    rdfs:label "Sacraments" ;
    rdfs:subClassOf <RBypJHdXoQQwqYlG95KCDCQ> ;
    skos:altLabel "Means of Grace"^^xsd:string,
        "Sacramental Rites"^^xsd:string,
        "Sacraments of the Church"^^xsd:string ;
    skos:definition "Sacraments are efficacious signs of grace instituted by Christ and entrusted to the Church, by which divine life is dispensed to the faithful. Each sacrament effects what it signifies through the action of Christ and the Holy Spirit."^^xsd:string ;
    skos:example "Each sacrament belongs to the Church’s public liturgy."^^xsd:string,
        "Sacraments confer grace through visible signs."^^xsd:string,
        "The Church celebrates seven sacraments instituted by Christ."^^xsd:string .

