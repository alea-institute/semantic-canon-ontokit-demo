        "Reivindicações de Educação Obrigatória"@pt-br,
        "义务教育要求"@zh-cn ;
    skos:definition "A claim made by parents regarding their legal responsibility to provide compulsory education to their children." .

<R9svMPVZEwWhCgaqTuYRXxY> a owl:Class ;
    rdfs:label "Commentary" ;
    rdfs:subClassOf <RDmbgHQXJxEvx3QYfR6qWAn> ;
