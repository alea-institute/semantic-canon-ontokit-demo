    skos:altLabel "Verletzung eines stillschweigenden Vertrags"@de-de,
        "Breach of Implied Contract"@en-gb,
        "Incumplimiento de contrato implícito"@es-es,
        "Incumplimiento de contrato implícito"@es-mx,
