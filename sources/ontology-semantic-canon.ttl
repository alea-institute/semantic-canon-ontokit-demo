    skos:definition "Seminary is a religious house dedicated to the formation of candidates for ordained ministry. A seminary orders communal life, study, prayer, and pastoral training toward preparation for Holy Orders."^^xsd:string ;
    skos:example "A diocesan seminary prepares future priests for service within a particular Church."^^xsd:string,
        "A major seminary provides theological formation for those preparing for priesthood."^^xsd:string,
        "A religious order seminary forms candidates according to its charism."^^xsd:string,
        "A seminary forms candidates through prayer, study, and communal life."^^xsd:string .

<RCThJJxvpYzIQdmsefCOhNO> a owl:Class ;
    rdfs:label "Articulation Disorder" ;
    rdfs:subClassOf <R7RTOi3HJBujhrMQbvqgmBZ> ;
    skos:altLabel "Phonetic Disorder",
        "Pronunciation Disorder",
        "Speech Sound Disorder" ;
    skos:definition "An Articulation Disorder is a speech disorder characterized by difficulties in correctly producing speech sounds, leading to mispronunciations that can affect intelligibility. This condition can result from various factors, including developmental delays, structural anomalies, neurological impairments, or hearing loss." ;
    skos:example "Phonetic articulation disorder, where a child consistently substitutes one sound for another, such as saying \"wabbit\" instead of \"rabbit,\" due to difficulty in producing the correct sound." ;
    skos:prefLabel "Speech Articulation Disorder" .

<RCTi5ncHpG7fN8DcDwgfMwN> a owl:Class ;
    rdfs:label "New Jersey Special Statutory Court" ;
    rdfs:subClassOf <R519e1c1BE7657EB2eeDDfb5> ;
    skos:definition "A New Jersey Special Statutory Court is a specialized court within the New Jersey State Courts system that is created by statute to handle specific types of cases." .

<RCTiU3W5CpVCeWnO9Enu73A> a owl:Class ;
    rdfs:label "Fee Increase or Decrease" ;
    rdfs:isDefinedBy "From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/" ;
    rdfs:subClassOf <R8DuEmmnbcptnIZhPdF2Tvx> ;
    skos:altLabel "Gebührenerhöhung oder -senkung"@de-de,
        "Fee Increase or Decrease"@en-gb,
        "Aumento o disminución de tarifas"@es-es,
        "Aumento o disminución de tarifas"@es-mx,
        "Augmentation ou diminution des frais"@fr-fr,
        "הגברת או הפחתת עמלות"@he-il,
        "शुल्क वृद्धि या कमी"@hi-in,
        "料金の増減"@ja-jp,
        "Aumento ou redução de taxas"@pt-br,
        "费用增加或减少"@zh-cn ;
    skos:definition "A Fee Increase or Decrease is a type of discount or credit that modifies the original cost of legal services provided, resulting in either an increase or decrease in the overall fee charged." .

<RCTmoU2BbiIxrDeGj7ql4Ge> a owl:Class ;
    rdfs:label "Georgia Superior Court - Walton County" ;
    rdfs:subClassOf <RCBE5bLTCIia7wAstjMsnKO> ;
    skos:definition "Georgia Superior Court - Walton County: A court of general jurisdiction in the state of Georgia that has authority over civil and criminal cases within Walton County." .

<RCTuN5eYKGiYrzU3foCgqli> a owl:Class ;
    rdfs:label "Parable of the Talents" ;
    rdfs:subClassOf <R9lPPcEUakauoTtSdt9K3La> ;
    skos:altLabel "Parable of Entrusted Gifts"^^xsd:string,
        "Talents Parable"^^xsd:string ;
    skos:definition "Parable of the Talents means the teaching in which Jesus Christ describes servants entrusted with differing amounts of wealth who are judged according to their faithfulness and diligence. Parable of the Talents teaches accountability before God and calls disciples to active stewardship of the gifts entrusted to them."^^xsd:string ;
    skos:example "Christian theology interprets the parable of the talents as a call to faithful use of God-given gifts in view of final judgment."^^xsd:string,
        "Entrustment of the Talents"^^xsd:string,
        "Faithful Servants Rewarded"^^xsd:string,
        "Judgment of the Unfaithful Servant"^^xsd:string,
        "The Gospel of Matthew recounts a master rewarding servants who wisely invested the talents entrusted to them."^^xsd:string ;
    skos:prefLabel "Parable of the Faithful and Unfaithful Servants"^^xsd:string .

<RCTyWuwAAdk4X3BrHs0kara> a owl:Class ;
    rdfs:label "Akkadian" ;
    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Akkadisch"@de-de,
        "Akkadien"@fr-fr,
        "アッカド語"@ja-jp,
        "Acádio"@pt-br,
        "阿卡德语"@zh-cn ;
    skos:definition "Akkadian is an ancient language used in Mesopotamia, characterized by its cuneiform script and grammar, and is considered a predecessor to modern-day Semitic languages." .

<RCTzTfQ8g3oId4ykzTyYH3b> a owl:Class ;
    rdfs:label "Fetal Alcohol Syndrome" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/10.00-MultipleBody-Adult.htm> ;
    rdfs:subClassOf <R8LxIR1bsgFd3td2G24G3mq>,
        <RnmmbswQcOryRPEoDnHIbC> ;
    skos:altLabel "Alcohol-Induced Birth Defects",
        "Alcohol-Related Birth Defects",
        "Alcohol-Related Neurodevelopmental Disorder (ARND)",
        "FAS" ;
    skos:definition "Fetal Alcohol Syndrome (FAS) is a severe form of Fetal Alcohol Spectrum Disorders (FASD) resulting from prenatal alcohol exposure. It is characterized by growth deficiencies, distinctive facial anomalies, and central nervous system dysfunction, leading to intellectual disabilities, behavioral problems, and learning difficulties." ;
    skos:prefLabel "Prenatal Alcohol Syndrome" .

<RCU0796Sp0Hnq9vSjpGjpFm> a owl:Class ;
    rdfs:label "Permanent Deacon" ;
    rdfs:subClassOf <R8pRJGAJiNSZ8h4pbZQEEy1> ;
    skos:definition "A Permanent Deacon is an ordained deacon who is not ordained with the intention of becoming a priest and who remains permanently in the diaconal state. He exercises a ministry of Word, Liturgy, and Charity under the authority of the bishop, often while also living a secular professional and family life."^^xsd:string ;
    skos:example "A married permanent deacon serves with the support of his family and diocese."^^xsd:string,
        "A permanent deacon balances ministry with professional work and family responsibilities."^^xsd:string,
        "A permanent deacon proclaims the Gospel and assists at the altar during Mass."^^xsd:string,
        "Permanent deacons often lead outreach to the poor, sick, and marginalized."^^xsd:string,
        "The bishop assigns a permanent deacon to parish liturgical and charitable service."^^xsd:string .

<RCU1FrfEgIGJ9hxZXDbeSRh> a owl:Class ;
    rdfs:label "Gbaya" ;
    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Gbaya"@de-de,
        "Gbaya"@fr-fr,
        "Gbaya"@ja-jp,
        "Gbaya"@pt-br,
        "Gbaya"@zh-cn ;
    skos:definition "Gbaya is a structured system of communication that consists of grammar and vocabulary, and is a specific language within the context of legal matters." .

<RCU6ReSCEN31kllOAIaq5Ut> a owl:Class ;
    rdfs:label "Overtime Pay" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RX4IL0dBTdT6NybOqieEPR> ],
        <RiYwKEna4NZ311TVYJ2yCj> ;
    skos:definition "Overtime pay refers to the additional compensation provided to employees who work hours in excess of what is considered standard or regular for a given period, typically a workweek. The rate for overtime pay is often higher than the employee's regular hourly wage, commonly set at one and a half times the standard rate or more, depending on labor laws and employment contracts." .

<RCU6cL02zgQvulp4Vx8Q0Hc> a owl:Class ;
    rdfs:label "Preparer" ;
    rdfs:subClassOf <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:definition "A Preparer is an individual or entity responsible for completing and submitting documentation on behalf of someone else, typically for a specific legal or financial process. Examples include immigration preparers, who assist with immigration paperwork, and bankruptcy preparers, who help file bankruptcy documents, although their roles may be limited by law in providing legal advice." .

<RCU7t1b9rWuUjGuFf81VQOE> a owl:Class ;
    rdfs:label "Insurance Broker Malpractice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9Q9CszYRTjTgwQ8JRqVZ0x> ],
        <R9q0hyYnNxQC475BKXOxjbm>,
        <RGm7jrTspmRi606c5XWZ1z> ;
    skos:altLabel "Versicherungsmakler-Malpractice"@de-de,
        "Insurance Broker Malpractice"@en-gb,
        "Negligencia profesional del corredor de seguros"@es-es,
        "Negligencia profesional del corredor de seguros"@es-mx,
        "Faute professionnelle de courtier en assurance"@fr-fr,
        "שגיאת מקצוע של סוכן ביטוח"@he-il,
        "बीमा ब्रोकर लापरवाही"@hi-in,
        "保険ブローカーの過失"@ja-jp,
        "Negligência de corretor de seguros"@pt-br,
        "保险经纪人过失"@zh-cn ;
    skos:definition "Insurance Broker Malpractice refers to a type of malpractice claim that arises from the actions or omissions of an insurance broker in the course of providing insurance services to a client." .

<RCUEkyjCqG7yCPQB6OZopyD> a owl:Class ;
    rdfs:label "Necessary and Proper Clause Claim" ;
    rdfs:subClassOf <RDkqXQLaqeFlhG4isnkHJuv> ;
    skos:altLabel "Anspruch auf die notwendige und angemessene Klausel"@de-de,
        "Necessary and Proper Clause Claim"@en-gb,
        "Reclamo de la Cláusula de Necesario y Adecuado"@es-es,
        "Reclamo de la Cláusula de Necesario y Adecuado"@es-mx,
        "Revendication de la clause nécessaire et appropriée"@fr-fr,
        "תביעת סעיף הנחוץ והמתאים"@he-il,
        "आवश्यक और उपयुक्त धारा दावा"@hi-in,
        "必要かつ適切な条項の主張"@ja-jp,
        "Reivindicação da Cláusula Necessária e Adequada"@pt-br,
        "必要和适当条款要求"@zh-cn ;
    skos:definition "A Necessary & Proper Clause claim is a legal argument asserting that a particular law or action exceeds the authority granted to Congress by the Necessary and Proper Clause of the United States Constitution. This claim is based on the interpretation that the Necessary and Proper Clause empowers Congress to pass laws that are necessary and proper for carrying out its enumerated powers, and that any law or action must be directly linked to an enumerated power in order to be constitutionally valid." .

<RCUIB6wyjoiIrYc2gTKCbtn> a owl:Class ;
