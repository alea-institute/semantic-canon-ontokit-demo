            owl:someValuesFrom <RDS8DPtuFReTFfJ5nGCczD5> ],
        <Rt7TTPXJ7WX1Jrjufs0Mdr> ;
    skos:altLabel "Personal Property Beneficiary" ;
    skos:definition "A legatee is an individual or entity named in a will to receive personal property or money from the estate of the deceased. This term differentiates from a devisee, who inherits real property." .

<RCwe6IUx1b5fuhKW0fivDZu> a owl:Class ;
    rdfs:label "Bond Assets" ;
    dc:identifier "BONDA",
        "EQTYA-BONDS" ;
    rdfs:subClassOf <RBTvzt8uobb19tFbNSYQkFA> ;
