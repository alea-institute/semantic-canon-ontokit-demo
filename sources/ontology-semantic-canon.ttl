<RCI49gPXtdN68uJtwf5fzEv> a owl:Class ;
    rdfs:label "Baptism of the Lord" ;
    rdfs:subClassOf <R7oT3qg4wZmB5K3qC79EVID>,
        <R9VpyiXQxLbATS2mPSOlbqT>,
        <RPq5X7NPLuzbWzt3kLIhkw> ;
    skos:altLabel "Baptism in the Jordan"^^xsd:string,
        "Manifestation of the Trinity"^^xsd:string,
        "Theophany at the Jordan"^^xsd:string ;
    skos:definition "Baptism of the Lord means the baptism of Jesus by John the Baptist in the Jordan River at the beginning of his public ministry. Baptism of the Lord reveals Jesus’ identity as the beloved Son of the Father and manifests the Trinity through the descent of the Holy Spirit."^^xsd:string ;
    skos:example """And when Jesus was baptized, … the heavens were opened and He saw the Spirit of God descending like a dove, and alighting on Him, and lo, a voice from heaven, saying "this is My beloved Son,” with whom I am well pleased."
(Matthew 3:16-17)"""^^xsd:string,
        "The Gospels recount Jesus’ baptism by John in the Jordan River."^^xsd:string,
        "The baptism of the Lord marks the beginning of Jesus’ public ministry."^^xsd:string ;
    skos:prefLabel "Baptism of Jesus"^^xsd:string .

<RCI7GdauKqsWgoTCyOWVVA8> a owl:Class ;
    rdfs:label "Central Visual Acuity Loss" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/2.00-SpecialSensesandSpeech-Adult.htm#2_02> ;
    rdfs:subClassOf <RDtYReEP1pIEFHvlzGGAFcY> ;
    skos:altLabel "Legally Blind",
        "Profound Vision Loss" ;
    skos:definition "Central visual acuity loss is a condition where the best-corrected vision in the better eye measures 20/200 or less, indicating severe impairment in the central vision. This level of acuity loss signifies significant visual impairment that cannot be corrected to a level better than 20/200, typically requiring adaptive measures for daily living." ;
    skos:prefLabel "Severe Visual Impairment" .

