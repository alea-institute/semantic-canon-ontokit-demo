    rdfs:subClassOf <RSwOCeFhWxUA3fOiTvlja4> ;
    skos:altLabel "Jobless Benefits",
        "Unemployment Compensation",
        "Unemployment Insurance Benefits",
        "Unemployment Insurance Payments" ;
