<RHSZPHkLvnB6N4bgIo6kuX> a owl:Class ;
    rdfs:label "Business Torts and Actions" ;
    rdfs:subClassOf <R8jYAnNATrfoBxAtIKpf72X>,
        <RDqSn32zsjxExcBFzIYxT2D> ;
    skos:altLabel "Geschäftliche Delikte und Klagen"@de-de,
        "Business Torts and Actions"@en-gb,
        "Agravios y Acciones Comerciales"@es-es,
        "Agravios y Acciones Comerciales"@es-mx,
