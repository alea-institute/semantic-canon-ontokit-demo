        "Actividades ultrapeligrosas"@es-es,
        "Actividades ultrapeligrosas"@es-mx,
        "Activités ultradangereuses"@fr-fr,
        "פעילויות קיצוניות מאוד"@he-il,
        "अत्यधिक खतरानक गतिविधियाँ"@hi-in,
        "超危険活動"@ja-jp,
        "Atividades ultraperigosas"@pt-br,
        "超危险活动"@zh-cn ;
    skos:definition "An activity that is so inherently dangerous that the person engaging in it is strictly liable for any resulting harm, regardless of whether they were negligent or not." .

<RDTPef6LjCeQg2TUb7aY88W> a owl:Class ;
    rdfs:label "Prevailing Wage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RqiDHswc43JoKvLEHWMGvR> ],
        <RiYwKEna4NZ311TVYJ2yCj> ;
    skos:definition "The \"Prevailing Wage\" is the hourly wage, typically established by government authorities, that is paid to workers in a specific locality or industry for a particular type of labor. It is intended to ensure that workers on government-funded projects or in certain sectors receive a fair and competitive wage, often based on the average wage rates for similar work in the region." .

<RDVQLifN70TJSPCRJJLBgPY> a owl:Class ;
    rdfs:label "Police Officer" ;
    rdfs:subClassOf <RILQypXcjvqd1GxNIcqsb7> ;
    skos:altLabel "Polizeibeamter"@de-de,
        "Police Officer"@en-gb,
        "Agente de Policía"@es-es,
        "Oficial de Policía"@es-mx,
        "Agent de police"@fr-fr,
        "שוטר"@he-il,
        "पुलिस अधिकारी"@hi-in,
        "警察官"@ja-jp,
        "Policial"@pt-br,
        "警察"@zh-cn ;
    skos:definition "A member of a police force or other organization of a municipality who is responsible for the prevention and detection of crime and the enforcement of the general criminal laws of the state. Aldazabal v. Carey, 396 N.Y.S.2d 84, 58 A.D.2d 120 (N.Y. App. Div. 1977)" .

<RDVeTFioc9tEXhTGI2gd6Nn> a owl:Class ;
    rdfs:label "Peacemaking" ;
    rdfs:subClassOf <R9F1zhfl4EiAf0VCEYCEnon> ;
    skos:altLabel "Conflict Resolution"^^xsd:string,
        "Conflict Resolution in Charity"^^xsd:string,
        "Mediation and Dialogue"^^xsd:string,
        "Peacebuilding"^^xsd:string,
        "Promotion of Peace"^^xsd:string,
        "Reconciliation Work"^^xsd:string,
        "Restorative Justice"^^xsd:string,
        "Social Harmony Promotion"^^xsd:string ;
    skos:definition "Peacemaking is the moral and spiritual commitment to restore right relationship by addressing conflict through justice, reconciliation, and charity. Peacemaking seeks not mere absence of violence, but the presence of right order grounded in truth and love."^^xsd:string ;
    skos:example "Peacemaking brings estranged family members together through honest dialogue and forgiveness."^^xsd:string,
        "Peacemaking guides mediation between conflicting groups to restore trust and justice."^^xsd:string,
        "Peacemaking motivates nonviolent responses to injustice and hostility."^^xsd:string .

<RDWrlAT5y1sm1PdlKJzlEwj> a owl:Class ;
    rdfs:label "Prosecutor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <RZSnKehA643O8824iC320g> ;
            owl:someValuesFrom <RBt449Gy4YQBuVqNLxE7Gg> ],
        [ a owl:Restriction ;
            owl:onProperty <RZSnKehA643O8824iC320g> ;
            owl:someValuesFrom <RD2RElTCvTbk5aUX9CfbJC5> ],
        <RcTA2iQmrtqOnX3WrjJIp8> ;
    skos:altLabel "DA",
        "State's Attorney",
        "Crown Prosecutor"@en-ca,
        "Crown Prosecutor"@en-gb ;
    skos:definition "A prosecutor is a legal professional responsible for representing the government in criminal cases by presenting evidence, building a case against the defendant, and seeking their conviction. Prosecutors also have a duty to ensure that justice is served and that defendants' rights are upheld throughout the legal process." ;
    skos:prefLabel "District Attorney" .

<RDYh2aODcMWS8YJE0zGwPfE> a owl:Class ;
    rdfs:label "Military Veteran" ;
    rdfs:subClassOf <R9e1bYJPmM4lWEdGvWIxf6t> ;
    skos:altLabel "Veteran",
        "Militär-Veteran"@de-de,
        "Vétéran militaire"@fr-fr,
        "軍人退役者"@ja-jp,
        "Veterano militar"@pt-br,
        "军人退役者"@zh-cn ;
    skos:definition "A military veteran is an individual who has previously served in the armed forces of a country, including the army, navy, air force, or other branches of service, and has completed their active duty or reserve obligations. Military veterans may have served in various capacities, ranks, and locations during their time in service. In many countries, including the United States, veterans are protected from discrimination and are eligible for various benefits, such as healthcare, education, and employment support, in recognition of their service." .

<RDa0nehxECXxnQM6X3gAbNJ> a owl:Class ;
    rdfs:label "Senior Citizen Healthcare Coverage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RPkiSm11zOecVvnpuZ5VVH> ],
        <R2KPYsdWkWMbWmP6hpsr2c> ;
    skos:definition "This refers to healthcare plans specifically designed to cater to the needs of individuals who are in their senior years, generally those 65 and older. In the U.S., Medicare is the primary provider of healthcare coverage for seniors, offering various plans that include hospital stays, medical services, and prescription drugs." ;
    skos:prefLabel "Elderly Healthcare Coverage" .

<RDb7mHsQQLLSVsxIdQivBMB> a owl:Class ;
    rdfs:label "Labor Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC1RuXMxvyeWXk4LhcJIxIu> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rfw7NfMHyrhfFQj8ob4M4U> ],
        <RCKyQq2d2O4kCcP6LbXtuCz> ;
    skos:altLabel "Employment Rights" ;
    skos:definition "Labor rights are the legal and social protections designed to ensure fair treatment, equitable wages, and safe working conditions for workers. These rights can include the freedom to organize and join labor unions, the right to collective bargaining, and protection from unlawful discrimination or harassment in the workplace." ;
    skos:prefLabel "Workers' Rights" .

<RDc33cOIljrKrMeiGE52rQp> a owl:Class ;
    rdfs:label "Vacancy" ;
