    skos:altLabel "Brother"^^xsd:string,
        "Consecrated Brother"^^xsd:string ;
    skos:definition "A Religious Brother is a male religious who publicly professes the evangelical counsels and lives community life within an institute of consecrated life without ordination to the priesthood. In monastic contexts, he is commonly called a monk and dedicates his life to prayer, work, and service according to a rule."^^xsd:string ;
