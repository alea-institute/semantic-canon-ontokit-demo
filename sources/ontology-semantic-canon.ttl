    rdfs:subClassOf <RD56727CABa3aB066e948fc1> ;
    skos:definition "This industry group comprises establishments primarily engaged in (1) acting as agents (i.e., brokers) in selling annuities and insurance policies or (2) providing other employee benefits and insurance related services, such as claims adjustment and third party administration." .

<MqQx3WSASiOOx-A9ARPHqw> a owl:Class ;
