    rdfs:subClassOf <RDIwFaFcH4KY0gwEY0QlMTp> ;
    skos:altLabel "Public Administration",
        "Öffentliche Verwaltung"@de-de,
        "Public Administration Industry"@en-gb,
        "Industria de la Administración Pública"@es-es,
        "Industria de la Administración Pública"@es-mx,
        "Industrie de l'administration publique"@fr-fr,
        "תעשיית המנהל הציבורי"@he-il,
