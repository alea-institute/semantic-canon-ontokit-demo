<RDeXT5Kv4E7Dr18IlbAMl0D> a owl:Class ;
    rdfs:label "Rest Break Violation Claim" ;
    rdfs:subClassOf <R92S2HIVThaRnO0lgcFKgIw> ;
    skos:altLabel "Verstoß gegen die Ruhepause geltend machen"@de-de,
        "Rest Break Violation Claim"@en-gb,
        "Reclamación por violación del descanso"@es-es,
        "Reclamo por violación del descanso"@es-mx,
        "Réclamation pour violation de pause"@fr-fr,
        "תביעה על הפרת מנוחה"@he-il,
        "आराम विराम उल्लंघन दावा"@hi-in,
        "休憩時間違反請求"@ja-jp,
        "Reivindicação de violação de intervalo de descanso"@pt-br,
        "休息时间违规索赔"@zh-cn ;
    skos:definition "A rest break violation claim is a legal action initiated by an employee against their employer for not complying with the legal requirement to provide rest breaks of a certain duration during the workday. The claim typically arises when an employer either denies or interrupts the rest break, does not provide the break in accordance with applicable labor laws, or requires the employee to perform work duties during the rest break. In some cases, employers may also be liable for rest break violations if they do not compensate employees for certain types of work performed during rest breaks." .

<RDebWvZPYljGPGcwuhNz4rR> a owl:Class ;
    rdfs:label "Missouri Circuit Court - McDonald County" ;
    rdfs:subClassOf <RDECjssxw76vdlahxiUTb4L> ;
    skos:definition "Missouri Circuit Court - McDonald County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters in McDonald County, Missouri." .

<RDef8aRK4pZQeql9eOhL7O3> a owl:Class ;
    rdfs:label "Small Intestine Transplantation" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/5.00-Digestive-Adult.htm#5_11> ;
    rdfs:subClassOf <RB6mWlc1WihUbnT7ztVcao5> ;
    skos:altLabel "Intestinal Transplant",
        "Small Bowel Transplantation" ;
    skos:definition "Small intestine transplantation is a surgical procedure where a diseased or non-functional small intestine is replaced with a healthy donor intestine. This transplant is typically performed for patients with severe intestinal failure or dysfunction who cannot absorb nutrients effectively through other means." .

<RDerBKRP3302MfXLaDAaHQn> a owl:Class ;
    rdfs:label "Episcopal Conference (Actor)" ;
    rdfs:subClassOf <RDMsL8T3t9qIU3TOdiJvQBN> ;
    skos:altLabel "Episcopal Assembly"^^xsd:string,
        "National Conference of Bishops"^^xsd:string ;
    skos:definition "An Episcopal Conference is a permanent institution through which the bishops of a country or defined territory exercise certain pastoral functions jointly for the faithful. It fosters coordinated teaching, governance, and pastoral action while respecting each diocesan bishop’s proper authority."^^xsd:string ;
    skos:example "Bishops collaborate through the episcopal conference on common concerns."^^xsd:string,
        "Each bishop retains authority over his own diocese despite conference actions."^^xsd:string,
        "The conference coordinates liturgical adaptations approved by the Holy See."^^xsd:string ;
    skos:prefLabel "Conference of Bishops"^^xsd:string .

<RDesaWHAeV52XIBg1EK2z8k> a owl:Class ;
    rdfs:label "Intern" ;
    rdfs:subClassOf <RBfgMJEBmJrI7Wp0zUjROJ3> ;
    skos:definition "An intern is an individual, often a student, who works temporarily for an organization to gain practical experience in a specific industry. Internships can be paid or unpaid and are often seen as a stepping stone to full-time employment." .

<RDesytbN8TFMKoWlfrwJAdk> a owl:Class ;
    rdfs:label "Wetland" ;
    rdfs:subClassOf <R9BC2mdYLFmSyLcCkV4odRX> ;
    skos:altLabel "Aquatic Ecosystem Zone",
        "Marshland" ;
    skos:definition "A Wetland Area is a type of land area characterized by the presence of water, either permanently or seasonally, and hosts specific types of vegetation and wildlife adapted to saturated conditions. Wetland areas are often subject to environmental regulations aimed at their protection, management, and conservation." ;
    skos:prefLabel "Floodplain" .

<RDexpiWmmK9xFb7iMaBJpcD> a owl:ObjectProperty ;
    rdfs:label "folio:reverted" ;
    rdfs:isDefinedBy <http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067> ;
    rdfs:subPropertyOf <RdpSPh3bFHYrQ3vYPDwJYB> ;
    skos:altLabel "reverted" ;
    skos:definition "In legal contexts, \"reverted\" refers to the act of returning to a previous state, condition, or set of circumstances, often as a result of a judicial decision or the operation of law. This term is typically used when rights, property, or legal status are restored to their former condition, either due to contractual stipulations, legal provisions, or court orders." .

<RDf1QQsIRXdoXon43LsVRNz> a owl:Class ;
