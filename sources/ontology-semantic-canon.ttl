<R9Huj7AR4M1laLv0PVxLDe> a owl:Class ;
    rdfs:label "Sin of Omission" ;
    rdfs:subClassOf <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Failure of Moral Duty"^^xsd:string,
        "Omitted Good"^^xsd:string,
        "Passive Sin"^^xsd:string,
        "Sin by Neglect"^^xsd:string ;
    skos:definition "Sin of Omission is a sin committed by failing to do what moral law, charity, or justice requires. Sin of Omission arises when a person freely neglects a duty that he or she has the ability and obligation to fulfill."^^xsd:string ;
    skos:example "A parent neglects the moral or material care owed to a child."^^xsd:string,
        "A person fails to help someone in serious need despite having the ability to do so."^^xsd:string,
        "A person ignores an obligation of charity out of indifference or fear."^^xsd:string,
        "A professional omits a required duty, causing foreseeable harm."^^xsd:string,
        "A witness remains silent when truth and justice require testimony."^^xsd:string .

<R9HvF7FfEi0bAHAm2QCwRUe> a owl:Class ;
    rdfs:label "Sick Leave" ;
    rdfs:subClassOf <RB2BaikN50BQY375QT0PEWD> ;
    skos:definition "Sick leave is a form of paid time off that allows employees to take time away from work when they are ill or need medical care. It is designed to ensure that employees can recover from illness without losing income." ;
    skos:prefLabel "Sick Day" .

<R9HyMVAp54g7Y2qHYFRfSeq> a owl:Class ;
    rdfs:label "Cheroenhaka (Nottoway)" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<R9I0nYrXSCGRN5gaGJRTypk> a owl:Class ;
    rdfs:label "Hunting License" ;
    rdfs:subClassOf <R9zyvDXyYEEyM7dTnON56uL> ;
    skos:definition "A hunting license is an official permit issued by a governing authority that grants individuals the legal right to hunt specific species of wildlife within designated areas and during specified seasons. To obtain a hunting license, applicants often must complete a hunter education course and adhere to established regulations, bag limits, and conservation measures. The license may have stipulations based on species, weapon type, and region." .

<R9I7IUYUmnVRQo4aTRWojbu> a owl:Class ;
    rdfs:label "Military Enrollment" ;
    rdfs:subClassOf <RC8JmK2y8Na9Itkk0MCtMS4> ;
    skos:definition "Military Enrollment refers to the process by which individuals join the armed forces, either voluntarily or through conscription. This initial phase includes a series of steps such as application, background checks, and basic training to prepare the individual for service." .

<R9IBK1C50E7u2akjOiYsVFx> a owl:Class ;
    rdfs:label "Negligent Spoliation of Evidence" ;
    rdfs:subClassOf <R7NwY5UT07qF3VkI8MYarxj> ;
    skos:altLabel "Fahrlässige Vernichtung von Beweismitteln"@de-de,
        "Negligent Spoliation of Evidence"@en-gb,
        "Dilación Negligente de Pruebas"@es-es,
        "Dilación Negligente de Pruebas"@es-mx,
        "Spoliation de preuves négligente"@fr-fr,
        "השחתת ראיות שגויה"@he-il,
        "लापरवाह साक्ष्य नष्ट"@hi-in,
        "過失による証拠隠滅"@ja-jp,
        "Destruição negligente de provas"@pt-br,
        "过失毁证"@zh-cn ;
    skos:definition "The intentional or reckless destruction or alteration of evidence by a party who had a duty to preserve it, resulting in the inability to use the evidence in a legal proceeding, due to their negligence." .

<R9INwIwwIifomch7DOeSFDg> a owl:Class ;
