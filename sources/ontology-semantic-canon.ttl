        "Delinquent youth halfway group homes",
        "Group homes for the disabled without nursing care",
        "Group homes for the hearing or visually impaired",
        "Halfway group homes for delinquents or ex-offenders",
        "Homes for unwed mothers",
        "Orphanages" .

<bA9EJfiTRXKdo7VwxuPsdg> a owl:Class ;
    rdfs:label "Gift, Novelty, and Souvenir Retailers" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=459420> ;
    rdfs:subClassOf <lzWt_lXURkmw_BjPtxi_JQ> ;
