    skos:example "Aircraft dealers",
        "All-terrain vehicle (ATV) dealers",
        "Moped dealers",
        "Motorcycle dealers",
        "Motorcycle parts and accessories dealers",
        "Personal watercraft dealers",
        "Powered golf cart dealers",
        "Snowmobile dealers",
        "Utility trailer dealers" .

<MyQL1VP2RnyEZR-OEZsF6g> a owl:Class ;
    rdfs:label "Offices of All Other Miscellaneous Health Practitioners" ;
