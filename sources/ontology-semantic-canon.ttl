<R7QWiAxrz8JDUrQnMjSWWkc> a owl:Class ;
    rdfs:label "Reptiles" ;
    rdfs:subClassOf <R8sd4v04cEXnzbttN2gUEpV>,
        <RDfwCFFw23Fb7WhqmrYLBqS> ;
    skos:definition "Reptiles are a class of vertebrate animals characterized by their dry, scaly skin, laying of amniotic eggs, and ectothermic metabolism. This diverse group includes lizards, snakes, turtles, and crocodiles, and they are primarily found in terrestrial habitats, although some species are adapted to aquatic environments." ;
    skos:prefLabel "Reptilia" .

<R7QXlJ9s0u5JTB6fZHW9nsP> a owl:Class ;
