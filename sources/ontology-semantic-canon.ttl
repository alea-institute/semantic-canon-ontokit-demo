    skos:definition "Colorado State Courts are the judicial branch of the Colorado state government, responsible for interpreting and enforcing state laws and resolving legal disputes within the state." ;
    skos:hiddenLabel "CO" ;
    skos:prefLabel "Colorado State Courts" .

<RCFFae11B860b38Db844E14a> a owl:Class ;
