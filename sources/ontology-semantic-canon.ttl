<R7pYWE5yneUU2vE894jKGGG> a owl:Class ;
    rdfs:label "Autonomy" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Freedom of Choice"^^xsd:string,
        "Moral Agency"^^xsd:string,
        "Personal Autonomy"^^xsd:string,
        "Self-Determination"^^xsd:string,
        "Self-Governance"^^xsd:string ;
    skos:definition "Autonomy is the ethical principle that recognizes a person’s capacity and right to make free and informed decisions about his or her own actions. Autonomy requires respect for conscience and rational agency while remaining ordered to truth and the objective moral good."^^xsd:string ;
    skos:example "A competent adult makes personal life decisions without coercion."^^xsd:string,
        "A patient freely consents to a medical procedure after receiving adequate information."^^xsd:string,
        "A person declines participation in an action that violates deeply held moral convictions."^^xsd:string,
        "A researcher respects a participant’s right to withdraw from a study at any time."^^xsd:string,
        "An individual forms a moral judgment according to a well-formed conscience."^^xsd:string .

