    skos:definition "A court located in Union County, New Mexico that has limited jurisdiction over certain types of cases." .

<RzqZHFcPdOltkkfOpukuYT> a owl:Class ;
    rdfs:label "Real Estate Broker's Liability to Prospective Purchaser for Failure to Inspect and Disclose" ;
    rdfs:subClassOf <RCfunX4u69LUQ3gbhckE0oI>,
        <RDp8cEr3KYyVDenm1P9ejdx> ;
    skos:altLabel "Haftung des Immobilienmaklers gegenüber potenziellen Käufern bei Nichtinspektion und Nichtoffenlegung"@de-de,
        "Responsabilité du courtier immobilier envers l'acheteur potentiel pour défaut d'inspection et de divulgation"@fr-fr,
        "不動産ブローカーの検査と開示の怠慢による潜在的な購入者への責任"@ja-jp,
        "Responsabilidade do corretor de imóveis para o comprador em potencial por falha em inspecionar e divulgar"@pt-br,
        "房地产经纪人未检查和披露对潜在购买者的责任"@zh-cn ;
    skos:definition "The legal responsibility of a real estate broker to a potential buyer for not inspecting and revealing information about a property." .

<Rzqx5UOno00GCvPYpSdWD5> a owl:Class ;
    rdfs:label "Contact Short Name" ;
    rdfs:subClassOf <R8zrphg3yY4ZZzvj2CAu6hN> ;
    skos:definition "Contact Short Name refers to an abbreviated or simplified name used to easily identify a person or entity. This shortened name may be used in databases, communications, or reports, and is usually derived from the client's full legal or DBA name for ease of reference." .

<RzrvyhxM3e9TKFbTTL2Huh> a owl:Class ;
    rdfs:label "Respiratory Failure" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/3.00-Respiratory-Adult.htm#3_14> ;
    rdfs:subClassOf <RcqrMBmLwAweHAkomaAaNq> ;
    skos:altLabel "Prolonged Respiratory Failure" ;
    skos:definition "Respiratory failure is a serious condition in which the respiratory system fails to adequately exchange oxygen and carbon dioxide, leading to insufficient oxygenation of the blood or inadequate removal of carbon dioxide. This condition, resulting from chronic respiratory disorders, requires invasive mechanical ventilation, noninvasive ventilation with bilevel positive airway pressure (BiPAP), or a combination of both treatments for a continuous period of at least 48 hours, or at least 72 hours if postoperative." ;
    skos:prefLabel "Chronic Respiratory Failure" .

<RzujIHyLZLQTcyZMUFLsDq> a owl:Class ;
    rdfs:label "Minnesota District Court - Dodge County" ;
    rdfs:subClassOf <RxLV9XEaDWbDIA8N1fl2fM> ;
    skos:definition "Minnesota District Court - Dodge County is a specific court within the Minnesota District Court system that has jurisdiction over legal matters within Dodge County, Minnesota." .

<RzwEONnxUELw6N9WvbCTth> a owl:Class ;
