<R8C21XIcxp9SGBNeg8jgUaU> a owl:Class ;
    rdfs:label "Amusement, Gambling, and Recreation Industry" ;
    dc:identifier "MEN-AMUS" ;
    rdfs:subClassOf <R7BZzP16LxkLJjYqRNwWXP> ;
    skos:altLabel "Amusement, Gambling, and Recreation Industries",
        "Freizeit-, Glücksspiel- und Erholungsbranche"@de-de,
        "Amusement, Gambling, and Recreation Industry"@en-gb,
        "Industria del ocio, juego y recreación"@es-es,
        "Industria del entretenimiento, juego y recreación"@es-mx,
        "Industrie des loisirs, des jeux d'argent et de la détente"@fr-fr,
        "תעשיית הבידור, ההימורים והפנאי"@he-il,
