            owl:someValuesFrom <RB4GQZ26zq1PJ9m6vGUuoiy> ],
        <RdfKnWpXsG2eBmnS3oJNTF> ;
    skos:definition "Trusts and Estate Planning Events refer to significant occurrences, like death, funeral, or incapacity, that trigger the provisions and directives outlined in estate planning documents. Such events necessitate actions like asset distribution, trust activation, or execution of end-of-life directives to ensure the deceased or incapacitated individual's wishes are honored." .

<R8oBTLovip7JQGJ9AeOmmCD> a owl:Class ;
    rdfs:label "Antitrust - Horizontal Claims" ;
    rdfs:subClassOf <RCFPWMbdFLbplboOqvI77Jh> ;
    skos:altLabel "Wettbewerbsrecht - horizontale Ansprüche"@de-de,
        "Antitrust - Horizontal Claims"@en-gb,
        "Antimonopolio - Reclamaciones horizontales"@es-es,
