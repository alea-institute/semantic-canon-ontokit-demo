        "Prisão"@pt-br,
        "监禁"@zh-cn ;
    skos:definition "Imprisonment refers to the legal act of confining a person to a specific location, typically a prison or jail, as a result of a litigation event." ;
    skos:prefLabel "Jailing" .

<R6NLFwVRdI5dCvtQ1dm4f2> a owl:Class ;
