    skos:definition "A sealed document is a legal record that is kept confidential and is not accessible to the public or even to parties in a case unless permitted by the court. The sealing of a document restricts its availability to protect sensitive information, trade secrets, or to comply with privacy laws and regulations." ;
    skos:prefLabel "Sealed" .

<RDYXXp95X3xGt2LwsMQcos4> a owl:Class ;
