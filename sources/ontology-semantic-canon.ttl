<RBFzEhwwWr6rYGWQPP62wVH> a owl:Class ;
    rdfs:label "Beneficence" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Active Benevolence"^^xsd:string,
        "Altruistic Responsibility"^^xsd:string,
        "Charitable Action"^^xsd:string,
        "Doing Good"^^xsd:string,
        "Positive Moral Duty"^^xsd:string ;
    skos:definition "Beneficence is the ethical principle that directs persons to act for the good of others. Beneficence requires positive efforts to promote well-being, prevent harm, and advance authentic human flourishing."^^xsd:string ;
    skos:example "A caregiver acts to prevent foreseeable harm to a dependent person."^^xsd:string,
        "A charity provides food and shelter to those in need."^^xsd:string,
        "A physician recommends treatment that best promotes a patient’s overall health."^^xsd:string,
        "A public official designs policies to improve community well-being."^^xsd:string,
        "A researcher adjusts a study protocol to protect participants’ welfare."^^xsd:string .

