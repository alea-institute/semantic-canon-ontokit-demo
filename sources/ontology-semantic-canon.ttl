<RxRPFp7YGDk41u5iwczwzi> a owl:Class ;
    rdfs:label "Betrayal by Judas" ;
    rdfs:subClassOf <R8hw8N5f6CCS519HZccaPdl> ;
    skos:altLabel "Betrayal of Jesus by Judas"^^xsd:string,
        "Judas’ Betrayal"^^xsd:string,
        "Treachery of Judas Iscariot"^^xsd:string ;
    skos:definition "Betrayal by Judas means the act by which Judas Iscariot handed Jesus over to the authorities by identifying him with a kiss. Betrayal by Judas fulfills Scripture and marks the immediate precipitating cause of Jesus’ arrest and Passion."^^xsd:string ;
    skos:example "Christian theology interprets the betrayal by Judas as a grave act of treachery within the unfolding of salvation history."^^xsd:string,
        "The Gospels recount Judas betraying Jesus with a kiss in the Garden of Gethsemane."^^xsd:string ;
    skos:prefLabel "Kiss of Judas"^^xsd:string .

