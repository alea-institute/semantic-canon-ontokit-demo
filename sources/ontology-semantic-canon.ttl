    skos:hiddenLabel "RESC" .

<RS4MNLzEw9KGWGaiRAbgdF> a owl:Class ;
    rdfs:label "Governmental Branch" ;
    rdfs:subClassOf <RBQGborh1CfXanGZipDL0Qo> ;
    skos:definition "The branches of government typically refer to the three main divisions of a democratic system: the legislative, which makes laws; the executive, which enforces and administers laws; and the judicial, which interprets laws. These branches are designed to balance power and ensure that no single entity has unchecked authority." ;
    skos:prefLabel "Branches of Government" .

<RadAvJ7EdvJm13pHxKGCSa> a owl:Class ;
