<R8D6zCNSxUO8g0ZstLxnK28> a owl:Class ;
    rdfs:label "Chronic Obstructive Pulmonary Disease" ;
    rdfs:subClassOf <RcqrMBmLwAweHAkomaAaNq> ;
    skos:altLabel "COPD" ;
    skos:definition "Chronic Obstructive Pulmonary Disease (COPD) is a progressive respiratory condition characterized by persistent airflow limitation due to chronic inflammation of the airways and lung tissue. The most common forms of COPD are chronic bronchitis and emphysema, leading to symptoms such as chronic cough, breathlessness, and reduced lung function, necessitating ongoing management and treatment." ;
    skos:prefLabel "Chronic Respiratory Disease" .

<R8EoZh39tWmXCkmP2Xzjl6E> a owl:Class ;
