    rdfs:subClassOf <R8hdJfF8TO1kOvUijgwk9k> ;
    skos:altLabel "Bench Trial",
        "Bench Trial"@de-de,
        "Bench Trial"@en-gb,
        "Juicio sin jurado"@es-es,
        "Juicio de banco"@es-mx,
        "Procès sans jury"@fr-fr,
        "משפט בפני ערך"@he-il,
        "बेंच ट्रायल"@hi-in,
        "裁判員裁判"@ja-jp,
        "Julgamento sem júri"@pt-br,
        "法官裁定"@zh-cn ;
    skos:definition "A bench trial is a trial by judge or panel of judges, as opposed to a trial by jury." ;
    skos:hiddenLabel "TRIBEN" .

