    rdfs:subClassOf <RBLAHsgfwEzyP8N8VTMdgmM> ;
    skos:altLabel "Autistic Disorder with Language Deficits" ;
    skos:definition "Autism Spectrum Disorder with Language Impairment is characterized by deficits in social communication and interaction, alongside restricted, repetitive patterns of behavior or interests. Individuals with this condition exhibit significant difficulties with language development and usage, impacting their ability to communicate effectively and engage in social interactions." ;
    skos:prefLabel "Autistic Spectrum Disorder with Communication Impairment" .

<RBgl3tnuy31G2edlQGJSWWM> a owl:Class ;
