<R7nPK8iVZiiW2HLs0guuVLO> a owl:Class ;
    rdfs:label "Social Friendship" ;
    rdfs:comment "In a global Catholic ontology, Social Friendship represents the innovative vision of Pope Francis articulated in Fratelli tutti. It moves beyond the legalistic definitions of peace to describe a love that reaches across borders, social classes, and ideologies to build a universal brotherhood."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RB4yg0TUPW2kfmcnhwGTCIV> ],
        <R9X6xDAYYSYwCeCqMHt5G75> ;
    skos:altLabel "Fratelli tutti"^^xsd:string,
        "Universal Fraternity"^^xsd:string ;
    skos:definition "Social Friendship is a distinct form of charity that seeks the common good through the intentional building of fraternal bonds between diverse members of the human family. It demands a culture of encounter where the dignity of every person is recognized, moving society past the \"culture of walls\" toward a shared commitment to global solidarity."^^xsd:string .

<R7nYjWxGQdHVUZcYq7nUpSZ> a owl:Class ;
