<RCrIpl5MlPNmRIXmXmMt78P> a owl:Class ;
    rdfs:label "Guardian Angel Prayer" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RyTfHxUQPVMUQrtIt1Mycz> ;
    skos:altLabel "Angel of God Prayer"^^xsd:string,
        "Guardian Angel Devotion"^^xsd:string ;
    skos:definition "Guardian Angel Prayer is a traditional Catholic prayer that asks one’s guardian angel for protection, guidance, and illumination throughout daily life. It expresses trust in God’s providence exercised through angelic care."^^xsd:string ;
    skos:example """Angel of God,
my guardian dear,
To whom God's love
commits me here,
Ever this day,
be at my side,
To light and guard,
Rule and guide."""^^xsd:string,
        "At the start of the school day, the teacher led students in the Guardian Angel Prayer."^^xsd:string,
        "Before going to sleep, the child prayed the Guardian Angel Prayer at the bedside."^^xsd:string,
        "During morning prayer, he recited the Guardian Angel Prayer to seek guidance and protection."^^xsd:string .

