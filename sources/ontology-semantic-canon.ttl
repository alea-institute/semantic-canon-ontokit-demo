    rdfs:subClassOf <feRSrU7jSMuNLYyfCK3qcg> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in the commercial catching or taking of marine animals (except finfish and shellfish)." .

<kgNqfc5QQH21ebNgUflj5w> a owl:Class ;
    rdfs:label "Line-Haul Railroads" ;
