<yPIW4uCrQPmTqbzwxIf0bQ> a owl:Class ;
    rdfs:label "Solid Waste Combustors and Incinerators" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=562213> ;
    rdfs:subClassOf <nEU9oAnvS4GKVFPRE4aqrA> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in operating combustors and incinerators for the disposal of nonhazardous solid waste. These establishments may produce byproducts, such as electricity and steam." .

<yUiU8D7sT0uIwx0oXS-yAA> a owl:Class ;
