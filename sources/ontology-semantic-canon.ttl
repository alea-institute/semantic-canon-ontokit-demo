    skos:definition "Industries in this group include establishments that: operate facilities where patrons can primarily engage in sports, recreation, amusement, or gambling activities and/or; provide other amusement and recreation services, such as supplying and servicing amusement devices in places of business operated by others; operating sports teams, clubs, or leagues engaged in playing games for recreational purposes; and guiding tours without using transportation equipment." ;
    skos:hiddenLabel "AMUS" .

<R8FLbODQd9k85hPERve6IN7> a owl:Class ;
    rdfs:label "Environmental Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCXo6eQMlbZx9milrSaYo1v> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBeZkopwGsxt3K5BXOgNBNF> ],
        <RCKyQq2d2O4kCcP6LbXtuCz> ;
    skos:definition "Environmental rights refer to the entitlements related to the protection of the natural environment and the right to live in a healthy and sustainable environment. These rights may include access to clean water and air, protection against environmental degradation, and the ability to participate in decisions affecting the environment." .

<R8GuYn7yMmfL0coiNQ0OE8f> a owl:Class ;
    rdfs:label "Immigrant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RqWYmNLhfvzysGhC75yUNw> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RJ4c5efwPEoWH1XeoJxiB4> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7SaXrn5D1aJju69qYJCWL6> ],
        <RD2KAbcnrk0vfpUCEog3N9F> ;
    skos:definition "An immigrant is an individual who moves to a country other than their country of origin with the intention of residing there permanently or for an extended period. The reasons for immigration can vary and may include seeking employment opportunities, better living conditions, or reunification with family." ;
    skos:prefLabel "Alien" .

<R8Q2ik3utpYM1LNPjwbkF4A> a owl:Class ;
    rdfs:label "Rosary's Joyful Mysteries" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RfIUmrXFSaK6jqyfB1cypX> ;
    skos:definition "Rosary’s Joyful Mysteries are a set of five mysteries of the Holy Rosary that contemplate the joyful events surrounding the Incarnation and early life of Jesus Christ. Rosary’s Joyful Mysteries direct meditation toward God’s saving action through Mary’s obedience, Christ’s humility, and the hidden life of the Holy Family."^^xsd:string ;
    skos:example "During Advent, the family emphasized the Rosary’s Joyful Mysteries in nightly prayer."^^xsd:string,
        "Joyful Mysteries of the Rosary"^^xsd:string,
        "The catechist explained that the Rosary’s Joyful Mysteries focus on Christ’s hidden life and Mary’s fiat."^^xsd:string,
        "While meditating on the Annunciation, she reflected on the first mystery of the Rosary’s Joyful Mysteries."^^xsd:string ;
    skos:prefLabel "Joyful Mysteries"^^xsd:string .

<R8Tktpdf3HuYd3nI7nf9xQU> a owl:Class ;
    rdfs:label "Psychographic Market Segment" ;
    rdfs:subClassOf <R8UG79BtYP2uqnKNklLYXB8> ;
    skos:altLabel "Consumer Interest Segments",
        "Interest Market Segments" ;
    skos:definition "Psychographic market segment refers to divisions of the market that are categorized based on what consumers think about and value, as well as how they live their lives, including consumers' specific interests, preferences, and passions. This category includes consumers who share a common interest or enthusiasm for particular products, services, activities, or priorities. These segments include areas like health-conscious, tech segment, sustainability segment, and others." ;
    skos:note "Non-copyrightable idea and fact inspiration drawn from IAB 2.0. https://www.meaningcloud.com/developer/documentation/predefined/deep-categorization-models/iab-2-0" ;
    skos:prefLabel "Preference-Based Market Segments" .

<R8VN5tK4TtD0GqDw2NCbaLr> a owl:Class ;
    rdfs:label "Obligee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8428LJEfCIiJBkESQPpEhQ> ],
        [ a owl:Restriction ;
