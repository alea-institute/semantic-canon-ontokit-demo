<R7oT3qg4wZmB5K3qC79EVID> a owl:Class ;
    rdfs:label "Christological Events" ;
    rdfs:subClassOf <REYZrQdidTmIiJf5n7mz2B> ;
    skos:altLabel "Christ-Centered Events"^^xsd:string,
        "Events in the Life of Christ"^^xsd:string ;
    skos:definition "Christological Events means events in Sacred Scripture that directly concern the person, identity, and saving work of Jesus Christ. Christological Events reveal Christ’s divine and human natures, his redemptive mission, and his central role in salvation history."^^xsd:string ;
    skos:example "The Gospel of Luke recounts the annunciation to Mary concerning the conception of Jesus."^^xsd:string,
        "The New Testament proclaims Jesus’ resurrection as the definitive victory over death."^^xsd:string,
        "The Transfiguration reveals Jesus’ divine glory to Peter, James, and John."^^xsd:string ;
    skos:prefLabel "Events of Jesus Christ"^^xsd:string .

