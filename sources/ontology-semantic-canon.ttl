    dc:source <https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_08> ;
    rdfs:subClassOf <R8paNAt8rFPV0BKzwRBKnQ4> ;
    skos:altLabel "Low Platelet Count" ;
    skos:definition "Thrombocytopenia is a medical condition characterized by a low platelet count in the blood, which can lead to increased bleeding and bruising. It results from either decreased production of platelets, increased destruction of platelets, or sequestration of platelets in the spleen." ;
    skos:prefLabel "Thrombocytopenia" .

