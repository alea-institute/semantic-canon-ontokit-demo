<RC50YHTrJRiQMAZO5mgyjjK> a owl:Class ;
    rdfs:label "Sports Ethics" ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Athletic Ethics"^^xsd:string,
        "Ethics in Athletics"^^xsd:string,
        "Ethics of Sport"^^xsd:string,
        "Sporting Ethics"^^xsd:string ;
    skos:definition "Sports ethics is the normative evaluation of conduct, rules, and institutions in athletic activity, focusing on fairness, integrity, safety, and respect for persons. It examines how competition, training, governance, and commercialization promote or undermine human flourishing and the common good."^^xsd:string ;
    skos:example "A coach removed a player from competition after a concussion to protect long-term health."^^xsd:string,
        "A league disciplined an athlete for doping after laboratory testing confirmed the violation."^^xsd:string,
        "A sports federation revised eligibility rules to promote competitive fairness and inclusion."^^xsd:string,
        "A youth program limited training intensity to match participants’ developmental stages."^^xsd:string,
        "An official recused themselves from a match due to a conflict of interest."^^xsd:string,
        "Athlete Health and Safety"^^xsd:string,
        "Coaching Ethics"^^xsd:string,
        "Doping and Performance Enhancement Ethics"^^xsd:string,
        "Officiating Ethics"^^xsd:string,
        "Youth Sports Ethics"^^xsd:string .

