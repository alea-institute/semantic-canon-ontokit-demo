<R8k7Nk5pFGXNNV0rDCN83wV> a owl:Class ;
    rdfs:label "Employment Title" ;
    rdfs:subClassOf <RGOU62BPz1QTVsWRE2Nodz> ;
    skos:definition "Employment Title refers to the formal designation given to a specific job position within an organization, such as \"Software Engineer,\" \"Marketing Manager,\" or \"Legal Counsel.\" The title is often used to signify the roles and responsibilities of the position, and may also indicate the employee's rank or level within the organizational hierarchy" .

<R8kFUc6asww50zagzd2HtG7> a owl:Class ;
    rdfs:label "Baptism by Immersion" ;
    rdfs:subClassOf <RB9nahq2xaGnFjLrP4TCfdV> ;
    skos:altLabel "Baptism by Full Immersion"^^xsd:string,
        "Immersion Baptism"^^xsd:string,
        "Immersive Baptism"^^xsd:string ;
    skos:definition "Baptism by Immersion is a mode of Baptism by Water in which the person is wholly or partially immersed in natural water while the Trinitarian formula is pronounced. It visibly signifies dying and rising with Christ through sacramental rebirth."^^xsd:string ;
    skos:example "Baptism by immersion symbolizes dying and rising with Christ."^^xsd:string,
        "Immersion is an ancient and fully valid mode of baptism."^^xsd:string .

<R8kJiXXQgVo4W6AjgldSQWj> a owl:Class ;
