        "オークション"@ja-jp,
        "Leilão"@pt-br,
        "拍卖"@zh-cn ;
    skos:definition "An auction is a legal event where goods or property are sold to the highest bidder, typically as part of a bankruptcy or restructuring process." .

<R8mhyaytzU3aWKoT5W7nlls> a owl:Class ;
