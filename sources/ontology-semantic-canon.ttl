    rdfs:subClassOf <F0ZuOpBBQameXhSNJBFSaQ> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in manufacturing ophthalmic goods. Examples of products made by these establishments are prescription eyeglasses (except grinding lenses in a retail setting), contact lenses, sunglasses, eyeglass frames, reading glasses made to standard powers, and protective eyewear." .

<AJ5lzURcSlq6HlldFTfz-g> a owl:Class ;
    rdfs:label "All Other Grain Farming" ;
