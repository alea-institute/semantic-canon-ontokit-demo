<RXhRW62NYQ5imtM7qjDgH0> a owl:Class ;
    rdfs:label "Homeowners Association Forclosure" ;
    rdfs:subClassOf <RsCr2ffuxk4pqU5CQ8SAxq> ;
    skos:definition "Homeowners Association Foreclosure is the legal process by which a Homeowners Association (HOA) takes possession of a property within its jurisdiction due to the homeowner's failure to pay association fees or fines. The property is subsequently sold to satisfy the outstanding debt, and the process is governed by state laws and the HOA's governing documents." ;
    skos:prefLabel "HOA Foreclosure" .

<RXnlQU3DRiWI6bIqVpQ3XM> a owl:Class ;
