<R6Ac48SBKrXaFuJ58XrecO> a owl:Class ;
    rdfs:label "Governmental Ethics" ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Administrative Ethics"^^xsd:string,
        "Civic Ethics"^^xsd:string,
        "Ethics in Government"^^xsd:string,
        "Public Sector Ethics"^^xsd:string ;
    skos:definition "Governmental ethics is the normative evaluation of conduct, decision-making, and institutions within public governance. It addresses integrity, accountability, transparency, and the responsible exercise of public power in service of the common good."^^xsd:string ;
    skos:example "A civil servant refused a gift from a regulated entity to avoid undue influence."^^xsd:string,
        "A public official disclosed a financial interest, then recused themselves from a procurement decision."^^xsd:string,
        "A regulatory body adopted clear criteria to ensure consistent treatment of similarly situated parties."^^xsd:string,
        "An agency published internal policies to allow public scrutiny of decision-making processes."^^xsd:string,
        "An inspector general investigated misuse of public funds and reported findings to the legislature."^^xsd:string,
        "Civil Service Ethics"^^xsd:string,
        "Conflict of Interest in Government"^^xsd:string,
        "Corruption Prevention"^^xsd:string,
        "Ethics of Policy-Making"^^xsd:string,
        "Government Fairness and Impartiality"^^xsd:string,
        "Governmental Transparency and Accountability"^^xsd:string,
        "Integrity in Public Office"^^xsd:string,
        "Public Resource Stewardship"^^xsd:string .

