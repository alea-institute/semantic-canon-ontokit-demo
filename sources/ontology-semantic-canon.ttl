    rdfs:subClassOf <R79aItNTJQwHgR002wuX3iC> ;
    skos:definition "A file type that usually contains other files or directories that have been compressed." .

<R8uMgFwwOTwfOpkGF733wx9> a owl:Class ;
    rdfs:label "Florida Circuit Court - Osceola County - 9th Circuit Court" ;
    rdfs:subClassOf <R3Q1HDu5jO8nvhdbr2Uj0c> ;
    skos:definition "A Florida Circuit Court located in Osceola County that operates within the 9th Circuit Court jurisdiction." .

<R8uPIk7OdU6TA8qkpovKICu> a owl:Class ;
