<RDnbxazqAWfPyFjrjdnj3Ha> a owl:Class ;
    rdfs:label "Ambulatory Health Care Services Industry" ;
    dc:identifier "HTC-AHCS" ;
    rdfs:subClassOf <RCSG4k3ah1Pu5YgPexPgOmL> ;
    skos:altLabel "Ambulatory Health Care Services",
        "Ambulante Gesundheitsdienstleistungsbranche"@de-de,
        "Ambulatory Health Care Services Industry"@en-gb,
        "Industria de servicios de atención médica ambulatoria"@es-es,
        "Industria de servicios de atención médica ambulatoria"@es-mx,
        "Industrie des services de soins ambulatoires"@fr-fr,
        "תעשיית שירותי טיפול ברפואה סיעודית"@he-il,
        "अम्बुलेटरी स्वास्थ्य देखभाल सेवाएं उद्योग"@hi-in,
        "外来医療サービス産業"@ja-jp,
        "Indústria de serviços de saúde ambulatorial"@pt-br,
        "门诊医疗服务行业"@zh-cn ;
    skos:definition "Industries in this group provide health care services directly or indirectly to ambulatory patients and do not usually provide inpatient services. Health practitioners in this subsector provide outpatient services, with the facilities and equipment not usually being the most significant part of the production process. This group includes offices of physicians, dentists, chiropractors, optometrists, psychologists, mental health practitioners, podiatrists, etc." ;
    skos:hiddenLabel "AHCS" .

<RDx4PuWu7ZznwNEGW6rXll0> a owl:Class ;
