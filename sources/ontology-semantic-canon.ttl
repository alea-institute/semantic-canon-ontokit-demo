    rdfs:subClassOf <MwnaQpgaQMKZakdQuETm4g> ;
    skos:definition "This industry comprises establishments primarily engaged in providing still, video, or digital photography services.  These establishments may specialize in a particular field of photography, such as commercial and industrial photography, portrait photography, and special events photography.  Commercial or portrait photography studios are included in this industry." .

<mNcLJvWOTFaGZevzn_LXQA> a owl:Class ;
