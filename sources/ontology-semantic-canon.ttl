<RLbnDn37fORF1YNLKZiLIV> a owl:Class ;
    rdfs:label "Socio-economic Ethics"^^xsd:string ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Social Ethics"^^xsd:string,
        "Social and Economic Ethics"^^xsd:string,
        "Societal Ethics"^^xsd:string ;
    skos:definition "Socio-economic ethics is the ethical evaluation of economic and social systems, policies, and practices as they affect human dignity, justice, solidarity, and the common good. It judges wealth, labor, markets, and institutions by how they serve persons—especially the poor—and how they order social life toward integral human flourishing."^^xsd:string ;
    skos:example "Socio-economic ethics applies subsidiarity to determine appropriate levels of governance."^^xsd:string,
        "Socio-economic ethics critiques labor practices that undermine worker dignity."^^xsd:string,
        "Socio-economic ethics evaluates whether economic policies promote integral human development."^^xsd:string,
        "Socio-economic ethics guides responses to poverty through justice rather than charity alone."^^xsd:string,
        "Socio-economic ethics informs debates about wealth inequality and social responsibility."^^xsd:string ;
    skos:prefLabel "Socioeconomic Ethics"^^xsd:string .

