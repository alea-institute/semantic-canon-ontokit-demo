        "Independent theatrical lighting technicians" .

<nYVXguBtTOCqYJ4mWdz52g> a owl:Class ;
    rdfs:label "Petroleum Lubricating Oil and Grease Manufacturing" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=324191> ;
    rdfs:subClassOf <tIcmYcXQQkyqFjsOLEbcQQ> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in blending or compounding refined petroleum to make lubricating oils and greases and/or re-refining used petroleum lubricating oils." .

<nbJo8kf2RH6SCxduI8LuJg> a owl:Class ;
