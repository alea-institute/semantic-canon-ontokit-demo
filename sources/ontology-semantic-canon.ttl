        <RDqSn32zsjxExcBFzIYxT2D> ;
    skos:altLabel "Gewaltsames Eindringen und Zurückhalten"@de-de,
        "Forcible Entry and Detainer"@en-gb,
        "Desahucio por la fuerza"@es-es,
        "Desalojo forzoso"@es-mx,
        "Effraction et détention forcée"@fr-fr,
        "כניעה וכניעה חוזרת"@he-il,
        "बलप्रयोग और दखल-दवाब"@hi-in,
        "不法侵入および立ち退き"@ja-jp,
        "Invasão de domicílio e despejo forçado"@pt-br,
        "非法侵入和驱逐"@zh-cn ;
    skos:definition "The concept of Forcible Entry and Detainer refers to the illegal act of entering and taking possession of someone else's property without their consent, and the legal actions that can be taken to remove the trespasser and regain possession of the property." .

<RZJZNdSy3FUyGbADv9IdRF> a owl:Class ;
    rdfs:label "Head of State or Government" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC6aqtaoqNvoQggYxN1RQKg> ],
        <RD0eI0kZbrRDzdWWH6WoOGN> ;
    skos:definition "The Head of State or Government is the highest-ranking official in a country, responsible for either ceremonial duties, executive powers, or both, depending on the form of government. In some countries, the roles of Head of State and Head of Government are separate, with the former often being a monarch or president and the latter usually being a prime minister or chancellor." .

<RZt6wRozUsGTgVqOixInL5> a owl:Class ;
    rdfs:label "Visa for Artist or Entertainer in a Reciprocal Exchange Program" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rj8CP6YnshKY7MmCXaiuY1> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7Zwd84vqcynsz8PsQJt7xj> ],
        <RD1oQDMlC6FytjOndhJTMy8> ;
    skos:altLabel "P-2 Visa" ;
    skos:definition "This visa (in the U.S., the P-2 visa) is designed for artists or entertainers who will perform as part of a reciprocal exchange program between an organization in the destination country (e.g., U.S.) and an organization in another country. In the United States, the P-2 visa allows for a temporary stay tied to the duration of the specific performance or event, generally for a period of up to one year, with options for extension" .

<Ra3Zq5bHGGG3OhZhxSNyk4> a owl:Class ;
    rdfs:label "Respect for Human Dignity" ;
    rdfs:subClassOf <R9F1zhfl4EiAf0VCEYCEnon> ;
    skos:altLabel "Human Dignity Respect"^^xsd:string,
        "Protection of Human Life"^^xsd:string,
        "Respect for the Human Person"^^xsd:string,
        "Reverence for Human Worth"^^xsd:string ;
    skos:definition "Respect for Human Dignity is the moral principle that requires honoring the inherent worth of every human person in thought, word, and action. Respect for Human Dignity forbids treating any person merely as a means and obliges protection of life, freedom, and moral integrity."^^xsd:string ;
    skos:example "Respect for human dignity grounds opposition to torture and human trafficking."^^xsd:string,
        "Respect for human dignity guides ethical limits on medical and scientific experimentation."^^xsd:string,
        "Respect for human dignity prohibits treating workers as disposable resources."^^xsd:string,
        "Respect for human dignity requires humane care for the sick and dying."^^xsd:string .

<RaE0yNxl79wosO0dNpKTnw> a owl:Class ;
    rdfs:label "Trial Court Forum" ;
    rdfs:subClassOf <R9MgbwX1P8fNJNx3EbF0gnu> ;
    skos:definition "A Trial Court Forum is a level of court forum where legal proceedings are conducted and judgments are made, typically involving the presentation of evidence and witnesses." .

<RaSUkwgm6NE3TznRNysK9M> a owl:Class ;
    rdfs:label "National Upper House Legislator" ;
    rdfs:subClassOf <RmafyqOLdKzHzFsjz4ro2r> ;
    skos:altLabel "Member of Upper House",
        "Upper Chamber Member" ;
    skos:definition "A National Upper House Legislator is a member of the higher chamber in a bicameral national legislature, typically responsible for providing a check on the lower house and representing broader state or regional interests. This official participates in crafting, debating, and voting on national legislation, often with special powers such as confirming executive appointments or ratifying treaties." ;
    skos:example "U.S. Senator" ;
    skos:prefLabel "U.S. Senator" .

<Raw03V8d0o2ILRa4VEpq4t> a owl:Class ;
    rdfs:label "Data Breach" ;
    rdfs:subClassOf <RKUCwOJGfYiSc7zU1qkhAS> ;
    skos:definition "A \"Data Breach\" refers to an incident in which unauthorized individuals gain access to confidential data, often resulting in the exposure or theft of sensitive information. Such breaches can compromise personal, financial, or business-related data, posing risks to individuals, organizations, and stakeholders." .

<Rb1mDAxtz3ATD5BGqdp2Qm> a owl:Class ;
    rdfs:label "Translation Version" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7SWDfYuq2ExnV9WkGTLhyA> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDOvAHsvY8TKJ1O1orXPM9o> ],
        <R9rAx8tTZaguHOK8Gku2h8L> ;
    skos:definition "Translation Version is a specific rendering of a source text into another language, distinguished by translation philosophy, wording, and ecclesial approval status. It identifies which translated form governs citation, proclamation, study, or normative use."^^xsd:string ;
    skos:prefLabel "Translation"^^xsd:string .

<Rbu3eo1hVQwnxZ4CADqtBw> a owl:Class ;
    rdfs:label "Occupational Authority" ;
    rdfs:subClassOf <R8L6V5AA4I5wcDrZtJjGLRb> ;
    skos:altLabel "Professional Authority"^^xsd:string,
        "Workplace Authority"^^xsd:string ;
    skos:definition "Occupational Authority is the moral authority exercised within a work or professional context to direct tasks, roles, and conduct toward the profession's or employment's legitimate ends. Occupational Authority binds those who exercise it to respect the dignity of workers and to order labor toward the common good."^^xsd:string ;
    skos:example "A department head delegates authority to complete a defined project."^^xsd:string,
        "A professional body enforces ethical standards within a vocation."^^xsd:string .

<RbxVEZPis7iHhky06utRnR> a owl:Class ;
    rdfs:label "Interior Sin" ;
    rdfs:subClassOf <R7M4dFUNY2TqtFocZDZHld> ;
    skos:altLabel "Internal Sin"^^xsd:string,
        "Inward Sin"^^xsd:string,
        "Sin of the Heart"^^xsd:string ;
    skos:definition "Interior Sin is sin committed within the inner life of the person through thought, desire, intention, or consent of the will, even without external action. Interior Sin remains morally real because moral evaluation attaches to the will and intention, not only to outward behavior."^^xsd:string ;
    skos:example "A person commits interior sin by willingly nurturing hatred or resentment."^^xsd:string,
        "A person knowingly entertains a desire for another’s harm and consents to it internally."^^xsd:string,
        "Interior sin includes consenting to prideful or vengeful intentions."^^xsd:string,
        "Interior sin occurs when a person deliberately fosters lustful thoughts without external action."^^xsd:string .

<RcFMyoBqiU6MFHzWCgwUUm> a owl:Class ;
