<R8Pogwk8dsFkGt4xSX5aqXU> a owl:Class ;
    rdfs:label "Responsibility" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Accountability"^^xsd:string,
        "Answerability"^^xsd:string,
        "Collective Responsibility"^^xsd:string,
        "Moral Responsibility"^^xsd:string,
        "Personal Accountability"^^xsd:string,
        "Stewardship Obligation"^^xsd:string,
        "Stewardship Responsibility"^^xsd:string ;
    skos:definition "Responsibility is the ethical principle that obliges persons to answer for their actions and omissions in light of their freedom, roles, and duties. Responsibility orders moral agency toward accountability, faithful stewardship, and care for the consequences of one’s choices."^^xsd:string ;
    skos:example "Responsibility directs leaders to account for decisions affecting others."^^xsd:string,
        "Responsibility guides parents to provide for their children’s material and moral needs."^^xsd:string,
        "Responsibility obliges professionals to fulfill duties associated with their roles."^^xsd:string,
        "Responsibility requires a person to accept the consequences of freely chosen actions."^^xsd:string,
        "Responsibility supports stewardship of resources entrusted to one’s care."^^xsd:string .

<R8PwWb18KA69NQK0efCC0a6> a owl:Class ;
    rdfs:label "Parable of the Good Samaritan" ;
    rdfs:subClassOf <R9rCbt2Rlk0Nw3UJ6rbp5gB> ;
    skos:altLabel "Good Samaritan Parable"^^xsd:string,
        "Parable of Neighborly Mercy"^^xsd:string,
        "Parable of the Merciful Samaritan"^^xsd:string ;
    skos:definition "Parable of the Good Samaritan means the teaching in which Jesus Christ describes a Samaritan who shows mercy to a wounded man when others pass by. Parable of the Good Samaritan reveals that love of neighbor transcends ethnic, religious, and social boundaries and defines authentic discipleship."^^xsd:string ;
    skos:example "Act of Mercy Toward the Wounded Man"^^xsd:string,
        "Call to Imitate Mercy"^^xsd:string,
        "Christian moral teaching interprets the Good Samaritan as the model of active love of neighbor."^^xsd:string,
        "Redefinition of Neighbor"^^xsd:string,
        "The Gospel of Luke recounts a Samaritan caring for a man wounded by robbers on the road to Jericho."^^xsd:string .

