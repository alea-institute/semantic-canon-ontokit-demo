    skos:hiddenLabel "INEX" .

<RDuvu3dUJz2utfkB5G6RviW> a owl:Class ;
    rdfs:label "Visual Field Loss" ;
    rdfs:subClassOf <R8aoLYQoIooB9xRkhiMtgR4> ;
    skos:definition "Visual Field Loss refers to a reduction or loss of the normal field of vision, affecting peripheral or central sight. This condition can result from various underlying causes such as glaucoma, stroke, or retinal damage, significantly impacting daily activities and the ability to navigate environments." ;
    skos:example "Central Vision Loss" .

<RDv8hBbEMrPuIgEyXvljAYY> a owl:Class ;
