    skos:altLabel "Archdiocesan Church"^^xsd:string,
        "Archiepiscopal See"^^xsd:string,
        "Metropolitan Archdiocese"^^xsd:string ;
    skos:definition "An Archdiocese is a particular church entrusted to an archbishop as its proper pastor and ordinary. It typically holds metropolitan status within an ecclesiastical province, exercising limited supervisory functions toward suffragan dioceses according to canon law."^^xsd:string ;
    skos:example "A metropolitan archdiocese presides over an ecclesiastical province."^^xsd:string,
        "An archdiocese coordinates ministries across parishes and institutions."^^xsd:string,
        "An archdiocese governs pastoral life under the leadership of an archbishop."^^xsd:string,
        "The cathedral serves as the principal church of the archdiocese."^^xsd:string .

<RCgHPUjj8sMRl3Do8koXLiG> a owl:Class ;
