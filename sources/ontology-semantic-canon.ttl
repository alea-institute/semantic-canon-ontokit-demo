    skos:definition "Asbestos Claims refer to legal claims made by individuals who have suffered harm due to exposure to asbestos, seeking compensation for damages such as medical expenses, lost wages, and pain and suffering." ;
    skos:prefLabel "Asbestos Exposure Claims" .

<RCVSYBROU6MtXETWw86DMH0> a owl:Class ;
    rdfs:label "Bury the Dead" ;
    rdfs:subClassOf <Ru9TAhxYKI0ZIOxJGezsYK> ;
    skos:altLabel "Burial of the Dead"^^xsd:string,
        "Care for the Dead"^^xsd:string,
        "Cemetery Care"^^xsd:string,
        "Funeral Care of the Deceased"^^xsd:string,
        "Funeral Rites Support"^^xsd:string,
        "Respectful Burial"^^xsd:string ;
    skos:definition "Bury the Dead is a corporal work of mercy that consists in ensuring the deceased receive respectful and dignified burial. Bury the Dead honors the human body, expresses hope in the resurrection, and comforts the living."^^xsd:string ;
    skos:example "A church provides burial assistance for those unable to afford funeral costs."^^xsd:string,
        "A community maintains gravesites as an act of remembrance and respect."^^xsd:string,
        "A parish assists a family in arranging funeral rites for a deceased loved one."^^xsd:string,
        "Burial Assistance for the Poor"^^xsd:string,
        "Care for Unclaimed Remains"^^xsd:string,
        "The faithful gather to pray for the dead and commend them to God’s mercy."^^xsd:string,
        "Volunteers ensure respectful burial for persons who die without family or resources."^^xsd:string .

<RCVScmAKNuwNtt98P0Wpvkn> a owl:Class ;
