<R7PX1rDXmNgCrkuDqtGGkIS> a owl:Class ;
    rdfs:label "Bus" ;
    rdfs:subClassOf <R1okJKMvv4mMHv7m4TzwBe> ;
    skos:definition "A bus is a large, motorized vehicle designed to transport multiple passengers. It is commonly used for public transportation and can vary in size and configuration, including city buses, school buses, and long-distance coaches." .

