<R9OCJDSLZnUbVwWxu2ddA5J> a owl:ObjectProperty ;
    rdfs:label "folio:affirmed" ;
    rdfs:domain <RDSYPGgBlFz5eWNtwoMA2c5> ;
    rdfs:isDefinedBy <http://docs.oasis-open.org/legaldocml/akn-core/v1.0/os/part1-vocabulary/akn-core-v1.0-os-part1-vocabulary.html#_Toc523925067> ;
    rdfs:subPropertyOf <RdpSPh3bFHYrQ3vYPDwJYB> ;
    skos:altLabel "affirmed",
        "upheld" ;
    skos:definition "In the context of appellate law, \"affirmed\" refers to the decision of an appellate court to uphold the ruling or decision of a lower court. This signifies that, upon review, the appellate court has found no significant legal error in the lower court's handling of the case and agrees with the conclusion reached." ;
    skos:prefLabel "folio:upheld" .

