    rdfs:subClassOf <R1EbxjQwzgikspixQygdfK> ;
    skos:altLabel "Statement for Purposes of Medical Diagnosis or Treatment" ;
    skos:definition "A Medical Treatment Statement is a hearsay exception that allows the admission of statements made for purposes of medical diagnosis or treatment. This exception is based on the belief that statements made to medical professionals are likely to be truthful because the declarant has a strong motivation to provide accurate information to receive proper care." ;
    skos:prefLabel "Medical Diagnosis Statement" .

<R7U1M4K5pt4eRGECPeztKAZ> a owl:Class ;
