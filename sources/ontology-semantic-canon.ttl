    skos:definition "This industry group comprises establishments manufacturing furniture related products, such as mattresses, blinds, and shades." .

<16SG-uYqRxia3OkgDaXBRA> a owl:Class ;
    rdfs:label "Lime and Gypsum Product Manufacturing" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=3274> ;
    rdfs:subClassOf <1fwWe7gBQpieS5cknXqvIg> ;
    skos:definition "This industry group comprises establishments primarily engaged in (1) manufacturing lime from calcitic limestone, dolomitic limestone, or other calcareous materials or (2) manufacturing gypsum products." .

<1n8WzhIBRJuB796TVihXfg> a owl:Class ;
    rdfs:label "Consumer Goods Rental" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=5322> ;
    rdfs:subClassOf <RDqvWcvBcUV4cKSUqlFKc4k> ;
    skos:definition "This industry group comprises establishments primarily engaged in renting personal and household-type goods. Establishments classified in this industry group generally provide short-term rental although in some instances, the goods may be leased for longer periods of time. These establishments often operate from a retail-like or storefront facility." .

<1tmAKTvUSTmbb1RU_rd4WQ> a owl:Class ;
    rdfs:label "Other Specialty Trade Contractors" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=2389> ;
    rdfs:subClassOf <pghJQ5LtTs2mdrNX0Qlf2Q> ;
    skos:definition "This industry group comprises establishments primarily engaged in site preparation activities and in specialized trades (except foundation, structure, and building exterior contractors; building equipment contractors; and building finishing contractors). The specialty trade work performed includes new work, additions, alterations, maintenance, and repairs." .

<1vxa6AN8TJa3-QTPxRNiDA> a owl:Class ;
    rdfs:label "Nonferrous Metal (except Copper and Aluminum) Rolling, Drawing, Extruding, and Alloying" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=33149> ;
    rdfs:subClassOf <851IJnH0SbCdeOgoqi0vZw> ;
    skos:definition "This industry comprises establishments primarily engaged in one or more of the following: (1) recovering nonferrous metals (except copper and aluminum) and nonferrous metal alloys from scrap; (2) alloying purchased nonferrous metals (except copper and aluminum); (3) rolling, drawing, and extruding shapes from purchased nonferrous metals (except copper and aluminum); and (4) recovering nonferrous metals from scrap (except copper and aluminum) and rolling, drawing, or extruding shapes in integrated facilities." .

<2Oxye5SjQYyEy3BmoxJcfQ> a owl:Class ;
    rdfs:label "All Other Miscellaneous Retailers" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=45999> ;
    rdfs:subClassOf <Y35yCdJSS8epkqV594aqDA> ;
    skos:definition "This industry comprises establishments primarily engaged in retailing miscellaneous specialized lines of merchandise (except motor vehicle and parts dealers; building material and garden equipment and supplies dealers; food and beverage retailers; furniture, home furnishings, electronics, and appliance retailers; general merchandise retailers; health and personal care retailers; gasoline stations and fuel dealers; clothing, clothing accessories, shoe, and jewelry retailers; sporting goods, hobby, and musical instrument retailers; book retailers and news dealers; florists; office supplies, stationery, and gift retailers; used merchandise retailers; pet and pet supplies retailers; art dealers; and manufactured (mobile) home dealers)." ;
    skos:example "Art supply retailers",
        "Cemetery memorial (e.g., headstones, markers, vaults) dealers",
        "Cigar retailers",
        "E-cigarette retailers",
        "Home security equipment retailers",
        "Swimming pool (above-ground) and supply retailers",
        "Tobacco retailers",
        "Vape shops" .

<2UU3O83LQWOr41rYmPHrdg> a owl:Class ;
