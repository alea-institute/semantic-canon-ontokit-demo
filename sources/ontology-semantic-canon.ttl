    rdfs:subClassOf <dN2iD83iS9eNVDIF5FKpEw> ;
    skos:definition "This U.S. industry comprises establishments known as medical laboratories primarily engaged in providing analytic or diagnostic services, including body fluid analysis, generally to the medical profession or to the patient on referral from a health practitioner." ;
    skos:example "Blood analysis laboratories",
        "Medical bacteriological laboratories",
        "Medical forensic laboratories",
        "Medical pathology laboratories",
        "Medical testing laboratories" .

<MUcQh1dDSZOjgTJqJLGPVA> a owl:Class ;
