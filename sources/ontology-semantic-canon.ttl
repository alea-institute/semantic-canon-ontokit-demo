    rdfs:subClassOf <RC5bITZZ0taJOXwcwS314VU> ;
    skos:altLabel "Verfügungsklauselanspruch"@de-de,
        "Disposing Clause Claim"@en-gb,
        "Reclamación de cláusula de disposición"@es-es,
        "Reclamación de cláusula de disposición"@es-mx,
        "Réclamation de clause de disposition"@fr-fr,
        "תביעת סעיף השטחה"@he-il,
        "विनियोजन धारा दावा"@hi-in,
