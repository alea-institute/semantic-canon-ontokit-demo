<R9WOb0bt92MYMFhZ3FFwROe> a owl:Class ;
    rdfs:label "Court Appointed" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RrTw7gZ2F0N6WBdARbUMAg> ],
        <R8nREeU6lB0zs0dt9N339nm> ;
    skos:definition "\"Court-appointed\" refers to an attribute where a judge selects and assigns an Actor (e.g., attorney, expert, professional), often to an individual who cannot afford legal representation. These appointments are often made in criminal cases or civil matters involving indigent parties to ensure access to legal counsel." .

<R9XbvULiDU6Lhqax71LzThw> a owl:Class ;
    rdfs:label "Overpayment of Public Benefit" ;
    rdfs:comment "From LIST: Legal Issues Taxonomy — https://taxonomy.legal/" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RgQLVqqo23cFKNa2n4P7wp> ],
        <R79ZRcChNA1jEORJLsPWYSv> ;
    skos:definition "Overpayment of public benefit occurs when an individual or family receives more financial assistance or services than they are entitled to under a specific public benefit program. This can happen due to administrative errors, fraud, or changes in the recipient's eligibility status, and often necessitates actions like repayment plans or legal proceedings to recover the excess funds." .

<R9Zpw6W6vllQC97Xj87kMAX> a owl:Class ;
    rdfs:label "Counterfeiting" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8dxOsfM0gsVdvh1SKyl4ub> ],
        <R7V9R3w28BDjOd4lLUUrvQ5> ;
    skos:altLabel "Fälschung"@de-de,
        "Counterfeiting"@en-gb,
        "Falsificación"@es-es,
        "Falsificación"@es-mx,
        "Contrefaçon"@fr-fr,
        "זיוף"@he-il,
        "नकली"@hi-in,
        "偽造"@ja-jp,
        "Falsificação"@pt-br,
        "伪造"@zh-cn ;
    skos:definition "(Definition of \"Counterfeiting/Forgery\") The altering, copying, or imitation of something, without authority or right, with the intent to deceive or defraud by passing the copy or thing altered or imitated as that which is original or genuine; or the selling, buying, or possession of an altered, copied, or imitated thing with the intent to deceive or defraud." .

<R9auCu5af3YRnpebdBnsVkv> a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:subClassOf <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Healthcare Recipient",
        "Medical Care Receiver" ;
    skos:definition "A Patient is an individual who receives medical care, treatment, or other health services from a healthcare provider or institution. This person is under professional care due to illness, injury, or for preventive health measures, and is the recipient of medical attention, diagnosis, and therapeutic interventions." .

<R9eIiLHT0vej9GgZzxXl8kP> a owl:Class ;
    rdfs:label "Translator" ;
    rdfs:subClassOf <R8eT1bTptg5J6ZfnwSUQYpf> ;
    skos:altLabel "Ecclesiastical Translator"^^xsd:string,
        "Language Translator"^^xsd:string ;
    skos:definition "A translator is a person or corporate body that renders a text from one language into another while preserving its meaning, intent, and doctrinal integrity within the Catholic tradition. In ecclesial contexts, a translator serves the Church by enabling authoritative texts to be received, understood, and used across linguistic communities."^^xsd:string ;
    skos:example "A Vatican office relies on a translator for an encyclical’s official version."^^xsd:string,
        "A scholar serves as a translator of the Bible into a vernacular language."^^xsd:string .

<R9eRaHXUh5Kv605aMyZLhOt> a owl:Class ;
    rdfs:label "Judicial Branch" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDnLOdTNWmEc4EhZ0SZXDm7> ],
        <RS4MNLzEw9KGWGaiRAbgdF> ;
    skos:definition "The judicial branch interprets and applies the law, ensuring it aligns with a nation's constitution or legal principles. It is comprised of courts, with higher courts, often called supreme or constitutional courts, having the final say on legal disputes." .

<R9eeGuKoZdrMyG2YsBzxZ4l> a owl:Class ;
