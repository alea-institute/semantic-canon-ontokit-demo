        <RB7BB00LuJawNLM8CZW6z7U>,
        <RBAoFbSK8WP6xJyVrgQd5PZ> ;
    skos:altLabel "Claim Preclusion",
        "Res Adjudicata",
        "Rechtskraft"@de-de,
        "Res Judicata"@en-gb,
        "Cosa Juzgada"@es-es,
        "Cosa Juzgada"@es-mx,
        "Autorité de la chose jugée"@fr-fr,
        "רס יודיקטה"@he-il,
        "रेस जुडिकाटा"@hi-in,
        "既判力"@ja-jp,
        "Coisa Julgada"@pt-br,
        "已判定事项"@zh-cn ;
    skos:definition "Res Judicata refers to the legal principle that a matter that has been adjudicated by a competent court and a final judgment has been rendered, cannot be litigated again between the same parties or their privies." .

<R8Q29bAm8uBwUw5NEpxF7MR> a owl:Class ;
    rdfs:label "Civilian" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7qVMTAfVUMCpr6LhRZ23eF> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Non-Combatant"^^xsd:string ;
    skos:definition "A civilian is a person who does not belong to the armed forces or organized armed groups of a party to an armed conflict. Civilian status confers protection from attack unless and for such time as the person directly participates in hostilities."^^xsd:string ;
    skos:example "A civilian who directly participated in hostilities lost protection for the duration of that participation."^^xsd:string,
        "A humanitarian aid worker operating in a conflict zone qualified as a protected civilian."^^xsd:string,
        "A journalist embedded with armed forces remained a civilian under the law of armed conflict."^^xsd:string,
        "A resident who took no part in the fighting retained civilian protection throughout the conflict."^^xsd:string .

<R8Qlu8j6378wRwqtVUxZJFg> a owl:Class ;
    rdfs:label "Public Information" ;
    rdfs:subClassOf <R89ziIl0nXs5c4ONtS7qXTP> ;
    skos:altLabel "Open Information",
        "Publicly Accessible Data",
        "Unrestricted Information" ;
    skos:definition "Public Information refers to information that is openly available to anyone and does not require any form of authorization or clearance for access. This type of information is intended for widespread dissemination and does not necessarily pose a risk of harm to the organization (e.g., company, nonprofit, nation) if disclosed." ;
    skos:prefLabel "Publicly Available Information" .

<R8RH0L3Ly427nlRy8H0l2qy> a owl:Class ;
    rdfs:label "Prospectus" ;
