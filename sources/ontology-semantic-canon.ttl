<RDxxROCAuEn3rnd1G1n1iWC> a owl:ObjectProperty ;
    rdfs:label "cos:hasAuthority" ;
    rdfs:comment "Use this property to distinguish binding doctrinal teaching, authoritative pastoral guidance, disciplinary norms, and non-binding opinion."^^xsd:string ;
    rdfs:range <RkaH1u58Roj4YNWXPG0Cap> ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:definition "The property `cos:hasAuthority` links a statement, act, document, or communicative event to the level of authority it carries within the Church. The property expresses the normative weight of the content based on its source, intent, and ecclesial scope, independent of truth value or prudential quality."^^xsd:string .

