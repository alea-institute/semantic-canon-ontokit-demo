        "介入者"@ja-jp,
        "Interveniente"@pt-br,
        "干涉人"@zh-cn ;
    skos:definition "A person who intervenes or seeks to intervene in a civil action." .

<R9OgIrSnvf4G55veAeT6Eqp> a owl:Class ;
    rdfs:label "Exterior Personal Sin" ;
    rdfs:subClassOf <R7M4dFUNY2TqtFocZDZHld> ;
    skos:altLabel "External Personal Sin"^^xsd:string,
        "Manifest Sin"^^xsd:string,
        "Outward Sin"^^xsd:string,
        "Sin in Word or Deed"^^xsd:string ;
    skos:definition "Exterior Personal Sin is sin committed through outward expression in word or deed that manifests an interior consent of the will. Exterior Personal Sin gives visible form to moral disorder and directly affects others as well as the sinner."^^xsd:string ;
    skos:example "A person commits theft by taking property that does not belong to them."^^xsd:string,
        "A person lies verbally to deceive another for personal gain."^^xsd:string,
        "A person publicly insults another, causing unjust harm to reputation."^^xsd:string .

<R9PYNVVb9kMDcRtGNPADrO5> a owl:Class ;
    rdfs:label "Legal Rights" ;
    rdfs:subClassOf <R7Ii0y3ouva1y6sqrwWACBl> ;
    skos:altLabel "Juridical Rights"^^xsd:string,
        "Legal Entitlements"^^xsd:string,
        "Rights Recognized by Law"^^xsd:string,
        "Rights at Law"^^xsd:string ;
    skos:definition "Legal rights are entitlements or privileges conferred by law that provide an individual or entity with certain freedoms, protections, or benefits. These rights can be civil, political, or social in nature and are enforceable by the judiciary, serving as the basis for legal claims or actions." ;
    skos:example "A defendant relies on procedural rights to receive a fair hearing."^^xsd:string,
        "A tenant asserts a legal right to occupy leased property under a valid lease."^^xsd:string .

<R9QDC1chH8o0jmTMsmrcaUW> a owl:Class ;
    rdfs:label "New York Community Justice Center" ;
    rdfs:subClassOf <R3391bdB1A2adE51071C7cf7> ;
    skos:definition "A specialized court program in New York State that aims to reduce crime and improve public trust in the justice system, by providing community-based services and alternative sentencing options." .

<R9SAKPHWeGi7uZqUG6EMlt> a owl:Class ;
    rdfs:label "Correctional Facility Official" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8ibMTtrBCWGIGOeFjTLtL0> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Correctional Facility Staff",
        "Jail Official" ;
    skos:definition "A Prison Official is an individual responsible for the management, oversight, and operation of a correctional facility, ensuring security, order, and compliance with regulations. These officials oversee the staff, inmate population, and administrative functions, playing a critical role in maintaining the safety and rehabilitation efforts within the prison." ;
    skos:prefLabel "Prison Official" .

<R9Sn2rwvFp1q6oYORzblWjv> a owl:Class ;
    rdfs:label "Winner-Take-All Electoral System" ;
    rdfs:subClassOf <R7OQ65vKuOBSSGgSVYnoMfx> ;
    skos:altLabel "Dominance Voting System",
        "Majoritarian System",
        "Plurality System",
        "Relative Majority System",
        "Simple Majority System",
        "Single-Member Plurality" ;
    skos:definition "A winner-take-all electoral system is a voting method in which the candidate or party receiving the most votes wins all available seats or electoral votes, without any proportional distribution. This system is often used in single-member districts and can lead to a significant advantage for the majority party, potentially underrepresenting minority groups." ;
    skos:example "At-Large Voting: City of Los Angeles City Council elections",
        "Electoral College System: United States presidential elections" ;
    skos:prefLabel "Winner-Takes-All Voting" .

<R9SopVNnOp9zwSj4fwxAofC> a owl:Class ;
    rdfs:label "Faith" ;
    rdfs:subClassOf <RBZqFAgKcZ5EESijJoUuppE> ;
    skos:altLabel "Assent of Faith"^^xsd:string,
        "Belief in Divine Revelation"^^xsd:string,
        "Ecclesial Faith"^^xsd:string,
        "Living Faith"^^xsd:string ;
    skos:definition "Faith is the theological virtue by which a person freely assents to God and to all that God has revealed. Faith unites intellect and will to divine truth on the authority of God who reveals, not on human proof alone."^^xsd:string ;
    skos:example "Faith deepens through prayer, study, and participation in the sacraments."^^xsd:string,
        "Faith enables trust in God’s promises even without complete understanding."^^xsd:string,
        "Faith moves a believer to accept the truths taught by the Church as revealed by God."^^xsd:string,
        "Faith sustains adherence to Christ amid doubt or persecution."^^xsd:string .

<R9TOzhWvuxDJlWPJfg2UmhF> a owl:Class ;
    rdfs:label "Jury Trial" ;
    dc:identifier "TRIJRY" ;
    rdfs:subClassOf <R8hdJfF8TO1kOvUijgwk9k> ;
    skos:altLabel "Jury Trial",
        "Jury-Prozess"@de-de,
        "Jury Trial"@en-gb,
        "Juicio por jurado"@es-es,
        "Juicio por jurado"@es-mx,
        "Procès avec jury"@fr-fr,
        "משפט עם חבורת שופטים"@he-il,
        "ज्यूरी ट्रायल"@hi-in,
        "陪審裁判"@ja-jp,
        "Julgamento por júri"@pt-br,
        "陪审团审判"@zh-cn ;
    skos:definition "A jury trial, or trial by jury, is a lawful proceeding in which a jury makes a decision or findings of fact. It is distinguished from a bench trial in which a judge or panel of judges makes all decisions." ;
    skos:hiddenLabel "TRIJRY" .

<R9Uol8M7H5u6lSDwss6uXIF> a owl:Class ;
    rdfs:label "Dementia" ;
    rdfs:subClassOf <REFNhmFYG6yk3W0RPLFV6g> ;
    skos:altLabel "Cognitive Decline Disorder" ;
    skos:definition "Dementia is a broad category of brain diseases characterized by a decline in memory, thinking, behavior, and the ability to perform everyday activities. It is a progressive condition that often leads to significant impairment in social and occupational functioning, requiring comprehensive medical and supportive care." .

<R9VP28VqK4AHUw790wby7ME> a owl:Class ;
    rdfs:label "Significant Shareholder Disclosure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R24Fe8aF4D15b46F6031E543> ],
        <RmCERXtzdqIJcW9mdbk0Bb> ;
    skos:definition "Significant Shareholder Disclosure is an investor's filing with the financial regulator (e.g., U.S. Securities and Exchange Commission (SEC)), providing detailed information about the investor's identity, background, source of funds, and intentions regarding the company, serving as a transparency measure to inform the market and the company's management. It's often triggered by an ownership threshold." ;
    skos:prefLabel "Beneficial Ownership Report" .

<R9WErGUpoZhFvRc4tWN0Q2s> a owl:ObjectProperty ;
    rdfs:label "cos:hasProvenance"^^xsd:string ;
    rdfs:comment "Provenance pointer (e.g., official PDF, print edition)."^^xsd:string,
        "RIEHL: Can't we just use the standard `dc:source` (Dublin Core)?"^^xsd:string ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:example "Official PDF"^^xsd:string,
        "Print Edition"^^xsd:string,
        "Web Edition"^^xsd:string .

<R9XzhwCpeRMiamNWRROfb75> a owl:Class ;
    rdfs:label "Meeting" ;
    rdfs:subClassOf <R4olkoqXdxjuNfJrjzI08R> ;
    skos:altLabel "Meeting"@de-de,
        "Meeting"@en-gb,
        "Reunión"@es-es,
        "Junta"@es-mx,
        "Réunion"@fr-fr,
        "פגישה"@he-il,
        "बैठक"@hi-in,
        "会議"@ja-jp,
        "Reunião"@pt-br,
        "会议"@zh-cn ;
    skos:definition "A meeting is a type of communication event where individuals come together to discuss a specific topic or agenda." .

<R9YFJkZPmIaTVmf1YJ89hSq> a owl:Class ;
    rdfs:label "Broadcasting and Content Providers Industry" ;
    dc:identifier "INF-BROD" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=516> ;
    rdfs:subClassOf <RHwCmZ2yKrJobzC86GC6Ep> ;
    skos:altLabel "Broadcasting",
        "Rundfunkindustrie"@de-de,
        "Broadcasting Industry"@en-gb,
        "Industria de la radiodifusión"@es-es,
        "Industria de la radiodifusión"@es-mx,
        "Industrie de la radiodiffusion"@fr-fr,
        "תעשיית השידורים"@he-il,
        "प्रसारण उद्योग"@hi-in,
        "放送業"@ja-jp,
        "Indústria de radiodifusão"@pt-br,
        "广播业"@zh-cn ;
    skos:definition """Industries in the Broadcasting and Content Providers subsector include establishments that create content or acquire the right to distribute content and subsequently broadcast or distribute that content.  The industry groups (Radio and Television Broadcasting Stations and Media Streaming Distribution Services, Social Networks, and Other Media Networks and Content Providers) are based on differences in the methods of communication and the nature of services provided.  The Radio and Television Broadcasting Stations industry group includes establishments that operate radio or television broadcasting stations for the programming and transmission of programs to the public.  Programming may originate in their own studio, from an affiliated network, or from external sources.  The Media Streaming Distribution Services, Social Networks, and Other Media Networks and Content Providers industry group includes establishments providing media streaming distribution services, operating social network sites, operating media broadcasting and cable television networks, and supplying information, such as news reports, articles, pictures, and features, to the news media.  The establishments classified in this subsector are often engaged in the production and purchase of programs and other textual, audio, and/or video content, and they typically generate revenues from the sale of advertising space and air time, subscriptions, donations, subsidies, and/or the sale of programs.

Establishments operating telecommunications facilities and infrastructure and distributing audio and video programming, including cable and satellite television subscription programming, are included in Subsector 517, Telecommunications.  Establishments primarily engaged as independent contractors in the installation and maintenance of broadcasting systems are classified in Sector 23, Construction.  Establishments primarily engaged in the production, or production and distribution, of motion pictures and sound recordings are included in Subsector 512, Motion Picture and Sound Recording Industries.""" ;
    skos:hiddenLabel "BROD" .

<R9b4AVPrNl8MQ6fUQUojS5k> a owl:Class ;
    rdfs:label "Estimate of Damages" ;
    rdfs:subClassOf <RfBdQ771UMEZMpb5zTUXAZ> ;
    skos:altLabel "Schadensschätzung"@de-de,
        "Estimate of Damages"@en-gb,
        "Estimación de daños"@es-es,
        "Estimación de daños"@es-mx,
        "Estimation des dommages"@fr-fr,
        "הערכת נזקים"@he-il,
        "हानि का अनुमान"@hi-in,
        "損害額の見積もり"@ja-jp,
        "Estimativa de danos"@pt-br,
        "损害估计"@zh-cn ;
    skos:definition "Estimate by the client and/or provider as to the amount of damages" .

<R9bu7L3xOUfbWLaHRhimQa> a owl:Class ;
    rdfs:label "Reinsurer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Fr7Djl5US9i-GPKMBW4K7g> ],
        <RBl2WJxJ69U7TybdQRUInbs> ;
    skos:definition "A reinsurer is a company that provides financial protection to insurance companies by accepting portions of their insurance liabilities. This process allows the primary insurance company to mitigate risks, ensuring that it can meet its financial obligations to policyholders even in the event of particularly large or numerous claims." .

<R9dPGGL1IRXLLjb1323qtj6> a owl:Class ;
    rdfs:label "Director" ;
    dc:identifier "DIRC" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <RBPsxBT931DDyTjxIBVJgE0> ;
            owl:someValuesFrom <R7eVYpVEsDqKqMUL2HL23Zr> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Director",
        "Regisseur"@de-de,
        "Director"@en-gb,
        "Director"@es-es,
        "Director"@es-mx,
        "Réalisateur"@fr-fr,
        "מנהל"@he-il,
        "निदेशक"@hi-in,
        "監督"@ja-jp,
        "Diretor"@pt-br,
        "导演"@zh-cn ;
    skos:definition "A director is the head of an organization, either elected or appointed, who generally has certain powers and duties relating to management or administration. A corporation's board of directors is composed of a group of people who are elected by the shareholders to make important company policy decisions." ;
    skos:hiddenLabel "DIRC" .

<R9gcJW5zpEIb8x5yJrfxBMg> a owl:Class ;
    rdfs:label "Suicide and \"Right to Die\" Claims" ;
    rdfs:subClassOf <RBzrK4RsgfLScZvC4Z4lCCX>,
        <RCfunX4u69LUQ3gbhckE0oI> ;
    skos:altLabel "Selbstmord und Ansprüche auf das \"Recht zu sterben\""@de-de,
        "Suicide and \"Right to Die\" Claims"@en-gb,
        "Suicidio y reclamaciones de \"derecho a morir\""@es-es,
        "Suicidio y reclamos de \"derecho a morir\""@es-mx,
        "Suicide et revendications du \"droit de mourir\""@fr-fr,
        "התאבדות ותביעות \"זכות למות\""@he-il,
        "आत्महत्या और \"मरने का अधिकार\" दावे"@hi-in,
        "自殺と「死ぬ権利」の主張"@ja-jp,
        "Suicídio e reivindicações do \"direito de morrer\""@pt-br,
        "自杀和“死亡权”要求"@zh-cn ;
    skos:definition "The concept of \"Suicide and 'Right to Die' Claims\" refers to legal claims and arguments related to intentional self-harm or assisted suicide, including cases involving prisoners and allegations of negligence." .

<R9jRx7isWVizbJSNmFNEydC> a owl:Class ;
    rdfs:label "O-1 Visa" ;
    rdfs:subClassOf <RNUBxUepOEIOvagLHcD3N0> ;
    skos:altLabel "Elite Performer Visa",
        "Talent Visa" ;
    skos:definition "An O-1 visa is issued to individuals with extraordinary ability in the sciences, arts, education, business, or athletics, recognized at a national or international level. This visa allows them to enter the U.S. to continue work in their field of expertise." ;
    skos:prefLabel "Extraordinary Ability Non-Immigrant Visa" .

<R9kj3rbJwO4aZsqQhukBD7y> a owl:Class ;
    rdfs:label "Medical Expenses" ;
    rdfs:subClassOf <RouKBMqFNMZxi21EPh6JJ6> ;
    skos:altLabel "Medizinische Ausgaben"@de-de,
        "Medical Expenses"@en-gb,
        "Gastos Médicos"@es-es,
        "Gastos Médicos"@es-mx,
        "Frais médicaux"@fr-fr,
        "הוצאות רפואיות"@he-il,
        "चिकित्सा खर्च"@hi-in,
        "医療費"@ja-jp,
        "Despesas médicas"@pt-br,
        "医疗费用"@zh-cn ;
    skos:definition "Medical Expenses refer to the costs incurred for medical treatment and care, including both past and future expenses, as a result of an injury or illness, and are considered a type of economic damage in legal cases." .

<R9lPPcEUakauoTtSdt9K3La> a owl:Class ;
    rdfs:label "Parables of Judgment" ;
    rdfs:subClassOf <RBwnjqdPUZaR0T0pghMXTl6> ;
    skos:altLabel "Eschatological Parables"^^xsd:string,
        "Judgment Parables"^^xsd:string,
        "Parables of Accountability"^^xsd:string ;
    skos:definition "Parables of Judgment means the parables taught by Jesus Christ that emphasize accountability, vigilance, and the reality of divine judgment. Parables of Judgment warn of the consequences of unfaithfulness and call hearers to readiness for the coming of God’s Kingdom."^^xsd:string ;
    skos:example "Christian theology interprets the parables of judgment as calls to vigilance and faithful stewardship."^^xsd:string,
        "Jesus teaches parables that warn of judgment for those unprepared for God’s coming."^^xsd:string .

<R9mh7fC3v6u4exodERd3fmK> a owl:Class ;
    rdfs:label "Mortgagee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RhceZsFaOSAIBa7BX1vpbF> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <s7-eJGGYSoaQIrtyJagrOg> ],
        <R9OzLGaxH8FUa0QvIz14ZLA> ;
    skos:definition "A Mortgagee is the lender in a mortgage transaction, typically a bank or financial institution, that provides funds for the borrower (mortgagor) to purchase property. The mortgagee holds a lien on the property as security for the loan repayment and can foreclose on the property if the borrower fails to meet the terms of the mortgage." .

<R9noL17x75XO1GZAF9nfsel> a owl:Class ;
    rdfs:label "Real Right of Pledge" ;
    rdfs:subClassOf <R8cjnXHiv1wNe6nzPvWnhQw> ;
    skos:altLabel "Collateral Right",
        "Pledge Right" ;
    skos:definition "The Real Right of Pledge is a security interest that allows a creditor to hold a tangible asset or property as collateral to secure a debt or obligation from the debtor. In the event of default, the creditor has the right to seize and potentially sell the pledged property to satisfy the debt, subject to the rules and procedures outlined in the governing law." .

<R9o0sZT3FdlEsNm24CtqmNJ> a owl:Class ;
    rdfs:label "U.S. Executive Branch" ;
    rdfs:subClassOf <RF9A23e15C1cfD0540b8Afae> ;
    skos:definition "The U.S. Executive Branch is the division of the federal government responsible for enforcing laws and administering public policy, headed by the President of the United States. It comprises the President, Vice President, Cabinet members, and federal agencies and departments." ;
    skos:prefLabel "Presidential Administration" .

<R9r2XYxmAiksCgeIwOht0sP> a owl:Class ;
    rdfs:label "Spoken Word Recording" ;
    rdfs:subClassOf <RBp9ycllxg1PqalOMlG8bdV> ;
    skos:altLabel "A Spoken Word Recording is an audio capture of spoken performances, such as speeches, poetry, audiobooks, or podcasts, stored in a medium that can be played back." .

<R9rCbt2Rlk0Nw3UJ6rbp5gB> a owl:Class ;
    rdfs:label "Parables of Mercy" ;
    rdfs:subClassOf <RBwnjqdPUZaR0T0pghMXTl6> ;
    skos:altLabel "Mercy Parables"^^xsd:string,
        "Parables of Compassion"^^xsd:string,
        "Parables of Forgiveness"^^xsd:string ;
    skos:definition "Parables of Mercy means the parables taught by Jesus Christ that reveal God’s merciful love, forgiveness, and compassion toward sinners and the vulnerable. Parables of Mercy call hearers to repentance, conversion, and imitation of divine mercy."^^xsd:string ;
    skos:example "The parable of the Good Samaritan teaches love of neighbor through merciful action."^^xsd:string,
        "The parable of the prodigal son reveals the Father’s mercy toward the repentant sinner."^^xsd:string .

<R9salgO5L9Ssp5nE8uBWXjP> a owl:Class ;
    rdfs:label "Health Regulatory Events" ;
    rdfs:subClassOf <RCvV18Mbbb9FYFXbHt1inuL> .

<R9seb5qQstcsgRm3UE8hV5t> a owl:Class ;
    rdfs:label "False Advertising" ;
    rdfs:subClassOf <R7MsH9WtTPf14W1GB1m8zrB>,
        <RHSZPHkLvnB6N4bgIo6kuX> ;
    skos:altLabel "Irreführende Werbung"@de-de,
        "False Advertising"@en-gb,
        "Publicidad engañosa"@es-es,
        "Publicidad falsa"@es-mx,
        "Publicité mensongère"@fr-fr,
        "פרסום מטעה"@he-il,
        "झूठी विज्ञापन"@hi-in,
        "誤解を招く広告"@ja-jp,
        "Publicidade enganosa"@pt-br,
        "虚假广告"@zh-cn ;
    skos:definition "False Advertising: A type of business tort or product liability claim that involves the dissemination of misleading or deceptive information about a product or service in order to induce consumers to purchase it." ;
    skos:prefLabel "False Advertising Claim" .

<R9uSx85K0E4Hiq1ZA5AtdjX> a owl:Class ;
    rdfs:label "Civil War" ;
    rdfs:comment "In a global Catholic ontology, Civil War is a specific manifestation of armed conflict where the \"tranquillity of order\" is shattered within the boundaries of a single political community. The Church views such events with particular sorrow, as they represent a rupture in social solidarity and fraternal charity between members of the same nation or people."^^xsd:string ;
    rdfs:subClassOf <R79CBFMSwUZjwKG9qV6AfQb> ;
    skos:altLabel "Domestic Hostilities"^^xsd:string,
        "Ethnic Conflict"^^xsd:string,
        "Internal Armed Conflict"^^xsd:string,
        "Intranational Conflict"^^xsd:string,
        "Intrastate War"^^xsd:string ;
    skos:definition "Civil War is a state of organized, violent contention between internal factions, ethnic groups, or a sovereign government and insurgent forces within the same country. It demands the application of both international humanitarian law and the Church's principles on legitimate authority and the protection of the common good to prevent the total dissolution of the social fabric."^^xsd:string ;
    skos:example "Establishing truth and reconciliation commissions after a domestic conflict to restore national unity and heal social divisions."^^xsd:string,
        "Mediating between ethnic factions to address the root causes of systemic injustice and prevent further bloodshed."^^xsd:string,
        "Negotiating a ceasefire between government forces and rebel groups to allow for the delivery of humanitarian aid to displaced citizens."^^xsd:string .

<R9uiDByr48mJfLgUdiIZrSi> a owl:Class ;
    rdfs:label "Sodomy" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf <R8TvbewYypS9Uy4y5JGIwEH> ;
    skos:altLabel "Sodomie"@de-de,
        "Sodomy"@en-gb,
        "Sodomía"@es-es,
        "Sodomía"@es-mx,
        "Sodomie"@fr-fr,
        "סודומיה"@he-il,
        "सोडोमी"@hi-in,
        "アナルセックス"@ja-jp,
        "Sodomia"@pt-br,
        "鸡奸"@zh-cn ;
    skos:definition "Oral or anal sexual intercourse with another person, forcibly and/or against that person’s will or not forcibly or against the person’s will in instances where the victim is incapable of giving consent because of his/her youth or because of his/her temporary or permanent mental or physical incapacity." .

<R9urXqVYLqwUXpAConC0lYj> a owl:Class ;
    rdfs:label "Conservatorship of Juvenile" ;
    rdfs:subClassOf <RDuglENJJNibMF8YDtmXkpE> ;
    skos:altLabel "Vormundschaft für Minderjährige"@de-de,
        "Conservatorship of Juvenile"@en-gb,
        "Tutela de Menores"@es-es,
        "Tutela de Menores"@es-mx,
        "Tutelle des mineurs"@fr-fr,
        "הצמתות של קטין"@he-il,
        "किशोर की संरक्षणशीलता"@hi-in,
        "未成年者の保護"@ja-jp,
        "Curatela de Menores"@pt-br,
        "未成年人监护"@zh-cn ;
    skos:definition "A conservatorship of juvenile is a legal arrangement where a court appoints a responsible adult to care for a minor's personal and financial needs when the minor's parents are unable to do so." .

<R9xAhmz7X3SZm1uhR5XRZCB> a owl:Class ;
    rdfs:label "Primeval History Events" ;
    rdfs:subClassOf <R9o7849l09skEBQqbxSItaV> .

<R9zyvDXyYEEyM7dTnON56uL> a owl:Class ;
    rdfs:label "Wildlife Permit" ;
    rdfs:subClassOf <RCKrakJNv6b1oTTMhd4c5DU> ;
    skos:definition "A wildlife permit, such as a hunting or fishing license, is an official authorization granted by a governing authority that allows individuals to legally pursue, capture, or kill specific types of wildlife during designated seasons or under certain conditions. These permits are often used to manage and conserve wildlife populations, and their issuance typically requires payment of a fee, completion of safety courses, and adherence to specified regulations and quotas." .

<RA6A4235BB1961E1e4aA330e> a owl:Class ;
    rdfs:label "International Development Cooperation Agency" ;
    dc:identifier "US-FD-STATE-IDCA" ;
    rdfs:subClassOf <R0480ee8B57a1441863FE362> ;
    skos:altLabel "Agentur für internationale Entwicklungszusammenarbeit"@de-de,
        "International Development Cooperation Agency"@en-gb,
        "Agencia de Cooperación para el Desarrollo Internacional"@es-es,
        "Agencia de Cooperación para el Desarrollo Internacional"@es-mx,
        "Agence de coopération pour le développement international"@fr-fr,
        "סוכנות לשיתוף פעולה בפיתוח בינלאומי"@he-il,
        "अंतरराष्ट्रीय विकास सहयोग एजेंसी"@hi-in,
        "国際開発協力機構"@ja-jp,
        "Agência de Cooperação para o Desenvolvimento Internacional"@pt-br,
        "国际发展合作署"@zh-cn ;
    skos:definition "The International Development Cooperation Agency (IDCA) was established by Executive Order in September, 1979. The IDCA was abolished by act of Oct. 2, 1998 (112 Stat. 2681-790) and its functions transferred to the Department of State, U.S. Agency for International Development, and overseas Private Investment Corporation." ;
    skos:hiddenLabel "IDCA" ;
    skos:prefLabel "International Development Cooperation Agency" .

<RA9020b486d6f24494eC2624> a owl:Class ;
    rdfs:label "Food and Drug Administration" ;
    dc:identifier "US-FD-HHS-FDA" ;
    rdfs:subClassOf <RDA5e5cC4E75f969fbe25383> ;
    skos:altLabel "Food and Drug Administration",
        "Lebensmittel- und Arzneimittelbehörde"@de-de,
        "Food and Drug Administration"@en-gb,
        "Administración de Alimentos y Medicamentos"@es-es,
        "Administración de Alimentos y Medicamentos"@es-mx,
        "Administration des denrées alimentaires et des médicaments"@fr-fr,
        "רשות המזון והתרופות"@he-il,
        "खाद्य और औषध शासन"@hi-in,
        "食品医薬品局"@ja-jp,
        "Administração de Alimentos e Medicamentos"@pt-br,
        "食品药品监督管理局"@zh-cn ;
    skos:definition "The Food and Drug Administration (FDA or USFDA) is a federal agency of the United States Department of Health and Human Services, one of the United States federal executive departments." ;
    skos:prefLabel "FDA" .

<RB0OjYiZ6X1hMIZOMK1KqhB> a owl:Class ;
    rdfs:label "10th Amendment Claim" ;
    rdfs:subClassOf <R7MGQ9xUx0PxGLp5yxprdpZ> ;
    skos:altLabel "Tenth Amendment Claim",
        "10. Änderungsantrag Anspruch"@de-de,
        "10th Amendment Claim"@en-gb,
        "Reclamo de la 10ª Enmienda"@es-es,
        "Reclamo de la 10ª Enmienda"@es-mx,
        "Revendication de 10ème amendement"@fr-fr,
        "תביעת התיקון העשירי"@he-il,
        "10वीं संशोधन दावा"@hi-in,
        "第10修正案主張"@ja-jp,
        "Reivindicação da 10ª Emenda"@pt-br,
        "第十修正案索赔"@zh-cn ;
    skos:definition "A Tenth Amendment claim is a legal argument asserting that a federal action or law has violated the Tenth Amendment of the United States Constitution, which reserves powers not delegated to the federal government to the states or the people. Such claims typically involve disputes over the balance of power between federal and state governments and aim to protect state sovereignty and autonomy." .

<RB0QemTkd6XZOLDEO42pdIw> a owl:Class ;
    rdfs:label "Driving Under the Influence" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rj1p7FbFSLxlWfUlSPZxhX> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RLvhxz3b1k2IU3MaAgeRtF> ],
        <RCqBiJAwLT5iG2nvk12tNKW>,
        <Rj1p7FbFSLxlWfUlSPZxhX> ;
    skos:altLabel "DWI",
        "Driving While Intoxicated",
        "Fahren unter Alkohol- oder Drogeneinfluss"@de-de,
        "Driving Under the Influence"@en-gb,
        "Conducir bajo los efectos del alcohol"@es-es,
        "Conducir bajo los efectos del alcohol"@es-mx,
        "Conduite en état d'ivresse"@fr-fr,
        "נהיגה תחת השפעת סמים או אלכוהול"@he-il,
        "मादक पदार्थों के अधीन गाड़ी चलाना"@hi-in,
        "飲酒運転"@ja-jp,
        "Dirigir sob influência de álcool ou drogas"@pt-br,
        "酒后驾车"@zh-cn ;
    skos:definition "Driving or operating a motor vehicle or common carrier while mentally or physically impaired as the result of consuming an alcoholic beverage or using a drug or narcotic." ;
    skos:prefLabel "DUI" .

<RB0hju1karAVIAsSqkf1Pza> a owl:ObjectProperty ;
    rdfs:label "folio:obtained" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:altLabel "acquired",
        "obtained" ;
    skos:definition "To obtain an artifact (e.g., document, evidence) or a legal result (e.g., judgment, sanctions). In legal and administrative contexts, \"obtained\" refers to the successful acquisition or securing of a legal status, permission, or qualification by an individual or entity. This term indicates that the individual or entity has met the necessary criteria or completed the required procedures to gain a particular right, privilege, or certification, such as asylum, a professional license, or licensure to practice law." ;
    skos:example "Applicant Obtained License",
        "Asylee Obtained Asylum",
        "Investigator Obtained Evidence",
        "Lawyer Obtained Licensure" ;
    skos:prefLabel "folio:acquired" .

<RB2MwY72GbUZH9ccu7omcmE> a owl:Class ;
    rdfs:label "Insured" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rt7TTPXJ7WX1Jrjufs0Mdr> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Insurant" ;
    skos:definition "The insured is the individual or entity specifically covered under an insurance policy. This person or organization receives the benefits of the policy, such as financial compensation or coverage, in the event of a covered loss or claim as stipulated in the insurance contract." ;
    skos:prefLabel "Policyholder" .

<RB4wzors3lwuJhitD5uuVLS> a owl:Class ;
    rdfs:label "Insurance Form" ;
    rdfs:subClassOf <RCtVq1uma9QpsVZHKZuLBkJ> ;
    skos:definition "An Insurance Form is a standardized document used by an insurance provider for capturing relevant information to evaluate, administer, or process an insurance policy. This could be for applications, claims, renewals, or any other insurance-related activities." .

<RB4yg0TUPW2kfmcnhwGTCIV> a owl:Class ;
    rdfs:label "Solidarity" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Common Good Orientation"^^xsd:string,
        "Communal Responsibility"^^xsd:string,
        "Fraternal Commitment"^^xsd:string,
        "Human Solidarity"^^xsd:string,
        "Social Responsibility"^^xsd:string,
        "Social Solidarity"^^xsd:string ;
    skos:definition "Solidarity is the ethical principle that recognizes persons and communities as mutually responsible for one another’s good. Solidarity directs moral action toward shared commitment, social friendship, and the pursuit of the common good."^^xsd:string ;
    skos:example "Solidarity calls workers and employers to mutual concern for dignity and fairness."^^xsd:string,
        "Solidarity encourages personal sacrifice for the sake of the common good."^^xsd:string,
        "Solidarity guides public policy toward protecting vulnerable populations."^^xsd:string,
        "Solidarity motivates communities to support those affected by poverty or injustice."^^xsd:string,
        "Solidarity shapes international cooperation in response to humanitarian crises."^^xsd:string .

<RB66KavQ9akLTya7pGnGqVH> a owl:Class ;
    rdfs:label "Environmental Policy" ;
    rdfs:subClassOf <RCZyrH2dIAtpDh2AzPTekph> ;
    skos:altLabel "Environmental Stewardship Principles",
        "Green Policy" ;
    skos:definition "An Environmental Policy is a statement outlining an organization's approach to managing its environmental impact, often including commitments to sustainability, resource management, and regulatory compliance. The policy serves as a guide for the company's environmental practices." ;
    skos:prefLabel "Sustainability Policy" .

<RB6SCzZbAqqmRhIB6DPk2Kn> a owl:Class ;
    rdfs:label "Accounting, Tax Preparation, Bookkeeping, and Payroll Services Industry" ;
    dc:identifier "PRS-ACCT" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=5412> ;
    rdfs:subClassOf <RBFLYkta0F7DwegW1FnUX52> ;
    skos:altLabel "Accounting Services",
        "Buchhaltungsdienstleistungsbranche"@de-de,
