<R9UI9vD7heuXyZscLal5JUz> a owl:Class ;
    rdfs:label "Technology Ethics" ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "AI Ethics"^^xsd:string,
        "Digital Ethics"^^xsd:string,
        "Ethics of Technology"^^xsd:string,
        "Information and Technology Ethics"^^xsd:string,
        "Tech Ethics"^^xsd:string,
        "Technological Responsibility Ethics"^^xsd:string ;
    skos:definition "Technology Ethics is the field of applied ethics that examines the moral implications of designing, deploying, and using technology. Technology Ethics evaluates how technological power affects human dignity, freedom, responsibility, and the common good."^^xsd:string ;
    skos:example "Technology ethics critiques automation that undermines worker dignity without just cause."^^xsd:string,
        "Technology ethics evaluates whether an AI system respects human dignity and accountability."^^xsd:string,
        "Technology ethics guides responsible collection and use of personal data."^^xsd:string,
        "Technology ethics informs limits on surveillance technologies to protect privacy."^^xsd:string,
        "Technology ethics promotes human-centered design over purely efficiency-driven systems."^^xsd:string .

<R9UJ1OgonwKRdgJj6ntI9hY> a owl:Class ;
