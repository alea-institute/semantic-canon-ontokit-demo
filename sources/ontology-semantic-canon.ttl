<R87v1YvLO0pDjR3Y3nrhQlO> a owl:Class ;
    rdfs:label "Social Security Payments" ;
    rdfs:subClassOf <RSwOCeFhWxUA3fOiTvlja4> ;
    skos:altLabel "Pension Payments",
        "Social Insurance Benefits",
        "Social Security Retirement Payments",
        "Social Welfare Payments" ;
    skos:definition "Social Security Payments are government-provided financial benefits designed to support individuals who are retired, disabled, or survivors of deceased workers. These payments are funded through payroll taxes and aim to provide a safety net for individuals and their families, ensuring a basic level of income." ;
    skos:prefLabel "Retirement Benefits",
        "Social Security Income" .

