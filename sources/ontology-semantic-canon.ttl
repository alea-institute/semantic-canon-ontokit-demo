    skos:prefLabel "Global Segment" .

<RtLCzYWZfRT3o7tzhyamNE> a owl:Class ;
    rdfs:label "Peripheral Neuropathy" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_14> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH> ;
    skos:altLabel "Peripheral Nerve Disorder" ;
    skos:definition "Peripheral neuropathy refers to a range of disorders caused by damage to the peripheral nerves, which are the nerves outside the brain and spinal cord. This condition often results in symptoms such as pain, numbness, tingling, and weakness, typically affecting the extremities like the hands and feet." ;
    skos:prefLabel "Peripheral Nerve Disease" .

<RtSnrf1URIhJNP0fCJ6SZ7> a owl:Class ;
    rdfs:label "Mammals" ;
    rdfs:subClassOf <R8sd4v04cEXnzbttN2gUEpV> ;
    skos:definition "Mammals are a class of vertebrate animals characterized by the presence of mammary glands which produce milk for feeding their young, hair or fur, and a neocortex region in the brain. Mammals are warm-blooded and include a wide range of species from terrestrial to aquatic environments, such as humans, elephants, and whales." ;
    skos:prefLabel "Mammalia" .

