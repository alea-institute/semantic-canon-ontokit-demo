    rdfs:subClassOf <RBt449Gy4YQBuVqNLxE7Gg> ;
    skos:altLabel "Criminal Justice Division",
        "District Attorney's Office",
        "Federal Prosecutor's Office",
        "Government Criminal Prosecution Office",
        "Prosecutor's Office",
        "Public Prosecutor's Office",
        "State Attorney's Office",
        "State Prosecutor's Office" ;
    skos:definition "A Governmental Criminal Law Division is a government entity responsible for prosecuting criminal cases on behalf of the public. It conducts investigations, files charges, represents the government in criminal trials, and ensures the enforcement of criminal laws." .

<RD328f4DC4f88B447d5B764d> a owl:Class ;
