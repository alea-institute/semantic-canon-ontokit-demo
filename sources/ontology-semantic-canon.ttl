<RRTf0NaJCqqQm5rsltQSDH> a owl:Class ;
    rdfs:label "Multi-Jurisdictional Survey" ;
    rdfs:subClassOf <RDs4RXqtrzif7ulCp2kI0mO> ;
    skos:definition "A multi-jurisdictional survey (e.g., 50-state survey, 50-country survey) involves a systematic examination of laws, regulations, or practices across multiple specific jurisdictions within a larger entity, such as states within a country. It is often used to identify variations in legal standards or requirements and assess their impact on compliance or policy development." ;
    skos:prefLabel "50-State Survey" .

