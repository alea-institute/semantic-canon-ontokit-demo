        "Línguas cuxíticas"@pt-br,
        "库施特语系"@zh-cn ;
    skos:definition "Cushitic languages are a group of languages within the broader category of Language, which are spoken primarily in the Horn of Africa and are characterized by shared grammatical features and vocabulary." .

<R7PyR6ZeFKwHLi0gh4W6HUK> a owl:Class ;
    rdfs:label "Obsessive-Compulsive Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RCnCHWsREqpfQAAfaN2lRPV>,
