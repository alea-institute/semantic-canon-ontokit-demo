<R88118b7E360b769002CA4b0> a owl:Class ;
    rdfs:label "U.S. Dept. of Education" ;
    dc:identifier "US-FD-ED" ;
    rdfs:subClassOf <R22815eC3Af3bFF0d002Ca58> ;
    skos:altLabel "US-amerikanisches Bildungsministerium"@de-de,
        "U.S. Dept. of Education"@en-gb,
        "Departamento de Educación de EE. UU."@es-es,
        "Departamento de Educación de EE. UU."@es-mx,
        "Département de l'Éducation des États-Unis"@fr-fr,
