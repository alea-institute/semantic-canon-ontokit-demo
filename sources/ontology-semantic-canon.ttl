<RDSCWJq2W3bOLNRFQlBfSSA> a owl:Class ;
    rdfs:label "Baptism of Desire" ;
    rdfs:subClassOf <Rf3vlNVG6AT99vTWHcqcws> ;
    skos:altLabel "Baptism in Desire"^^xsd:string,
        "Desiderative Baptism"^^xsd:string,
        "Implicit Baptism"^^xsd:string ;
    skos:definition "Baptism of Desire is the means by which a person receives the grace of baptism without the sacramental rite through an explicit or implicit desire for baptism joined to repentance and charity. It brings justification and incorporation into Christ, though it does not confer the sacramental character."^^xsd:string ;
    skos:example "Baptism of desire presupposes faith and repentance."^^xsd:string,
        "Baptism of desire reflects God’s mercy beyond sacramental limits."^^xsd:string,
        "Catechumens who die before receiving water baptism may receive baptism of desire."^^xsd:string .

