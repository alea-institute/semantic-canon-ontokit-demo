    skos:altLabel "Informierte Einwilligung"@de-de,
        "Informed Consent"@en-gb,
        "Consentimiento Informado"@es-es,
        "Consentimiento Informado"@es-mx,
        "Consentement éclairé"@fr-fr,
        "הסכמה מושכלת"@he-il,
        "सूचित सहमति"@hi-in,
        "インフォームド・コンセント"@ja-jp,
        "Consentimento informado"@pt-br,
        "知情同意"@zh-cn ;
    skos:definition "The concept of Informed Consent refers to the legal requirement for medical professionals to fully inform patients of the risks and benefits of a medical procedure or treatment, and to obtain the patient's voluntary agreement to undergo the procedure or treatment." .

<R87PmoWmotSgo32gCYT29sw> a owl:Class ;
    rdfs:label "Savings and Loan Association" ;
