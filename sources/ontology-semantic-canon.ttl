<RKBTWD2NLiGqld62bEnjG8> a owl:Class ;
    rdfs:label "Agony in the Garden" ;
    rdfs:subClassOf <RD0JfBltrTwUJkeYjw8iN1P>,
        <RDxAHb6WWxvwiBtuiLOfgfr> ;
    skos:altLabel "Gethsemane Agony"^^xsd:string,
        "Prayer in the Garden"^^xsd:string ;
    skos:definition "Agony in the Garden means the intense prayer and suffering of Jesus Christ in the Garden of Gethsemane on the night before his Passion. Agony in the Garden reveals Christ’s human anguish and his complete obedience to the Father’s will."^^xsd:string ;
    skos:example "Christian spirituality reflects on the agony in the garden as the model of trusting obedience amid suffering."^^xsd:string,
        """In His anguish He prayed with all the greater intensity, and His sweat became like drops of blood falling to the ground. Then He rose from prayer and came to His disciples, only to find them asleep, exhausted with grief.
(Luke 22:44-45)"""^^xsd:string,
        "The Gospels describe Jesus praying in Gethsemane and asking that the cup pass from him if possible."^^xsd:string ;
    skos:prefLabel "Agony at Gethsemane"^^xsd:string .

