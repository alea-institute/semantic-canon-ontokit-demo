    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=3231> ;
    rdfs:subClassOf <R856uwdSyc5Lfpm3Hghf1f0> ;
    skos:definition "NULL" .

<FQRPl0mWQw6wcgApCjO-iA> a owl:Class ;
    rdfs:label "Other Nonmetallic Mineral Product Manufacturing" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=3279> ;
