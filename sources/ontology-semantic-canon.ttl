<R9CnOvmitM11ptxXIxgCDYT> a owl:Class ;
    rdfs:label "Foreign Corporation Financial Disclosure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBIXc4MqHYUkxA0MXlxno1u> ],
        <RmCERXtzdqIJcW9mdbk0Bb> ;
    skos:definition "A Foreign Corporation Financial Disclosure, known in the U.S. as a Form 20-F, is an annual report submitted to the governmental entity (e.g., Securities and Exchange Commission) by foreign private issuers with securities listed on domestic (e.g., U.S.) exchanges. In the United States, the 20-F provides a comprehensive overview of the company's financial position and business operations, including audited financial statements, executive compensation, major shareholders, material risks, and other information required by the SEC." ;
    skos:prefLabel "20-F" .

<R9DvHEUtANGcKLft0SFDni4> a owl:Class ;
