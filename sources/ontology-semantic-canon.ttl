        "Hospitality to the Unhoused"^^xsd:string,
        "Housing the Homeless"^^xsd:string,
        "Safe Refuge Provision"^^xsd:string,
        "Temporary Housing Assistance"^^xsd:string ;
    skos:definition "Shelter the Homeless is a corporal work of mercy that consists in providing safe and dignified housing to those without a stable place to live. Shelter the Homeless responds to material vulnerability by protecting life, health, and human dignity."^^xsd:string ;
    skos:example "A charity provides temporary housing for individuals transitioning out of homelessness."^^xsd:string,
        "A community establishes emergency shelter following a natural disaster."^^xsd:string,
        "A faith-based organization offers safe refuge to those fleeing violence or persecution."^^xsd:string,
        "A family hosts a person experiencing homelessness through a hospitality program."^^xsd:string,
        "A parish opens its facilities as an overnight shelter during extreme weather."^^xsd:string,
        "Host Family Program"^^xsd:string .

