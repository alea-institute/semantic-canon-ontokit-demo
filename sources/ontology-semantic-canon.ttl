<N3Ci3xnZQZaoGkfh_Fgudw> a owl:Class ;
    rdfs:label "Resin and Synthetic Rubber Manufacturing" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=32521> ;
    rdfs:subClassOf <gLTB7HCCQYGMADi6I1CL6g> ;
