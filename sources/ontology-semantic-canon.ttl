<RBpseS3fO7sq2jPuFJjJRzq> a owl:Class ;
    rdfs:label "Jesus' Healing Miracles" ;
    rdfs:subClassOf <RvsGnqbpH0lHwlXuGAmIqD> ;
    skos:altLabel "Healing Works of Christ"^^xsd:string,
        "Healings Performed by Jesus"^^xsd:string,
        "Miraculous Healings by Jesus"^^xsd:string ;
    skos:definition "Jesus’ Healing Miracles means the acts by which Jesus Christ restored physical, psychological, or spiritual health to the sick and afflicted during his public ministry. Jesus’ Healing Miracles reveal Christ’s compassion, divine authority, and power to heal the whole person."^^xsd:string ;
    skos:example "Jesus' healing miracles demonstrate Jesus’ authority over sickness and death."^^xsd:string .

<RBrBYbsaP35Zqr9ZrYFHMda> a owl:Class ;
    rdfs:label "Chemical Manufacturing Industry" ;
    dc:identifier "MFG-CHEM" ;
    rdfs:subClassOf <RBOjgvcq6Z33XxMhTxWiiDS> ;
    skos:altLabel "Chemical Manufacturing",
        "Chemische Industrie"@de-de,
        "Industrie chimique"@fr-fr,
        "化学製造業"@ja-jp,
        "Indústria química"@pt-br,
        "化学制造业"@zh-cn ;
    skos:definition "This industry group is based on the transformation of organic and inorganic raw materials by a chemical process and the formulation of products. It industry group includes establishments that make: chemicals, synthetic dyes, rubber, synthetic fibers, pesticides, fertilizers, paint, and cleaning materials." ;
    skos:hiddenLabel "CHEM" .

<RC2P0YZS5Ku67wmSwN4OxWs> a owl:Class ;
    rdfs:label "Public Administration Industry" ;
