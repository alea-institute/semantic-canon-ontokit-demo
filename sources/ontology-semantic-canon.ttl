<RJKpVvwNySrKM39s51LW3F> a owl:Class ;
    rdfs:label "Child Care Cost Claim" ;
    dc:source "From LIST: Legal Issues Taxonomy — https://taxonomy.legal/" ;
    rdfs:subClassOf <RBOwCCBkhg24geD2foAgBOB> ;
    skos:definition "A Child Care Cost Claim is a request made by a parent or guardian to receive financial assistance or reimbursement for expenses related to the care of their child. This may include costs associated with daycare, after-school programs, or babysitters. Such claims are often made to government agencies or employers through childcare subsidy programs or flexible spending accounts." .

<RJMHIP73KFeE7kZfxyGrag> a owl:Class ;
