        "Jeu illégal"@fr-fr,
        "הימורים בלתי חוקיים"@he-il,
        "अवैध जुआ"@hi-in,
        "違法賭博"@ja-jp,
        "Jogo ilegal"@pt-br,
        "非法赌博"@zh-cn ;
