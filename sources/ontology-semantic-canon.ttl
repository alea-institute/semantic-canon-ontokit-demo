<RBX1KA0BJR7y27zZSvaLBVE> a owl:Class ;
    rdfs:label "Credit Intermediation and Related Activities Industry" ;
    dc:identifier "FNS-BANK" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=522> ;
    rdfs:subClassOf <RCksXAlY9lRN16wERqZZ8Tk> ;
    skos:altLabel "Banking and Credit",
        "Bank- und Kreditwirtschaft"@de-de,
        "Banking and Credit Industry"@en-gb,
        "Industria Bancaria y de Crédito"@es-es,
        "Industria Bancaria y de Crédito"@es-mx,
        "Industrie bancaire et de crédit"@fr-fr,
        "תעשיית הבנקאות והאשראי"@he-il,
