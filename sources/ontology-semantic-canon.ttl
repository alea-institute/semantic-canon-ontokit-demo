            owl:someValuesFrom <R7m7hUozBtx7JODLD9VRxlY> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9QxJZ2V1DDLTPgviKpGISS> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDhZWHoYtGaz11YejcsN0CS> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Automobile Driver",
        "Operator",
        "Vehicle Operator" ;
    skos:definition "A driver is an individual who operates a motor vehicle, controlling its direction and speed on public or private roads. This role requires adherence to traffic laws and regulations to ensure safety and order on thoroughfares." ;
    skos:prefLabel "Motorist" .

<R8dLmng1TNW6uYIBHtkJuab> a owl:Class ;
    rdfs:label "Employee" ;
    dc:identifier "EMPE" ;
