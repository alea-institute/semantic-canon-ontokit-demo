    rdfs:subClassOf <RC1Ba5YP8y1uxOkQF7LsVU8> ;
    skos:definition "This industry group comprises establishments primarily engaged in organizing, promoting, and/or managing live performing arts productions, sports events, and similar events, held in facilities that they manage and operate or in facilities that are managed and operated by others." .

<u3vWIxTJSVuTaMFWrzwtCw> a owl:Class ;
    rdfs:label "Other Health and Personal Care Retailers" ;
