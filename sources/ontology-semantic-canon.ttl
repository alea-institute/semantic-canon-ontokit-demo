<RC4Pdxi5qe0Is3sCmIHT4ju> a owl:Class ;
    rdfs:label "Civil Rights Violation Claim" ;
    rdfs:subClassOf <RBREngQZS9QIgeWCOMPBLIo> ;
    skos:altLabel "Anspruch auf Verletzung der Bürgerrechte"@de-de,
        "Civil Rights Violation Claim"@en-gb,
        "Reclamación por violación de derechos civiles"@es-es,
        "Reclamo por violación de derechos civiles"@es-mx,
        "Réclamation pour violation des droits civils"@fr-fr,
        "תביעה על הפרת זכויות אזרחיות"@he-il,
        "नागरिक अधिकार उल्लंघन दावा"@hi-in,
        "市民権侵害請求"@ja-jp,
        "Reivindicação de violação dos direitos civis"@pt-br,
        "民权侵犯索赔"@zh-cn ;
    skos:definition "A civil rights violation claim is a legal action brought against a government entity for violating an individual's rights protected by law, such as discrimination or denial of voting rights." .

<RC6vjtn3GZLRw0qRl5YjMwV> a owl:Class ;
    rdfs:label "Retirement Account" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCrOThiq2BioEVHnqev8KdQ> ],
        <RB5FdDMLLaFHBHANY4bMB3T> ;
    skos:altLabel "401(k)",
        "Individual Retirement Account",
        "Pension" ;
    skos:definition "A Retirement Account is a financial account designed to help individuals save for their retirement, often offering tax advantages. Types of retirement accounts include 401(k)s, Individual Retirement Accounts (IRAs), and pension plans, among others, and they typically come with restrictions on withdrawals to incentivize long-term saving. Relevant to several areas of law (e.g., Bankruptcy Law)." .

<RC9rPAii8f99I7p4Hi5Qdia> a owl:Class ;
    rdfs:label "Sensory Disability" ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Sensory Deficit",
        "Sensory Impairment",
        "Sensory Loss" ;
    skos:definition "Sensory Disability refers to impairments that affect one or more of the senses, such as sight, hearing, touch, taste, or smell. These disabilities can range from mild to severe and can significantly impact an individual's ability to interact with their environment and perform daily activities." .

<RCBF76e886458EE774c35fd1> a owl:Class ;
    rdfs:label "North Dakota" ;
    dc:identifier "NAM-US-US+ND" ;
    rdfs:subClassOf <R1E70ce4D699e90144cB32b8> ;
