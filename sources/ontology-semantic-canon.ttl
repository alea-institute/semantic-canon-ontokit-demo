        <R8qItBwG2pRMFhUq1HQEMnb> ;
    skos:altLabel "Vertrauliche Kommunikation"@de-de,
        "Privileged Communication"@en-gb,
        "Comunicación privilegiada"@es-es,
        "Comunicación privilegiada"@es-mx,
        "Communication privilégiée"@fr-fr,
        "תקשורת פרטית"@he-il,
        "विशेषाधिकार संचार"@hi-in,
        "特権通信"@ja-jp,
        "Comunicação privilegiada"@pt-br,
        "特权通信"@zh-cn ;
    skos:definition "Privileged Communication: A type of communication that is protected by law and cannot be disclosed without the consent of the parties involved, even in legal proceedings." .

<RCqqI0SLTxsE8Z2rCu7KOXm> a owl:Class ;
    rdfs:label "Prohibition" ;
    rdfs:subClassOf <RClhbl4E1TJp9LygIXewIhn> ;
    skos:definition "Prohibition refers to a legal or moral mandate that forbids or restricts a specific action, behavior, or practice, enforceable by law or ethical principles." .

<RCrVPCBH6CAlY5QotfilJKY> a owl:Class ;
    rdfs:label "New Jersey County Court" ;
    rdfs:subClassOf <R519e1c1BE7657EB2eeDDfb5> ;
    skos:definition "A New Jersey County Court is a court of law that has jurisdiction over cases within a specific county in New Jersey, and is a subcategory of the New Jersey State Courts." .

<RCrkuhfEvrGj2ITZSLQCqYW> a owl:Class ;
    rdfs:label "Automobile Registration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RnnJLAzGV4emQlsf4z80ci> ],
        <R8wOITiPftK5xTRvzn957oX> ;
    skos:definition "\"Automobile Registration\" refers to the official process of recording essential information about an automobile, such as its make, model, and ownership, with a government authority. This registration, often represented by a certificate or license plate, is required for the vehicle to be legally driven on public roads." ;
    skos:prefLabel "Vehicle Registration" .

<RCsRWbVwZat6lud2K3XpOLj> a owl:Class ;
    rdfs:label "Hearing Disability" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/2.00-SpecialSensesandSpeech-Adult.htm#2_10> ;
    rdfs:subClassOf <RC9rPAii8f99I7p4Hi5Qdia> ;
    skos:altLabel "Auditory Disability",
        "Auditory Impairment",
        "Hearing Loss" ;
    skos:definition "A Hearing Disability is a partial or total inability to hear sounds in one or both ears, which can affect communication, social interaction, and daily activities. This condition can range from mild hearing loss to profound deafness and may require the use of hearing aids, cochlear implants, or other assistive devices." ;
    skos:prefLabel "Hearing Impairment" .

<RCsSG3CCLhnxP2AJIMaGhaZ> a owl:Class ;
    rdfs:label "Cooperative" ;
    rdfs:isDefinedBy <https://ncbaclusa.coop/resources/state-cooperative-statute-library/> ;
