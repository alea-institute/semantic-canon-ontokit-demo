    skos:altLabel "Mediationsveranstaltung"@de-de,
        "Mediation Event"@en-gb,
        "Evento de Mediación"@es-es,
        "Evento de Mediación"@es-mx,
        "Événement de médiation"@fr-fr,
        "אירוע גישור"@he-il,
        "मध्यस्थता घटना"@hi-in,
        "調停イベント"@ja-jp,
        "Evento de mediação"@pt-br,
        "调解事件"@zh-cn ;
    skos:definition "A Mediation Event is a specific type of Alternative Dispute Resolution (ADR) Event that involves a neutral third party facilitating communication and negotiation between parties in conflict, with the goal of reaching a mutually acceptable resolution." .

<RXSTGSDxWOEtAveyXQuMH1> a owl:Class ;
    rdfs:label "Child Dependency Court" ;
