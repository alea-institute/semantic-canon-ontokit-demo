        "Desalojo ilegal"@es-mx,
        "détention illégale"@fr-fr,
        "הפרת מניעה חוקית"@he-il,
        "अवैध रोकथाम"@hi-in,
        "不法拘束"@ja-jp,
        "detenção ilegal"@pt-br,
        "非法拘留"@zh-cn ;
    skos:definition "An unlawful detainer is a summary proceeding for a landlord to recover possession of a leased premises from a tenant wrongfully withholding or \"detaining\" the property." .

<R9wXEpicPBDF420JUfmdsD8> a owl:Class ;
    rdfs:label "Drug Testing Policy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8xSzwRnuQy4kqrATCJ6awq> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9Tyn1myNHR9ZL14Xk8j972> ],
        <RCZyrH2dIAtpDh2AzPTekph> ;
    skos:definition "A drug testing policy is a formal document established by an organization that outlines the procedures, guidelines, and consequences related to the testing of employees for the presence of drugs and/or alcohol. It generally seeks to ensure a safe and productive work environment by preventing substance abuse and its associated risks." .

<R9x5QwRGiVmdj639Zj4wz1a> a owl:Class ;
    rdfs:label "Wild Animal" ;
    rdfs:subClassOf <RBbKQavNM8iQqNfPu2byT6X> ;
    skos:altLabel "Untamed Animal",
        "Wild Creature" ;
    skos:definition "A Wild Animal is a species that lives and thrives in its natural habitat without direct dependence on or control by humans. These animals have not been domesticated and typically rely on their instincts and the environment to find food, shelter, and survive." ;
    skos:prefLabel "Wildlife" .

<R9yYWVntPUsGv3az0vFvdn> a owl:Class ;
