<RBAxfpbmWO6iXLjcldJnbKt> a owl:Class ;
    rdfs:label "Background Check Discrimination Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDAQMAQLYgoUdaKQquAhteq> ],
