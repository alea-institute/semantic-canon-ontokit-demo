    rdfs:subClassOf <y-QlHZwpSwWYcD3gWKUN0A> ;
    skos:definition "This industry comprises establishments primarily engaged in accepting demand and other deposits and making commercial, industrial, and consumer loans. Commercial banks and branches of foreign banks are included in this industry." .

<AO4Cla5zQ_-BzZE6i8I0Bw> a owl:Class ;
