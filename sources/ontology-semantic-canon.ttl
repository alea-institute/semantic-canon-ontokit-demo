    rdfs:subClassOf <RCeiXNGpqL4H3jo1g1NobSm> ;
    skos:definition "A court of general jurisdiction in Washington County, Indiana, with the power to hear and decide a wide range of legal cases within its geographical jurisdiction." .

<RCLcEoQ1oheH0tnukpmBgOw> a owl:Class ;
    rdfs:label "Compiler" ;
    rdfs:subClassOf <R8eT1bTptg5J6ZfnwSUQYpf> ;
    skos:altLabel "Collector"^^xsd:string ;
    skos:definition "A compiler is a person or corporate body that gathers, organizes, and arranges texts, materials, or data from multiple sources into a coherent work for ecclesial, doctrinal, liturgical, or administrative use. The compiler does not necessarily originate the content but exercises judgment in selection, structure, and presentation."^^xsd:string ;
    skos:example "A compiler organizes excerpts from Church documents into a catechetical handbook."^^xsd:string,
        "A scholar acts as a compiler of conciliar decrees in a reference volume."^^xsd:string,
        "An office serves as a compiler of decretals into a unified collection."^^xsd:string .

<RCLh5SOu3ypA0CJli2dYT5a> a owl:Class ;
    rdfs:label "Extraordinary Ability Immigrant Petition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RtNdCOiqmpVOXZef1DicAV> ],
        <RKY2B2HNSx5K82dgVN6Qn7> ;
    skos:definition "An Extraordinary Ability Immigrant Petition (in the U.S., the I-140 EB-1) allows individuals with extraordinary abilities in the sciences, arts, education, business, or athletics to apply for permanent residency in the United States. Applicants must demonstrate sustained national or international acclaim and recognition in their field of expertise. Applicants must be able to demonstrate extraordinary ability in the sciences, arts, education, business, or athletics through sustained national or international acclaim." ;
    skos:prefLabel "I-140 EB-1" .

<RCLh6dCWClLfzibDvK1OZkV> a owl:Class ;
    rdfs:label "Filing Fee Waived" ;
