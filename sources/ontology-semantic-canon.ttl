    rdfs:subClassOf <W34Tw5sHTNqJ7fTdB7PAmw> ;
    skos:definition "This industry comprises establishments primarily engaged in providing an array of specialty and luxury passenger transportation services via limousine or luxury sedan generally on a reserved basis. These establishments do not operate over regular routes and on regular schedules." .

<LyySShq8T5ivZ1h7GRTPNQ> a owl:Class ;
