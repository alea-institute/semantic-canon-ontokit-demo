    skos:example "A transitional deacon preaches homilies and assists at the altar during Mass."^^xsd:string,
        "A transitional deacon serves in a parish while completing final seminary requirements."^^xsd:string,
        "A transitional deacon typically proceeds to priesthood after a defined period of service."^^xsd:string,
        "During the diaconal year, a transitional deacon deepens pastoral and liturgical formation."^^xsd:string,
        "The bishop ordains a seminarian as a transitional deacon before priestly ordination."^^xsd:string ;
    skos:prefLabel "Deacon Candidate For Priesthood"^^xsd:string .

