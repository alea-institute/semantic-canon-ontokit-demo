        <R9u4hHZJYFWdtdGcgkoqz1x> ;
    skos:altLabel "Vertraulichkeitsvereinbarung"@de-de,
        "Confidentiality Agreement"@en-gb,
        "Acuerdo de Confidencialidad"@es-es,
        "Acuerdo de Confidencialidad"@es-mx,
        "Accord de confidentialité"@fr-fr,
        "הסכם סודיות"@he-il,
        "गोपनीयता समझौता"@hi-in,
        "機密保持契約"@ja-jp,
        "Acordo de confidencialidade"@pt-br,
        "保密协议"@zh-cn ;
    skos:definition "A Confidentiality Agreement is a legal contract between parties that outlines the terms and conditions for keeping certain information confidential and not disclosing it to third parties." .

<RBnnUGl8ihPMJL1oEIbNGBD> a owl:Class ;
    rdfs:label "Conversion Claim" ;
    rdfs:subClassOf <R8jYAnNATrfoBxAtIKpf72X>,
        <RDqSn32zsjxExcBFzIYxT2D>,
        <RHSZPHkLvnB6N4bgIo6kuX> ;
    skos:altLabel "Civil Theft",
        "Umwandlungsanspruch"@de-de,
        "Revendication de conversion"@fr-fr,
        "転換請求"@ja-jp,
        "Reivindicação de conversão"@pt-br,
        "转换索赔"@zh-cn ;
    skos:definition "A Conversion Claim (Civil Theft) is a civil claim that arises when someone intentionally takes another person's property without permission, and then uses or sells it as their own." .

<RBnsEcCI2IYcIzlWhNi3KyD> a owl:Class ;
    rdfs:label "Pretrial Release Revocation" ;
