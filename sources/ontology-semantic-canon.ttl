    rdfs:subClassOf <RB3vkqIG4fsRfjNZyWvQk6U>,
        <RVR7H8k9X3Zf9PluTbj8J2> ;
    skos:altLabel "Charitable Forgiveness"^^xsd:string,
        "Merciful Pardon"^^xsd:string,
        "Reconciliation"^^xsd:string,
        "Release of Resentment"^^xsd:string,
        "Willing Forgiveness"^^xsd:string ;
    skos:definition "Forgive Offenses Willingly is a spiritual work of mercy that consists in freely pardoning those who have caused injury or offense. Forgive Offenses Willingly restores charity by releasing resentment and entrusting justice to God."^^xsd:string ;
    skos:example "A Christian prays for the one who caused harm as an act of mercy."^^xsd:string,
        "A believer releases bitterness after being wronged by a colleague."^^xsd:string,
        "A community promotes reconciliation after conflict through acts of forgiveness."^^xsd:string,
        "A family member forgives repeated offenses to preserve unity and peace."^^xsd:string,
        "A person forgives an offender without waiting for an apology."^^xsd:string .

