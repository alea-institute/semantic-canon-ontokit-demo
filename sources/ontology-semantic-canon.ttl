<kVMh7FMMSUeYrg0u2UvdkA> a owl:Class ;
    rdfs:label "Manufactured Home (Mobile Home) Manufacturing" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=321991> ;
    rdfs:subClassOf <fOPbREAsSIarGeJiYAaoiw> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in making manufactured homes (i.e., mobile homes) and nonresidential mobile buildings. Manufactured homes are designed to accept permanent water, sewer, and utility connections and although equipped with wheels, they are not intended for regular highway movement." .

<kVz6aMuNRIavyx_hUGiaVA> a owl:Class ;
    rdfs:label "Specialized Freight (except Used Goods) Trucking, Long-Distance" ;
