    rdfs:subClassOf <RB2K2E9rftRKciKOqkr1BeV> ;
    skos:altLabel "FPTP",
        "First-Past-the-Post Voting",
        "Simple Majority System",
        "Single-Member Plurality" ;
    skos:definition "A First-Past-the-Post (FPTP) electoral system is a voting method where the candidate with the most votes in a single-member district wins the election. This system does not require the winner to achieve a majority of the votes, only a plurality." ;
    skos:example "Constituency-Based Voting: Canadian federal elections",
        "First-Past-the-Post (FPTP): United Kingdom general elections",
        "Single-Member District Plurality: U.S. House of Representatives elections" ;
    skos:prefLabel "Plurality Voting" .

