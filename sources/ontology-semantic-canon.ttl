<R89ziIl0nXs5c4ONtS7qXTP> a owl:Class ;
    rdfs:label "Security and Confidentiality Attributes" ;
    dc:source <https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf#page=401&zoom=100,124,477> ;
