            owl:someValuesFrom <RUhSbbDJZa8Crs3tIWcIfV> ],
        <Rt7TTPXJ7WX1Jrjufs0Mdr> ;
    skos:definition "A devisee is an individual or entity designated in a will to receive real property from the estate of the deceased. The term specifically refers to beneficiaries of real estate, distinguishing them from legatees who inherit personal property." .

<R7ThXbAhhJvDfLZDgWWqPJz> a owl:Class ;
