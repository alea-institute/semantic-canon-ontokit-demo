<R4BbNqGb3HJAUtTar6b1i> a owl:Class ;
    rdfs:label "Domestic Authority" ;
    rdfs:subClassOf <R8L6V5AA4I5wcDrZtJjGLRb> ;
    skos:altLabel "Authority of the Domestic Church"^^xsd:string,
        "Familial Authority"^^xsd:string,
        "Family Governance"^^xsd:string,
        "Household Authority"^^xsd:string ;
    skos:definition "Domestic Authority is the moral and juridical power exercised within the family unit, often referred to as the \"domestic church,\" to govern, educate, and sanctify its members in accordance with natural and divine law. It is the foundational layer of social authority, rooted in the sacrament of marriage and the natural right of parents, rather than being derived from the state."^^xsd:string ;
    skos:example "A father leading the family in the rosary before bed"^^xsd:string,
        "a husband and wife jointly deciding on a significant financial investment for the household"^^xsd:string,
        "a widowed grandmother acting as the head of the household for her grandchildren"^^xsd:string,
        "parents establishing specific rules regarding internet usage for their children"^^xsd:string .

