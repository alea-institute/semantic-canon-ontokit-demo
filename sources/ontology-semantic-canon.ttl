<R8JoCwCI4MPbdDjdY8UHi7L> a owl:Class ;
    rdfs:label "Coronation of Mary" ;
    rdfs:subClassOf <R78g2Psn6TygAlkIoCnXqdd>,
        <ROaU08jUOgsbTbTXXNTIXX> ;
    skos:altLabel "Coronation of the Blessed Virgin Mary"^^xsd:string,
        "Coronation of the Mother of God"^^xsd:string,
        "Coronation of the Virgin Mary"^^xsd:string,
        "Mary Crowned as Queen of Heaven"^^xsd:string,
        "Queenship of Mary"^^xsd:string ;
    skos:definition "The Coronation of Mary is the belief that Mary, exalted in heavenly glory, is crowned as Queen by God in recognition of her unique role in salvation history. It expresses her participation in Christ’s kingship and her continuing intercessory role for the faithful."^^xsd:string ;
    skos:example "A church artwork portrayed the Coronation of Mary with Christ placing a crown upon her head."^^xsd:string,
        """A great sign appeared in the sky, a woman clothed with the sun, with the moon under her feet, and on her head a crown of twelve stars.
(Revelation 12:1)"""^^xsd:string,
        "A theologian linked the Coronation of Mary to themes of hope and intercession."^^xsd:string,
        "The faithful celebrated the Queenship of Mary as an expression of her exaltation in heaven."^^xsd:string .

