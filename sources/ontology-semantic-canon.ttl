<R7g2nPR7ZWwdLzPrlvUb6Q7> a owl:Class ;
    rdfs:label "Sin of Word" ;
    rdfs:subClassOf <R9OgIrSnvf4G55veAeT6Eqp> ;
    skos:altLabel "Misuse of Language"^^xsd:string,
        "Offense of Speech"^^xsd:string,
        "Sinful Speech"^^xsd:string,
        "Verbal Sin"^^xsd:string ;
    skos:definition "Sin of Word is a form of exterior personal sin committed through speech that violates truth, charity, or reverence. Sin of Word occurs when spoken language is used to harm others, dishonor God, or corrupt moral order."^^xsd:string ;
    skos:example "A person damages another’s reputation by spreading false accusations."^^xsd:string,
        "A person knowingly lies to deceive another through spoken words."^^xsd:string,
        "A person speaks irreverently about God or sacred things."^^xsd:string .

