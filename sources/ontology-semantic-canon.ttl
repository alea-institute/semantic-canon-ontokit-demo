    skos:prefLabel "Unemployment Income" .

<RCn9LUvz0qRZZwYVwFfUzEm> a owl:Class ;
    rdfs:label "Party-List Proportional Representation System - Open List" ;
    dc:source <https://en.wikipedia.org/wiki/Open_list> ;
    rdfs:subClassOf <RCMZqt2BD3qRRYlj61ssnIZ> ;
    skos:altLabel "Voter-Determined List System" ;
    skos:definition "An Open List Party-List Proportional Representation System allows voters to influence the order of candidates on a party's list by indicating their preference for specific candidates. The number of seats each party wins is determined by the proportion of votes received, and candidates are selected based on their popularity within the party list." ;
    skos:example "Local Open List: Switzerland's National Council elections",
        "National Open List: Finland's Eduskunta elections",
        "Regional Open List: Sweden's Riksdag elections" .

