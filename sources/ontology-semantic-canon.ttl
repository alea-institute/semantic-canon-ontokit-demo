<Rm8MHBr4Qut8YqPsuzz7xO> a owl:Class ;
    rdfs:label "Spousal Authority" ;
    rdfs:subClassOf <R4BbNqGb3HJAUtTar6b1i> ;
    skos:altLabel "Authority within Marriage"^^xsd:string,
        "Conjugal Authority"^^xsd:string,
        "Headship and Mutual Subjection"^^xsd:string,
        "Marital Authority"^^xsd:string,
        "Mutual Authority of Spouses"^^xsd:string ;
    skos:definition "Spousal Authority is the moral authority spouses exercise within the covenant of marriage for the good of one another and of the family they form. Spousal Authority operates through mutual self-gift and ordered responsibility, directing shared life toward unity, fidelity, and salvation rather than domination."^^xsd:string ;
    skos:example "A husband and wife jointly decide how to allocate household finances."^^xsd:string,
        "A wife consents to medical decisions for her husband during a medical emergency."^^xsd:string,
        "Spouses discern together whether to relocate for family or work reasons."^^xsd:string,
        "Spouses establish shared practices of prayer and worship in their home."^^xsd:string .

