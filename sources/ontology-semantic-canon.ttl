<RCBP9N5ER7Y6inNQdjggrKt> a owl:Class ;
    rdfs:label "Estate" ;
    rdfs:subClassOf <RCIwc6WJi6IT7xePURxsi4T> ;
    skos:altLabel "Personal Estate",
        "Property Holdings" ;
    skos:definition "An Estate refers to all the possessions, property, and legal rights owned by an individual, including land, tenements, and personal assets. It also encompasses the total assets and liabilities left by a person at death, which are subject to distribution according to the terms of a will or the laws of intestacy." ;
    skos:prefLabel "Personal Property" .

<RCD644b34Dca88E2613EBce9> a owl:Class ;
