    rdfs:subClassOf <nSv2xP7YS9qZV7SMY7Aknw> ;
    skos:definition "This industry comprises establishments primarily engaged in raising bees. These establishments may collect and gather honey; and/or sell queen bees, packages of bees, royal jelly, bees' wax, propolis, venom, pollen, and/or other bee products." .

<IBVNBPHeQva7m00TTfEC-g> a owl:Class ;
    rdfs:label "Convention and Visitors Bureaus" ;
