<RBrSWvfPR3YZFl63qupzFML> a owl:Class ;
    rdfs:label "Neurological Collapse States" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_20> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH>,
        <RtHkyQ5lSxRaJ9oaSOWbkx> ;
    skos:altLabel "Severe Neurological Impairment States" ;
    skos:definition "Neurological Collapse States refer to conditions characterized by severe impairment of brain function, leading to a significant reduction or absence of conscious awareness and neurological activity. These states can arise from various causes, including trauma, disease, or systemic failure, and are critical in determining legal and medical decisions regarding life support and end-of-life care." ;
    skos:prefLabel "Neurological Failure States" .

<RBwnjqdPUZaR0T0pghMXTl6> a owl:Class ;
    rdfs:label "Christ's Parables" ;
    rdfs:subClassOf <R9VpyiXQxLbATS2mPSOlbqT> ;
    skos:definition "Christ’s Parables means the short narrative teachings used by Jesus Christ to reveal truths about the Kingdom of God through imagery drawn from ordinary life. Christ’s Parables both disclose divine mysteries to receptive listeners and challenge hearers to conversion and deeper understanding."^^xsd:string ;
    skos:example "The Gospels record Jesus teaching the crowds through parables drawn from daily life."^^xsd:string,
        "The parable of the Good Samaritan illustrates love of neighbor through concrete action."^^xsd:string ;
    skos:prefLabel "Parables of Jesus"^^xsd:string .

<RC27xIi05f9TBUDgpjVvuCg> a owl:Class ;
    rdfs:label "Borrower" ;
    dc:identifier "BORR" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R77pHybcEdlO9OmqSuiyWi1> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7xqVevh0JKSwX977TRIZQV> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Borrower",
