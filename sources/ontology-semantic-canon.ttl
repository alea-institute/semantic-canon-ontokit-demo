    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9tyJmIM3Lx7OItGji5zPXN> ],
        <RCFgxBbypUKKsDDOJ1iOk36> ;
    skos:altLabel "Gegenbeklagter"@de-de,
        "Counter-Defendant"@en-gb,
        "Contrademandado"@es-es,
        "Contrademanda"@es-mx,
        "Contre-défendeur"@fr-fr,
        "נתבע נגדי"@he-il,
        "काउंटर-डिफेंडेंट"@hi-in,
        "反訴被告"@ja-jp,
        "Contraréu"@pt-br,
        "反被告"@zh-cn ;
    skos:definition "A person against whom a counterclaim is brought." .

<RhBvOCNsTuHs1L1cRSwWuL> a owl:Class ;
    rdfs:label "Supervised Release" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9WUFEb3p0Ep21EQ8yBptxD> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RFKZXX9MKTuXedgtPWeU3i> ],
        <R0tJKDoGSixec7FgGKnAAl> ;
    skos:altLabel "Community Sentence",
        "Conditional Release",
        "Conditional Sentence" ;
    skos:definition "In criminal justice, parole is the conditional release of an offender from incarceration, allowing them to serve the remainder of their sentence under community supervision, provided they comply with certain terms and conditions set by a parole board" ;
    skos:prefLabel "Parole" .

<Ri4LGaOgWzMWy2yX79DQi0> a owl:Class ;
    rdfs:label "Hemolytic Anemias" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_05> ;
    rdfs:subClassOf <R7O2ClQ73HLZZLgFgtNbVTF> ;
    skos:definition "Hemolytic Anemias are a group of conditions characterized by the premature destruction of red blood cells, leading to a decreased number of circulating red blood cells and a resultant anemia. The condition can be caused by intrinsic factors, such as genetic defects, or extrinsic factors, such as autoimmune reactions or infections." .

<Rijn2Efl5I4ixKTA86MDfT> a owl:Class ;
    rdfs:label "Spinal Cord Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_08> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH> ;
    skos:altLabel "Spinal Cord Disease",
        "Spinal Cord Injury" ;
    skos:definition "Spinal cord disorders involve conditions that affect the spinal cord, impairing its function and potentially causing a range of neurological and physical disabilities. These disorders can result from trauma, disease, or degeneration, impacting the transmission of nerve signals between the brain and the rest of the body." ;
    skos:prefLabel "Myelopathy" .

<RkaH1u58Roj4YNWXPG0Cap> a owl:Class ;
    rdfs:label "Authority (Source and Scope)"@en ;
    skos:definition "Authorities are persons, offices, bodies, or sources whose judgments, teachings, or decisions carry recognized weight within a defined domain. Their authority grounds reliance, obedience, or assent according to the nature and scope of that authority."@en ;
    skos:prefLabel "Authorities"@en .

<RkbK9db9B0b7yQsNemaaiQ> a owl:Class ;
    rdfs:label "Verse (Textual Unit)" ;
    rdfs:subClassOf <R7SWDfYuq2ExnV9WkGTLhyA> ;
    skos:altLabel "Biblical Verse"^^xsd:string,
        "Scriptural Verse"^^xsd:string ;
    skos:definition "Verse is a minimal, numbered textual unit within Sacred Scripture used to organize and cite the biblical text. It allows precise reference to specific words or sentences within a chapter."^^xsd:string ;
    skos:example "John 1:1."^^xsd:string,
        "Matthew 28:19."^^xsd:string,
        "Psalm 23:1."^^xsd:string ;
    skos:prefLabel "Verse"^^xsd:string .

<RktL8UcgTzfjXB8cZ4KM52> a owl:Class ;
    rdfs:label "Parent-Child Liability" ;
    rdfs:subClassOf <R7XlRtk6WMnbMZULXcg7SnI> ;
    skos:altLabel "Eltern-Kind-Haftung"@de-de,
        "Parent-Child Liability"@en-gb,
        "Responsabilidad paterno-filial"@es-es,
        "Responsabilidad paterno-filial"@es-mx,
        "Responsabilité parent-enfant"@fr-fr,
        "אחריות הורה-ילד"@he-il,
        "माता-पिता-बच्चे की ज़िम्मेदारी"@hi-in,
        "親子責任"@ja-jp,
        "Responsabilidade pai-filho"@pt-br,
        "父母子女责任"@zh-cn ;
    skos:definition "The legal concept of Parent-Child Liability refers to the responsibility of a parent for the actions or debts of their child, within the context of Family Liability." .

<RlZdd14uUrCvqa8YJ7RzNd> a owl:Class ;
    rdfs:label "Authorship" ;
    rdfs:subClassOf <R8O3PoolmgHAy2hrZsguhqy> ;
    skos:definition "Authorship, particularly human authorship in copyright law, designates the creation of a work by a human being, attributing legal rights and responsibilities to the creator. This principle recognizes the human creator as the source of intellectual creativity and grants them exclusive rights over their work." .

<RlgFAjqizwHVxH4GdLhb1J> a owl:Class ;
    rdfs:label "Municipal Liability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCR7Z71r5mmHYFs1xoAWwzE> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9Ssnolzs98skM2RcQkIjkY> ],
        <R9b5fs8QJuliSZYeaJLJU2t> ;
    skos:altLabel "Kommunale Haftung"@de-de,
        "Municipal Liability"@en-gb,
        "Responsabilidad Municipal"@es-es,
        "Responsabilidad Municipal"@es-mx,
        "Responsabilité municipale"@fr-fr,
        "אחריות מוניציפלית"@he-il,
        "नगर प्रशासन की जिम्मेदारी"@hi-in,
        "地方自治体の責任"@ja-jp,
        "Responsabilidade municipal"@pt-br,
        "市政责任"@zh-cn ;
    skos:definition "Municipal Liability refers to the legal responsibility of a city or other local government entity for the actions or omissions of its employees or agents, which may result in harm or damages to individuals or property." .

<Rmh26VkWP4ZFcOPX4XE3oA> a owl:Class ;
    rdfs:label "Sacraments of Healing" ;
    rdfs:subClassOf <RB91Ir5bSOsoHyaGccORDpQ> ;
    skos:altLabel "Healing Sacraments"^^xsd:string,
        "Sacraments of Restoration"^^xsd:string ;
    skos:definition "Sacraments of Healing are the sacraments through which Christ continues his work of healing and reconciliation among the faithful. They restore spiritual health weakened by sin and provide grace in times of illness and suffering."^^xsd:string ;
    skos:example "Christ continues his healing ministry through these sacraments."^^xsd:string,
        "The Church offers the sacraments of healing in times of spiritual or bodily distress."^^xsd:string,
        "The sacraments of healing restore communion with God and the Church."^^xsd:string .

<RmiYQJshZzYvIsqEWLjj1x> a owl:Class ;
    rdfs:label "Export Control Claims" ;
    rdfs:subClassOf <R9LVBKjvGRuzwgtlhuLST36> ;
    skos:altLabel "Export Violation Claim" ;
    skos:definition "An Export Control Claim arises when an individual or entity is accused of violating regulations that govern the export, re-export, and transfer of controlled goods, technology, and services. This claim involves allegations of unauthorized exports, failure to obtain necessary licenses, or exporting to prohibited destinations or entities." .

<RnDeUu0kFB2F39jo4UbcuQ> a owl:Class ;
    rdfs:label "Visa" ;
    rdfs:subClassOf <R7gKTQpOKfQ2tOdPu6cLN3w> ;
    skos:definition "A visa is an official document or endorsement that grants the holder permission to enter, stay, or leave a specific country for a specified period. It is usually stamped or affixed to the traveler's passport and may come with various conditions such as the purpose of the visit, duration of stay, and whether multiple entries are allowed" .

<RnKWv1E6U2Ssc5SRsG14NO> a owl:Class ;
    rdfs:label "Factual Statement" ;
    rdfs:subClassOf <RDmbgHQXJxEvx3QYfR6qWAn> ;
    skos:altLabel "Tatsachenbehauptung"@de-de,
        "Factual Statement"@en-gb,
        "Declaración de Hecho"@es-es,
        "Afirmación Fáctica"@es-mx,
        "Déclaration factuelle"@fr-fr,
        "הצהרת עובדה"@he-il,
        "तथ्यात्मक बयान"@hi-in,
        "事実陳述"@ja-jp,
        "Declaração factual"@pt-br,
        "事实陈述"@zh-cn ;
    skos:definition "A document's statement of fact (e.g., brief's recitation of facts, judicial findings of fact)." .

<RnZ7eyYiAky9xPb7cvRsir> a owl:Class ;
    rdfs:label "Hospitality - Real Estate Asset" ;
