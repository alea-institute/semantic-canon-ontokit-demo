<R8GXZxWsugTGgVmMyhrFO20> a owl:Class ;
    rdfs:label "Employment-Based Immigration Request" ;
    rdfs:subClassOf <RB5tNYSDrxEoYAqZ3sy0rae> ;
    skos:definition "An Employment-Based Immigration Request is a type of immigration application in which an individual seeks entry or residency in a destination country based on a job offer or employment opportunity. The sponsoring employer usually files petitions and necessary documents on behalf of the employee, and the process often involves labor certifications and other prerequisites to prove the employment need." .

<R8GdwZqxh68i37ND4exqzbh> a owl:Class ;
    rdfs:label "Originating Country" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RYR2drZu94msrQ4RDFyPoU> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCyM0jZS12kH8LsAYFKrKQA> ],
        <R9ODLnhxFt38FQNV4BUbRSD> ;
    skos:definition "Originating Country, in the context of immigration and customs, refers to the country from which an individual or goods have moved or are seeking to move from. In the immigration context, this move is often with the intention of settling in another country either temporarily or permanently. This term is important for customs and immigration processes and policies, as it can influence visa requirements, eligibility for asylum, and other legal considerations." .

<R8Gn7fCY4bwZYcotFK7je9z> a owl:Class ;
