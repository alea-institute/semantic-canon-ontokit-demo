    skos:definition "A court located in Vanderburgh County, Indiana that has jurisdiction over civil and criminal cases within its geographical area." .

<RBjHlhJCrfswuGxGyjLZibB> a owl:Class ;
    rdfs:label "Borderline Personality Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RCnCHWsREqpfQAAfaN2lRPV> ;
    skos:altLabel "BPD",
        "Borderline Disorder",
        "EUPD",
        "Emotional Dysregulation Disorder",
        "Emotionally Unstable Personality Disorder",
        "Unstable Personality Disorder" ;
    skos:definition "Borderline Personality Disorder (BPD) is a mental health condition characterized by pervasive instability in moods, behavior, self-image, and functioning. Individuals with BPD often experience intense episodes of anger, depression, and anxiety that can last from a few hours to days, leading to impulsive actions and unstable relationships." .

<RBjIeLyl8QWh6zXpbbqu07F> a owl:Class ;
