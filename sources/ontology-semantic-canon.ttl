<R7xwsOkoji8EZRUrS511KGF> a owl:Class ;
    rdfs:label "Triune God" ;
    rdfs:subClassOf <R7VytRdXoJzs9aO8OQmI3l1> ;
    skos:altLabel "One God in Three Persons"^^xsd:string,
        "The Trinity"^^xsd:string,
        "Trinitarian God"^^xsd:string,
        "Triune Deity"^^xsd:string ;
    skos:definition "The Triune God refers to the one true God who exists eternally as three distinct divine Persons: Father, Son, and Holy Spirit. Each Person fully possesses the one divine essence, equal in divinity and united in communion without division or hiera"^^xsd:string ;
    skos:example "Catholic theology treats the Triune God as the central mystery of faith."^^xsd:string,
        "Catholics confess the Triune God in the Nicene Creed."^^xsd:string,
        "Christian prayer often addresses the Triune God through Trinitarian formulas."^^xsd:string,
        "The liturgy glorifies the Triune God as Father, Son, and Holy Spirit."^^xsd:string ;
    skos:prefLabel "Holy Trinity"^^xsd:string .

<R7z0ey8ZMeOT1q01VNPe1HY> a owl:Class ;
    rdfs:label "Geographic Market Segments" ;
