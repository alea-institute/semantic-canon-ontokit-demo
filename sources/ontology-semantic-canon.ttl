    skos:definition "This U.S. industry comprises establishments primarily engaged in manufacturing ornamental and architectural metal work, such as staircases, metal open steel flooring, fire escapes, railings, and scaffolding." .

<3ktxWGz6Td2564VVz9eAmw> a owl:Class ;
    rdfs:label "Support Activities for Animal Production" ;
