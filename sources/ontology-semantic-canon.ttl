            owl:someValuesFrom <RCp6PzHvkRv1l3pXC9E4Mse> ],
        <RCzs34uEQI9f4cuWp3bQO0P> ;
    skos:altLabel "Act of God Doktrin"@de-de,
        "Act of God Doctrine"@en-gb,
        "Doctrina de la Fuerza Mayor"@es-es,
        "Doctrina del Caso Fortuito"@es-mx,
        "Doctrine de la force majeure"@fr-fr,
        "תפיסת כוח מעלה"@he-il,
        "भगवान की कृपा नीति"@hi-in,
        "天災責任原則"@ja-jp,
        "Doutrina do caso fortuito"@pt-br,
        "天灾责任原则"@zh-cn ;
    skos:definition "The Act of God Doctrine is a legal defense in civil litigation that excuses a party from liability for damages or injuries caused by natural events that are beyond human control, such as earthquakes, floods, or lightning strikes." .

<R8Ctbvy5bjPzTRvIZNlGihO> a owl:Class ;
