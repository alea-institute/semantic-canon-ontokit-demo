        "finalized",
        "folio:concluded" ;
    skos:definition "In a legal framework, \"completed\" refers to the finalization or conclusion of a legal task, process, or document. This term indicates that all necessary actions, procedures, or requirements have been fulfilled, bringing an aspect of the work to a close and often rendering it effective or enforceable." ;
    skos:prefLabel "folio:finalized" .

<RBHWUtQZOtxmjDCio0r5UJt> a owl:Class ;
