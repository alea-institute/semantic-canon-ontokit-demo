<RBkiXeTu9Rj1Hq7ISd21CMx> a owl:Class ;
    rdfs:label "Bulimia Nervosa" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RCfOoWbuAOqLv617rVNcHYh> ;
    skos:altLabel "Bulimia" ;
    skos:definition "Bulimia Nervosa is an eating disorder characterized by recurrent episodes of binge eating followed by compensatory behaviors such as vomiting, excessive exercise, or misuse of laxatives to prevent weight gain. Individuals with this disorder often have a preoccupation with body image and weight, leading to a cycle of bingeing and purging." ;
    skos:prefLabel "Bulimic Disorder" .

