        "文档类型"@zh-cn ;
    skos:definition "Types of documents." .

<RC3I2GwWuuKWmRJVXgxXeb> a owl:Class ;
    rdfs:label "Partnership" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9fslqJlcJW7E5ey4lzHMF5> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9JkfZIjkVSa5ud1tJ14w3i> ],
