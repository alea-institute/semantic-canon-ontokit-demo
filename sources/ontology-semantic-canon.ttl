    skos:altLabel "IRS-Berufungsbüro"@de-de,
        "IRS Office of Appeals"@en-gb,
        "Oficina de Apelaciones del IRS"@es-es,
        "Oficina de Apelaciones del IRS"@es-mx,
        "Bureau des appels de l'IRS"@fr-fr,
        "משרד הערעורים של ה-IRS"@he-il,
