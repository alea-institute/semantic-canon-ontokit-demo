    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:altLabel "replaced" ;
    skos:definition "\"Replaced\" in a legal or administrative context refers to the act of substituting one item, individual, agreement, or legal document with another. This process involves the removal or cessation of the original entity or item's role or function, and its subsequent substitution with a new or updated equivalent." ;
    skos:example "Judge Replaced Order",
        "Registrar Replaced License" .

<RBMGOGO9AkbcyrLkeYSDnZK> a owl:Class ;
