<R8JM6rpfa00K75qJEo3ghVb> a owl:Class ;
    rdfs:label "Multiple Sclerosis" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_09> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH>,
        <REFNhmFYG6yk3W0RPLFV6g> ;
    skos:altLabel "MS" ;
    skos:definition "Multiple Sclerosis (MS) is a chronic autoimmune disease that affects the central nervous system (CNS), leading to the destruction of the protective myelin sheath covering nerve fibers. This demyelination disrupts nerve signals, resulting in symptoms such as muscle weakness, coordination problems, visual disturbances, and cognitive impairments." .

<R8JQFdoJa70Do7hIAD4wEWZ> a owl:Class ;
