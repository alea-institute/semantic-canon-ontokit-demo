<RCymFqZ4uzSi1MXyfIUk1TH> a owl:Class ;
    rdfs:label "Party Admission" ;
    dc:source "Fed. R. Evid. 801(d)(2)" ;
    rdfs:subClassOf <R82DCY9wpy8RlxYrwn0NIya> ;
    skos:altLabel "Admission by a Party",
        "Statement by a Party Opponent" ;
    skos:definition "A Party Admission is a statement made by a party to a legal proceeding that is offered as evidence against that party. Party admissions are considered non-hearsay and are admissible as an exception to the hearsay rule due to the inherent reliability and fairness of allowing a party's own statements to be used against them." .

