<RBjPBNzYwjjG3VNncAAPVPz> a owl:Class ;
    rdfs:label "Gastrointestinal Hemorrhaging" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/5.00-Digestive-Adult.htm#5_02> ;
    rdfs:subClassOf <RB6mWlc1WihUbnT7ztVcao5> ;
    skos:altLabel "Gastrointestinal Bleed" ;
    skos:definition "Gastrointestinal hemorrhaging refers to bleeding that occurs within the gastrointestinal (GI) tract, which includes the esophagus, stomach, intestines, and rectum. This condition can manifest as either upper GI bleeding (e.g., from ulcers or varices) or lower GI bleeding (e.g., from hemorrhoids or colorectal cancer) and may require urgent medical attention and treatment to manage blood loss and address underlying causes." ;
    skos:prefLabel "GI Bleeding" .

<RBjRDGuY8fy58h8EnOOASDY> a owl:Class ;
    rdfs:label "Shoshone-Paiute Tribes of the Duck Valley Reservation" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<RBjYlL8vzxrD1PFYtYCf24M> a owl:Class ;
    rdfs:label "Assignee of Member" ;
    rdfs:subClassOf <RBH54tIgUv3NHcHH7pgwdaL> ;
    skos:definition "An assignee of a member (e.g., member of an LLC) is a person or entity to whom a member transfers their membership interest, either partially or wholly. The assignee typically acquires the economic rights associated with the membership interest but may not automatically gain the right to participate in the management or voting of the organization unless the other members consent." .

<RBjZ0mWjcW2uFBnCYMtdXHU> a owl:Class ;
    rdfs:label "Sin of Deed" ;
    rdfs:subClassOf <R9OgIrSnvf4G55veAeT6Eqp> ;
    skos:altLabel "Deed-Based Sin"^^xsd:string,
        "External Act of Sin"^^xsd:string,
        "Sin by Action"^^xsd:string ;
    skos:definition "Sin of Deed is a form of exterior personal sin committed through an outward action that violates divine law and right reason. Sin of Deed gives concrete expression to moral disorder by choosing and performing an act contrary to charity, justice, or truth."^^xsd:string ;
    skos:example "A person commits a sin of deed by acting knowingly against justice and charity."^^xsd:string,
        "A person commits an act of violence against an innocent individual."^^xsd:string,
        "A person defrauds another through deliberate deceptive action."^^xsd:string,
        "A person steals property that belongs to another."^^xsd:string .

