<R8jcVDnQwdnKGmGiTEDU6a0> a owl:Class ;
    rdfs:label "Borda Count Electoral System" ;
    rdfs:subClassOf <R8aVRgLAjmuf0OiloIoc9pm> ;
    skos:definition "The Borda count electoral system is a voting method where voters rank candidates in order of preference, and points are assigned based on the position in which each candidate is ranked. The candidate with the highest total points across all ballots wins the election, promoting a consensus-based selection rather than a simple majority." .

<R8jj3srBAJ1uwSbhFqlt9Y1> a owl:Class ;
