<RCKrakJNv6b1oTTMhd4c5DU> a owl:Class ;
    rdfs:label "Licenses and Permits" ;
    rdfs:comment "From LIST: Legal Issues Taxonomy — https://taxonomy.legal/" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RKKRGOkIme6pnG2BSePt1Z> ],
        <RBCzyIAi2Hjl80hfQr8wAMR> ;
    skos:altLabel "License",
        "Regulatory License" ;
    skos:definition "A license is a legal authorization granted by a governing body or entity, permitting an individual or organization to engage in certain activities, such as operating a business or practicing a profession. Licenses are generally subject to regulations and can be revoked if the licensee fails to comply with specified conditions." ;
    skos:prefLabel "Permit" .

<RCR7Z71r5mmHYFs1xoAWwzE> a owl:Class ;
    rdfs:label "Immunity and Privilege" ;
    rdfs:subClassOf <R8mREFTbCVNHGAdqneLSd0d>,
        <R9m8Wz6rX8oJIJfhFFncV5x>,
        <RCzs34uEQI9f4cuWp3bQO0P> ;
    skos:altLabel "Immunity",
        "Immunität und Privileg"@de-de,
        "Immunity and Privilege"@en-gb,
        "Inmunidad y Privilegio"@es-es,
        "Inmunidad y Privilegio"@es-mx,
        "Immunité et privilège"@fr-fr,
        "חסינות ופריבילגיה"@he-il,
        "अवरोध और विशेषाधिकार"@hi-in,
        "免責特権"@ja-jp,
        "Imunidade e privilégio"@pt-br,
        "豁免和特权"@zh-cn ;
    skos:definition "Immunity and Privilege refers to legal defenses that protect individuals or entities from being held liable or from having to disclose certain information in a legal proceeding. These defenses can include governmental immunity, parental immunity, and various types of privileges such as attorney-client privilege or fair and true reporting privilege." .

<RCksXAlY9lRN16wERqZZ8Tk> a owl:Class ;
    rdfs:label "Finance and Insurance Services Industry" ;
    dc:identifier "FNS" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=52> ;
    rdfs:subClassOf <RDIwFaFcH4KY0gwEY0QlMTp> ;
    skos:altLabel "Finance and Insurance Services",
        "Finanz- und Versicherungsdienstleistungsbranche"@de-de,
        "Finance and Insurance Services Industry"@en-gb,
        "Industria de Servicios Financieros y de Seguros"@es-es,
        "Industria de Servicios Financieros y de Seguros"@es-mx,
        "Industrie des services financiers et d'assurance"@fr-fr,
        "תעשיית שירותי פיננסים וביטוח"@he-il,
        "वित्त और बीमा सेवा उद्योग"@hi-in,
        "金融・保険サービス業"@ja-jp,
        "Indústria de Serviços Financeiros e de Seguros"@pt-br,
        "金融和保险服务行业"@zh-cn ;
    skos:definition "The Finance and Insurance industry group comprises establishments primarily engaged in financial transactions (transactions involving the creation, liquidation, or change in ownership of financial assets) and/or in facilitating financial transactions. Three principal types of activities include: raising funds by taking deposits and/or issuing securities and, in the process, incurring liabilities; and pooling of risk by underwriting insurance and annuities; and providing specialized services facilitating or supporting financial intermediation, insurance, and employee benefit programs." ;
    skos:hiddenLabel "FNS" .

<RCq8YWUS1BXn0VEMPqX9g4i> a owl:Class ;
    rdfs:label "Magisterial Authority Level" ;
    rdfs:subClassOf <RDJCVxMdg9nG7TJxLsDHfRB> ;
    skos:altLabel "Doctrinal Authority Level"^^xsd:string,
        "Ecclesial Teaching Authority"^^xsd:string,
        "Magisterium Authority Level"^^xsd:string,
        "Teaching Authority of the Church"^^xsd:string ;
    skos:definition "Magisterial Authority Level is the authority by which the Church authentically teaches doctrine concerning faith and morals. Magisterial Authority Level binds the faithful’s assent according to the manner in which teaching is proposed and the degree of authority exercised."^^xsd:string ;
    skos:example "A papal encyclical instructs the faithful on moral or social doctrine."^^xsd:string,
        "An ecumenical council defines a doctrine concerning faith or morals."^^xsd:string,
        "Bishops teaching in communion with the pope propose doctrine to be held definitively."^^xsd:string,
        "The Catechism of the Catholic Church presents authoritative teaching on faith and morals."^^xsd:string,
        "The pope teaches infallibly when speaking ex cathedra."^^xsd:string .

<RCuhulltRlDN8kiH5sooyW9> a owl:Class ;
    rdfs:label "Cardiovascular Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/4.00-Cardiovascular-Adult.htm> ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Cardiovascular Conditions",
        "Cardiovascular Diseases" ;
    skos:definition "Cardiovascular disorders encompass any condition that impairs the normal functioning of the heart or the circulatory system, including arteries, veins, capillaries, and lymphatic vessels. These disorders can be congenital, present from birth, or acquired, developing over time due to various factors such as lifestyle or disease." ;
    skos:prefLabel "Heart and Circulatory Disorders" .

<RDIlcywwSJazWLKcbP7QyIE> a owl:Class ;
    rdfs:label "Sacramental Matter" ;
    rdfs:subClassOf <Rcm78ktCa1cCaDSJIY93Yz> ;
    skos:altLabel "Material Element of a Sacrament"^^xsd:string,
        "Sacramental Material Element"^^xsd:string,
        "Sacramental Sign"^^xsd:string ;
    skos:definition "Sacramental Matter is the visible, tangible element or prescribed action used in a sacrament through which Christ conveys grace. It is determined by divine institution and specified by the Church for valid sacramental celebration."^^xsd:string ;
    skos:example "Without proper sacramental matter, a sacrament is invalid."^^xsd:string .

