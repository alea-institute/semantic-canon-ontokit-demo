<RCgPB4rjIkAlnYP6um4QOJq> a owl:Class ;
    rdfs:label "Original Writings Objection" ;
    dc:source "Fed. R. Evid. 1001",
        "Fed. R. Evid. 1007" ;
    rdfs:subClassOf <RoABbJ9kEFzmBvBSGmbAyq> ;
    skos:altLabel "Collateral Matter Objection",
        "Duplicate Document Objection",
        "Independent Facts Objection",
        "Non-genuine Original Objection",
        "Secondary Evidence Objection",
        "Unauthentic Copy Objection" ;
    skos:definition "An Original Writings Objection, also known as the Best Evidence Rule Objection, is raised when a party attempts to introduce a copy or other secondary evidence of a document when the original document is available and required. This objection asserts that the party offering the evidence must provide the original document, as it is the best evidence of its content." ;
    skos:prefLabel "Best Evidence Rule Objection" .

<RCgWPJFp3h83GkZcWfIPGC8> a owl:Class ;
