    rdfs:subClassOf <WDvs-ij5QFqS5OP9Bat39g> ;
    skos:definition "This industry comprises establishments primarily engaged in growing sugarcane." .

<b8jmVN-HR4W0oYPfSfZ_7w> a owl:Class ;
    rdfs:label "Toilet Preparation Manufacturing" ;
