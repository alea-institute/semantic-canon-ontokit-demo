    skos:altLabel "Catholic Campus Minister"^^xsd:string,
        "College Campus Minister"^^xsd:string,
        "University Minister"^^xsd:string ;
    skos:definition "A Campus Minister is a lay ecclesial minister entrusted with pastoral care, faith formation, and evangelization within a college or university setting. He or she accompanies students, faculty, and staff in integrating Catholic faith with academic and personal life."^^xsd:string ;
    skos:example "A campus minister supports Catholic life at a university."^^xsd:string,
        "Campus ministers organize retreats and service projects for students."^^xsd:string .

