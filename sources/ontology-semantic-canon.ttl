    rdfs:subClassOf <R9OVY5GWczMSrxKsf8cfgpq> ;
    skos:altLabel "Lease Digest",
        "Tenancy Contract Overview" ;
    skos:definition "A Lease Abstract is a summary document that highlights the key terms, conditions, and provisions of a lease agreement. It serves as a quick reference guide for both landlords and tenants, often utilized for portfolio management or due diligence." ;
    skos:prefLabel "Lease Summary" .

<R7OJgVOoKOeIJVrRB9KrLYZ> a owl:Class ;
