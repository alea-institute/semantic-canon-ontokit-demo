    rdfs:subClassOf <_1Ev3PQ-SDG5LAgWif3Lag> ;
    skos:definition "This industry comprises establishments primarily engaged in the merchant wholesale distribution of nondurable goods (except printing and writing paper; stationery and office supplies; industrial and personal service paper; drugs and druggists' sundries; apparel, piece goods, and notions; grocery and related products; farm product raw materials; chemical and allied products; petroleum and petroleum products; beer, wine, and distilled alcoholic beverages; farm supplies; books, periodicals, and newspapers; flowers, nursery stock, and florists' supplies; tobacco and tobacco products; and paint, varnishes, wallpaper, and supplies)." ;
    skos:example "Artists' supplies merchant wholesalers",
        "Burlap merchant wholesalers",
