<Rss8FJTgnn6V9FuSLxl90u> a owl:Class ;
    rdfs:label "Insanity Defense" ;
    rdfs:subClassOf <R8mREFTbCVNHGAdqneLSd0d> ;
    skos:altLabel "Insanity" ;
    skos:definition "The insanity defense is a legal strategy in which a defendant claims that they were not criminally responsible for their actions at the time of the alleged crime due to a severe mental disorder or illness. If successful, this defense can result in the defendant being found not guilty by reason of insanity or being committed to a psychiatric institution rather than being subject to criminal penalties." ;
    skos:prefLabel "Mental Insanity" .

<RssAZbpAdTvtzgbHYQtB6a> a owl:Class ;
    rdfs:label "Lack of Authentication Objection" ;
    dc:source "Fed. R. Evid. 901",
        "Fed. R. Evid. 902" ;
    rdfs:subClassOf <RoABbJ9kEFzmBvBSGmbAyq> ;
    skos:altLabel "Foundational Authentication Objection",
        "Insufficient Authentication Objection",
        "Lack of Authenticity Objection" ;
    skos:definition "A Lack of Authentication Objection is raised when a party attempts to introduce evidence without providing sufficient proof that the evidence is genuine and authentic. This objection asserts that the party offering the evidence has not met the necessary burden to establish that the evidence is what it purports to be." ;
    skos:prefLabel "Unauthenticated Evidence Objection" .

