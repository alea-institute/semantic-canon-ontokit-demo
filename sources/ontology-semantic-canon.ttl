    skos:altLabel "Events of Legal Effect"^^xsd:string,
        "Juridical Events"^^xsd:string,
        "Legal Actions and Proceedings"^^xsd:string,
        "Legal Occurrences"^^xsd:string,
        "Legally Significant Events"^^xsd:string ;
    skos:definition "Legal Events are actions, occurrences, or procedural steps that have legal significance and produce effects within a legal system. Legal Events create, modify, enforce, or terminate rights, duties, statuses, or legal relationships."^^xsd:string ;
    skos:example "A company dissolves and files articles of dissolution with the appropriate authority."^^xsd:string,
        "A party files a civil complaint initiating a lawsuit."^^xsd:string,
        "A regulatory agency conducts a compliance inspection of a licensed entity."^^xsd:string,
        "An employer terminates an employee pursuant to an employment contract."^^xsd:string .

