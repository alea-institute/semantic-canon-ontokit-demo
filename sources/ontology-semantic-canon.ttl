    rdfs:subClassOf <RCxI8cqNSzWB8ZAuv6RBHmV> ;
    skos:definition "Filing Fee Waived: A status within a legal dispute indicating that the fee required to file the case has been waived." .

<RCLmMhA7u7IrGyH5gDUKn0M> a owl:Class ;
    rdfs:label "Code of Conduct" ;
    rdfs:subClassOf <RBCzyIAi2Hjl80hfQr8wAMR>,
        <RCBtDyjzrPbQyhvU5V64Irn> ;
    skos:altLabel "Behavioral Guidelines",
        "Conduct Policy",
        "Ethical Code" ;
