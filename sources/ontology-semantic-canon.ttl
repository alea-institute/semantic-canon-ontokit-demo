<RBNIuOy1i1MW9lQzAhB9gVQ> a owl:Class ;
    rdfs:label "Personal Dispute" ;
    rdfs:comment "In a global Catholic ontology, a Personal Dispute represents a friction between individuals that threatens the bonds of charity and communal harmony. The Church encourages resolving these disagreements through fraternal correction and mediation, viewing them as opportunities to practice forgiveness and restore the \"tranquillity of order\" at a micro-social level."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDSYPGgBlFz5eWNtwoMA2c5> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDFhtJuTWcY7UZGV9F5yOoA> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9F1zhfl4EiAf0VCEYCEnon> ],
        <R7O9EXc5CO83M0CzT8VzNFT> ;
    skos:altLabel "Domestic Conflict"^^xsd:string,
        "Fraternal Discord"^^xsd:string,
        "Interpersonal Strife"^^xsd:string,
        "Private Disagreement"^^xsd:string ;
    skos:definition "A Personal Dispute is a non-violent disagreement or conflict between private individuals regarding personal rights, obligations, or relationships. It serves as the primary context for applying the Gospel mandates of reconciliation and justice before a conflict escalates into a formal legal or public matter."^^xsd:string ;
    skos:example "Addressing a verbal insult through the process of fraternal correction to maintain peace within a local parish community."^^xsd:string,
        "Engaging in a structured dialogue to settle a private financial misunderstanding without seeking civil litigation."^^xsd:string,
        "Resolving a disagreement between neighbors over the shared boundary of their properties."^^xsd:string ;
    skos:prefLabel "Individual Conflict"^^xsd:string .

