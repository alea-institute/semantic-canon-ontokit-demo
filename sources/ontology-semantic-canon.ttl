<R70EVLsDqbyH67OcMFU5d1p> a owl:Class ;
    rdfs:label "Crops" ;
    rdfs:subClassOf <RB9zzoSs7UGZstS4ptLmvxR> ;
    skos:altLabel "Agricultural Plants",
        "Cultivated Plants",
        "Farm Crops" ;
    skos:definition "Crops are cultivated plants grown on a large scale for food, fiber, fuel, or other commercial purposes. They play a crucial role in agriculture and the global economy, providing essential resources for human and animal consumption, industrial uses, and energy production." .

<R74NaktGSuv9KJ3aBnw26GP> a owl:Class ;
    rdfs:label "Leafy Vegetables" ;
    rdfs:subClassOf <Rub2xErcJ0t8GToQfoaVG1> ;
    skos:altLabel "Leafy Greens",
        "Salad Greens" ;
    skos:definition "Leafy vegetables, also known as greens, are a category of vegetables harvested primarily for their edible leaves, which are rich in vitamins, minerals, and dietary fiber. They are consumed raw or cooked and are valued for their nutritional benefits, including high levels of vitamins A, C, and K, as well as antioxidants and phytonutrients." .

<R752LnUHc6rfnv4O2TfcpZl> a owl:Class ;
    rdfs:label "Virgin Islands Territory Courts" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:locatedIn ;
            owl:someValuesFrom <R81193c1B44b02C9e7e232ee> ],
        <RyItksdT5vInqyBuoGgoDr> ;
    skos:definition "The Virgin Islands Territory Courts are a subset of U.S. Territory Courts and include the Virgin Islands Police Court, Virgin Islands Supreme Court, Superior Court of the Virgin Islands, Virgin Islands Territorial Court, and Virgin Islands Municipal Court." .

<R75Bx0QJin6XW4ki2c8pJGw> a owl:Class ;
    rdfs:label "Nonpossessory Interest" ;
    rdfs:subClassOf <R8cjnXHiv1wNe6nzPvWnhQw> ;
    skos:altLabel "Property Incumbrances" ;
    skos:definition "Nonpossessory Interest refers to a type of property interest that grants certain rights to use or enjoy the property without possessing it. This includes interests such as easements, covenants, and profits à prendre, where the holder has limited rights related to the property owned by another person." ;
    skos:prefLabel "Non-Possession Property Rights" .

<R76UTCrg8DDzlFkZCPjrdqe> a owl:Class ;
    rdfs:label "Visa for Skilled Workers and Specialty Occupations" ;
    rdfs:subClassOf <RD1oQDMlC6FytjOndhJTMy8> ;
    skos:altLabel "Skilled Worker Visa",
        "Specialty Occupation Visa" ;
    skos:definition "A Specialty Occupation Visa is a type of visa that allows foreign nationals to work in a job that requires specialized knowledge or expertise, typically at a professional level that requires at least a bachelor's degree or equivalent. This visa category is often designed to address specific labor shortages or to attract individuals with specialized skills to contribute to a country's economy." ;
    skos:prefLabel "H-1B Visa"@en-us .

<R78g2Psn6TygAlkIoCnXqdd> a owl:Class ;
