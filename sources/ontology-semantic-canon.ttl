    rdfs:subClassOf <BsO8OrIXSZ6XyLGTD8O5AA> ;
    skos:definition "This industry comprises establishments primarily engaged in retailing new outdoor power equipment or retailing new outdoor power equipment in combination with activities, such as repair services and selling replacement parts." .

<ihg-2B_JQN-uAxaMGCKIhw> a owl:Class ;
    rdfs:label "Horses and Other Equine Production" ;
