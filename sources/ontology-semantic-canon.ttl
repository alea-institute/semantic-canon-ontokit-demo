            owl:someValuesFrom <R9Ssnolzs98skM2RcQkIjkY> ],
        <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:definition "A private right of action refers to the legal authority granted to an individual or private party to file a lawsuit for violations of law that have affected them. Essentially, it enables citizens to enforce statutes or regulations by taking alleged violators to court, rather than relying solely on government agencies for enforcement." ;
    skos:prefLabel "Private Enforcement Right" .

<R7oZYoHPjrvOgl09T5WKFGI> a owl:Class ;
