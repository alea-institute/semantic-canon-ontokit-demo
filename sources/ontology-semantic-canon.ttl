<RC8UTL51hrOj35UcqMCEaCm> a owl:Class ;
    rdfs:label "Pedagogical Authority" ;
    rdfs:subClassOf <R9aY60yvdEVudPss03CM1LF> ;
    skos:altLabel "Academic Authority"^^xsd:string,
        "Didactic Authority"^^xsd:string,
        "Instructional Authority"^^xsd:string,
        "Teaching Authority"^^xsd:string ;
    skos:definition "Pedagogical Authority is the moral and institutional authority exercised by an educator to instruct, guide, and evaluate learners for the sake of intellectual and moral formation. Pedagogical Authority serves truth and human dignity, and it remains ordered to the learner’s growth rather than the educator’s power."^^xsd:string ;
    skos:example "A catechist instructs children in the teachings of the Church."^^xsd:string,
        "A professor establishes evaluation criteria for a theology course."^^xsd:string,
        "A school administrator enforces academic standards for students."^^xsd:string,
        "A teacher assigns coursework to support mastery of a subject."^^xsd:string,
        "An educator corrects errors to foster understanding and intellectual discipline."^^xsd:string ;
    skos:prefLabel "Educational Authority"^^xsd:string .

