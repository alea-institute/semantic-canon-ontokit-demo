<RBYjEVQYN2eWNPHqVk6LlZu> a owl:Class ;
    rdfs:label "Fitness & Exercise Market Segment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <MqQx3WSASiOOx-A9ARPHqw> ],
        <RBXoCwCeY64Ow60nWKSZCC> ;
    skos:altLabel "Workout Market Segment" ;
    skos:definition "The fitness & exercise market segment refers to a division of the market that is specifically targeted towards consumers who are interested in physical fitness and exercise. This segment encompasses products, services, and marketing strategies that are designed to cater to the needs, preferences, and interests of individuals who seek to maintain or improve their physical health, fitness level, and overall well-being through various forms of exercise." ;
    skos:example "Home Fitness Equipment",
        "Wearable Fitness Trackers",
        "Yoga and Pilates Studios" ;
    skos:prefLabel "Health & Fitness Market" .

<RBYljozfgM7STIDRjMBJEHf> a owl:Class ;
    rdfs:label "Regulatory Taking Claim" ;
    rdfs:subClassOf <R9LVBKjvGRuzwgtlhuLST36>,
        <RDwajUPdKVdK5tlwiUjmNzG> ;
    skos:altLabel "Entschädigungsklage wegen Regulierungseingriffen"@de-de,
        "Regulatory Taking Claim"@en-gb,
        "Reclamación por expropiación regulatoria"@es-es,
        "Reclamación por expropiación regulatoria"@es-mx,
        "Réclamation pour expropriation réglementaire"@fr-fr,
        "תביעה על פיצוי חקיקתי"@he-il,
        "नियामक लेनदान दावा"@hi-in,
        "規制による財産権侵害請求"@ja-jp,
        "Reivindicação de desapropriação regulatória"@pt-br,
        "监管征收索赔"@zh-cn ;
    skos:definition "The concept of Regulatory Taking refers to a situation where a government regulation or law results in the taking of private property or its use, without providing just compensation to the owner." .

<RBYqZ2F48W9KQpT4dmVuJUX> a owl:Class ;
    rdfs:label "Media Ethics" ;
    rdfs:comment "In a global Catholic ontology, Media Ethics regulates the use of communication tools and platforms to ensure they serve the truth and foster authentic human encounter. It expands upon Information Ethics by focusing specifically on the responsibilities of creators, journalists, and users within the public square, guided by the principle that \"communication is a human rather than a technical reach.\""^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8dg62MjLTQnUX9VOs20LYJ> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCG4QF2vhgY9jI81Z8dII42> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RzLNZvmvjHqtxVfg3yhhM9> ],
        <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Digital Communication Ethics"^^xsd:string,
        "Ethics of Public Discourse"^^xsd:string,
        "Mass Communication Ethics"^^xsd:string ;
    skos:definition "Media Ethics provides the normative framework for the production and consumption of content across all communication platforms to ensure the protection of human dignity. It seeks to balance the right to freedom of expression with the duty to seek the truth and respect the reputations of others."^^xsd:string ;
    skos:example "Correcting published errors promptly to maintain the integrity of the public record and the community's trust."^^xsd:string,
        "Designing advertising campaigns that respect the dignity of the person and avoid the exploitation of human vulnerabilities."^^xsd:string,
        "Respecting the privacy of individuals by refusing to publish sensationalized details of their personal lives."^^xsd:string ;
    skos:prefLabel "Journalism Ethics"^^xsd:string .

