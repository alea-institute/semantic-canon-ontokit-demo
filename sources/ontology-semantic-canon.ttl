    skos:altLabel "Tierquälerei"@de-de,
        "Cruelty to Animals"@en-gb,
        "Crueldad hacia los animales"@es-es,
        "Crueldad hacia los animales"@es-mx,
        "Cruauté envers les animaux"@fr-fr,
        "אכזריות לבעלי חיים"@he-il,
        "पशुओं के प्रति क्रूरता"@hi-in,
        "動物虐待"@ja-jp,
        "Crueldade contra animais"@pt-br,
        "虐待动物"@zh-cn ;
    skos:definition "The intentional infliction of harm or suffering on animals, including neglect, abuse, and torture, which is prohibited by law and may result in criminal charges and penalties." .

<R7r9N1ibygOvS0a95xKIxZ1> a owl:Class ;
    rdfs:label "Implicit Premise" ;
    rdfs:subClassOf <RBZcHfpwTv94silyPjBatn1> ;
    skos:altLabel "Assumed Premise"^^xsd:string,
        "Hidden Premise"^^xsd:string,
        "Suppressed Premise"^^xsd:string,
        "Unstated Premise"^^xsd:string ;
    skos:definition "Implicit Premise is a premise that an argument relies on but does not state explicitly. The reader or listener must supply it to make the reasoning valid or complete."^^xsd:string ;
    skos:example "God acts consistently with his nature."^^xsd:string,
        "Human life deserves protection."^^xsd:string,
        "Public authority should pursue the common good."^^xsd:string,
        "What begins to exist has a cause."^^xsd:string .

<R7rFTVKN1Cc9kDZb75hc6jl> a owl:Class ;
    rdfs:label "Temporary Protected Status" ;
    rdfs:subClassOf <R8N4pMIOhTNbqcmDczSephq> ;
    skos:altLabel "TPS",
        "Temporary Protected Status (TPS) is a temporary immigration status granted to eligible nationals of designated countries that are experiencing ongoing armed conflict, environmental disaster, or other extraordinary conditions. In the United States, individuals granted TPS are allowed to live and work in the U.S. for a limited period and are protected from deportation." .

<R7rGAr4SqkaXUrTvSBKvJg0> a owl:Class ;
    rdfs:label "New York Supreme Court - Allegany County" ;
    rdfs:subClassOf <R06956a0657387D6513A8528> ;
    skos:definition "The New York Supreme Court - Allegany County is a court of general jurisdiction located in Allegany County, New York, with authority to hear and decide a wide range of civil and criminal cases within its geographical jurisdiction." .

<R7rMU6Js4awTWJdyPKTmK9C> a owl:Class ;
    rdfs:label "Alford Plea" ;
    rdfs:subClassOf <RBPehVKHmGilQbPA55VggB6> ;
    skos:altLabel "Plea of Convenience" ;
    skos:definition "An Alford plea (aka best-interests plea) is a type of guilty plea in which a defendant maintains their innocence but acknowledges that the prosecution has enough evidence to likely secure a conviction. This plea allows the defendant to accept punishment without admitting guilt." ;
    skos:prefLabel "Best Interests Plea" .

<R7rQPa68hcj34ouzYvp14lD> a owl:Class ;
    rdfs:label "Sickle Cell Disease" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/7.00-HematologicalDisorders-Adult.htm#7_05> ;
    rdfs:subClassOf <Ri4LGaOgWzMWy2yX79DQi0> ;
    skos:definition "Sickle Cell Disease is a genetic disorder characterized by the production of abnormally shaped red blood cells that resemble a crescent or sickle. These malformed cells can obstruct blood flow, causing pain, anemia, and a range of complications affecting various organs." ;
    skos:prefLabel "Sickle Cell Anemia" .

<R7rQQvx2SzP5GiUEpbCJjjp> a owl:Class ;
