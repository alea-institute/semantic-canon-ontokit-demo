    rdfs:subClassOf <RlZdd14uUrCvqa8YJ7RzNd> ;
    skos:definition "Human Authorship in copyright law refers to the requirement that a work must be created by a human individual to be eligible for copyright protection. This criterion emphasizes the human intellect and creativity as the fundamental source of copyrightable material, excluding works created by automated processes or non-human entities." .

<R9aHX0YWVEiSlueAEV234XV> a owl:Class ;
    rdfs:label "Application for Patent Registration" ;
    rdfs:subClassOf <R7KdQLWwrvkyzohDgf48st7> ;
    skos:definition "An Application for Patent Registration is a formal request submitted to a patent office for the grant of a patent on a specific invention or discovery. The application typically includes a written specification describing the invention in detail, any applicable drawings, and claims that define the scope of the protection sought" ;
    skos:prefLabel "Patent Application" .

<R9aPd17Cb8wTbqBJQiND1By> a owl:Class ;
    rdfs:label "Night Blindness" ;
    rdfs:subClassOf <R8aoLYQoIooB9xRkhiMtgR4> ;
    skos:altLabel "Night Vision Deficiency" ;
    skos:definition "Night Blindness, also known as Nyctalopia, is a visual impairment that affects an individual's ability to see in low light or darkness. This condition can result from various underlying issues such as retinal disorders, vitamin A deficiency, or cataracts, and significantly impacts activities that require good vision in dim lighting." ;
    skos:prefLabel "Nyctalopia" .

