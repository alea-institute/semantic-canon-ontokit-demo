<R50fTKExGPGTyoyWAZDkk5> a owl:Class ;
    rdfs:label "Charity (Virtue)"^^xsd:string ;
    rdfs:subClassOf <RBZqFAgKcZ5EESijJoUuppE> ;
    skos:altLabel "Agape"^^xsd:string,
        "Charity"^^xsd:string,
        "Divine Love"^^xsd:string,
        "Love of God and Neighbor"^^xsd:string ;
    skos:definition "Charity is the theological virtue by which a person loves God above all things for God’s own sake and loves neighbor as oneself for love of God. Charity perfects all the virtues by ordering every act toward communion with God and self-giving love of others."^^xsd:string ;
    skos:example "Charity animates moral action by orienting it toward communion and self-gift."^^xsd:string,
        "Charity forgives offenses out of love rather than resentment."^^xsd:string,
        "Charity leads a person to serve the poor without seeking recognition."^^xsd:string,
        "Charity moves a believer to love God above all things in prayer and obedience."^^xsd:string,
        "Charity unites faith and hope in lived love."^^xsd:string ;
    skos:prefLabel "Love"^^xsd:string .

