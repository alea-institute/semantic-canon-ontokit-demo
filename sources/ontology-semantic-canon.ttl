<R7NB9WJzAFK6tIIGmfIj5Ay> a owl:Class ;
    rdfs:label "Objections to Direct Examination" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
