    skos:prefLabel "Creditors' Committee" .

<R7IpkmsG5ugeP6FKhN6nYGU> a owl:Class ;
    rdfs:label "Giving of the Law at Sinai" ;
    rdfs:subClassOf <R7hUqSzjreR3vfFZVZniVs4> ;
    skos:altLabel "Decalogue Proclamation"^^xsd:string,
        "Mount Sinai Theophany"^^xsd:string,
        "Sinai Revelation"^^xsd:string ;
    skos:definition "Giving of the Law at Sinai represents the theophanic moment when God descended upon Mount Sinai in fire, smoke, and thunder to deliver the Ten Commandments and Torah directly to Moses and the assembled Israelites. This event established the covenant's legal foundation, transforming liberated slaves into a covenant community bound by divine instruction governing worship, justice, and holiness."^^xsd:string ;
    skos:example "Contemporary biblical scholars studied giving of the Law at Sinai alongside ancient Near Eastern law codes like Hammurabi's."^^xsd:string,
        "Rabbinic tradition developed elaborate midrashim about giving of the Law at Sinai, portraying cosmic phenomena and angelic witnesses."^^xsd:string,
        "Thomas Aquinas analyzed giving of the Law at Sinai when developing natural law theory and divine positive law distinctions."^^xsd:string ;
    skos:note """Moses's Mountain Ascent (Exodus 19:3)
Israel's Consecration Preparation (Exodus 19:10-15)
Divine Descent in Fire and Smoke (Exodus 19:16-20)
Trumpet Blast and Mountain Quaking (Exodus 19:16-19)
Ten Commandments Proclamation (Exodus 20:1-17)
People's Fearful Response (Exodus 20:18-21)
Moses Entering the Thick Darkness (Exodus 20:21)
Book of the Covenant Reading (Exodus 24:7)
Covenant Code Laws (Exodus 21-23)
Forty Days on Mountain (Exodus 24:18)
Tablet Writing by God's Finger (Exodus 31:18)
Second Tablet Set After Breaking (Exodus 34:1-4)
Moses's Face Radiance (Exodus 34:29-35)"""^^xsd:string .

<R7Kt1BGh5cJfFNgHJj0WtBI> a owl:Class ;
    rdfs:label "Vocational Student Visa" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDeZlellOVEkUBkTSbLgxUC> ],
        <RBe8WASOOp24Pw0SKparbSV> ;
    skos:altLabel "M-1 Visa",
        "The Vocational Student Visa (in the U.S., the M-1 visa) is a non-immigrant visa for students who wish to pursue vocational or non-academic training or education. This visa does not permit full-time university or college study, and its duration is generally for the length of the vocational program up to a maximum of one year, with some options for extension" .

<R7LQAM6H8WDBexXwLl2Si3f> a owl:Class ;
