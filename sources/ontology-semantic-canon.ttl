<R9p6OUjgt1II1cDFTjv0kIF> a owl:Class ;
    rdfs:label "Guerrilla Fighter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCVJpXd6K04j2x2KVeWj1pv> ],
        <RBvvWK0xG1iusmC0NoE8dEo> ;
    skos:altLabel "Asymmetric Warfare Fighter"^^xsd:string,
        "Insurgent"^^xsd:string,
        "Irregular Fighter"^^xsd:string,
        "Rebel Fighter"^^xsd:string ;
    skos:definition "A guerrilla fighter is a member of an irregular armed force who conducts hostilities using decentralized organization, mobility, and asymmetric tactics against an opposing force. Legal status depends on command structure, distinction from civilians, compliance with the law of armed conflict, and the fighter’s conduct during operations."^^xsd:string ;
    skos:example "A guerrilla fighter operated under a responsible command and carried arms openly during an engagement."^^xsd:string,
        "A guerrilla fighter who failed to distinguish from civilians lost combatant privileges under applicable law."^^xsd:string,
        "A resistance member conducted hit-and-run attacks against occupying forces as a guerrilla fighter."^^xsd:string,
        "An urban guerrilla fighter sabotaged military supply lines while blending into the local population."^^xsd:string ;
    skos:prefLabel "Resistance Fighter"^^xsd:string .

<R9pssJwbQ89wfcLFqq9DWIw> a owl:Class ;
