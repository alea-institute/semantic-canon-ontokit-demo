    skos:definition "The Pennsylvania Court of Common Pleas - Forest County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering legal proceedings in Forest County, Pennsylvania." .

<RzXEQztwCXDC6aEDCdTBsj> a owl:Class ;
    rdfs:label "Nevada Court of Appeals" ;
    rdfs:subClassOf <RF6152bC3Ba7bEB25daEC5de> ;
    skos:definition "The Nevada Court of Appeals is a court within the Nevada State Courts system that hears appeals from lower courts and makes decisions on legal disputes." .

<RzZsWnimVMfomNyig7SO9e> a owl:Class ;
    rdfs:label "Bankruptcy Chapter 7 Claim" ;
    rdfs:subClassOf <R7vBjMmDitSBmBKZvNugCLG> ;
    skos:altLabel "Insolvenz Kapitel 7 Forderung"@de-de,
        "Bankruptcy Chapter 7 Claim"@en-gb,
        "Reclamación del Capítulo 7 de la bancarrota"@es-es,
        "Reclamación del Capítulo 7 de la bancarrota"@es-mx,
        "Réclamation de faillite Chapitre 7"@fr-fr,
        "תביעת פרק 7 של בישול"@he-il,
        "दिवालियापन अध्याय 7 दावा"@hi-in,
        "破産第7章請求"@ja-jp,
        "Reivindicação de falência Capítulo 7"@pt-br,
        "破产第7章索赔"@zh-cn ;
    skos:definition "A Bankruptcy Chapter 7 Claim is a type of claim made by a creditor in a bankruptcy case under Chapter 7 of the Bankruptcy Code, seeking to recover a debt owed by the debtor." .

<RzajD2KuPBjHSugvdBJN59> a owl:Class ;
    rdfs:label "Right to Effective Assistance of Counsel" ;
    rdfs:subClassOf <R9EPdnM3F87jVOjCROdPARe> ;
    skos:definition "The \"Right to Effective Assistance of Counsel\" refers to an individual's entitlement not only to legal representation but to representation that is competent and effective. It means that a lawyer must perform adequately and any significant failure in this duty can lead to a violation of a defendant's rights, potentially resulting in reversals of convictions or other legal remedies." .

<RzbRrublchPvUBEyEBe7IY> a owl:Class ;
    rdfs:label "Negligent Performance of An Undertaking" ;
    rdfs:subClassOf <RCfunX4u69LUQ3gbhckE0oI> ;
    skos:altLabel "Fahrlässige Erfüllung einer Verpflichtung"@de-de,
        "Negligent Performance of An Undertaking"@en-gb,
        "Incumplimiento negligente de una obligación"@es-es,
        "Incumplimiento negligente de una obligación"@es-mx,
        "Exécution négligente d'une entreprise"@fr-fr,
        "ביצוע של איחוד שגוי"@he-il,
        "एक अनुबंध के अनावश्यक प्रदर्शन"@hi-in,
        "義務の怠慢な履行"@ja-jp,
        "Execução negligente de um compromisso"@pt-br,
        "违约行为的疏忽履行"@zh-cn ;
    skos:definition "The Negligent Performance of An Undertaking refers to a legal claim of negligence where a party fails to fulfill their obligation or duty, resulting in harm or damage to another party." .

<RzbzW8gDXSPAygq6nTeo9G> a owl:Class ;
    rdfs:label "Arizona Superior Court - Gila Cty." ;
    rdfs:subClassOf <R30265408Cb3d04Ed2b2957b> ;
    skos:definition "Arizona Superior Court - Gila Cty. is a specific court within the Arizona Superior Court system that has jurisdiction over legal matters within Gila County." .

<Rzdq5CpQ5r3bKxjcqxhAEQ> a owl:Class ;
    rdfs:label "Pueblo of Taos" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<RzgyVNiCOeush4yockpq4Y> a owl:Class ;
    rdfs:label "Mobile Home" ;
    rdfs:subClassOf <RBRPjYycc1QcWOn4irY0BW9> ;
    skos:altLabel "Mobile Residence",
        "Prefabricated Residential Unit",
        "Trailer Home" ;
    skos:definition "A Mobile Home is a prefabricated residential structure built in a factory and transported to its site, designed for permanent or semi-permanent habitation. These homes are typically placed in mobile home parks or on private land and can be moved to different locations as needed." ;
    skos:example "Double-Wide Mobile Home",
        "Single-Wide Mobile Home" ;
    skos:prefLabel "Manufactured Home" .

<RzhHNQEOzpZ6j2pdUx9QMc> a owl:Class ;
    rdfs:label "Ponca Tribe of Nebraska" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<RziAeU4JpHMFVsSvtwTTdU> a owl:Class ;
    rdfs:label "Provincial Superior" ;
    rdfs:subClassOf <R69pFKCbtXWO4nkV3D1B0L> ;
    skos:altLabel "Provincial Minister"^^xsd:string,
        "Provincial Mother"^^xsd:string,
        "Provincial Prior"^^xsd:string ;
    skos:definition "A Provincial Superior is the major superior who governs a religious province of an institute of consecrated life, exercising authority under the institute’s constitutions and the institute’s supreme moderator. The Provincial Superior directs the province’s mission, personnel, discipline, and apostolic works, usually for a fixed term and with the help of a council."^^xsd:string ;
    skos:example "Dominican Provincial Prior"^^xsd:string,
        "Franciscan Provincial Minister"^^xsd:string,
        "Jesuit Provincial Superior"^^xsd:string,
        "Provincial Superior Of A Congregation Of Religious Sisters"^^xsd:string,
        "Provincial Superior Of The Missionaries Of Charity"^^xsd:string .

<Rzkc596nCuFi7zaE5CS932> a owl:Class ;
    rdfs:label "Soybeans" ;
    rdfs:subClassOf <R8sIRvD8VHcXHmMNAc5QUlC>,
        <RxWrCyEH6sVtwYoR6elPPp> ;
    skos:altLabel "Edamame",
        "Glycine Max",
        "Soya Beans" ;
    skos:definition "Soybeans are legumes from the Glycine max species, known for their high protein content and versatility in food, feed, and industrial applications. They are cultivated for their seeds, which are processed into products like soy oil, tofu, and soy milk, and used as a key ingredient in animal feed and biodiesel production." .

<RzoLFQE0iuqIQJlexIGgjM> a owl:Class ;
    rdfs:label "Illinois Circuit Court - Coles County (5th Circuit Court)" ;
    rdfs:subClassOf <RCtUZjZqZ1lszDFiDOLUuTh> .

