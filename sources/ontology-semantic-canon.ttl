<RqiDHswc43JoKvLEHWMGvR> a owl:Class ;
    rdfs:label "Prevailing Wage Violation Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDTPef6LjCeQg2TUb7aY88W> ],
        <R9UYGSnWQz2MvNsWUofGb6J> ;
    skos:altLabel "Anspruch auf Verletzung des vorherrschenden Lohns"@de-de,
        "Prevailing Wage Violation Claim"@en-gb,
        "Reclamo por violación del salario prevaleciente"@es-es,
        "Reclamo por violación del salario mínimo"@es-mx,
        "Réclamation de violation du salaire prévalent"@fr-fr,
        "תביעה על הפרת שכר מתחרה"@he-il,
        "प्रबल वेतन उल्लंघन दावा"@hi-in,
        "支配賃金違反請求"@ja-jp,
        "Reivindicação de violação do salário prevalecente"@pt-br,
        "普遍工资违规索赔"@zh-cn ;
    skos:definition "A prevailing wage violation claim is a legal action initiated by an employee against their employer for not paying the required prevailing wage for work performed on a government-funded construction project or a project subject to prevailing wage laws. Prevailing wage laws require contractors and subcontractors to pay workers on public works projects the prevailing wage rate for their job classification in the local area where the work is performed. The claim typically arises when an employer pays workers less than the applicable prevailing wage rate or does not properly classify workers for the purposes of determining their prevailing wage rate." ;
    skos:prefLabel "Davis-Bacon Act Claim" .

