            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8RfDzMtuMPdmNTonmhBxu> ],
        <R7I7inwWLqKi8ZMm0Ey6dkK>,
        <RITVzcNUrw2Bg0fvFueOTT> .

