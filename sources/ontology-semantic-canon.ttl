<RTM0OWNVhLnesUlYZpd1jF> a owl:Class ;
    rdfs:label "Victim" ;
    rdfs:subClassOf <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:definition "A victim is an individual who suffers harm, injury, loss, or hardship due to an unlawful act, omission, or negligence of another party. This harm can manifest physically, emotionally, financially, or in any other form detrimental to the individual's well-being or rights." .

<RTSI7ogxo4mf2wErPNxZDK> a owl:Class ;
    rdfs:label "Vestibular Disorder" ;
    rdfs:subClassOf <RC9rPAii8f99I7p4Hi5Qdia> ;
    skos:definition "Disturbance of labyrinthine-vestibular function involves a condition characterized by frequent episodes of balance disturbances, tinnitus (ringing in the ears), and progressive hearing loss. Diagnosis typically requires evidence of impaired vestibular function through tests such as caloric or other vestibular assessments, as well as documented hearing loss established by audiometry." ;
    skos:prefLabel "Disturbance of Labyrinthine-Vestibular Function" .

<RTWpoh9tHMCjgHHoS1igdV> a owl:Class ;
