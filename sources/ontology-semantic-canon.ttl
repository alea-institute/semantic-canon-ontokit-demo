<RDr2w9AvQVNGuLJy9BotftQ> a owl:Class ;
    rdfs:label "Nervous System Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_11> ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:definition "Nervous system cancer encompasses malignant tumors originating in the central nervous system (CNS), which includes the brain and spinal cord, as well as primary cancers of the peripheral nerves or spinal roots. This category includes high-grade tumors such as glioblastoma multiforme, ependymoblastoma, diffuse intrinsic brain stem gliomas, and other aggressive malignancies that may be primary, metastatic, progressive, or recurrent following initial anticancer therapy." .

<RDrZfl9rDyGVk1ikSmx5TRd> a owl:Class ;
