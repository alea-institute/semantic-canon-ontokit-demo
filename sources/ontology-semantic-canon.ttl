    rdfs:subClassOf <7WY07yhXQL-MtSYRIdkzJA> ;
    skos:definition "This industry comprises establishments primarily engaged in retailing new musical instruments, sheet music, and related supplies; or retailing these new products in combination with musical instrument repair, rental, or music instruction." ;
    skos:example "Musical instrument retailers",
        "Piano retailers",
        "Sheet music retailers" .

<jrg6Ufe-Tx2lnzgn1Id0Wg> a owl:Class ;
    rdfs:label "Metal Service Centers and Other Metal Merchant Wholesalers" ;
