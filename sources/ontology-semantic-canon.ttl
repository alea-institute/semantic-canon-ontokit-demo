    rdfs:subClassOf <Rafw4pSzJ3S3d8sq6quprG> ;
    skos:definition "Court Forum Level refers to a specific level within the Court Forum hierarchy, which includes Trial Court Forum and Appellate Court Forum." .

<R9MkAYX7plpRbwDyxRRG3Fe> a owl:Class ;
    rdfs:label "Intervenor" ;
    rdfs:subClassOf <RCFgxBbypUKKsDDOJ1iOk36> ;
    skos:altLabel "Intervenient"@de-de,
        "Intervenor"@en-gb,
        "Interventor"@es-es,
