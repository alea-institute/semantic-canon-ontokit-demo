    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Fulfulde"@de-de,
        "Peul"@fr-fr,
        "フラニ語"@ja-jp,
        "Fula"@pt-br,
        "富拉语"@zh-cn ;
