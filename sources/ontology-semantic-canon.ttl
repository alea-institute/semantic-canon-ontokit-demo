<RuWy2Mln0IfiDNDCvyTZo9> a owl:Class ;
    rdfs:label "Missouri Circuit Court - Worth County" ;
    rdfs:subClassOf <RDECjssxw76vdlahxiUTb4L> ;
    skos:definition "Missouri Circuit Court - Worth County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Worth County." .

<RuXnK6ekIOAF6EA1wVtA5d> a owl:Class ;
    rdfs:label "Lung Cancer" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_14> ;
    rdfs:subClassOf <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Lung Carcinoma",
        "Pulmonary Carcinoma" ;
    skos:definition "Lung cancer is a type of cancer that begins in the lungs, often in the cells lining the air passages. It can be classified into different types, primarily non-small cell lung cancer (NSCLC) and small cell lung cancer (SCLC), each requiring specific treatments such as surgery, chemotherapy, radiation therapy, and targeted therapy." .

<RuZhvzjemQZ4MkRHbBb0AP> a owl:Class ;
