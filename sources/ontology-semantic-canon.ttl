            owl:someValuesFrom <RMYMXrTULF8jaQ2iszKZiN> ],
        <RDSepz944v79Sc4zhy0qy2X> ;
    skos:altLabel "Confidentiality Levels",
        "Data Protection Attributes",
        "Information Security Levels",
        "Protection Classifications" ;
    skos:definition "Security and Confidentiality Attributes refer to the various levels of protection and access controls applied to information to prevent unauthorized disclosure, modification, or destruction. These attributes include different classifications such as top secret, secret, confidential, and restricted, each defining the degree of security and the associated protocols for managing sensitive information within an organization (e.g., company, nonprofit, nation)." ;
    skos:prefLabel "Data Security Attributes" .

