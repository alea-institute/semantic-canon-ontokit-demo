    skos:hiddenLabel "EQPR" .

<RM8uFdNbkVDabwW32Bv8E> a owl:Class ;
    rdfs:label "Religious Law System" ;
    rdfs:subClassOf <RVPwUkNgWhlwyYWWSPrLuZ> ;
    skos:altLabel "Divine Law",
        "Sacred Law",
        "Theocratic Legal System" ;
    skos:definition "A Religious Law System is a legal framework grounded in religious beliefs, texts, and traditions, governing both the moral and legal aspects of the lives of its adherents. These systems derive their authority from sacred scriptures and religious institutions, and often encompass both private conduct and public law." .

<RM9xLNaRTTvo1CwFn80Y6T> a owl:Class ;
    rdfs:label "Legal Aid Organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RfJigJT2rTvBzyMa18Nh9F> ],
        <RMIoMi1OqwHKqsjgrjdaHj> ;
    skos:definition "A Legal Aid Organization is a non-profit entity that provides free or low-cost legal assistance to individuals who cannot afford private legal representation. These organizations typically serve low-income clients, offering services on matters such as family law, housing, and employment issues." ;
    skos:example "Global Alliance for Legal Aid (GALA)",
        "International Legal Aid Group (ILAG)",
        "International Legal Foundation (ILF)",
        "Legal Action Worldwide (LAW)",
        "Legal Aid Agency (UK)",
        "Legal Services Corporation",
        "National Legal Aid & Defender Association (NLADA)" ;
    skos:prefLabel "Legal Assistance Entity" .

<RMo0rWec8owXGDAYl6PGNG> a owl:Class ;
    rdfs:label "Concurrent Interest" ;
    rdfs:subClassOf <R8cjnXHiv1wNe6nzPvWnhQw> ;
    skos:altLabel "Dual Ownership",
        "Shared Ownership",
        "Simultaneous Ownership" ;
    skos:definition "Concurrent Interest refers to the situation where two or more parties simultaneously hold ownership interests in the same piece of property. This type of ownership includes various forms such as joint tenancy, tenancy in common, and tenancy by the entirety, each with distinct legal implications regarding the rights of the owners." ;
    skos:prefLabel "Co-Ownership" .

<RNICD9MDcFQJJX6nxX11Vt> a owl:Class ;
    rdfs:label "Legal Proposition" ;
    rdfs:subClassOf <R9abezigCOxFsNH1QItgXgB> ;
    skos:altLabel "Legal Argument",
        "Point of Law",
        "Legal Proposition"@en-gb,
        "Proposición legal"@es-es,
        "Proposición legal"@es-mx,
        "הצעת חוק"@he-il,
        "कानूनी प्रस्ताव"@hi-in ;
    skos:definition "A legal proposition is a statement that outlines a principle, rule, or application of law that arguably applies to a particular legal matter, usually in writing. Legal propositions are foundational components of legal arguments, supported by statutes, case law, or other legal authorities to persuade a stakeholder (e.g., decisionmaker, opposing counsel, a counterparty) to reach a particular conclusion." .

<RNUBxUepOEIOvagLHcD3N0> a owl:Class ;
    rdfs:label "Extraordinary Ability Non-Immigrant Visa Types" ;
    rdfs:subClassOf <RD1oQDMlC6FytjOndhJTMy8> ;
    skos:definition "An O visa is issued to foreign nationals with extraordinary ability in the sciences, arts, education, business, or athletics, allowing them to enter the U.S. to continue work in their field. This visa category includes O-1 for individuals with extraordinary ability, O-2 for essential support personnel, and O-3 for their immediate family members." ;
    skos:prefLabel "O Visa" .

<ROT1GuNtl9h4QU8jrvAVO9> a owl:Class ;
    rdfs:label "Derivatives Investment Assets" ;
    rdfs:subClassOf <RBVQj7fYsBw67yNXs4WI6RX> ;
    skos:definition "Derivatives Investment Assets are financial instruments whose value is derived from an underlying asset, index, or security. Examples include options, futures, and swaps, and these derivatives are often used for hedging risk or for speculative purposes, offering the potential for high returns but also carrying high risk." ;
    skos:prefLabel "Derivatives" .

<ROWsW3Tkpc2YQmbHQehntm> a owl:Class ;
    rdfs:label "Mining and Natural Resources Extraction Industry" ;
    dc:identifier "NRS" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=21> ;
    rdfs:subClassOf <RDIwFaFcH4KY0gwEY0QlMTp> ;
