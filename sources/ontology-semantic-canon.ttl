            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC5UxgyyVCwYeNUnCC4xjiN> ],
        <RZ1dOPJ6HH6lMJGSLNxfwV> ;
    skos:altLabel "Garantie"@de-de,
        "Guaranty"@en-gb,
        "Garantía"@es-es,
        "Garantía"@es-mx,
        "Garantie"@fr-fr,
        "ערבות"@he-il,
        "गारंटी"@hi-in,
        "保証"@ja-jp,
        "Garantia"@pt-br,
        "保证"@zh-cn ;
    skos:definition "A guaranty claim is a cause of action over a legal promise made by one party to be responsible for the debt or obligation of another party." .

<RBIXc4MqHYUkxA0MXlxno1u> a owl:Class ;
    rdfs:label "Foreign Private Issuer Report" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9CnOvmitM11ptxXIxgCDYT> ],
        <RmCERXtzdqIJcW9mdbk0Bb> ;
    skos:definition "A Foreign Private Issuer Report is a document filed by foreign companies listed on U.S. exchanges, summarizing financial and operational data. It is a U.S.-specific requirement aimed at standardizing information for U.S. investors." ;
    skos:prefLabel "International Company Disclosure" .

<RBIjupGmQLqpwi89uEk45qA> a owl:Class ;
    rdfs:label "Expiration Date" ;
    rdfs:subClassOf <R7sBKqCcmlK1Dw9HBvKenYy> ;
    skos:altLabel "Valid Until Date" ;
    skos:definition "For a legal proceeding or regulatory filing (e.g., patent registration, trademark registration) that filing's expiration date refers to the expiration date of a specific status, benefit, or action, as indicated in official documents such as visas, permits, or contracts. This date marks the end of the authorized period for a particular activity, residency, or employment, as determined by the relevant regulatory authority" .

<RBJTAn05NRo2Qu9uwRcjmsA> a owl:Class ;
    rdfs:label "Heretic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCYPQ7RrHYodALUh9zixyk2> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Doctrinal Deviant"^^xsd:string,
        "Doctrinal Dissenter"^^xsd:string,
        "Heterodox Believer"^^xsd:string ;
    skos:definition "A heretic is a person who, after valid incorporation into a religious community, obstinately denies or doubts a doctrine recognized as authoritative within that system. The status attaches to the actor, not the belief itself, and depends on persistence, knowledge, and accountability under the applicable normative framework."^^xsd:string ;
    skos:example "A baptized theologian who persistently denied a defined doctrine was classified as a heretic."^^xsd:string,
        "A public teacher who continued doctrinal denial after correction was treated as a formal heretic."^^xsd:string,
        "A repentant heretic renounced the error and was restored to full communion."^^xsd:string,
        "An individual who unknowingly held an erroneous belief qualified as a material heretic."^^xsd:string .

<RBJWgTkaOcLU7qdyszskft6> a owl:Class ;
    rdfs:label "Data Tampering" ;
    rdfs:subClassOf <RKUCwOJGfYiSc7zU1qkhAS> ;
    skos:definition "Data tampering involves the unauthorized alteration of data, often to mislead or commit fraud. It can compromise the integrity of the data and lead to incorrect or false conclusions." .

<RBKBnWyBmr5Hmg5T3VdTFxL> a owl:Class ;
    rdfs:label "Lacks Personal Knowledge Objection" ;
    dc:source "Fed. R. Evid. 602" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8jIR8iqxwPvaiF10RkWcgO> ],
        <RCEx7g3wSm7TRkpl2WQko0s> ;
    skos:altLabel "Beyond Experience Objection",
        "No Direct Knowledge Objection",
        "Objection to Testimony Without Personal Experience" ;
    skos:definition "A Lacks Personal Knowledge Objection is raised when a party in a legal proceeding believes that a witness is testifying about matters beyond their direct experience or observation. This objection aims to ensure that testimony is based on firsthand knowledge and is reliable." .

<RBKT7TSvBSVEvxJuaKhCz8P> a owl:Class ;
    rdfs:label "Workers' Compensation Discrimination Claim" ;
    rdfs:subClassOf <R8UnJ8s91KxQbW7GpGgIhsP>,
        <RD22PX6hiObnrRSM3c6bXdR> ;
    skos:altLabel "Diskriminierungsklage wegen Arbeitsunfallentschädigung"@de-de,
        "Workers' Compensation Discrimination Claim"@en-gb,
        "Reclamo por discriminación de compensación de trabajadores"@es-es,
        "Reclamo por discriminación en compensación de trabajadores"@es-mx,
        "Réclamation pour discrimination en matière de compensation des travailleurs"@fr-fr,
        "תביעה על הפרת זכויות עובדים בקבלת פיצויים"@he-il,
        "वर्कर्स कंपेंसेशन भेदभाव दावा"@hi-in,
        "労働者補償差別請求"@ja-jp,
        "Reclamação de discriminação de compensação de trabalhadores"@pt-br,
        "工人赔偿歧视索赔"@zh-cn ;
    skos:definition "A workers' compensation discrimination claim is a legal action brought by an employee who alleges that they have been subjected to unfair treatment, retaliation, or adverse actions by their employer due to filing a workers' compensation claim or exercising their rights under workers' compensation laws. Workers' compensation is a system designed to provide medical benefits and wage replacement for employees who suffer work-related injuries or illnesses. Employers are generally prohibited from discriminating or retaliating against employees who seek workers' compensation benefits." .

<RBKhb3AMMOBaiFMfEwhiTxJ> a owl:Class ;
    rdfs:label "Contribution Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RLNlm7nXyJQLJmk8qYnaPQ> ],
        <RDbz1PVc6y57oOb9jAIl0eN> ;
    skos:altLabel "Recovery Claim",
        "Beitragsgeltendmachung"@de-de,
        "Contribution Claim"@en-gb,
        "Reclamación de contribución"@es-es,
        "Reclamación de contribución"@es-mx,
        "Réclamation de contribution"@fr-fr,
        "תביעת תרומה"@he-il,
        "योगदान दावा"@hi-in,
        "貢献請求"@ja-jp,
        "Reivindicação de contribuição"@pt-br,
        "贡献索赔"@zh-cn ;
    skos:definition "A Contribution Claim is a legal claim made by a defendant seeking to recover a portion of damages paid to a plaintiff from another party who is also responsible for the same harm." .

<RBLOT3utnNtA6pYPhY1sHFH> a owl:Class ;
    rdfs:label "Governance Risk" ;
    rdfs:isDefinedBy <https://www.canada.ca/en/treasury-board-secretariat/corporate/risk-management/taxonomies.html> ;
    rdfs:subClassOf <RxTxaN981tLTsN82qPBcp> ;
    skos:altLabel "Strategic Direction Risk" ;
    skos:definition "Governance Risk refers to the potential for negative consequences arising from an organization's ineffective or inadequate leadership, decision-making processes, and oversight structures. This can result from poor corporate governance practices, lack of transparency, or weak accountability mechanisms, ultimately leading to reputational damage, legal liabilities, and decreased stakeholder trust, which can impact the organization's performance and sustainability." .

<RBLYLKMD32yWd9Wva6rGSya> a owl:Class ;
    rdfs:label "Regulatory Applicant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RKY2B2HNSx5K82dgVN6Qn7> ],
        <R7RS1hG7BxbLQktXIrO1Rro> ;
    skos:definition "A Regulatory Applicant is an individual or entity that applies for authorization, licensing, or compliance approval from a regulatory authority. This role relates to sectors where operations are subject to legal and regulatory standards, ensuring adherence to established laws, guidelines, and norms." .

<RBNz30rxM6l0GnL6R9XDyU2> a owl:Class ;
    rdfs:label "Vandalism" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8ldDGTh6RHzt0IDL7p597U> ],
        <RCqBiJAwLT5iG2nvk12tNKW> ;
    skos:altLabel "Vandalismus"@de-de,
        "Vandalism"@en-gb,
        "Vandalismo"@es-es,
        "Vandalismo"@es-mx,
        "Vandalisme"@fr-fr,
        "וינדליזם"@he-il,
        "उपद्रव"@hi-in,
        "破壊行為"@ja-jp,
        "Vandalismo"@pt-br,
        "破坏行为"@zh-cn ;
    skos:definition "DEFINITION OF Destruction/Damage/Vandalism of Property — To willfully or maliciously destroy, damage, deface, or otherwise injure real or personal property without the consent of the owner or the person having custody or control of it." .

<RBOrw0GX3E0xD5DuimNLYnD> a owl:Class ;
    rdfs:label "Humility" ;
    rdfs:subClassOf <RBAHGQZblh8cggdiTJggZfv> ;
    skos:altLabel "Freedom from Pride"^^xsd:string,
        "Lowliness of Heart"^^xsd:string,
        "Meekness"^^xsd:string,
        "Self-Knowledge in Truth"^^xsd:string ;
    skos:definition "Humility is the moral virtue that disposes a person to recognize truthfully one’s dependence on God and one’s proper place in relation to others. Humility orders self-knowledge toward gratitude, teachability, and service rather than self-exaltation."^^xsd:string ;
    skos:example "Humility enables acceptance of correction without resentment."^^xsd:string,
        "Humility frees a person from comparison and self-exaltation."^^xsd:string,
        "Humility leads a person to acknowledge limitations and seek guidance."^^xsd:string,
        "Humility moves a leader to serve rather than dominate."^^xsd:string .

<RBPQXNYlLOe2ILlrQXwUo0M> a owl:Class ;
    rdfs:label "Contract Formation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R0HJ4Pb6Bo9RmE3gbl7Wqh> ],
        <RdfKnWpXsG2eBmnS3oJNTF> ;
    skos:definition "Contract Formation is the event when a contract is formed and fully executed, meeting all legal requirements necessary for it to be binding and enforceable. This includes the elements of offer, acceptance, consideration, mutual assent, and legality of purpose." ;
    skos:prefLabel "Agreement Formation" .

<RBPeXt0dsiWqYS2ICgfvplu> a owl:Class ;
    rdfs:label "Ambassador" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC6aqtaoqNvoQggYxN1RQKg> ],
        <RD0eI0kZbrRDzdWWH6WoOGN> ;
    skos:definition "An ambassador is a diplomatic representative who serves as the highest-ranking official of their home country's government in a foreign nation. The ambassador is responsible for managing diplomatic relations, representing their country's interests, and overseeing the activities of their nation's embassy or consulate in the host country." .

<RBPehVKHmGilQbPA55VggB6> a owl:Class ;
    rdfs:label "Guilty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RMp106nIJRsFkB6OvTrosk> ],
        <RB3ZDkOj3NY83VeYDOB98XR> ;
    skos:definition "In a criminal context, \"guilty\" is a legal determination made by a court or jury when the defendant has been found responsible or culpable for the charges brought against them. It signifies that the defendant has been proven to have committed the alleged crime and may face penalties or sentencing as a result of the guilty verdict." .

<RBQwuwI8kIy4gvRmoiZHA5m> a owl:Class ;
    rdfs:label "Invoice Terms" ;
    rdfs:isDefinedBy "From LEDES (Legal Electronic Data Exchange Standard). https://ledes.org/" ;
    rdfs:subClassOf <R9kmGZf5FSmFdouXWQ1Nndm> ;
    skos:altLabel "Invoice Data",
        "Rechnungsbedingungen"@de-de,
        "Invoice Terms"@en-gb,
        "Términos de factura"@es-es,
        "Términos de factura"@es-mx,
        "Conditions de facturation"@fr-fr,
        "תנאי חשבונית"@he-il,
        "चालान शर्तें"@hi-in,
        "請求書条件"@ja-jp,
        "Termos de fatura"@pt-br,
        "发票条款"@zh-cn ;
    skos:definition "Invoice terms refers to the specific information related to billing and payment for legal services provided within the context of an engagement agreement." .

<RBRNVPrymiaUPOuY1n3RDZ3> a owl:Class ;
    rdfs:label "Lack of Insurance Coverage" ;
    rdfs:subClassOf <RCzs34uEQI9f4cuWp3bQO0P> ;
    skos:altLabel "Mangelnde Versicherungsdeckung"@de-de,
        "Lack of Insurance Coverage"@en-gb,
        "Falta de cobertura de seguro"@es-es,
        "Falta de cobertura de seguro"@es-mx,
        "Absence de couverture d'assurance"@fr-fr,
        "חוסר כיסוי ביטוח"@he-il,
        "बीमा कवरेज की कमी"@hi-in,
        "保険のカバー不足"@ja-jp,
        "Falta de cobertura de seguro"@pt-br,
        "缺乏保险覆盖"@zh-cn ;
    skos:definition "Lack of insurance coverage refers to a situation where an individual or entity does not have an insurance policy, or the existing policy does not cover a specific risk, loss, or event. This can result in financial liability for the uninsured party, who must bear the cost of any damages or losses incurred." .

<RBRosNDPt8cNUuRnoPqYufN> a owl:Class ;
    rdfs:label "Breach of Implied Warranty of Habitability" ;
    rdfs:subClassOf <R7NPSSODp2sRYDRSQ2hvF3b>,
        <RDSBerlLWg1ntpLqDQn1eVn> ;
    skos:altLabel "Verletzung der stillschweigenden Gewährleistung der Bewohnbarkeit"@de-de,
        "Breach of Implied Warranty of Habitability"@en-gb,
        "Incumplimiento de la garantía implícita de habitabilidad"@es-es,
        "Incumplimiento de la garantía implícita de habitabilidad"@es-mx,
        "Violation de la garantie implicite d'habitabilité"@fr-fr,
        "הפרת אחריות מתישבת למגורים במצב תקין"@he-il,
        "आवासीय गुणवत्ता की निहित वारंटी का उल्लंघन"@hi-in,
        "暗黙の居住保証の違反"@ja-jp,
        "Violação da garantia implícita de habitabilidade"@pt-br,
        "违反隐含的适居保证"@zh-cn ;
    skos:definition "The Breach of Implied Warranty of Habitability refers to a legal claim that arises when a landlord fails to provide a tenant with a safe and habitable living environment, which is implied in every lease agreement." .

<RBRxyr8yklA9Jy8BHM9j4YT> a owl:Class ;
    rdfs:label "Cruel and Unusual Punishment Claim" ;
    rdfs:subClassOf <RKj3panTdxsJ7nFn11CPGT> ;
    skos:altLabel "Cruel & Unusual Punishment Clause Claim",
        "Anspruch auf Schutz vor grausamer und ungewöhnlicher Bestrafung"@de-de,
        "Cruel and Unusual Punishment Claim"@en-gb,
        "Reclamo de castigo cruel e inusual"@es-es,
        "Reclamo de castigo cruel e inusual"@es-mx,
        "Revendication de protection contre les peines cruelles et inhabituelles"@fr-fr,
        "תביעה על עינויים אכזריים ובלתי רגילים"@he-il,
        "निर्दयी और असामान्य दंड दावा"@hi-in,
        "残酷で異常な刑罰の主張"@ja-jp,
        "Reivindicação de proteção contra punições cruéis e incomuns"@pt-br,
        "残忍和不寻常的惩罚索赔"@zh-cn ;
    skos:definition "A cruel and unusual punishment claim is a legal action initiated by an individual alleging that their Eighth Amendment right to be free from cruel and unusual punishment has been violated by the government or a government actor. The Eighth Amendment prohibits the government from imposing punishments that are excessive, torturous, or barbaric. A cruel and unusual punishment claim may arise in various contexts, such as when a person is subjected to excessive physical or mental pain, suffering, or humiliation during the course of their punishment, when a person is punished for a non-violent offense in a way that is disproportionate to the crime, or when a person is denied necessary medical treatment while in custody." .

<RBStwQIMfdzqv8MhastPnDX> a owl:Class ;
    rdfs:label "Angel Investor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDQ4H6Mofyz6JJD4n1ASHIZ> ],
        <R8hWq9dSn0Su2Y59JE48V3H> ;
    skos:definition "High-net-worth individuals who provide capital for startups, often in exchange for equity or convertible debt." .

<RBV7sRG5Rn12K0LqLOhxdRz> a owl:Class ;
    rdfs:label "19th Amendment Claim" ;
    rdfs:subClassOf <R7MGQ9xUx0PxGLp5yxprdpZ> ;
    skos:altLabel "19. Änderungsantrag"@de-de,
        "19th Amendment Claim"@en-gb,
        "Reclamación de la Enmienda 19"@es-es,
        "Reclamación de la Enmienda 19"@es-mx,
        "Revendication du 19ème amendement"@fr-fr,
        "תביעת התיקון התשיעי עשר"@he-il,
        "19वीं संशोधन दावा"@hi-in,
        "19改正請求"@ja-jp,
        "Reivindicação da 19ª Emenda"@pt-br,
        "第19修正案索赔"@zh-cn ;
    skos:definition "A 19th Amendment claim is a legal assertion related to the Nineteenth Amendment of the United States Constitution, which grants citizens the right to vote regardless of sex, effectively giving women the right to vote." .

<RBVRWCqwvw5wwVjVNAmPMup> a owl:Class ;
    rdfs:label "Bioethics" ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Biomedical Ethics"^^xsd:string,
        "Ethics of Life Sciences"^^xsd:string,
        "Medical Bioethics"^^xsd:string ;
    skos:definition "Bioethics is the field of applied ethics that examines moral questions arising from medicine, biology, and the life sciences. Bioethics evaluates human actions affecting life and health in light of human dignity, moral responsibility, and the common good."^^xsd:string ;
    skos:example "Bioethics addresses ethical limits on genetic modification of human embryos."^^xsd:string,
        "Bioethics evaluates the moral permissibility of in vitro fertilization."^^xsd:string,
        "Bioethics guides decisions about withdrawing disproportionate medical treatment."^^xsd:string,
        "Bioethics informs policies governing research involving human subjects."^^xsd:string,
        "Bioethics protects human dignity in debates about euthanasia and assisted suicide."^^xsd:string .

<RBVpHQ7fb2I2B69LOWszQjd> a owl:Class ;
    rdfs:label "Justifiable Homicide" ;
    rdfs:isDefinedBy <https://ucr.fbi.gov/nibrs/2012/resources/nibrs-offense-definitions> ;
    rdfs:subClassOf <RBzrK4RsgfLScZvC4Z4lCCX> ;
    skos:altLabel "Rechtfertigungsgrund für Tötung"@de-de,
        "Justifiable Homicide"@en-gb,
        "Homicidio justificado"@es-es,
        "Homicidio justificable"@es-mx,
        "Homicide justifié"@fr-fr,
        "התנצלות רצח"@he-il,
        "ज्युस्टिफायबल होमिसाइड"@hi-in,
        "正当防衛殺人"@ja-jp,
        "Homicídio justificável"@pt-br,
        "正当防卫杀人"@zh-cn ;
    skos:definition "The killing of a perpetrator of a serious criminal offense by a peace officer in the line of duty, or the killing, during the commission of a serious criminal offense, of the perpetrator by a private individual." .

<RBW2PKb6dohgDy8xEBXigGy> a owl:Class ;
    rdfs:label "Television Series" ;
    rdfs:subClassOf <RCR0Wfb4Zz9V56W2ri7JeTU> ;
    skos:altLabel "TV Series",
        "TV Show",
        "Television Show" ;
    skos:definition "A Television Series is a set of episodic content produced for television broadcast, typically following a consistent narrative or theme across multiple episodes and seasons. Television series can range from dramas and comedies to documentaries and reality shows, engaging viewers with recurring characters and storylines." .

<RBW9y6esXubLJl4QMtm0Y70> a owl:Class ;
    rdfs:label "Treaties" ;
    rdfs:subClassOf <RC1CZydjfH8oiM4W3rCkma3> ;
    skos:altLabel "Verträge"@de-de,
        "Traités"@fr-fr,
        "条約"@ja-jp,
        "Tratados"@pt-br,
        "条约"@zh-cn ;
    skos:definition "A signed agreement or arrangement made by negotiation between by two political authorities (usually states or sovereign governments), and usually ratified by the states' lawmaking authorities." .

<RBWJ0sl9N65u3lsDkH9HFEa> a owl:Class ;
    rdfs:label "Holdover Tenant" ;
    rdfs:subClassOf <RBpYE6Y5CAH0m6srdnClfZz> ;
    skos:definition "A holdover tenant is an individual who remains in a rented property after the expiration of their lease or rental agreement. In such cases, the tenant continues to occupy the property without formal authorization or a renewed agreement with the landlord. Holdover tenancy situations often lead to legal actions, such as eviction proceedings, as the landlord seeks to regain possession of the property." .

<RBXOUUDPfzuxRdZOd1kgJEZ> a owl:Class ;
    rdfs:label "Occupational Safety and Health Act Claim" ;
    rdfs:isDefinedBy <https://www.dol.gov/general/aboutdol/majorlaws> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R01E1a02E74a0235f7022f40> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R765fdd1D03d3269330E964e> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R5DE425E15b8c8CE8fb6Eecf> ],
        <R8XAQoyqCZvUawGZUsBxFOG> ;
    skos:altLabel "OSH Act Claim",
        "Anspruch nach dem Arbeitsschutzgesetz"@de-de,
        "Occupational Safety and Health Act Claim"@en-gb,
        "Reclamación de la Ley de Seguridad y Salud Ocupacional"@es-es,
        "Reclamación de la Ley de Seguridad y Salud en el Trabajo"@es-mx,
        "Réclamation en vertu de la loi sur la sécurité et la santé au travail"@fr-fr,
        "תביעה על פי חוק הבריאות והבטיחות המקצועית"@he-il,
        "व्यवसायिक सुरक्षा और स्वास्थ्य अधिनियम दावा"@hi-in,
        "労働安全衛生法クレーム"@ja-jp,
        "Reclamação da Lei de Segurança e Saúde Ocupacional"@pt-br,
        "职业安全与健康法索赔"@zh-cn ;
    skos:definition "An Occupational Safety and Health Act (OSHA) claim is a legal action initiated by an employee or group of employees against an employer, alleging that the employer has violated safety and health regulations, failed to maintain a safe work environment, or retaliated against employees for reporting safety concerns or exercising their rights under the OSHA. The OSHA is a federal law enacted in 1970 to ensure safe and healthy working conditions for employees in the United States by setting and enforcing safety standards and regulations. Employers have a general duty under the OSH Act to provide their employees with work and a workplace free from recognized, serious hazards." ;
    skos:prefLabel "OSHA Claim" .

<RBZXbv75cyMrROEWybfqeTJ> a owl:Class ;
    rdfs:label "State Governmental Leader" ;
    rdfs:subClassOf <RDOoYq5UsqIy3nBTVUnTNco> ;
    skos:altLabel "Chief State Official",
        "Head of State Government",
        "State Executive",
        "Territorial Governmental Leader" ;
    skos:definition "A State Governmental Leader is the highest-ranking official in a state, province, or similar sub-national administrative division. This individual is typically responsible for executing state laws, overseeing state agencies, proposing legislation, and representing the state's interests at both national and international levels." ;
    skos:prefLabel "Provincial Governmental Leader" .

<RBZdShYeyerlOOUlB0f64SY> a owl:Class ;
    rdfs:label "Islamic Law System" ;
    rdfs:subClassOf <RM8uFdNbkVDabwW32Bv8E> ;
    skos:altLabel "Fiqh Law System",
        "Islamic Jurisprudence",
        "Muslim Law" ;
    skos:definition "Sharia Law is a legal system based on Islamic principles derived from the Quran, Hadith (sayings of Prophet Muhammad), and other Islamic texts. This system governs both personal and communal aspects of life, integrating moral and legal guidelines." ;
    skos:prefLabel "Sharia Law System" .

<RBZfnioqo6TROkTyGa1gqAS> a owl:Class ;
    rdfs:label "Denial-of-Service Attack" ;
    rdfs:subClassOf <RKUCwOJGfYiSc7zU1qkhAS> ;
    skos:definition "A denial-of-service attack, also known as a DoS attack, aims to disrupt a computer system or network by flooding it with an overwhelming amount of traffic, rendering the service unavailable to legitimate users." ;
    skos:prefLabel "DoS Attack" .

<RBZgWmGzcTraSAkw6fM50Tl> a owl:Class ;
    rdfs:label "Immigration Removal Proceeding" ;
    rdfs:subClassOf <RBEXxc9B6kR2p0BMwGjhWGW> ;
    skos:definition "Immigration Removal Proceeding is a legal process in which an individual is brought before an immigration court to determine their eligibility to remain in a country. If found to be in violation of immigration laws, the individual may be ordered to leave the country, commonly known as deportation." .

<RBaL7gtiLlgraIRVwa44vg2> a owl:Class ;
    rdfs:label "Trademark Assets" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rcwn8msRtDqTFPXcgrpN7A> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBQCFqSF0Q0sCqCcEwv2pgz> ],
        <RBUBqjNCYBI4CtLUcdAVYwy> ;
    skos:altLabel "Markenvermögenswerte"@de-de,
        "Trademark Assets"@en-gb,
        "Activos de marca"@es-es,
        "Activos de marca"@es-mx,
        "Actifs de marque"@fr-fr,
        "נכסי מותג"@he-il,
        "ट्रेडमार्क संपत्ति"@hi-in,
        "商標資産"@ja-jp,
        "Ativos de marca"@pt-br,
        "商标资产"@zh-cn ;
    skos:definition "Trademark Assets are a type of Intellectual Property Assets that refer to any distinctive sign, symbol, or expression used to identify and distinguish the goods or services of one party from those of others." .

<RBaoTrQdSHsKlmEEEjIF4Zn> a owl:Class ;
    rdfs:label "Governmental Authority Level" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC1CZydjfH8oiM4W3rCkma3> ],
        <http://webprotege.stanford.edu/RBTE2mUxX4WZjAu5EkKF4MA> ;
    skos:altLabel "Civic Authority Level"^^xsd:string,
        "Political Authority Level"^^xsd:string,
        "Public Authority Level"^^xsd:string,
        "Regulatory Authority Level"^^xsd:string,
        "State Authority Level"^^xsd:string ;
    skos:definition "Governmental Authority Level is a classification that indicates the degree of binding power with which a governmental body, office, or official issues laws, regulations, or directives. It clarifies the scope of obligation, enforcement, and deference owed within a political or civil jurisdiction."^^xsd:string ;
    skos:example "A constitutional provision binding all public authorities."^^xsd:string,
        "A court judgment with binding legal effect."^^xsd:string,
        "A municipal ordinance governing local conduct."^^xsd:string,
        "A regulation issued by a government ministry."^^xsd:string,
        "A statute enacted by a national legislature."^^xsd:string .

<RBb1yZeamyO4wj2dAFJdA5Z> a owl:Class ;
    rdfs:label "Court-Mandated Conference" ;
    rdfs:subClassOf <R73Uo5x4VyfiOXt6i4R256t> ;
    skos:altLabel "Gerichtlich angeordnete Konferenz"@de-de,
        "Court-Ordered Conference"@en-gb,
        "Conferencia ordenada por el tribunal"@es-es,
        "Conferencia ordenada por el juez"@es-mx,
        "Conférence ordonnée par le tribunal"@fr-fr,
        "כנס שצויין על ידי בית המשפט"@he-il,
        "अदालत आदेशित सम्मेलन"@hi-in,
        "裁判所命令による会議"@ja-jp,
        "Conferência ordenada pelo tribunal"@pt-br,
        "法院指定会议"@zh-cn ;
    skos:definition "A Court-Mandated Conference is a legal event that is required by a court order, typically held before a trial, where parties involved in a lawsuit meet to discuss the case and attempt to reach a settlement." .

<RBbjLAZo9jkKxwlZAq4fZWY> a owl:Class ;
    rdfs:label "Amnesty" ;
    rdfs:comment "In a global Catholic ontology, Amnesty serves as a tool for public mercy that facilitates the restoration of the \"tranquillity of order.\" It reflects the Church’s belief that while justice requires accountability, the common good occasionally demands the legal forgetting of offenses to allow a fractured society to move toward a future of peace."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RIBBxK4TkYe8LDSOqtHTwF> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCdJXw1Ml7DIBqmouWarZm2> ],
        <R9X6xDAYYSYwCeCqMHt5G75> ;
    skos:altLabel "Act of Oblivion"^^xsd:string,
        "Legal Forgetting"^^xsd:string,
        "Sovereign Clemency"^^xsd:string ;
    skos:definition "Amnesty is a sovereign act of the public authority that grants a general pardon for past political or legal offenses to a specific group of individuals. It functions as a bridge toward social reconciliation by removing the legal barriers to re-integration and inviting former adversaries to participate again in the life of the community."^^xsd:string ;
    skos:example "Granting a general pardon to all participants in a non-violent civil uprising to stabilize the new government."^^xsd:string,
        "Issuing a legal act of oblivion for military desertion to encourage the return of citizens following a prolonged war."^^xsd:string,
        "Providing immunity from prosecution for political prisoners as part of a negotiated peace settlement."^^xsd:string .

<RBbjh6B7AdBQ6Bks9h6sEwE> a owl:Class ;
    rdfs:label "Providing Alcohol to Minor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R97apJidWmx520LzKBIhkc1> ],
        <R7yue2mtjzJWKBkXpq5y1Mm>,
        <RDJwYAhLKCUFLjsFuACCRPB> ;
    skos:altLabel "Alkohol an Minderjährige abgeben"@de-de,
        "Supplying Alcohol to a Minor"@en-gb,
        "Suministro de Alcohol a Menores"@es-es,
        "Proporcionar Alcohol a Menores"@es-mx,
        "Fournir de l'alcool à un mineur"@fr-fr,
        "ספק של כוליות לקטין"@he-il,
        "नाबालिग को शराब देना"@hi-in,
        "未成年者へのアルコール提供"@ja-jp,
        "Fornecer álcool a menores"@pt-br,
        "向未成年人提供酒精"@zh-cn ;
    skos:definition "The act of giving or serving alcoholic beverages to an individual who is under the legal drinking age, which may result in legal consequences such as charges of negligence or violation of liquor laws." .

<RBcGW599uGbSbjjZZtMQdIZ> a owl:Class ;
    rdfs:label "Exempted Limited Partnership" ;
    dc:identifier "ENTITY-ELP" ;
    rdfs:subClassOf <RC3I2GwWuuKWmRJVXgxXeb> ;
    skos:altLabel "Exempted Limited Partnership",
        "Befreite Kommanditgesellschaft"@de-de,
        "Société en commandite exemptée"@fr-fr,
        "免責有限責任事業組合"@ja-jp,
        "Sociedade em comandita isenta"@pt-br,
        "豁免有限合伙企业"@zh-cn ;
    skos:definition "An exempted limited partnership (ELP) is a Cayman partnership that is registered under the Exempted Limited Partnership Law. The ELP Law specifically preserves relevant provisions of the Partnership Law and provides that the principles of common law and equity applicable to partnerships shall apply to ELPs." ;
    skos:hiddenLabel "ELP" .

<RBer5GFHRhnNksxEa5AOQ6i> a owl:Class ;
    rdfs:label "Georgia Magistrate Court" ;
    rdfs:subClassOf <R1F90737631a64BFab93D83e> ;
    skos:definition "Georgia Magistrate Court is a court of limited jurisdiction in the state of Georgia that handles civil claims of $15,000 or less, certain minor criminal offenses, and other legal matters as authorized by law." .

<RBey1qPhJGDlP3xszUL2JDF> a owl:Class ;
    rdfs:label "Arbitration Award" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC2LcVXjOZOiT3wqNc2SU5n> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8LtU1k4pyiSD639zaq4vrM> ],
        <RsJ6DupkWKlUlCHH0Ycxvp> ;
    skos:altLabel "Schiedsspruch"@de-de,
        "Arbitration Award"@en-gb,
        "Laudo arbitral"@es-es,
        "Laudo arbitral"@es-mx,
        "Sentence arbitrale"@fr-fr,
        "פסק דין עיוני"@he-il,
        "विवाद-सुलझाव पुरस्कार"@hi-in,
        "仲裁判決"@ja-jp,
        "Sentença arbitral"@pt-br,
        "仲裁裁决"@zh-cn ;
    skos:definition "An arbitration award is a decision made by an arbitrator or panel of arbitrators to resolve a dispute between parties, which is binding and enforceable by law." .

<RBf9jW3bWpfP4TPEFOvvZEv> a owl:Class ;
    rdfs:label "Not Liable" ;
    rdfs:subClassOf <R7knuzL2Cu6WLdyvQiDMp8F> ;
    skos:definition "\"Not liable\" is a legal determination in civil cases indicating that a party has been found not legally responsible or accountable for a particular harm, injury, or legal obligation. It means that the court has not established the party's liability for the claims brought against them, and they are not required to provide compensation or remedies to the plaintiff in the case." .

<RBfZA58JH88QrVPUBjsLg9j> a owl:Class ;
    rdfs:label "Right to Liberty" ;
    dc:source "International Bill of Human Rights" ;
    rdfs:subClassOf <RcUv6cuttcRWxmaQw6M1N4> ;
    skos:definition "The right to liberty refers to the fundamental human right to freedom from unlawful or arbitrary arrest, detention, or other forms of physical restraint. This right is enshrined in international legal instruments such as the Universal Declaration of Human Rights and the International Covenant on Civil and Political Rights, and aims to protect individual autonomy and freedom from state interference." .

<RBfcsZ2JrzHrZiwoKzHGWth> a owl:Class ;
    rdfs:label "Credit Theft" ;
    rdfs:subClassOf <RFjY2mO804t9gJNy5Dn4P1> ;
    skos:altLabel "Kreditdiebstahl"@de-de,
        "Credit Theft"@en-gb,
        "Robo de crédito"@es-es,
        "Robo de crédito"@es-mx,
        "Vol de crédit"@fr-fr,
        "גניבת זיכויים"@he-il,
        "क्रेडिट चोरी"@hi-in,
        "クレジット盗難"@ja-jp,
        "Roubo de crédito"@pt-br,
        "信用盗窃"@zh-cn ;
    skos:definition "The act of taking someone's personal information without their consent and using it to obtain credit or loans in their name." .

<RBk6ifsoekQHMhcCs8IVWuo> a owl:Class ;
    rdfs:label "Guardianship of Juvenile" ;
    rdfs:subClassOf <RDuglENJJNibMF8YDtmXkpE> ;
    skos:altLabel "Vormundschaft für Minderjährige"@de-de,
        "Guardianship of Juvenile"@en-gb,
        "Tutela de Menores"@es-es,
        "Tutela de Menores"@es-mx,
        "Tutelle des mineurs"@fr-fr,
        "אפוטרופוס של נוער"@he-il,
        "किशोर की प्रत्यक्ष परिचर्चा"@hi-in,
        "未成年者の保護"@ja-jp,
        "Guarda de Menores"@pt-br,
        "未成年人监护"@zh-cn ;
    skos:definition "The concept of Guardianship of Juvenile refers to the legal arrangement where a court appoints a guardian to take care of a minor's personal and financial affairs when the parents are unable to do so." .

<RBkIjxd2gCzL4CEXFFhTRCV> a owl:Class ;
    rdfs:label "Compliance Risk" ;
    rdfs:subClassOf <RBHsUy15guQC3jWrIYrwRsH> ;
    skos:definition "Risk in the way that an entity might comply (or potentially fail to comply) with applicable laws and/or regulations. This risk can arise from an organization's failure to adhere to internal policies, industry standards, or legal and regulatory requirements. Causes can include inadequate controls, lack of training, or noncompliance with ethical or governance standards, potentially leading to legal penalties, reputational damage, or loss of stakeholder trust, ultimately impacting the organization's overall performance and sustainability." .

<RBlHKm2Sl9aQa1SWLfievei> a owl:Class ;
    rdfs:label "Document ID" ;
    rdfs:subClassOf <R8EoZh39tWmXCkmP2Xzjl6E> ;
    skos:definition "Identifier (e.g., IRIs, UUIDs, GUIDs) of the particular document stored in the systems of  stakeholders (e.g., lay individuals, clerics, ecclesiastical officials, parishes, dioceses or eparchies, episcopal bodies, and the Holy See)." ;
    skos:prefLabel "Document Identifier" .

<RBmVfFGPaLW8uopGsgeSVfy> a owl:Class ;
    rdfs:label "Confidentiality Agreement" ;
