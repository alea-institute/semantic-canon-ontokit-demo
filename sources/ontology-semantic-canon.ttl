    skos:definition "Apostolic Events means the events recorded in the New Testament that involve the actions, sufferings, and witness of the apostles following Christ’s Ascension. Apostolic Events reveal the early Church’s expansion, challenges, and faithful proclamation of the Gospel under the guidance of the Holy Spirit."^^xsd:string .

<R9eX3Auj16MgFGGYWRmhns8> a owl:Class ;
    rdfs:label "Paralysis" ;
    rdfs:subClassOf <Rijn2Efl5I4ixKTA86MDfT>,
        <RpiyvcnyPAZ5hygNt0zO3j> ;
    skos:altLabel "Immobility",
        "Loss of Motor Function",
        "Plegia" ;
    skos:definition "Paralysis is the loss of muscle function in part or most of the body, often accompanied by sensory loss, due to nerve damage or disruption in the spinal cord or brain. It can be temporary or permanent and requires comprehensive medical treatment and rehabilitation to manage symptoms and improve quality of life." .

<R9m8Wz6rX8oJIJfhFFncV5x> a owl:Class ;
