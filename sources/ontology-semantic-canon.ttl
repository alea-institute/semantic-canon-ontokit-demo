    rdfs:subClassOf <R8aoLYQoIooB9xRkhiMtgR4> ;
    skos:altLabel "Low Vision",
        "Visual Impairment" ;
    skos:definition "Partial Vision Loss refers to a significant reduction in vision that cannot be fully corrected with conventional glasses, contact lenses, or surgery. This condition affects the ability to perform everyday tasks and may involve difficulties with visual acuity, contrast sensitivity, peripheral vision, or depth perception." ;
    skos:prefLabel "Partial Blindness" .

<RDudpkFU4l1qFgz09YHMm1t> a owl:Class ;
