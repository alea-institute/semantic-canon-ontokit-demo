<R9IkFUwMggGV4EMZUJMmcMo> a owl:Class ;
    rdfs:label "Novelty" ;
    rdfs:subClassOf <RDV2029Q3Zi4LQ1ehMJNj3w> ;
    skos:definition "Novelty in legal terms signifies that an invention must be new or original, not previously known or used, to be patentable. It ensures that patents are granted only for genuinely new advancements, not for modifications of existing ones." .

