    rdfs:subClassOf <XmPUH9fPRNCfOEtgdcKZxQ> ;
    skos:definition "This industry comprises establishments primarily engaged in acting as agents and/or brokers in one or more of the following: (1) selling real estate for others; (2) buying real estate for others; and (3) renting real estate for others." .

<Lyfw7h0kQuW53BpDMtDhiQ> a owl:Class ;
    rdfs:label "Limousine Service" ;
