    rdfs:subClassOf <RB6mWlc1WihUbnT7ztVcao5> ;
    skos:definition "Liver transplantation is a surgical procedure in which a diseased liver is replaced with a healthy donor liver to restore normal liver function. This procedure is typically performed for patients with end-stage liver disease, acute liver failure, or certain liver cancers, and requires lifelong immunosuppressive therapy to prevent organ rejection." ;
    skos:prefLabel "Hepatic Transplantation" .

