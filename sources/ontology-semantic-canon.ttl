    rdfs:subClassOf <dBznQuc4TF2u9qYTVToxXA> ;
    skos:definition "This industry comprises establishments primarily engaged in the merchant wholesale distribution of plastics materials and resins, and unsupported plastics film, sheet, sheeting, rod, tube, and other basic forms and shapes." .

<iy1-f21PR0OIRfHRMRIFtg> a owl:Class ;
    rdfs:label "Executive Offices" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=921110> ;
    rdfs:subClassOf <nnjsC5hERVuBO27JjtmriQ> ;
    skos:definition "This industry comprises government establishments serving as offices of chief executives and their advisory committees and commissions. This industry includes offices of the president, governors, and mayors, in addition to executive advisory commissions." .

<j1n7YNq0QkKs3uIOm5yNOQ> a owl:Class ;
    rdfs:label "Frozen Fruit, Juice, and Vegetable Manufacturing" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=311411> ;
    rdfs:subClassOf <JR-Scke0SMqJhTkv2_TqSQ> ;
