        "Frozen meat retailers",
        "Meat retailers",
        "Poultry dealers" .

<zxyXToiXS6aVbnljcU_LvQ> a owl:Class ;
    rdfs:label "Correctional Institutions" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=922140> ;
    rdfs:subClassOf <JISqOxriSfC1y8CA1FTktA> ;
    skos:definition "This industry comprises government establishments primarily engaged in managing and operating correctional institutions. The facility is generally designed for the confinement, correction, and rehabilitation of adult and/or juvenile offenders sentenced by a court." ;
