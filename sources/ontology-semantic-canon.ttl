        "目录"@zh-cn ;
    skos:definition "A compiled list of people, documents, or artifacts." .

<RByDRLSc43XXuxvGpaC4vtz> a owl:Class ;
    rdfs:label "Data Quality Principle" ;
    rdfs:isDefinedBy <http://oecdprivacy.org/> ;
    rdfs:subClassOf <R7xYDTzzTo7YiXeLN7zeBnw> ;
    skos:altLabel "Datenqualitätsprinzip"@de-de,
        "Data Quality Principle"@en-gb,
        "Principio de calidad de datos"@es-es,
        "Principio de calidad de datos"@es-mx,
        "Principe de qualité des données"@fr-fr,
        "עקרון איכות הנתונים"@he-il,
        "डेटा गुणवत्ता सिद्धांत"@hi-in,
        "データ品質の原則"@ja-jp,
        "Princípio de qualidade de dados"@pt-br,
        "数据质量原则"@zh-cn ;
    skos:definition "Data Quality is the privacy principle that personal data should be relevant to the purposes for which they are to be used, and, to the extent necessary for those purposes, should be accurate, complete and kept up-to-date." .

<RByIKxp7nCCxXrfXsd5vXJC> a owl:Class ;
    rdfs:label "Paternity Test" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBn4ChBncWmOuUIe6bkjBAV> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RLIvW0w85MZ3NIl5JwPbbe> ],
        <R7qicnAOVCTYIaiJHt9KmIy> ;
    skos:definition "A Paternity Test is a DNA test that compares the genetic material of an alleged father to that of a child to determine the likelihood of a biological relationship. This test is often used in legal contexts to establish parental rights, child support, or inheritance claims, but can also be used for personal reasons." .

<RBzuZhxURhACJqHvT3xW2AG> a owl:Class ;
    rdfs:label "Visa for Dependent of Temporary Religious Worker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
