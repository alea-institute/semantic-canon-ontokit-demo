    rdfs:subClassOf <_GX1xrnES226fbq1FpHXxw> ;
    skos:definition "This industry comprises establishments primarily engaged in (1) growing trees for reforestation and/or (2) gathering forest products, such as gums, barks, balsam needles, rhizomes, fibers, Spanish moss, ginseng, and truffles." .

<4fVv-16LRdSsxCe6ZpTibw> a owl:Class ;
