<RB6mWlc1WihUbnT7ztVcao5> a owl:Class ;
    rdfs:label "Digestive Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/5.00-Digestive-Adult.htm> ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Digestive System Disorders",
        "GI Disorders" ;
    skos:definition "Digestive disorders encompass a broad range of conditions affecting the digestive system, including the esophagus, stomach, intestines, liver, and pancreas. These disorders can result in significant functional limitations, impacting nutrient absorption, digestion, and overall health, and may require ongoing medical management or surgical intervention." ;
    skos:prefLabel "Gastrointestinal Disorders" .

<RBEA26e888c961BB4b0FDa59> a owl:Class ;
    rdfs:label "United Arab Emirates" ;
    dc:identifier "ASI-AE" ;
    rdfs:subClassOf <R9A38e7BFCdef3F6d2f46ccb> ;
    skos:altLabel "the" ;
    skos:hiddenLabel "AE" ;
    skos:prefLabel "United Arab Emirates" .

<RBJ0dgV4Z2Xk7aGfJt2nSj7> a owl:Class ;
    rdfs:label "Immune System Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm> ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Immunodeficiency Diseases" ;
    skos:definition "Immune system disorders are conditions that result from abnormalities in the immune system, leading to improper immune responses. These disorders include a wide range of diseases, such as autoimmune diseases, immune deficiency disorders, and hypersensitivity reactions, which can cause significant impairment in the body's ability to fight infections and maintain homeostasis." ;
    skos:prefLabel "Immunological Disorders" .

<RBLzDQdY5M3AjVUpILnB95K> a owl:Class ;
    rdfs:label "Disabilities and Health Conditions"^^xsd:string ;
    dc:source <http://publichealth.lacounty.gov/sapc/NetworkProviders/pm/082818/TypesofDisabilities.pdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8ASw8Dgh6TE62ku8oMci5u> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDETD6YVYGhLGZbM1fBnsfj> ],
        <R7sHH7RvjZ6aZS7ZExDpYmR>,
        <RuDAbRiNW105SQoqb1XZ4c> ;
    skos:altLabel "Chronic Health Condition",
        "Critical Health Condition",
        "Critical Illness",
        "Major Medical Condition",
        "Sickness"^^xsd:string,
        "Behinderung"@de-de,
        "Handicap"@fr-fr,
        "障害"@ja-jp,
        "Deficiência"@pt-br,
        "残疾"@zh-cn ;
    skos:definition "Disability refers to a physical, mental, or sensory impairment that significantly limits one or more major life activities, such as walking, speaking, learning, or working. Disabilities can be congenital or acquired, temporary or permanent, and vary in severity. Various laws, such as the Americans with Disabilities Act (ADA) in the United States, protect individuals with disabilities from discrimination and ensure they have equal access to opportunities, services, and accommodations." ;
    skos:prefLabel "Illness"^^xsd:string,
        "Severe Health Condition" .

<RBlfLOh5T3hwTWxMPyHfXBx> a owl:Class ;
    rdfs:label "Service to the Vulnerable" ;
    rdfs:subClassOf <R9F1zhfl4EiAf0VCEYCEnon> ;
    skos:altLabel "Aid to At-Risk Persons"^^xsd:string,
        "Care for the Poor"^^xsd:string,
        "Care for the Vulnerable"^^xsd:string,
        "Protection of the Vulnerable"^^xsd:string,
        "Service to the Marginalized"^^xsd:string ;
    skos:definition "Service to the Vulnerable is the moral commitment to assist persons who face heightened risk of harm due to poverty, illness, disability, age, exclusion, or injustice. Service to the Vulnerable expresses charity and justice by prioritizing protection, care, and empowerment of those least able to protect themselves."^^xsd:string .

<RBpSXv8uOXDikW5jk944sRN> a owl:Class ;
