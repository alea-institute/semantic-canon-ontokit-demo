        "Borrower"@en-gb,
        "Prestatario"@es-es,
        "Deudor"@es-mx,
        "Emprunteur"@fr-fr,
        "לווין"@he-il,
        "उधारदाता"@hi-in,
        "借り手"@ja-jp,
        "Mutuário"@pt-br,
        "借款人"@zh-cn ;
    skos:definition "A borrower is a person, company, or entity that obtains funds from a business or individual for a specified period of time upon condition of promising to repay the loan." ;
    skos:hiddenLabel "BORR" .

<RC2LcVXjOZOiT3wqNc2SU5n> a owl:Class ;
