<R7RTOi3HJBujhrMQbvqgmBZ> a owl:Class ;
    rdfs:label "Speech Disability" ;
    rdfs:subClassOf <RC9rPAii8f99I7p4Hi5Qdia> ;
    skos:altLabel "Speech Communication Disorder",
        "Speech Deficit",
        "Speech Disorder",
        "Speech Impairment",
        "Verbal Communication Disability" ;
    skos:definition "Speech Disability refers to impairments that affect an individual's ability to produce sounds that create words, impacting verbal communication. These disabilities can result from various causes, such as neurological disorders, physical impairments, or developmental conditions, and may affect articulation, fluency, voice, or resonance." .

<R7Ttdyo4FsvaupPKT35Qry0> a owl:Class ;
