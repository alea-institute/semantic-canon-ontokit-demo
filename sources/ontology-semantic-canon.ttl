<RRN0hbO2Bnf3hZ3Yv6xnQR> a owl:Class ;
    rdfs:label "Journeys of the Apostles" ;
    rdfs:subClassOf <R9eJYLpE8tqxZQwMcMzWXkl> ;
    skos:altLabel "Apostolic Journeys"^^xsd:string,
        "Apostolic Missionary Expeditions"^^xsd:string,
        "Missionary Travels of the Apostles"^^xsd:string ;
    skos:definition "Journeys of the Apostles means the missionary travels undertaken by the apostles to proclaim the Gospel, establish Christian communities, and strengthen the early Church. Journeys of the Apostles reveal the Church’s expansion beyond Jerusalem and the universal scope of Christ’s mission."^^xsd:string ;
    skos:example "Apostolic journeys lead to the founding of Christian communities across the Roman world."^^xsd:string,
        "Establishment of Early Christian Communities"^^xsd:string,
        "Evangelization of Asia Minor"^^xsd:string,
        "Journey of Peter to Rome"^^xsd:string,
        "Missionary Journeys of Saint Paul"^^xsd:string,
        "The Acts of the Apostles records Paul’s missionary journeys throughout Asia Minor and Greece."^^xsd:string .

