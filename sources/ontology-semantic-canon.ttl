<RgzU2qQimYpSp3WlNb1dNp> a owl:Class ;
    rdfs:label "Legal Ethics" ;
    rdfs:subClassOf <R740KsX4ol3KSiJ2DHXcsGL> ;
    skos:altLabel "Access to Justice Ethics"^^xsd:string,
        "Ethics of Legal Practice"^^xsd:string,
        "Judicial Ethics"^^xsd:string,
        "Lawyer Ethics"^^xsd:string,
        "Legal Advocacy Ethics"^^xsd:string,
        "Legal Compliance and Integrity Ethics"^^xsd:string,
        "Prosecutorial Ethics"^^xsd:string ;
    skos:definition "Legal Ethics is the field of applied ethics that governs the moral duties and professional conduct of those who practice or administer law. Legal Ethics orders legal practice toward justice, truth, and the protection of human dignity, even when advocacy and authority create tension."^^xsd:string ;
    skos:example "Legal ethics constrains prosecutors to seek justice rather than mere conviction."^^xsd:string,
        "Legal ethics limits advocacy that would mislead a court or suppress material truth."^^xsd:string,
        "Legal ethics obliges judges to avoid conflicts of interest and preserve impartiality."^^xsd:string,
        "Legal ethics requires a lawyer to maintain client confidentiality except where disclosure is morally and legally required."^^xsd:string,
        "Legal ethics supports access to justice for those who lack effective legal representation."^^xsd:string .

