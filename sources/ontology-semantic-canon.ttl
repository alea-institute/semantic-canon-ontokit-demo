    skos:altLabel "Position Downgrade",
        "Role Reassignment" ;
    skos:definition "Demotion is the reassignment of an employee to a lower rank, position, or salary grade, typically as a disciplinary measure or due to performance issues. This action reduces the employee's responsibilities, authority, and often their compensation." ;
    skos:prefLabel "Rank Reduction" .

<RDiv7JSMR8QXdJG121JCQpP> a owl:Class ;
    rdfs:label "Long Form" ;
    rdfs:subClassOf <RDSepz944v79Sc4zhy0qy2X> ;
    skos:definition "A Long Form is an extensive version of a document that provides detailed terms, conditions, and provisions. It is used in various legal contexts, such as contracts, agreements, and reports, to ensure thorough coverage of all relevant aspects and legal requirements." .

<RDj7pgP2OjIDNhdPGJXy4Bo> a owl:Class ;
