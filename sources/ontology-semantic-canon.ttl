<RBf03Oxc4EvytjS4owQ95fU> a owl:Class ;
    rdfs:label "Integrity" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Ethical Consistency"^^xsd:string,
        "Ethical Integrity"^^xsd:string,
        "Honesty of Character"^^xsd:string,
        "Moral Integrity"^^xsd:string,
        "Moral Uprightness"^^xsd:string,
        "Personal Integrity"^^xsd:string ;
    skos:definition "Integrity is the ethical principle that requires consistency between moral conviction, word, and action. Integrity directs persons to act truthfully and faithfully according to rightly formed conscience, even under pressure or cost."^^xsd:string ;
    skos:example "Integrity guides a researcher to report results honestly without manipulation."^^xsd:string,
        "Integrity leads a public official to refuse a bribe despite personal advantage."^^xsd:string,
        "Integrity obliges a leader to keep commitments made to others."^^xsd:string,
        "Integrity requires a professional to follow ethical standards even when no one is watching."^^xsd:string,
        "Integrity restrains action that would compromise conscience for convenience or gain."^^xsd:string .

