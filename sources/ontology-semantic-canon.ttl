    skos:definition "A Savings and Loan Association (S&L) is a financial institution primarily focused on accepting savings deposits and making mortgage loans. S&Ls play a significant role in providing home financing, particularly for residential properties, by offering favorable mortgage terms to depositors." ;
    skos:prefLabel "S&L" .

<R87S8o40yS5vy99GaMLuBzO> a owl:Class ;
    rdfs:label "Trial Before the Sanhedrin" ;
    rdfs:subClassOf <RD0JfBltrTwUJkeYjw8iN1P> ;
