    skos:example "Cadastral surveying services",
        "Cartographic surveying services",
        "Geodetic surveying services",
        "Mapping (except geophysical) services",
        "Topographic surveying services" .

<P7RY7N0pQwCdfFGp9V9yGA> a owl:Class ;
