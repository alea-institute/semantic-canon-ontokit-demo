<RObTyeuV6yxdWyj5mj108e> a owl:Class ;
    rdfs:label "Use and Permission Tax Payment" ;
    rdfs:subClassOf <RBIgSt9tTBIIgOibr6v8RDz> ;
    skos:altLabel "Activity Permission Tax Payment",
        "Usage Fee Payment",
        "User Tax Payment" ;
    skos:definition "Use and Permission Tax Payment includes taxes levied for the use of goods or permission to use goods or perform activities. These taxes are distinct from those assessed on the value of the goods themselves and are usually fixed amounts. This category also covers pollution taxes not based on the value of specific goods. Distinguishing between compulsory user charges and license fees considered as taxes and those regarded as non-tax revenues can be challenging." ;
    skos:prefLabel "Taxes on use of goods, or on permission to use goods or perform activities",
        "Utilization Tax Payment" .

<RPVH5QmsYwXZsVzYrSQZoq> a owl:Class ;
    rdfs:label "National Government Representative" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7MmeHfXj4xIERqXjFOEHHw> ],
        <R85Datx36zz4sBBoEYxCByw> ;
    skos:altLabel "Federal Government Officer",
        "National Elected Representative",
        "National-Level Public Official" ;
    skos:definition "A National Government Representative is an elected or appointed official who serves at the highest level of a country's government, typically in the executive or legislative branch. This individual is responsible for making, debating, or executing national laws and policies, representing constituents or the nation as a whole, and participating in governance at the federal level." ;
    skos:prefLabel "Federal Official" .

<RPh8aR0hguQPyn0Z23MfNo> a owl:Class ;
    rdfs:label "Freedom of Religion" ;
    rdfs:subClassOf <R7UZkDXz7Wg2AtyHFQEeySC>,
        <RBJlYzE4ZY14dTEghzbbMHg>,
        <RcUv6cuttcRWxmaQw6M1N4> ;
    skos:altLabel "Establishment Clause Claim",
        "Free Exercise Clause Claim",
        "Anspruch auf Religionsfreiheit"@de-de,
        "Freedom of Religion Claim"@en-gb,
        "Reclamo de Libertad Religiosa"@es-es,
        "Reclamo de Libertad Religiosa"@es-mx,
        "Revendication de la liberté de religion"@fr-fr,
        "תביעת חופש דת"@he-il,
        "धर्म की स्वतंत्रता का दावा"@hi-in,
        "宗教の自由主張"@ja-jp,
        "Reivindicação da liberdade religiosa"@pt-br,
        "宗教自由主张"@zh-cn ;
    skos:definition "A freedom of religion claim is a legal action initiated by an individual or group alleging that their right to freedom of religion has been violated by the government or a government actor. The First Amendment of the U.S. Constitution guarantees that the government shall not establish an official religion (the Establishment Clause) or prohibit the free exercise of religion (the Free Exercise Clause). A freedom of religion claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts religious practices, when a government actor favors one religion over another, or when an individual or group is discriminated against or denied benefits based on their religious beliefs or practices." .

<RQCqQcWqriNQ2XBCucDmpq> a owl:Class ;
    rdfs:label "Child" ;
    rdfs:subClassOf <RC5RK4Beoxturh6V8lBfWfZ> ;
    skos:definition "A Child is an individual who is the offspring of one or more parents, either biologically or through legal processes like adoption. In legal contexts, a child is often considered a minor and is under the guardianship of their parent(s) or legal guardian(s) until reaching the age of majority." .

<RQh6vIkKX7urKY6X1BYACh> a owl:Class ;
    rdfs:label "Exilic and Post-Exilic Events" ;
    rdfs:subClassOf <R9o7849l09skEBQqbxSItaV> .

<RRC3CmU6w2he0zPcqr6J7p> a owl:Class ;
    rdfs:label "Misrepresentation" ;
    rdfs:subClassOf <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Falschdarstellung"@de-de,
        "Misrepresentation"@en-gb,
        "Representación errónea"@es-es,
        "Representación errónea"@es-mx,
        "Tromperie"@fr-fr,
        "מרמות"@he-il,
        "गलत तरीके से प्रतिनिधित्व"@hi-in,
        "誤認表示"@ja-jp,
        "Má representação"@pt-br,
        "虚假陈述"@zh-cn ;
    skos:definition "A misrepresentation is a false statement made by one party to another, which induces the other party to enter into a contract or take some other action, and which causes harm or damages to the other party." .

<RRTsPoZhucp80NJy00WHwY> a owl:Class ;
    rdfs:label "Proportional Electoral System" ;
    rdfs:subClassOf <R7OQ65vKuOBSSGgSVYnoMfx> ;
    skos:definition "A proportional electoral system is a voting method designed to allocate seats in a legislative body in proportion to the number of votes each party or candidate receives. This system aims to create a representative body that mirrors the overall distribution of public support, promoting fairer and more inclusive representation." ;
    skos:prefLabel "Proportional Voting System" .

