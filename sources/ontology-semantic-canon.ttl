<R86JNywlzQr2sfGO77nCYwO> a owl:Class ;
    rdfs:label "Lack of Foundation Objection" ;
    dc:source "Fed. R. Evid. 901" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7wFa2OWTbJrSusNQEtRNTx> ],
        <RCEx7g3wSm7TRkpl2WQko0s> ;
    skos:altLabel "Inadequate Basis Objection",
        "Insufficient Grounds Objection",
        "Objection to Evidence Without Proper Context" ;
    skos:definition "A Lack of Foundation Objection is raised when a party in a legal proceeding believes that the evidence being presented has not been properly introduced or contextualized. This objection aims to ensure that evidence is admitted only when its relevance and reliability have been established through a sufficient foundation." .

<R86iUPXLpkUxhNOxdQYUaWl> a owl:Class ;
