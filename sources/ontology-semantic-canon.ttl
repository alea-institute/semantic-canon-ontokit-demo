<R7THdgb6vPCuvEA0fCDjLtd> a owl:Class ;
    rdfs:label "Hypoglycemia" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm> ;
    rdfs:subClassOf <RDAtMRi4dBGNW1PytkqmH4t> ;
    skos:altLabel "Low Blood Glucose" ;
    skos:definition "Hypoglycemia is an abnormally low level of blood glucose, which can result from diabetes management or other conditions. Symptoms can be recognized and reversed by consuming glucose-containing substances, though some individuals may not recognize the symptoms due to hypoglycemia unawareness. Severe cases can lead to complications like seizures or loss of consciousness." ;
    skos:prefLabel "Low Blood Sugar" .

