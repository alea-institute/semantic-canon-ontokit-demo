<R7KdQLWwrvkyzohDgf48st7> a owl:Class ;
    rdfs:label "Intellectual Property Regulatory Documents" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBUBqjNCYBI4CtLUcdAVYwy> ],
        [ a owl:Restriction ;
