<R9n8ukOX6QZ7e4bydqrEyfE> a owl:Class ;
    rdfs:label "Commutation" ;
    rdfs:subClassOf <RCRVBAzI4EaLARuVLhgDBTB> ;
    skos:definition "Commutation is the reduction of a punishment or sentence for a crime, usually from a more severe form to a lesser one, without negating the underlying conviction. Unlike a pardon, which absolves the individual of the crime, a commutation typically pertains to reducing the length of a prison sentence or changing the type of punishment, but the conviction remains on the individual's record." .

<R9nB8qcUs6VLcyZcPsiJwhS> a owl:Class ;
    rdfs:label "Anorexia Nervosa" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RCfOoWbuAOqLv617rVNcHYh> ;
    skos:altLabel "Anorexia" ;
    skos:definition "Anorexia Nervosa is an eating disorder characterized by an intense fear of gaining weight and a distorted body image leading to severe food restriction and extreme weight loss. Individuals with this disorder may also engage in excessive exercise, purging, or other behaviors to prevent weight gain." ;
    skos:prefLabel "Anorexic Disorder" .

<R9nFPCr7xpP9YY5pQp8jyyr> a owl:Class ;
