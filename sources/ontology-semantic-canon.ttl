    rdfs:subClassOf <oSmDmJrQR8i-AuHApZq3pQ> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in one or more of the following: (1) salting, roasting, drying, cooking, or canning nuts; (2) processing grains or seeds into snacks; and (3) manufacturing peanut butter and other nut butters." .

<CdACNfCfQk6tdHWb4_dqEw> a owl:Class ;
