<R7Npz2dMwAvM2YkbcTKhvKy> a owl:Class ;
    rdfs:label "Primary Canon" ;
    rdfs:subClassOf <RBkL8I5saFF7mqpLTI7GxSh> ;
    skos:definition "Primary Canon is an authoritative source text that directly establishes foundational norms, doctrines, or laws of the Church. It functions as a first-order reference for belief, governance, and interpretation."^^xsd:string .

<R7NwY5UT07qF3VkI8MYarxj> a owl:Class ;
    rdfs:label "Spoliation of Evidence" ;
    rdfs:subClassOf <RSRxb9psAJdqf8rppoiYI8> ;
    skos:altLabel "Destruction of Evidence",
        "Spoliation",
        "Beweismittelunterdrückung"@de-de,
        "Spoliation of Evidence"@en-gb,
        "Destrucción de pruebas"@es-es,
        "Deterioro de pruebas"@es-mx,
        "Destruction de preuves"@fr-fr,
        "פגיעה בראיות"@he-il,
        "साक्ष्यों का नष्ट करना"@hi-in,
        "証拠隠滅"@ja-jp,
        "Destruição de provas"@pt-br,
        "证据毁灭"@zh-cn ;
    skos:definition "The intentional or negligent destruction or alteration of evidence by a party in a legal matter, which may result in sanctions or adverse inferences against that party." .

<R7OtUosForl1Zon7KU3gQQR> a owl:Class ;
    rdfs:label "Real Estate Operator" ;
    rdfs:subClassOf <RDm4rfXgHt9wIDHbrUUGCGL> ;
    skos:altLabel "Property Operator",
        "Real Estate Manager" ;
    skos:definition "A Real Estate Operator is a professional or entity responsible for the day-to-day management, maintenance, and operations of real estate properties. This role includes overseeing property functions, ensuring tenant satisfaction, handling leasing activities, and maintaining the physical condition of the property." ;
    skos:prefLabel "Property Manager" .

<R7P2d6Z7m3cNjxzfx9zPjhe> a owl:Class ;
    rdfs:label "Works of Mercy" ;
    rdfs:subClassOf <R9F1zhfl4EiAf0VCEYCEnon> ;
    skos:altLabel "Acts of Mercy"^^xsd:string,
        "Deeds of Charity"^^xsd:string,
        "Merciful Works"^^xsd:string,
        "Works of Charity"^^xsd:string ;
    skos:definition "Works of Mercy are concrete acts of charity by which Christians respond to the needs of others in body and soul. Works of Mercy give practical expression to love of neighbor and witness to the mercy of God in the world."^^xsd:string .

<R7QqT8OYSjPMxWY3Tj1Nlam> a owl:Class ;
    rdfs:label "Proceeding Closed / Disposed" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R93BYWO8QMFsYQLgyLSLv17> ],
        <RCxI8cqNSzWB8ZAuv6RBHmV> ;
    skos:altLabel "Case Closed / Disposed" ;
    skos:definition "The concept of \"Case Closed / Disposed\" refers to the state or condition of a legal matter where all proceedings have been completed and the case has been resolved or dismissed." .

<R7SEjiYzkEBKWLmzH6Wet7N> a owl:Class ;
    rdfs:label "Electric Power Generation, Transmission and Distribution Industry" ;
    dc:identifier "UTL-ELEC" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=2211> ;
    rdfs:subClassOf <RBFAn1xyfuXmMiWDnpSsuU2> ;
    skos:altLabel "Electric Power",
        "Elektrizitätsindustrie"@de-de,
        "Electric Power Industry"@en-gb,
        "Industria de la energía eléctrica"@es-es,
        "Industria de la energía eléctrica"@es-mx,
        "Industrie de l'électricité"@fr-fr,
        "תעשיית הכוח החשמלי"@he-il,
        "इलेक्ट्रिक ऊर्जा उद्योग"@hi-in,
        "電力産業"@ja-jp,
        "Indústria de energia elétrica"@pt-br,
        "电力工业"@zh-cn ;
    skos:definition "This industry group comprises establishments primarily engaged in generating, transmitting, and/or distributing electric power.  Establishments in this industry group may perform one or more of the following activities: (1) operate generation facilities that produce electric energy; (2) operate transmission systems that convey the electricity from the generation facility to the distribution system; and (3) operate distribution systems that convey electric power received from the generation facility or the transmission system to the final consumer." ;
    skos:hiddenLabel "ELEC" .

<R7TITXLXKEsSewVpYpMw3tL> a owl:Class ;
    rdfs:label "Biblical Events" ;
    rdfs:subClassOf <RBypJHdXoQQwqYlG95KCDCQ> ;
    skos:altLabel "Biblical Narrative Events"^^xsd:string,
        "Salvation History Events"^^xsd:string ;
    skos:definition "Biblical Events means events narrated or attested in Sacred Scripture that form part of salvation history and the biblical account of God’s actions in the world. Biblical Events includes both unique, non-repeatable events (e.g., the Resurrection) and historically situated events involving biblical persons, peoples, and places as Scripture presents them."^^xsd:string ;
    skos:example "The Acts of the Apostles describes the descent of the Holy Spirit at Pentecost."^^xsd:string,
        "The Gospel of Luke recounts the annunciation to Mary by the angel Gabriel."^^xsd:string,
        "The Gospels narrate Jesus’ crucifixion under Pontius Pilate."^^xsd:string ;
    skos:prefLabel "Scriptural Events"^^xsd:string .

<R7TmA0IapaoAjuWfDF1T49i> a owl:Class ;
    rdfs:label "Leukemia" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/13.00-NeoplasticDiseases-Malignant-Adult.htm#13_06> ;
    rdfs:subClassOf <R7O2ClQ73HLZZLgFgtNbVTF>,
        <RDF3VrmH1eapfkrSQstevLs> ;
    skos:altLabel "Blood Cancer",
        "Hematologic Cancer" ;
    skos:definition "Leukemia is a type of cancer that affects the blood and bone marrow, characterized by the overproduction of abnormal white blood cells. This disease can be acute or chronic and often requires treatments such as chemotherapy, radiation therapy, or stem cell transplantation." .

<R7TzyLcZq0lELm4qq9pU6ru> a owl:Class ;
    rdfs:label "Third-Party Defendant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9tyJmIM3Lx7OItGji5zPXN> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RijIqw1HEfQF4ctjWUlgnq> ],
        <RCFgxBbypUKKsDDOJ1iOk36> ;
    skos:altLabel "Drittwiderbeklagter"@de-de,
        "Third-Party Defendant"@en-gb,
        "Demandado de Terceros"@es-es,
        "Demandado de Terceros"@es-mx,
        "défendeur tiers"@fr-fr,
        "נאשם מצד שלישי"@he-il,
        "तीसरी पक्ष का दावेदार"@hi-in,
        "第三者被告"@ja-jp,
        "réu de terceira parte"@pt-br,
        "第三方被告"@zh-cn ;
    skos:definition "A party who was not initially sued but is brought into a civil action by another defendant." .

<R7UYJUZ3D37DD8nEuNUXXti> a owl:Class ;
    rdfs:label "Refugee" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBCV26gN63NNAmGIxsKVAi7> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCjf3VBil5V7nwAGjhEkGIC> ],
        <R8GuYn7yMmfL0coiNQ0OE8f> ;
    skos:definition "In the context of immigration law, a \"Refugee\" is someone who has been forced to flee their home country due to a well-founded fear of persecution. That fear is often based on race, religion, nationality, political opinion, or membership in a particular social group." .

<R7aHk2AkuO60xkjZ0nGpV70> a owl:Class ;
    rdfs:label "Disinterested" ;
    rdfs:subClassOf <R8nREeU6lB0zs0dt9N339nm> ;
    skos:altLabel "Impartial",
        "Unbiased" ;
    skos:definition "The attribute \"disinterested\" refers to parties, often trustees or professionals, who have no personal interest in the outcome of the proceedings and no prior relationship with the debtor or creditors. Disinterested parties ensure unbiased administration and decision-making, fostering fairness and integrity in the process." ;
    skos:prefLabel "Neutral" .

<R7d6hYERMUTdeDdt51PsIX3> a owl:Class ;
    rdfs:label "Common Carrier" ;
    rdfs:subClassOf <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Public Utility" ;
    skos:definition "A common carrier is an individual or business that advertises to the public to transport people, offer goods, or provide services to the public. Common carriers are legally obligated to provide services to any paying customer without discrimination." ;
    skos:example "A bus company that offers transportation to the general public.",
        "A telephone company offering services to the public",
        "An airline that sells tickets to the public" ;
    skos:prefLabel "Public Transport Service" .

<R7dfLNS7HRE7sMgS8gwVYed> a owl:Class ;
    rdfs:label "Remote Synchronous Communication" ;
    rdfs:subClassOf <R8mhr9YGlyTNig0Qdru2f4t> ;
    skos:altLabel "Fernsynchronkommunikation"@de-de,
        "Remote Synchronous Communication"@en-gb,
        "Comunicación Sincrónica Remota"@es-es,
        "Comunicación Sincrónica Remota"@es-mx,
        "Communication synchrone à distance"@fr-fr,
        "תקשורת סינכרונית מרחוק"@he-il,
        "रिमोट समवर्ती संचार"@hi-in,
        "リモート同期通信"@ja-jp,
        "Comunicação síncrona remota"@pt-br,
        "远程同步通信"@zh-cn ;
    skos:definition "A communication that occurs synchronously and remotely, such as a telephone call or videoconference (e.g., Zoom, Teams, Meet)." .

<R7f6bqEjMQDMYjlvg0WINGf> a owl:Class ;
    rdfs:label "Sales and Consumption Tax Payment" ;
    rdfs:subClassOf <RBIgSt9tTBIIgOibr6v8RDz> ;
    skos:altLabel "Tax payment on production, sale, transfer, leasing and delivery of goods and rendering of services",
        "Transaction Tax Payment" ;
    skos:definition "Sales and Consumption Tax Payment (aka Tax payment on production, sale, transfer, leasing and delivery of goods and rendering of services) consists of all taxes, levied on transactions in goods and services on the basis of their intrinsic characteristics (e.g., value, weight of tobacco, strength of alcohol, and so on) as distinct from taxes imposed on the use of goods, or permission to use goods or perform activities." .

<R7iSh4AXN4oJuPPGv1KQDnD> a owl:Class ;
    rdfs:label "Freedom from War and Armed Conflict" ;
    rdfs:subClassOf <RBJlYzE4ZY14dTEghzbbMHg> ;
    skos:definition "Freedom from war and armed conflict is a human aspiration often reflected in international humanitarian law, which seeks to limit the effects of armed conflict on people and communities. While not always explicitly defined as a \"right,\" various international treaties like the Geneva Conventions aim to protect civilians, prisoners of war, and combatants from unnecessary suffering and violence during times of conflict." .

<R7ju2C0HxoDqBL5XSpENfiR> a owl:Class ;
    rdfs:label "Scripture" ;
    rdfs:subClassOf <R7Npz2dMwAvM2YkbcTKhvKy> ;
    skos:definition "Scripture is the collection of sacred writings inspired by the Holy Spirit and received by the Church as the written Word of God. It constitutes a foundational source of divine revelation and norms faith, morals, and worship."^^xsd:string .

<R7knuzL2Cu6WLdyvQiDMp8F> a owl:Class ;
    rdfs:label "Civil Legal Determination" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RijIqw1HEfQF4ctjWUlgnq> ],
        <R8AUKvbXRK8jOHSQaqxcAtD> ;
    skos:definition "A \"civil legal determination\" refers to the decision or verdict made by a court in a civil case. It includes outcomes such as finding a party liable or not liable for a particular claim or issue. This determination often leads to remedies or judgments, such as monetary awards or injunctive relief, to resolve the dispute between the parties involved in the civil litigation." .

<R7ma9Q5FiHDcIYgKoxKNUk9> a owl:Class ;
