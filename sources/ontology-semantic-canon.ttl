<R83sNnwSvTMsV9jowtvS2cv> a owl:Class ;
    rdfs:label "Large Trader Identification Form" ;
    rdfs:subClassOf <RmCERXtzdqIJcW9mdbk0Bb> ;
    skos:definition "A Large Trader Identification Form is a filing required by the financial regulator (e.g., U.S. Securities and Exchange Commission (SEC)) from large traders, defined as those whose transactions in National Market System (NMS) securities equal or exceed specified thresholds. The form provides the financial regulator with information about the large trader's identity, business activities, and affiliates to enhance market surveillance and analyze the impact of large traders on the securities market." ;
    skos:prefLabel "Form 13H" .

<R83u2PaBNXclAGLdTJGeFiG> a owl:Class ;
    rdfs:label "Limited Voting System" ;
    dc:source <https://en.wikipedia.org/wiki/Limited_voting> ;
    rdfs:subClassOf <R8aVRgLAjmuf0OiloIoc9pm> ;
    skos:altLabel "Minority Representation Voting",
        "Partial Voting System" ;
    skos:definition "The limited voting system is an electoral method where voters have fewer votes than the number of available seats, allowing for the possibility of minority representation. This system is designed to prevent any single group from winning all the seats and is often used to promote more diverse representation." ;
    skos:example "Alabama State Board of Education Elections: Limited voting used to ensure minority representation",
        "Gibraltar's Parliamentary Elections: Voters have ten votes for seventeen seats",
        "Spain's Senate Elections: Voters have two or three votes for four seats in each province" ;
    skos:prefLabel "Partial Block Voting" .

<R83uDPddEeGsIPUWzXqclpA> a owl:Class ;
    rdfs:label "Transparency" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Clarity"^^xsd:string,
        "Disclosure"^^xsd:string,
        "Openness"^^xsd:string,
        "Public Accountability"^^xsd:string ;
    skos:definition "Transparency is the ethical principle that requires openness, clarity, and truthfulness in actions, decisions, and communication, especially where authority or trust exists. Transparency enables accountability and informed participation by making relevant information accessible without deception or undue concealment."^^xsd:string ;
    skos:example "Transparency guides ethical reporting of data without manipulation or omission."^^xsd:string,
        "Transparency must respect legitimate limits imposed by privacy and confidentiality."^^xsd:string,
        "Transparency obliges organizations to disclose conflicts of interest."^^xsd:string,
        "Transparency requires leaders to explain the reasons for decisions that affect others."^^xsd:string,
        "Transparency supports trust by making procedures and criteria publicly known."^^xsd:string .

<R83yUF8cXJjshBdF83Knjbh> a owl:Class ;
    rdfs:label "Thyroid Gland Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm> ;
