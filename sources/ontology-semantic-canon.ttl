<RDsXFlhl3SWyKzTqYbFEOP> a owl:Class ;
    rdfs:label "Present Sense Impression" ;
    dc:source "Fed. R. Evid. 803(1)" ;
    rdfs:subClassOf <RDsA0EjhyOEG9HBBGLsyj0G> ;
    skos:altLabel "Contemporaneous Statement",
        "Spontaneous Statement" ;
    skos:definition "A Present Sense Impression is a statement describing or explaining an event or condition made while or immediately after the declarant perceived it. This hearsay exception is based on the belief that statements made in the moment, without time for reflection or fabrication, are inherently reliable." .

<RDsaH0AuQk6sV9PUheDPXBv> a owl:Class ;
