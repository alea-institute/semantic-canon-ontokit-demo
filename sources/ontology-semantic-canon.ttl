        "Wage and Hour Division"@en-gb,
        "División de Salarios y Horas"@es-es,
        "División de Salarios y Horas"@es-mx,
        "Division des salaires et des heures"@fr-fr,
        "מחלקת שכר ושעות"@he-il,
        "वेज और घंटे विभाग"@hi-in,
        "賃金・労働時間局"@ja-jp,
        "Divisão de Salários e Horas"@pt-br,
        "工资和工时部门"@zh-cn ;
    skos:definition "The Wage and Hour Division (WHD) of the United States Department of Labor is the federal office responsible for enforcing federal labor laws." ;
    skos:hiddenLabel "WHD" ;
    skos:prefLabel "Wage and Hour Division" .

<R75NqKK81qV8tykmMiU61ax> a owl:Class ;
    rdfs:label "Cyclist" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8bNzp6lTyATfctRVnXr5rl> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDsUlVQxaIAflOYepmX1kjU> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Biker" ;
    skos:definition "A cyclist is a person who rides a bicycle, utilizing it for transportation, recreation, or competitive purposes on various types of terrain and roads. This includes adhering to specific traffic laws and cycling regulations to maintain safety and coordination with other road users." ;
    skos:prefLabel "Bicycle Rider" .

<R77rieb3DsQdxBQrzBKyb0k> a owl:Class ;
    rdfs:label "Debts" ;
    rdfs:comment "Stemmed from Bankruptcy Project" ;
    rdfs:subClassOf <RDMogej8AdNSlkztHiKlIGK> ;
    skos:definition "Debts are financial obligations that require an individual or entity to repay borrowed money or assets to a lender according to agreed-upon terms. These obligations can take various forms, including loans, bonds, or promissory notes, and may accrue interest over time." .

<R79xLpY9gRRitoFR3T667If> a owl:Class ;
    rdfs:label "Zoological Taxonomy" ;
    rdfs:subClassOf <R9ax95LqcYtqPK458D1g7aP> ;
    skos:altLabel "Zoological Classification" ;
    skos:definition "Zoological Taxonomy is the scientific classification of animals based on their evolutionary relationships, anatomical structures, and genetic similarities, organizing them into hierarchical categories such as phyla, classes, orders, families, genera, and species. This system helps in understanding the diversity of animal life and their biological characteristics." ;
    skos:prefLabel "Animal Taxonomy" .

<R7C9ec572B8e01F73e191eb6> a owl:Class ;
    rdfs:label "Maine State Courts" ;
    dc:identifier "USCTS-STCOUS-ME" ;
    rdfs:subClassOf [ a owl:Restriction ;
