<RC9gxTda2u80ExW6y0El4YK> a owl:Class ;
    rdfs:label "Building Material and Garden Equipment and Supplies Dealers Industry" ;
    dc:identifier "RET-BMGD" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=444> ;
    rdfs:subClassOf <RDfdmGR6iPi4k2t6ecIUBkP> ;
    skos:altLabel "Building Material and Garden Equipment",
        "Baumaterial- und Gartenbauindustrie"@de-de,
        "Building Material and Garden Equipment Industry"@en-gb,
        "Industria de materiales de construcción y equipos de jardinería"@es-es,
        "Industria de materiales de construcción y equipos de jardinería"@es-mx,
        "Industrie des matériaux de construction et des équipements de jardin"@fr-fr,
        "תעשיית חומרי בניין וציוד גינון"@he-il,
