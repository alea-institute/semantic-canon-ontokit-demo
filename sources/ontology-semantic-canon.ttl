    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:altLabel "is bestowed upon",
        "is issued to" ;
    skos:definition "In legal and administrative contexts, \"issued to\" refers to the formal granting or providing of a legal status, document, or financial instrument by an authoritative body or entity to a specific recipient. This term indicates that the recipient is the designated holder or beneficiary of the issued item, such as asylum status, a business license, or stock ownership." ;
    skos:example "Asylum issuedTo Asylee",
        "License issuedTo Business",
        "Stock issuedTo Investor" ;
    skos:prefLabel "folio:isBestowedUpon" .

