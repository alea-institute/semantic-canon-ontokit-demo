    skos:altLabel "Rolle im Projektmanagement"@de-de,
        "Role in Project Management"@en-gb,
        "Rol en la Gestión de Proyectos"@es-es,
        "Rol en la Gestión de Proyectos"@es-mx,
        "Rôle dans la gestion de projet"@fr-fr,
        "תפקיד בניהול פרויקטים"@he-il,
