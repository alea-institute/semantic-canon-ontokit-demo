<RmXvSJFAd7ebRkO0LlY2rY> a owl:Class ;
    rdfs:label "Coronary Artery Disease" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/4.00-Cardiovascular-Adult.htm#4_04> ;
    rdfs:subClassOf <RCuhulltRlDN8kiH5sooyW9> ;
    skos:altLabel "Coronary Artery Disease",
        "Coronary Heart Disease" ;
    skos:definition "Ischemic heart disease (IHD), also known as coronary artery disease (CAD), is a condition characterized by reduced blood flow to the heart muscle due to the narrowing or blockage of coronary arteries. It manifests through symptoms such as angina pectoris (chest pain), myocardial infarction (heart attack), and may require interventions like coronary artery bypass grafting (CABG) or percutaneous coronary interventions (PCI)." ;
    skos:prefLabel "Ischemic Heart Disease" .

