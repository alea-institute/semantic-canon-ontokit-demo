    skos:example "Fruit basket or fruit bouquet retailers",
        "Gift retailers",
        "Greeting card retailers",
        "Novelty retailers",
        "Seasonal and holiday decoration retailers",
        "Souvenir retailers" .

<bCP5M_IYQRO22fkQNM1X-g> a owl:Class ;
