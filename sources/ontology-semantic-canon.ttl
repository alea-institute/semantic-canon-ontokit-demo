    skos:altLabel "Pancreatic Carcinoma" ;
    skos:definition "Pancreatic cancer is a type of cancer that originates in the tissues of the pancreas, an organ responsible for aiding digestion and regulating blood sugar. It is often diagnosed at an advanced stage and typically requires treatments such as surgery, chemotherapy, radiation therapy, and targeted therapy." ;
    skos:prefLabel "Pancreas Cancer" .

<R8RjNYOqUElQ9CiHuLprZjM> a owl:Class ;
