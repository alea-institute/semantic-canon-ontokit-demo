        "Receiver"@en-gb,
        "Receptor"@es-es,
        "Receptor"@es-mx,
        "Récepteur"@fr-fr,
        "מקבל"@he-il,
        "प्राप्तकर्ता"@hi-in,
        "レシーバー"@ja-jp,
        "Receptor"@pt-br,
        "接收器"@zh-cn ;
    skos:definition "A neutral person (often a professional trustee) appointed by a judge to take charge of the property and business of one of the parties to a lawsuit and receive his/her rents and profits while the right to the moneys has not been finally decided." .

<RDjMjjBlt5UcxM5InqAQx7P> a owl:Class ;
