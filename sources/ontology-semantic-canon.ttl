            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9aSzp9cEiBCzObnP92jYFX> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RwxL1z0C8tiJRzH9j7gwt3> ],
        <R8UG79BtYP2uqnKNklLYXB8> ;
    skos:altLabel "Geographic Market Attributes" ;
    skos:definition "Geographic market attributes refer to the characteristics of a market that are defined by the geographical scope and location of consumers and businesses. These attributes can include the national, international, and local reach of a market, and they play a crucial role in shaping marketing strategies and product offerings." ;
    skos:note "Non-copyrightable idea and fact inspiration drawn from IAB 2.0. https://www.meaningcloud.com/developer/documentation/predefined/deep-categorization-models/iab-2-0" ;
    skos:prefLabel "Market Geography" .

<R81193c1B44b02C9e7e232ee> a owl:Class ;
