    skos:hiddenLabel "RESIDL" ;
    skos:prefLabel "Residential Property" .

<RBSmDQDWWU1JFUM7xBamEjW> a owl:Class ;
    rdfs:label "Official Committee of Creditors" ;
    dc:identifier "COMM-OCCR" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7PHFZzZmVmczzNQl6iZKsa> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R4zb5sPFXnaKI3joMOlkOd> ],
        <RCoOnTANPIS6LCYx2SVkLJL> ;
    skos:altLabel "Official Committee of Creditors",
        "Offizieller Gläubigerausschuss"@de-de,
        "Comité Officiel des Créanciers"@fr-fr,
        "公式債権者委員会"@ja-jp,
        "Comitê Oficial de Credores"@pt-br,
        "债权人委员会"@zh-cn ;
    skos:definition "In U.S. bankruptcy law under chapter 11, the United States Trustee may appoint an official committee of unsecured creditors. The purpose of this committee is to represent the overall interests of all unsecured creditors." ;
    skos:hiddenLabel "OCCR" .

<RBU9zZzHpiivyY3EFmul3Ja> a owl:Class ;
    rdfs:label "Neurodevelopmental Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1>,
        <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_11> ;
    rdfs:subClassOf <RN3TubQIlusDFnPgrNAk8D> ;
    skos:definition "Neurodevelopmental Disorders are characterized by onset during the developmental period, that is, during childhood or adolescence, although sometimes they are not diagnosed until adulthood. Symptoms and signs may include, but are not limited to, underlying abnormalities in cognitive processing (for example, deficits in learning and applying verbal or nonverbal information, visual perception, memory, or a combination of these); deficits in attention or impulse control; low frustration tolerance; excessive or poorly planned motor activity; difficulty with organizing (time, space, materials, or tasks); repeated accidental injury; and deficits in social skills. Symptoms and signs specific to tic disorders include sudden, rapid, recurrent, non-rhythmic, motor movement or vocalization." .

<RBUe0cQF64tyOYgN6tqTSLm> a owl:Class ;
    rdfs:label "Disability and Medical Condition Discrimination" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBLzDQdY5M3AjVUpILnB95K> ],
        <R8UnJ8s91KxQbW7GpGgIhsP> ;
    skos:altLabel "Diskriminierung aufgrund von Behinderung und medizinischem Zustand"@de-de,
        "Discrimination fondée sur le handicap et l'état de santé"@fr-fr,
        "障害および医療状態に基づく差別"@ja-jp,
        "Discriminação por deficiência e condição médica"@pt-br,
        "残疾和医疗状况歧视"@zh-cn ;
    skos:definition "Discrimination based on a person's disability or medical condition, which is prohibited by law and can be the basis for a legal claim." .

<RBWAKJ6PD3hoPnmcbygkYBn> a owl:Class ;
    rdfs:label "Forms of Devotional Practice" ;
    rdfs:subClassOf <RDJkQMNK5utxd5sRAmWPnUw> ;
    skos:altLabel "Devotional Forms"^^xsd:string,
        "Forms of Pious Practice"^^xsd:string,
        "Modes of Devotional Prayer"^^xsd:string ;
    skos:definition "Forms of Devotional Practice are the modes or expressions through which devotional prayer and piety are carried out. They describe how devotion is practiced rather than the specific object of devotion."^^xsd:string ;
    skos:example "Different forms of devotional practice engage body and soul."^^xsd:string .

<RBWTNMvqynzbuBEvo2wGHe7> a owl:Class ;
    rdfs:label "Securities Law Claims" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RD1C77b5D46361ED0cbA4f20> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDeT3IwQX4XRp2NQltDXY4r> ],
        <R9LVBKjvGRuzwgtlhuLST36> ;
    skos:altLabel "Ansprüche aus Wertpapierrecht"@de-de,
        "Securities Law Claims"@en-gb,
        "Reclamaciones de derecho de valores"@es-es,
        "Reclamaciones de derecho de valores"@es-mx,
        "Réclamations en droit des valeurs mobilières"@fr-fr,
        "תביעות חוק ניירות ערך"@he-il,
        "सुरक्षा कानून दावे"@hi-in,
        "証券法クレーム"@ja-jp,
        "Reivindicações de direito de valores mobiliários"@pt-br,
        "证券法索赔"@zh-cn ;
    skos:definition "Securities Law Claims refer to legal claims arising from violations of laws and regulations related to securities, such as buying securities improperly during a corporate takeover or committing securities fraud." .

<RBXoCwCeY64Ow60nWKSZCC> a owl:Class ;
    rdfs:label "Health-Conscious Market Segment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCSG4k3ah1Pu5YgPexPgOmL> ],
        <R8Tktpdf3HuYd3nI7nf9xQU> ;
    skos:definition "The health-conscious segment refers to a portion of the market that is characterized by consumers who prioritize health and wellness in their purchasing decisions. This segment includes products and services that are designed to promote physical, mental, and emotional well-being, catering to individuals who seek a healthy lifestyle." ;
    skos:example "Health Supplements",
        "Organic Foods",
        "Preventive Healthcare Products" ;
    skos:prefLabel "Wellness Segment" .

<RBY6ZBEYa2Y7NOxChUaInA2> a owl:Class ;
    rdfs:label "Just War" ;
    rdfs:comment "In a global Catholic ontology, Just War serves as the primary moral filter for evaluating the legitimacy of armed conflict. It is not an endorsement of violence but a restrictive framework designed to prevent the arbitrary use of force and to protect the innocent by binding political and military leaders to objective ethical standards."^^xsd:string ;
    rdfs:subClassOf <R79CBFMSwUZjwKG9qV6AfQb> ;
    skos:altLabel "Bellum Justum"^^xsd:string,
        "Doctrine of Just Defense"^^xsd:string,
        "Ethical Warfare Framework"^^xsd:string,
        "Jus ad Bellum"^^xsd:string,
        "Jus in Bello"^^xsd:string,
        "Jus post Bellum"^^xsd:string,
        "Just War Theory"^^xsd:string ;
    skos:definition "Just War is a doctrine of applied ethics that establishes rigorous criteria to determine when the use of military force is morally permissible and how it must be conducted. It requires the simultaneous satisfaction of conditions regarding the cause of the conflict, the authority of the leader, and the proportionality of the response to ensure the pursuit of a lasting peace."^^xsd:string ;
    skos:example "Assessing the proportionality of a counter-attack to ensure the resulting destruction does not exceed the good achieved by the defense."^^xsd:string,
        "Evaluating whether a specific military intervention meets the requirement of last resort after all diplomatic efforts have failed."^^xsd:string,
        "Mandating the absolute protection of non-combatants during an active siege of a contested city."^^xsd:string .

<RBZqFAgKcZ5EESijJoUuppE> a owl:Class ;
    rdfs:label "Theological Virtues" ;
    rdfs:subClassOf <Rgp2p1OFbXqI1lBJieonvK> ;
    skos:altLabel "Divinely Infused Virtues"^^xsd:string,
        "God-Oriented Virtues"^^xsd:string ;
    skos:definition "Theological Virtues are virtues infused by God that directly orient the human person toward God as the ultimate end. Theological Virtues enable participation in divine life by shaping belief, desire, and love according to grace rather than human effort alone."^^xsd:string ;
    skos:example "Theological virtues grow through cooperation with grace and sacramental life."^^xsd:string,
        "Theological virtues orient moral action toward eternal communion with God."^^xsd:string .

<RBbkOoA0Hp0UmEnkGJOjs6D> a owl:Class ;
    rdfs:label "Skin Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/8.00-Skin-Adult.htm> ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Cutaneous Disorders" ;
    skos:definition "Skin disorders encompass a range of conditions affecting the skin's structure and function, including inflammatory, infectious, and neoplastic diseases. These disorders can cause symptoms such as rashes, lesions, and systemic effects that impair the skin's ability to protect the body." ;
    skos:prefLabel "Dermatological Disorders" .

<RBc5RGWuFjIluthibNwahF6> a owl:Class ;
    rdfs:label "Telecommunications Industry" ;
    dc:identifier "INF-TELE" ;
    rdfs:subClassOf <RHwCmZ2yKrJobzC86GC6Ep> ;
    skos:altLabel "Telecommunications",
        "Telekommunikationsbranche"@de-de,
        "Telecommunications Industry"@en-gb,
        "Industria de las Telecomunicaciones"@es-es,
        "Industria de las Telecomunicaciones"@es-mx,
        "Industrie des télécommunications"@fr-fr,
        "תעשיית הטלקומוניקציות"@he-il,
        "दूरसंचार उद्योग"@hi-in,
        "通信産業"@ja-jp,
        "Indústria de telecomunicações"@pt-br,
        "电信行业"@zh-cn ;
    skos:definition "Industries in this group provide telecommunications and the services related to that activity (e.g., telephony, including Voice over Internet Protocol (VoIP); cable and satellite television distribution services; Internet access; telecommunications reselling services). The group is primarily engaged in operating, and/or providing access to facilities for the transmission of voice, data, text, sound, and video." ;
    skos:hiddenLabel "TELE" .

<RBe8WASOOp24Pw0SKparbSV> a owl:Class ;
    rdfs:label "Student Visa" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDeZlellOVEkUBkTSbLgxUC> ],
        <RD1oQDMlC6FytjOndhJTMy8>,
        <Rj8CP6YnshKY7MmCXaiuY1> ;
    skos:altLabel "F-1 Visa"@en-us ;
    skos:definition "A Student Visa is a type of visa issued to foreign nationals who wish to enter a country for the purpose of pursuing academic studies at an accredited educational institution. The visa typically stipulates conditions such as the level of study, the duration of the course, and sometimes even the specific institution the student must attend, and it generally does not permit the holder to engage in full-time employment." .

<RBfgMJEBmJrI7Wp0zUjROJ3> a owl:Class ;
    rdfs:label "Temporary Employee" ;
    rdfs:subClassOf <RBY4j5UKZ7L8gp0q9Wrxyge> ;
    skos:definition "A Temporary Employee is an individual hired for a specific, limited period, often to assist with seasonal workloads or to fill in for a regular employee who is absent. Temporary employees may or may not have access to company benefits, and their employment is generally terminated when the specified period or project is completed." .

<RBgKnOpRzmN0EAjwIwILJoc> a owl:Class ;
    rdfs:label "Elements of Criminal Claim" ;
    rdfs:subClassOf <RDspRIwoJTlopUDjSgLRduf> ;
    skos:altLabel "Elemente des Strafanspruchs"@de-de,
        "Elements of Criminal Claim"@en-gb,
        "Elementos de la Demanda Penal"@es-es,
        "Elementos de la Demanda Penal"@es-mx,
        "Éléments de la demande pénale"@fr-fr,
        "אלמנטים של תביעה פלילית"@he-il,
        "आपराधिक दावे के तत्व"@hi-in,
        "刑事請求の要素"@ja-jp,
        "Elementos da ação penal"@pt-br,
        "刑事索赔要素"@zh-cn ;
    skos:definition "The Elements of Criminal Claim refer to the specific components that must be proven in a criminal case, including the harm caused, the intent of the accused, and the causal link between the two." .

<RBhkx3dQ6MLH4RmvBj4nBaz> a owl:Class ;
    rdfs:label "Whistleblower's Claims" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCB1peNZ9PAXPle3bpVvvBe> ],
        <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Whistleblower Claims",
        "Hinweisgeberansprüche"@de-de,
        "Whistleblower's Claims"@en-gb,
        "Reclamaciones del denunciante"@es-es,
        "Reclamaciones del informante"@es-mx,
        "Revendications des lanceurs d'alerte"@fr-fr,
        "תביעות הסועדים"@he-il,
        "व्हिसलब्लोअर के दावे"@hi-in,
        "告発者の請求"@ja-jp,
        "Reivindicações de denunciantes"@pt-br,
        "举报者的索赔"@zh-cn ;
    skos:definition "A Whistleblower's Claim is a legal action brought by an individual who reports illegal or unethical activities within an organization, seeking protection from retaliation and potentially receiving a portion of any resulting financial penalties." .

<RBhy5xMH5J79KIvhUTDqn5C> a owl:Class ;
    rdfs:label "Visa for Intermittent Intra-Company Transferee" ;
    rdfs:subClassOf <RD1oQDMlC6FytjOndhJTMy8> ;
    skos:altLabel "L-1A Visa" ;
    skos:definition "Visas for intermittent intra-company transferees (in the United States, L-1A Visa) is designed for managers, executives, or specialized knowledge employees who need to travel back and forth between affiliated companies in their home country and the destination country (e.g., U.S.). In the United States, the intermittent L-1 allows the individual to stay in the U.S. for shorter periods without affecting the maximum allowable period of stay, which is typically seven years for L-1A visas and five years for L-1B visas" .

<RBi5nYq1khAzzGeY5YZ10ya> a owl:Class ;
    rdfs:label "Leave-Related Claims" ;
    rdfs:subClassOf <R8TmxqBbWaNgdm0lJQdY6D4> ;
    skos:altLabel "Leave Claims",
        "Ansprüche im Zusammenhang mit Urlaub"@de-de,
        "Leave-Related Claims"@en-gb,
        "Reclamaciones relacionadas con permisos"@es-es,
        "Reclamaciones relacionadas con licencias"@es-mx,
        "Réclamations liées aux congés"@fr-fr,
        "תביעות הקשורות לחופשה"@he-il,
        "छुट्टी संबंधी दावे"@hi-in,
        "休暇関連請求"@ja-jp,
        "Reivindicações relacionadas a licenças"@pt-br,
        "与休假有关的索赔"@zh-cn ;
    skos:definition "Leave-related claims are legal actions initiated by an employee against their employer for not complying with applicable laws or the terms of an employment agreement regarding various types of leave, such as medical leave, family leave, or military leave. These claims can involve issues such as denial of leave, interference with the employee's right to take leave, or retaliation against the employee for taking leave. Employees may also bring leave-related claims if their employer fails to provide required notice or fails to provide benefits or protections required by law during the leave period." .

<RBkuFhzhFcv5vcQJU7NSntY> a owl:Class ;
    rdfs:label "Advance Directive" ;
    rdfs:subClassOf <RB4GQZ26zq1PJ9m6vGUuoiy> ;
    skos:definition "This is a broad term that refers to any document in which a person specifies what actions should be taken for their health if they are no longer able to make decisions for themselves because of illness or incapacity. An advance directive can include a variety of instructions about future medical care and can encompass several types of directives, including the living will and durable power of attorney for health care" .

<RBlWM6X0yqMrb4z4JQYaEP2> a owl:Class ;
    rdfs:label "6th Amendment Claim" ;
    rdfs:subClassOf <R7MGQ9xUx0PxGLp5yxprdpZ> ;
    skos:altLabel "Anspruch auf den 6. Zusatzartikel"@de-de,
        "6th Amendment Claim"@en-gb,
        "Reclamo de la Sexta Enmienda"@es-es,
        "Reclamo de la Sexta Enmienda"@es-mx,
        "Réclamation au titre du 6ème amendement"@fr-fr,
        "תביעת התיקון השישי"@he-il,
        "6 वीं संशोधन दावा"@hi-in,
        "第6修正案の主張"@ja-jp,
        "Reivindicação da 6ª Emenda"@pt-br,
        "第六修正案索赔"@zh-cn ;
    skos:definition "A Sixth Amendment claim is a legal assertion made by a defendant in a criminal case, arguing that their constitutional right to a fair trial, as guaranteed by the Sixth Amendment of the United States Constitution, has been violated. Such a claim may involve issues related to the right to counsel, the right to a speedy and public trial, the right to an impartial jury, or the right to be informed of the nature and cause of the accusation, among others." ;
    skos:prefLabel "Sixth Amendment Claim" .

<RBt6PLnwAaeJLOUww0swcdQ> a owl:Class ;
    rdfs:label "Manslaughter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7Ttdyo4FsvaupPKT35Qry0> ],
        <RBzrK4RsgfLScZvC4Z4lCCX> ;
    skos:altLabel "Totschlag"@de-de,
        "Homicide involontaire"@fr-fr,
        "過失致死"@ja-jp,
        "Homicídio culposo"@pt-br,
        "过失杀人"@zh-cn ;
    skos:definition "The unlawful killing of a human being without malice aforethought, but with either intent to cause harm or reckless disregard for human life." .

<RBtf1nxagk3C03uC0micRM9> a owl:Class ;
    rdfs:label "Funeral Practices" ;
    rdfs:subClassOf <R8lhhP1c4Hm9RruhEpWMrJW> ;
    skos:altLabel "Funeral Rites",
        "Mortuary Practices" ;
    skos:definition "Funeral Practices are the various rituals, ceremonies, and customs performed to honor and remember a deceased person. These practices vary greatly across different cultures, religions, and legal systems, often reflecting the beliefs and traditions of the community." ;
    skos:prefLabel "Death Rites" .

<RBvXYVuffq7XXEmGpCJ0vCx> a owl:Class ;
    rdfs:label "Truck Transportation Industry" ;
    dc:identifier "TRA-TRUK" ;
    rdfs:subClassOf <RUE4fCCSnGX1wIK324EyiL> ;
    skos:altLabel "Truck Transportation",
        "LKW-Transportindustrie"@de-de,
        "Truck Transportation Industry"@en-gb,
        "Industria del transporte de camiones"@es-es,
        "Industria del transporte de camiones"@es-mx,
        "Industrie du transport de camions"@fr-fr,
        "תעשיית הובלת משאיות"@he-il,
        "ट्रक परिवहन उद्योग"@hi-in,
        "トラック輸送業界"@ja-jp,
        "Indústria de transporte de caminhões"@pt-br,
        "卡车运输行业"@zh-cn ;
    skos:definition "Industries in this group provide over-the-road transportation of cargo using motor vehicles, such as trucks and tractor-trailers. This group includes general freight trucking and specialized freight trucking." ;
    skos:hiddenLabel "TRUK" .

<RByl0iNSHBNmfLanOSBWLSx> a owl:Class ;
    rdfs:label "Recurrent Use and Permission Tax Payment" ;
    rdfs:subClassOf <RObTyeuV6yxdWyj5mj108e> ;
    skos:altLabel "Fixed Interval Use Tax",
        "License Tax Payment",
        "Periodic Use Tax Payment",
        "Recurrent Utilization Tax Payment",
        "Recurrent taxes",
        "Regular Permission Fee Payment",
        "Regular Permission Tax Payment" ;
    skos:definition "Recurrent Use and Permission Tax Payment refers to taxes levied at regular intervals, usually as fixed amounts, for the use of goods or permission to use goods or perform activities. This category includes vehicle license taxes, as well as taxes on permission to hunt, shoot, fish, sell certain products, own dogs, broadcast license fees, and taxes on performing certain services." .

<RC162PeqaXFH2TskW9BwkAX> a owl:Class ;
    rdfs:label "Textile Mills Industry" ;
    dc:identifier "MFG-TXAP" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=313> ;
    rdfs:subClassOf <RBOjgvcq6Z33XxMhTxWiiDS> ;
    skos:altLabel "Textile and Apparel Manufacturing",
        "Textil- und Bekleidungsherstellungsindustrie"@de-de,
        "Textile and Apparel Manufacturing Industry"@en-gb,
        "Industria de fabricación de textiles y prendas de vestir"@es-es,
        "Industria de fabricación de textiles y prendas de vestir"@es-mx,
        "Industrie de la fabrication textile et vestimentaire"@fr-fr,
        "תעשיית ייצור בדים וביגוד"@he-il,
        "टेक्सटाइल और वस्त्र उत्पादन उद्योग"@hi-in,
        "繊維・衣服製造業"@ja-jp,
        "Indústria de fabricação têxtil e de vestuário"@pt-br,
        "纺织和服装制造业"@zh-cn ;
    skos:definition """Industries in the Textile Mills subsector group establishments that transform a basic fiber (natural or synthetic) into a product, such as yarn or fabric that is further manufactured into usable items, such as apparel, sheets, towels, and textile bags for individual or industrial consumption.  The further manufacturing may be performed in the same establishment and classified in this subsector, or it may be performed at a separate establishment and be classified elsewhere in the Manufacturing sector.

The main processes in this subsector include preparation and spinning of fiber, knitting or weaving of fabric, and the finishing of the textile.  The NAICS structure follows and captures this process flow.  Major industries in this flow, such as preparation of fibers, weaving of fabric, knitting of fabric, and fiber and fabric finishing, are uniquely identified.  Texturizing, throwing, twisting, and winding of yarn contain aspects of both fiber preparation and fiber finishing and are classified with preparation of fibers rather than with finishing of fibers.

NAICS separates the manufacturing of primary textiles and the manufacturing of textile products (except apparel) produced from purchased primary textiles, such as fabric.  The manufacturing of textile products (except apparel) from purchased fabric is classified in Subsector 314, Textile Product Mills, and apparel from purchased fabric is classified in Subsector 315, Apparel Manufacturing.

Excluded from this subsector are establishments that weave or knit fabric and make garments.  These establishments are included in Subsector 315, Apparel Manufacturing.""" ;
    skos:hiddenLabel "TXAP" .

<RC1RuXMxvyeWXk4LhcJIxIu> a owl:Class ;
    rdfs:label "Labor and Employment Law Regulatory Objectives" ;
    rdfs:subClassOf <RCDwLiS22z6MzQaQHS08hvk> ;
    skos:definition "Labor and Employment Law Regulatory Objectives encompass the fundamental principles and considerations surrounding labor and employment law." .

<RC5149hM9Fi4iI1O8qYvP31> a owl:Class ;
    rdfs:label "Employer-Sponsored Retirement Account" ;
    rdfs:subClassOf <RC6vjtn3GZLRw0qRl5YjMwV> ;
    skos:definition "An employer-sponsored retirement account is a retirement savings plan offered by an employer to its employees as part of their employee benefits package. Examples include 401(k) plans in the United States. These accounts allow employees to contribute a portion of their salary, often with employer matching contributions, to be invested for retirement, providing tax advantages and financial security in later years" .

<RC6aqtaoqNvoQggYxN1RQKg> a owl:Class ;
    rdfs:label "Visa for Heads of State, Country Leaders, Ambassadors, and Consuls" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RPOTUgLxDXoTM1Sg444hsM> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9HlxYOQb4WGC3goxZENvJs> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RZJZNdSy3FUyGbADv9IdRF> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBPeXt0dsiWqYS2ICgfvplu> ],
        <RDeH9slXtJOmFPiZhIzsDUg> ;
    skos:definition "A visa for heads of state, country leaders, ambassadors, and consuls is a specific category of diplomatic visa granted to high-ranking officials for the purpose of conducting official state business in a foreign country. These visas usually afford the holder special privileges and immunities under international law, such as exemption from certain immigration controls and sometimes even legal jurisdiction, to facilitate their diplomatic activities.",
        "A-1 Visa"@en-us .

<RC6b9qx6IeaqNoLfaLBJCwU> a owl:Class ;
    rdfs:label "Educational Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDeZlellOVEkUBkTSbLgxUC> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9s52tqrUPXtmrK5etr13n5> ],
        <RcUv6cuttcRWxmaQw6M1N4> ;
    skos:definition "Educational rights refer to the legal entitlements that guarantee individuals access to education, often focusing on equality of opportunity, non-discrimination, and the right to a basic education. These rights are commonly upheld by national laws and international treaties, such as the Universal Declaration of Human Rights, which emphasizes the importance of education for full human development." .

<RCAB15957188722B6fc98458> a owl:Class ;
    rdfs:label "São Tomé and Príncipe" ;
    dc:identifier "AFR-ST" ;
    rdfs:subClassOf <R712935EF6d6a33B83e501b7> ;
    skos:hiddenLabel "ST" ;
    skos:prefLabel "Sao Tome and Principe" .

<RCC4113C641530CE597A413d> a owl:Class ;
    rdfs:label "Connecticut" ;
    dc:identifier "NAM-US-US+CT" ;
    rdfs:subClassOf <R1E70ce4D699e90144cB32b8> ;
    skos:hiddenLabel "US+CT" ;
    skos:prefLabel "Connecticut" .

<RCCv5YLoHUOm5AlqcCBzqGf> a owl:Class ;
    rdfs:label "Legal Damages"^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8Jf4dr3IkvxQZBbs7AlZBg> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RuDAbRiNW105SQoqb1XZ4c> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RsJ6DupkWKlUlCHH0Ycxvp> ],
        <RDspRIwoJTlopUDjSgLRduf> ;
    skos:altLabel "Harm",
        "Schadensersatz"@de-de,
        "Damages"@en-gb,
        "Daños y perjuicios"@es-es,
        "Daños y perjuicios"@es-mx,
        "Dommages et intérêts"@fr-fr,
        "פיצויים"@he-il,
        "नुकसान"@hi-in,
        "損害賠償"@ja-jp,
        "Danos e prejuízos"@pt-br,
        "损害赔偿"@zh-cn ;
    skos:definition "Monetary compensation sought or awarded by a party as a result of harm or loss caused by another party, which is a specific element of a legal claim." .

<RCG4QF2vhgY9jI81Z8dII42> a owl:Class ;
    rdfs:label "Freedom of Speech" ;
    rdfs:subClassOf <R7UZkDXz7Wg2AtyHFQEeySC>,
        <RBJlYzE4ZY14dTEghzbbMHg> ;
    skos:altLabel "Anspruch auf Meinungsfreiheit"@de-de,
        "Freedom of Speech Claim"@en-gb,
        "Reclamo de Libertad de Expresión"@es-es,
        "Reclamo de Libertad de Expresión"@es-mx,
        "Revendication de la liberté d'expression"@fr-fr,
        "תביעת חופש הביטוי"@he-il,
        "वाणी की स्वतंत्रता का दावा"@hi-in,
        "言論の自由主張"@ja-jp,
        "Reivindicação da liberdade de expressão"@pt-br,
        "言论自由主张"@zh-cn ;
    skos:definition "A freedom of speech claim is a legal action initiated by an individual or entity alleging that their right to freedom of speech, as protected by the law (e.g., First Amendment of the United States Constitution), has been violated by the government or a government actor. The freedom of speech guarantees that the government shall not abridge the freedom of speech, which includes the right to express opinions, ideas, and beliefs without censorship or restraint. A freedom of speech claim may arise in various contexts, such as when a government body enacts a law or regulation that unduly restricts speech, when a public employee is disciplined for exercising their speech rights, or when a public forum is improperly restricted." ;
    skos:prefLabel "Freedom of Expression" .

<RCJC86Ng8OLL0uVSv8HxhwB> a owl:Class ;
    rdfs:label "Food and Beverage Retailers Industry" ;
    dc:identifier "RET-FBVS" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=445> ;
    rdfs:subClassOf <RDfdmGR6iPi4k2t6ecIUBkP> ;
    skos:altLabel "Food and Beverage Stores",
        "Lebensmittel- und Getränkegeschäftsbranche"@de-de,
        "Food and Beverage Store Industry"@en-gb,
        "Industria de tiendas de alimentos y bebidas"@es-es,
        "Industria de tiendas de alimentos y bebidas"@es-mx,
        "Industrie des magasins d'alimentation et de boissons"@fr-fr,
        "תעשיית חנויות מזון ומשקאות"@he-il,
        "खाद्य और पेय स्टोर उद्योग"@hi-in,
        "食品・飲料店業界"@ja-jp,
        "Indústria de lojas de alimentos e bebidas"@pt-br,
        "食品和饮料商店行业"@zh-cn ;
    skos:definition "Industries in the Food and Beverage Retailers subsector primarily retail general or specialized lines of food and beverage products.  Establishments in this subsector with fixed point-of-sale locations have special equipment (e.g., freezers, refrigerated display cases, refrigerators) for displaying food and beverage products and have staff trained in the processing of food products to guarantee the proper storage and sanitary conditions required by regulatory authority.  Vending machine operators are also included in this subsector." ;
    skos:hiddenLabel "FBVS" .

<RCJn3atbap7QaYJjysSsJ1P> a owl:Class ;
    rdfs:label "Accommodation Industry" ;
    dc:identifier "AFS-ACCM" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=721> ;
    rdfs:subClassOf <RDeR0053Q1cPSk9hSjORcBT> ;
    skos:altLabel "Accommodation and Hospitality",
        "Unterkunfts- und Gastgewerbebranche"@de-de,
        "Accommodation and Hospitality Industry"@en-gb,
        "Industria de Alojamiento y Hospitalidad"@es-es,
        "Industria de Hospedaje y Hospitalidad"@es-mx,
        "Industrie de l'hébergement et de l'hospitalité"@fr-fr,
        "תעשיית אירוח ואירופה"@he-il,
        "आवास और आतिथ्य उद्योग"@hi-in,
        "宿泊・ホスピタリティ産業"@ja-jp,
        "Indústria de Acomodação e Hospitalidade"@pt-br,
        "住宿和餐饮行业"@zh-cn ;
    skos:definition """Industries in the Accommodation subsector provide lodging or short-term accommodations for travelers, vacationers, and others.  There is a wide range of establishments in these industries.  Some provide lodging only, while others provide meals, laundry services, and recreational facilities, as well as lodging.  Lodging establishments are classified in this subsector even if the provision of complementary services generates more revenue.  The types of complementary services provided vary from establishment to establishment.

The subsector is organized into three groups: (1) traveler accommodation, (2) recreational accommodation, and (3) rooming and boarding houses, dormitories, and workers' camps.  The Traveler Accommodation industry group includes establishments that primarily provide traditional types of lodging services.  This group includes hotels, motels, and bed-and-breakfast inns.  In addition to lodging, these establishments may provide a range of other services to their guests.  The RV (Recreational Vehicle) Parks and Recreational Camps industry group includes establishments that operate lodging facilities primarily designed to accommodate outdoor enthusiasts.  Included are travel trailer campsites, recreational vehicle parks, and outdoor adventure retreats.  The Rooming and Boarding Houses, Dormitories, and Workers' Camps industry group includes establishments providing temporary or longer-term accommodations, that for the period of occupancy, may serve as a principal residence.  Board (i.e., meals) may be provided but is not essential.

Establishments that manage short-stay accommodation establishments (e.g., hotels and motels) on a contractual basis are classified in this subsector if they both manage the operation and provide the operating staff.  Such establishments are classified based on the type of facility managed and operated.""" ;
    skos:hiddenLabel "ACCM" .

<RCKyQq2d2O4kCcP6LbXtuCz> a owl:Class ;
    rdfs:label "Economic Rights" ;
    rdfs:subClassOf <R0TZk2qCI4HPwDl3e9FoOo> ;
    skos:definition "Economic rights refer to the entitlements that enable individuals to achieve a basic standard of living, such as the rights to work, receive a fair wage, and have access to essential social services like healthcare and education. These rights are often articulated in international treaties and may be protected to varying degrees by national laws." .

