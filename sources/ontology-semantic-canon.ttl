    skos:definition "The concept of \"Case Reactivated\" refers to a legal matter that was previously closed or pending, but has now been reopened or resumed." .

<RtOq2czQgfEjteQJAuxCW2> a owl:Class ;
    rdfs:label "Pennsylvania Court of Common Pleas -  Huntingdon County" ;
    rdfs:subClassOf <Rzg8mCIjXsMzEVnQwCTKIi> ;
    skos:definition "The Pennsylvania Court of Common Pleas - Huntingdon County is a specific court within the Pennsylvania Court of Common Pleas system, which is responsible for administering legal proceedings in Huntingdon County, Pennsylvania." .

<RtPWt1rGWs8PIV1fdPuOso> a owl:Class ;
    rdfs:label "Authoritative Doctrinal Teaching" ;
    rdfs:subClassOf <RCq8YWUS1BXn0VEMPqX9g4i> ;
    skos:altLabel "Authentic Doctrinal Teaching"^^xsd:string,
        "Authoritative Teaching"^^xsd:string,
        "Non-Definitive Doctrinal Teaching"^^xsd:string,
        "Ordinary Doctrinal Teaching"^^xsd:string ;
    skos:definition "Authoritative Doctrinal Teaching is a teaching on faith or morals proposed by the Church’s Magisterium with real authority but without definitive or infallible definition. It guides belief and reasoning and calls for religious submission of intellect and will."^^xsd:string .

<RtPbEtPqxdrCGQCE1mOuAX> a owl:NamedIndividual,
        <R7ju2C0HxoDqBL5XSpENfiR> ;
    rdfs:label "John 1:14" .

<RtQPFGzyCrviDEdzt0atY5> a owl:Class ;
    rdfs:label "Dzongkha" ;
    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Dzongkha"@de-de,
        "Dzongkha"@fr-fr,
        "ゾンカ語"@ja-jp,
        "Dzongkha"@pt-br,
        "宗喀语"@zh-cn ;
    skos:definition "Dzongkha is a written or spoken structured system of communication that is the official language of Bhutan." .

<RtVEoiPl048ZfSUppj1Cy2> a owl:Class ;
    rdfs:label "Bonded Labor Claim" ;
    rdfs:subClassOf <RDOQpX5t5sVf55UPK2CfZTy> ;
    skos:definition "A bonded labor claim alleges that an individual is forced to work under a debt or other obligation that they cannot repay and that limits their freedom. This practice is a form of modern-day slavery and is illegal under international law and in many national jurisdictions." .

<RtYoJXrPiwPxepfYK3gpd6> a owl:Class ;
    rdfs:label "Sjögren’s Syndrome" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_00D7>,
        <https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_10> ;
    rdfs:subClassOf <RBJ0dgV4Z2Xk7aGfJt2nSj7> ;
    skos:altLabel "Sicca Syndrome",
        "Sjögren's Disease" ;
    skos:definition "Sjögren's syndrome is an immune-mediated disorder of the exocrine glands. Involvement of the lacrimal and salivary glands is the hallmark feature, resulting in symptoms of dry eyes and dry mouth, and possible complications, such as corneal damage, blepharitis (eyelid inflammation), dysphagia (difficulty in swallowing), dental caries, and the inability to speak for extended periods of time. Involvement of the exocrine glands of the upper airways may result in persistent dry cough." .

<RtcZ2CKpIshtXjBITHbFuY> a owl:Class ;
    rdfs:label "Pedi; Sepedi; Northern Sotho" ;
    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Pedi; Sepedi; Nord-Sotho"@de-de,
        "Pedi; Sepedi; Sotho du Nord"@fr-fr,
        "ペディ語; セペディ語; 北ソト語"@ja-jp,
        "Pedi; Sepedi; Sotho do Norte"@pt-br,
        "佩迪语; 塞彭迪语; 北索托语"@zh-cn ;
    skos:definition "African language spoken in South Africa, belonging to the Bantu language family and specifically to the Sotho-Tswana group." .

<Rtcn744oelK5y1pAR0epCQ> a owl:ObjectProperty ;
    rdfs:label "folio:rejected" ;
    rdfs:domain <RDSYPGgBlFz5eWNtwoMA2c5> ;
    rdfs:range <RNICD9MDcFQJJX6nxX11Vt> ;
    rdfs:subPropertyOf <RdpSPh3bFHYrQ3vYPDwJYB> ;
    skos:altLabel "rejected" ;
    skos:definition "In legal proceedings, \"rejected\" refers to the decision of an authority (judicial, arbitral, administrative) to not accept an argument, testimony, evidence, document, or claim presented. This implies that the presented material is deemed unpersuasive, insufficient, irrelevant, or inadmissible under legal standards or specific case requirements." ;
    skos:example "Judge rejected argument" .

<RtdKpTDpiZa6z0RYYz0xA8> a owl:Class ;
    rdfs:label "Chappaquiddick Tribe of the Wampanoag Indian Nation" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<RthkEiKYxt3o1thUAdbzh7> a owl:Class ;
    rdfs:label "Reserved Power Clause Claim" ;
    rdfs:subClassOf <RB0OjYiZ6X1hMIZOMK1KqhB> ;
    skos:altLabel "Anspruch auf Vorbehaltsrechtsklausel"@de-de,
        "Reserved Power Clause Claim"@en-gb,
        "Reclamación de Cláusula de Poder Reservado"@es-es,
        "Reclamación de Cláusula de Poder Reservado"@es-mx,
        "Revendication de clause de pouvoir réservé"@fr-fr,
        "תביעת סעיף כוח מורשה מראש"@he-il,
        "रिजर्व्ड पावर क्लॉज क्लेम"@hi-in,
        "留保権条項クレーム"@ja-jp,
        "Reivindicação de cláusula de poder reservado"@pt-br,
        "保留权条款索赔"@zh-cn ;
    skos:definition "A Reserved Power Clause claim is a legal assertion related to the Tenth Amendment of the United States Constitution, which reserves to the states or the people any powers not specifically delegated to the federal government or prohibited to the states by the Constitution. This clause forms the basis of federalism, the division of power between the federal government and the states. A claim involving this clause typically arises when there is a dispute over whether a power exercised by the federal government infringes on powers reserved to the states or the people." .

<Rtjwn5Ob3Rl2crwYF1IFZl> a owl:Class ;
    rdfs:label "Definition" ;
    rdfs:subClassOf <RB3kSReNB4kis0pHfnZeHCa> ;
    skos:altLabel "Concept Definition"^^xsd:string,
        "Doctrinal Definition"^^xsd:string,
        "Dogmatic Definition"^^xsd:string,
        "Magisterial Definition"^^xsd:string,
        "Meaning Statement"^^xsd:string,
        "Operational Definition"^^xsd:string,
        "Stipulative Definition"^^xsd:string,
        "Term Definition"^^xsd:string ;
    skos:definition "A Definition is a statement that fixes a term’s meaning so speakers share the same concept when they use the term. In Catholic theology and magisterial teaching, definitions often function to clarify doctrine, distinguish errors, and specify how a term applies in faith and morals."^^xsd:string ;
    skos:example "Definition clarifies “transubstantiation” as a change of substance, not a change of appearances."^^xsd:string .

<Rtlb0g8ixWZV3HQygRlqzy> a owl:Class ;
    rdfs:label "County Governmental Representative" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R787C07azf3BxNqxCxSvBxc> ],
        <R85Datx36zz4sBBoEYxCByw> ;
    skos:altLabel "District Representative",
        "Sub-National Territory Representative" ;
    skos:definition "A County Governmental Representative is an elected or appointed official who serves in a governmental body overseeing an area larger than a municipality but smaller than a state or province. This individual is responsible for policy-making, budget allocation, and administration of services for a specific region, such as a county, district, or prefecture." ;
    skos:prefLabel "County Official" .

<RtoqwGhjnspOeVmvIXfmF0> a owl:Class ;
    rdfs:label "Parathyroid Gland Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/9.00-Endocrine-Adult.htm> ;
    rdfs:subClassOf <RDu2iPpQAdciNSirAd52mw4> ;
    skos:definition "Parathyroid gland disorders affect the regulation of calcium levels in the body, influencing bone health, blood calcium levels, and nerve and muscle function. These disorders can lead to osteoporosis, fractures, hypercalcemia, kidney failure, and hypocalcemia with associated symptoms such as tetany and muscle spasms." ;
    skos:prefLabel "Parathyroid Dysfunction" .

<Rtyq22ozVXJsU1wS8jDeDV> a owl:Class ;
    rdfs:label "Pennsylvania Magisterial District Court - Adams County" ;
    rdfs:subClassOf <R70IGZ5XRTshj1E64tVcxJD> ;
    skos:definition "A Pennsylvania Magisterial District Court in Adams County is a specific court within the Pennsylvania Magisterial District Court system that has jurisdiction over minor criminal offenses and civil cases." .

<Ru41sI42cmsEoPZNzlCVbW> a owl:Class ;
    rdfs:label "Peppers" ;
    rdfs:subClassOf <RCIv9j8UdKC0YVPrbl5EGRq> ;
    skos:altLabel "Capsicum" ;
    skos:definition "Peppers are fruit vegetables from the Capsicum genus, known for their diverse flavors ranging from sweet to spicy. They are used in a wide array of culinary applications, valued for their vibrant colors, unique flavors, and nutritional benefits, including vitamins A and C and antioxidants." ;
    skos:example "Bell Peppers",
        "Chili Peppers" .

<Ru5e8wEFd8LO47PKMYs9mP> a owl:Class ;
    rdfs:label "Seminole Tribe of Florida" ;
    rdfs:subClassOf <RC1ceWXE3emNHpYlrOvvmxG> .

<RuBd7UIXBNWTIC6Dr67bz7> a owl:Class ;
    rdfs:label "Minnesota District Court - Blue Earth County" ;
    rdfs:subClassOf <RxLV9XEaDWbDIA8N1fl2fM> ;
    skos:definition "Minnesota District Court - Blue Earth County: A specific court within the Minnesota District Court system located in Blue Earth County." .

<RuFa1wrcj6X39EQTjEVAxY> a owl:Class ;
    rdfs:label "Cerebral Palsy" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_07> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH> ;
    skos:altLabel "CP" ;
    skos:definition "Cerebral Palsy (CP) is a group of neurological disorders that affect movement, muscle tone, and posture, caused by damage to the developing brain either during pregnancy, childbirth, or shortly after birth. This condition leads to varying degrees of motor impairment and may also impact speech, vision, and cognitive abilities." .

<RuGrZGUFfiswzSZww3VhH2> a owl:Class ;
    rdfs:label "Intestate Status" ;
    rdfs:subClassOf <R3SDQBy4KfjSgp3bgpb4Fx> ;
    skos:altLabel "gesetzlicher Erbfolge"@de-de,
        "Intestate Status"@en-gb,
        "Estado Intestado"@es-es,
        "Estado Intestado"@es-mx,
        "statut d'héritier légal"@fr-fr,
        "מצב חסר צוואה"@he-il,
        "अधिविरासत स्थिति"@hi-in,
        "法定相続人の地位"@ja-jp,
        "status de herdeiro legítimo"@pt-br,
        "无遗嘱继承人身份"@zh-cn ;
    skos:definition "The state of having died without a valid will or testamentary disposition of property, resulting in the distribution of the deceased's assets according to the laws of intestacy." ;
    skos:prefLabel "Intestacy" .

<RuIG2rEI5t49RfIVJsH0IX> a owl:Class ;
    rdfs:label "Demand Futility" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7eVYpVEsDqKqMUL2HL23Zr> ],
        <R9JkfZIjkVSa5ud1tJ14w3i> ;
    skos:altLabel "Nachfrageaussichtslosigkeit"@de-de,
        "Demand Futility"@en-gb,
        "Futilidad de la Demanda"@es-es,
        "Futilidad de la Demanda"@es-mx,
        "Futilité de la demande"@fr-fr,
        "פסולת דרישה"@he-il,
        "मांग निष्फलता"@hi-in,
        "需要の無効"@ja-jp,
        "Futilidade da demanda"@pt-br,
        "需求无效"@zh-cn ;
    skos:definition "Demand futility is a legal concept within corporate and partnership liability claims that allows shareholders to bring a lawsuit on behalf of the company without first making a demand on the board of directors if doing so would be futile." .

<RuIaD5fYCRAjAwwIFXEwT7> a owl:Class ;
    rdfs:label "Hail Mary" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RCA6zlBfTqVXfLM0xipUkZf>,
        <RyTfHxUQPVMUQrtIt1Mycz> ;
    skos:altLabel "Marian Salutation"^^xsd:string ;
    skos:definition "Hail Mary is a foundational Marian prayer that honors the Blessed Virgin Mary and asks for her intercession with God. It combines biblical salutations with a petition for Mary’s prayer now and at the hour of death."^^xsd:string ;
    skos:example "During the Rosary, each decade included ten recitations of the Hail Mary."^^xsd:string,
        """Hail Mary,
Full of Grace,
The Lord is with thee.
Blessed art thou among women,
and blessed is the fruit
of thy womb, Jesus.
Holy Mary,
Mother of God,
pray for us sinners now,
and at the hour of our death."""^^xsd:string,
        "In moments of fear, she quietly prayed the Hail Mary for comfort and help.e"^^xsd:string,
        "The catechist taught the Hail Mary by explaining its biblical origins in Luke’s Gospel."^^xsd:string ;
    skos:prefLabel "Ave Maria"^^xsd:string .

<RuJballS0a7fp0UeRUTFgF> a owl:Class ;
    rdfs:label "Animal Authorship" ;
    rdfs:subClassOf <R5NlX3MRKQ0Ispm4G4jHuT> ;
    skos:definition "Animal Authorship in copyright law addresses the concept of works created by animals, questioning whether such creations can qualify for copyright protection. It challenges traditional notions of authorship by considering the legal status and intellectual property rights of works produced by non-human beings." .

<RuTiqSJ76kL8qUWS8cae3Z> a owl:Class ;
    rdfs:label "Noncompete Agreement" ;
    rdfs:subClassOf <R9u4hHZJYFWdtdGcgkoqz1x> ;
    skos:altLabel "Wettbewerbsverbot-Vereinbarung"@de-de,
        "Noncompete Agreement"@en-gb,
        "Acuerdo de no competencia"@es-es,
        "Acuerdo de no competencia"@es-mx,
        "Accord de non-concurrence"@fr-fr,
        "הסכם לא להתחרות"@he-il,
        "गैर-प्रतिस्पर्धा समझौता"@hi-in,
        "ノンコンペティション契約"@ja-jp,
        "Acordo de não concorrência"@pt-br,
        "竞业禁止协议"@zh-cn ;
    skos:definition "A Noncompete Agreement is a legal contract between an employer and an employee that restricts the employee from working for a competitor or starting a competing business for a certain period of time after leaving the employer." .

<RuUfFKt7Gf9HuDRacohSji> a owl:Class ;
