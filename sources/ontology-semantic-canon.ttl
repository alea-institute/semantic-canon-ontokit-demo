    rdfs:subClassOf <RBGd796pNg5ltGWhkyk2ifm> ;
    skos:altLabel "MBS" ;
    skos:definition "Mortgage-Backed Securities (MBS) are investment vehicles that represent claims to the cash flows from pools of mortgage loans, primarily residential or commercial properties. Investors in MBS receive periodic payments derived from the principal and interest of the underlying mortgages, offering a means to invest in real estate without direct property ownership." ;
    skos:prefLabel "Securitized Mortgages" .

<RDH9WWZMu71xyUZdsXmQUwd> a owl:Class ;
