        "Concrete block laying",
        "Foundation (e.g., brick, block, stone), building, contractors",
        "Marble, granite, and slate, exterior, contractors",
        "Masonry pointing, cleaning, or caulking",
        "Stucco contractors" .

<DSxlUvfHT0awVZ78QeZIIw> a owl:Class ;
