    rdfs:subClassOf <D4AoLnSSTVqX1Cj--YM_3A> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in operating racetracks without casinos. These establishments may also present and/or promote the events, such as auto, dog, and horse races, held in these facilities." .

<jwXNIpjWQ1eV9LIogPUJ3w> a owl:Class ;
    rdfs:label "Farm Labor Contractors and Crew Leaders" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=115115> ;
    rdfs:subClassOf <a-WMSGfvSDCXHFqyHRYryg> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in supplying labor for agricultural production or harvesting." .

<k-5fQrhLS6ydE0yJrKrtLQ> a owl:Class ;
