<R7Noco0WzoPRAfLQ1iJkI2t> a owl:Class ;
    rdfs:label "International Traffic in Arms Regulations (ITAR) Claim" ;
    rdfs:subClassOf <RmiYQJshZzYvIsqEWLjj1x> ;
    skos:altLabel "Arms Export Control Claim",
        "Defense Export Violation Claim",
        "ITAR Claim",
        "ITAR Violation Claim" ;
    skos:definition "An ITAR Claim arises when an individual or entity violates the International Traffic in Arms Regulations, which control the export and import of defense-related articles and services. This claim involves allegations of unauthorized export, re-export, or transfer of defense articles or technical data to foreign nationals or countries." ;
    skos:prefLabel "International Arms Control Claim" .

<R7O4HXKi7dDm0Q2urKsQLoE> a owl:Class ;
    rdfs:label "Radio Broadcast" ;
    rdfs:subClassOf <R8mCB7w7tqtq6yOWvTxdMJI> ;
    skos:altLabel "Radio Broadcasting",
        "Radio Transmission" ;
    skos:definition "A Radio Broadcast is the transmission of audio content via radio waves to reach a wide audience, typically through AM or FM frequencies. This medium delivers a variety of programming such as news, music, talk shows, and advertisements, and can be received on radios, car stereos, and internet streaming platforms." .

<R7O7as1yRGQddK7A38HaPOM> a owl:Class ;
