<R3OI7nrib1LEPtUfn5G5CH> a owl:Class ;
    rdfs:label "Bequest" ;
    rdfs:subClassOf <R8M0UJWeEVpeK5gMPLTQSl2> ;
    skos:altLabel "Estate Gift",
        "Inheritance Gift",
        "Inherited Bequest",
        "Legacy",
        "Testamentary Gift" ;
    skos:definition "A Bequest is a provision in a will or trust that designates the transfer of specific assets, property, or money to a particular beneficiary upon the death of the testator. It ensures that the intended recipients receive the designated items as part of the estate distribution." .

<R3c06SBnWZwSBWdavz3I7w> a owl:Class ;
    rdfs:label "Religious Order Priest" ;
    rdfs:subClassOf <RBbuxyUe808Ck5B7a7kfDQJ> ;
    skos:altLabel "Consecrated Priest"^^xsd:string,
        "Priest of a Religious Institute"^^xsd:string,
        "Priest of a Religious Order"^^xsd:string,
        "Religious Priest"^^xsd:string ;
    skos:definition "A Religious Order Priest is a presbyter who belongs to a religious order or other institute of consecrated life and lives under its rule and superiors. He exercises priestly ministry while bound by public vows, typically poverty, chastity, and obedience."^^xsd:string ;
    skos:example "A Franciscan priest serves the poor according to his order’s charism."^^xsd:string,
        "A Jesuit priest teaches theology at a Catholic university."^^xsd:string,
        "Religious order priests live in community under a common rule."^^xsd:string .

