<R7IGCyvSNX5OQrqkt3IMwIW> a owl:Class ;
    rdfs:label "Scourging at the Pillar" ;
    rdfs:subClassOf <RD0JfBltrTwUJkeYjw8iN1P>,
        <RDxAHb6WWxvwiBtuiLOfgfr> ;
    skos:altLabel "Flagellation of Christ"^^xsd:string,
        "Whipping at the Pillar"^^xsd:string ;
    skos:definition "Scourging at the Pillar means the brutal flogging of Jesus Christ ordered by Pontius Pilate prior to his condemnation and crucifixion. Scourging at the Pillar manifests the physical suffering Christ endured and forms a central moment of the Passion."^^xsd:string ;
    skos:example "Christian devotion meditates on the scourging at the pillar as a sign of Christ’s redemptive suffering."^^xsd:string,
        """Pilate’s next move was to take Jesus and have Him scourged.
(John 19:1)"""^^xsd:string,
        "The Gospels recount that Jesus was scourged on Pilate’s order before his crucifixion."^^xsd:string ;
    skos:prefLabel "Scourging of Jesus"^^xsd:string .

