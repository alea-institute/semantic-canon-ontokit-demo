<RBRT3WWlDa3ChxzHyS9NLC1> a owl:Class ;
    rdfs:label "Health Care Provider" ;
    rdfs:subClassOf <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Healthcare Practitioner",
        "Medical Professional",
        "Medical Service Provider" ;
    skos:definition "A Health Care Provider is a professional or institution licensed to provide medical services, treatment, or advice to individuals seeking health care. This term encompasses a wide range of practitioners and organizations responsible for diagnosing, treating, and preventing illness, injury, and other physical and mental impairments in human beings." ;
    skos:prefLabel "Health Care Professional" .

<RBSftPgkpTWJ4IzuvXyLBVG> a owl:Class ;
    rdfs:label "Territorial Market Segment" ;
    rdfs:subClassOf <R7z0ey8ZMeOT1q01VNPe1HY> ;
    skos:definition "A territorial market segment refers to a group of consumers or businesses categorized based on the geographical boundaries or territories within which they operate. This segmentation allows companies to tailor their marketing strategies and product offerings to the specific characteristics and needs of different countries, regions, or localities." .

