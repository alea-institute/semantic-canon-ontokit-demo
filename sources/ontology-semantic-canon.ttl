    rdfs:subClassOf <ORutjCtpQPmjqs3X09E-0w> ;
    skos:definition "This industry comprises establishments primarily engaged in one or more of the following: (1) growing grapes and manufacturing wines and brandies; (2) manufacturing wines and brandies from grapes and other fruits grown elsewhere; and (3) blending wines and brandies." .

<cftRHyfuTyeZi6Y6W7viUw> a owl:Class ;
