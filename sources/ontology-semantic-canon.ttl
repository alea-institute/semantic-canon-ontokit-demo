<R7HlDH3l1T7iKYGoPjHUNAg> a owl:Class ;
    rdfs:label "Autonomous Vehicle" ;
    rdfs:subClassOf <R1okJKMvv4mMHv7m4TzwBe> ;
    skos:altLabel "Automated Vehicle",
        "CAV",
        "Connected and Automated Vehicle",
        "Driverless Car",
        "Robotic Car",
        "Self-Driving Vehicle" ;
    skos:definition "An autonomous or connected vehicle, also known as a self-driving or driverless car, is a vehicle equipped with technology that allows it to navigate and operate with varying levels of human intervention (Level 1 through Level 4), or no human intervention (Level 5). Such vehicles rely on sensors, cameras, and artificial intelligence to perceive their environment and make decisions based on pre-programmed algorithms and real-time data." ;
    skos:prefLabel "Connected Vehicle" .

<R7HlwcQADrgo84ZIri15fkJ> a owl:Class ;
    rdfs:label "Confession of the Centurion" ;
    rdfs:subClassOf <RBIF8SqULlcUju99hpRYHBh> ;
    skos:altLabel "Centurion’s Confession"^^xsd:string,
        "Centurion’s Testimony at the Cross"^^xsd:string,
        "Profession of Faith by the Centurion"^^xsd:string ;
    skos:definition "Confession of the Centurion means the declaration by the Roman centurion at the crucifixion acknowledging Jesus’ identity as the Son of God or as a righteous man. Confession of the Centurion serves as a climactic Gentile witness to Christ’s true identity at the moment of his death."^^xsd:string ;
    skos:example "Christian tradition highlights the centurion’s confession as the first explicit Gentile profession of faith in Christ."^^xsd:string,
        "The Gospel of Mark records the centurion declaring, “Truly this man was the Son of God,” at Jesus’ death."^^xsd:string .

<R7Hptj9DTqNSzTL1KiyNTgF> a owl:Class ;
    rdfs:label "Temptation of Jesus" ;
    rdfs:subClassOf <R9VpyiXQxLbATS2mPSOlbqT> ;
    skos:altLabel "Temptation in the Wilderness"^^xsd:string,
        "Testing of Jesus"^^xsd:string,
        "Wilderness Temptation"^^xsd:string ;
    skos:definition "Temptation of Jesus means the event in which Jesus Christ was tempted by the devil in the wilderness after his baptism. Temptation of Jesus reveals Christ’s obedience to the Father, his rejection of false messianic power, and his victory over Satan."^^xsd:string ;
    skos:example "Christian theology interprets the temptation of Jesus as his definitive rejection of sin and misuse of power."^^xsd:string,
        "First Temptation: Stones into Bread"^^xsd:string,
        "Ministry of Angels to Jesus"^^xsd:string,
        "Second Temptation: Testing God"^^xsd:string,
        "The Gospels recount Jesus fasting for forty days and resisting the devil’s temptations in the wilderness."^^xsd:string,
        "Third Temptation: Worship for Power"^^xsd:string .

