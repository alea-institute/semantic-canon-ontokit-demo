<RZSnKehA643O8824iC320g> a owl:ObjectProperty ;
    rdfs:label "folio:workedFor" ;
    rdfs:domain <R8CdMpOM0RmyrgCCvbpiLS0> ;
    rdfs:range <R7L5eLIzH0CpOUE74uJvSjL>,
        <R8CdMpOM0RmyrgCCvbpiLS0>,
        <RBjHwNNG2ASVmasLFU42otk> ;
    skos:altLabel "was employed by",
        "worked for" ;
    skos:definition "\"Worked For\" refers to the employment or professional relationship where an individual, such as a lawyer or paralegal, is engaged in duties or services for an entity like a court, a judge, or a law firm. This term encompasses the scope of professional activities undertaken by the individual under the employment or direction of the specified legal entity or employer." ;
    skos:example "Assistant Worked For Lawyer",
        "Lawyer Worked For Firm",
        "Lawyer Worked For Judge",
        "Lawyer Worked for Supreme Court",
        "Paralegal Worked For Firm" ;
    skos:prefLabel "folio:wasEmployedBy" .

<Rt7TTPXJ7WX1Jrjufs0Mdr> a owl:Class ;
    rdfs:label "Beneficiary" ;
    rdfs:subClassOf <R8VN5tK4TtD0GqDw2NCbaLr> ;
    skos:definition "A beneficiary is an individual or entity designated to receive benefits, assets, or proceeds from a legal matter, including those of an estate, trust, insurance policy, or other financial or legal instruments. The term is commonly used in legal and financial contexts to specify who will benefit from a particular financial arrangement or legal structure." .

<zsRJsDRFRTWise5EO9WWIA> a owl:Class ;
    rdfs:label "Grocery and Related Product Merchant Wholesalers" ;
