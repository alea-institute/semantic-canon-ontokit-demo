<RDTF4Q14uUSOvU9E2KVRzs4> a owl:Class ;
    rdfs:label "Inductive Conclusion" ;
    rdfs:subClassOf <RDb23xlWAzEOF0aEdM9iCGN> ;
    skos:altLabel "Evidential Conclusion"^^xsd:string,
        "Inductive Inference"^^xsd:string,
        "Probable Conclusion"^^xsd:string ;
    skos:definition "Inductive Conclusion is a conclusion that follows with probability rather than necessity from its premises. The premises make the conclusion reasonable or likely, but they do not guarantee its truth."^^xsd:string ;
    skos:example "Therefore, the early Church likely held this belief."^^xsd:string,
        "Therefore, the policy will probably harm vulnerable groups."^^xsd:string,
        "Therefore, this practice tends to undermine human dignity."^^xsd:string,
        "Therefore, this type of being is likely contingent."^^xsd:string .

