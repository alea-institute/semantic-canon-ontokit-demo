<REF19f8F7Fa9d700b934A25b> a owl:Class ;
    rdfs:label "Tennessee State Courts" ;
    dc:identifier "USCTS-STCOUS-TN" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:locatedIn ;
            owl:someValuesFrom <R71F6e4C735a8B11315C1cea> ],
        <R1F4dbe4CD17b3B2a7f15b97> ;
    skos:definition "Tennessee State Courts are the judicial system of the state of Tennessee, consisting of various courts such as the Tennessee Circuit Court, Tennessee Court of Criminal Appeals, Tennessee Court of Appeals, Tennessee Superior Court for Law and Equity, and Tennessee Supreme Court." ;
    skos:hiddenLabel "TN" ;
    skos:prefLabel "Tennessee State Courts" .

<REYZrQdidTmIiJf5n7mz2B> a owl:Class ;
    rdfs:label "New Testament Events" ;
    rdfs:subClassOf <R7TITXLXKEsSewVpYpMw3tL> ;
    skos:altLabel "New Covenant Events"^^xsd:string ;
    skos:definition "New Testament Events means events recorded in the New Testament that reveal the life, ministry, death, resurrection, and continuing action of Jesus Christ and the early Church. New Testament Events form the core narrative of Christian revelation and directly ground Catholic doctrine, liturgy, and ecclesial life."^^xsd:string ;
    skos:example "The Gospels describe Jesus’ baptism by John in the Jordan River."^^xsd:string,
        "The New Testament proclaims the resurrection of Jesus on the third day after his crucifixion."^^xsd:string .

<RF9A23e15C1cfD0540b8Afae> a owl:Class ;
