<RmHNUyUV6s6uKkoTx4nk1a> a owl:Class ;
    rdfs:label "Parental Authority" ;
    rdfs:subClassOf <R4BbNqGb3HJAUtTar6b1i> ;
    skos:altLabel "Maternal Authority"^^xsd:string,
        "Parental Rights and Duties"^^xsd:string,
        "Paternal Authority"^^xsd:string ;
    skos:definition "Parental Authority is the natural and moral authority parents possess to care for, educate, and direct their children toward integral human and Christian maturity. Parental Authority carries a grave duty to seek the child’s true good, forming conscience, virtue, and faith while respecting the child’s growing capacity for freedom."^^xsd:string ;
    skos:example "A mother and father teach their child to pray and participate in Sunday Mass."^^xsd:string,
        "Parents consent to medical treatment for their minor child after consulting physicians."^^xsd:string,
        "Parents decide which school best serves their child’s academic and moral formation."^^xsd:string,
        "Parents guide their teenager’s use of technology to protect dignity and foster virtue."^^xsd:string,
        "Parents set household rules that promote discipline, charity, and responsibility."^^xsd:string .

<RmKGgthC7edDxTiRIwoo0V> a owl:Class ;
