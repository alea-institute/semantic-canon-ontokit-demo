<R7ACBSxxPoxApfGBWXvaV0e> a owl:Class ;
    rdfs:label "Restorative Justice" ;
    rdfs:comment "In a global Catholic ontology, Restorative Justice shifts the focus from punitive retribution to the healing of victims, the accountability of offenders, and the restoration of communal peace. It aligns with the Church's emphasis on the dignity of the human person and the belief that justice should seek to \"repair the breach\" rather than merely inflict a penalty."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Ruy2YPvV0BMCjA7etGq56l> ],
        <R9X6xDAYYSYwCeCqMHt5G75> ;
    skos:altLabel "Community Reparation"^^xsd:string,
        "Holistic Justice"^^xsd:string,
        "Reparative Justice"^^xsd:string,
        "Transformative Justice"^^xsd:string,
        "Victim-Offender Mediation"^^xsd:string ;
    skos:definition "Restorative Justice is a framework of applied ethics that prioritizes the healing of harm caused by wrongdoing through a collaborative process involving victims, offenders, and the community. It seeks to achieve a lasting peace by addressing the root causes of conflict and facilitating the reparation of relationships in accordance with the principle of social charity."^^xsd:string ;
    skos:example "Facilitating a dialogue between conflicting families to reach a mutual agreement on restitution and future behavior."^^xsd:string,
        "Organizing a mediation session where an offender listens to the impact of their actions on a victim."^^xsd:string .

