<RB0yotXccy2yZOf5seVzcxB> a owl:Class ;
    rdfs:label "Parable of the Pearl of Great Price" ;
    rdfs:subClassOf <R9UCFdrDU3BruofWcw9xAr5> ;
    skos:altLabel "Pearl of Great Price Parable"^^xsd:string ;
    skos:definition "Parable of the Pearl of Great Price means the teaching in which Jesus Christ compares the Kingdom of God to a merchant who sells everything to obtain a single pearl of extraordinary value. Parable of the Pearl of Great Price reveals the supreme worth of the Kingdom and the decisive commitment required to possess it."^^xsd:string ;
    skos:example "Christian theology interprets the parable of the pearl of great price as a call to single-minded devotion to the Kingdom of God."^^xsd:string,
