<R8SQ1qC9DBq8ApbGEWH6uD> a owl:Class ;
    rdfs:label "Outstanding Professor or Researcher Immigrant Petition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RtNdCOiqmpVOXZef1DicAV> ],
        <RKY2B2HNSx5K82dgVN6Qn7> ;
    skos:definition "An Outstanding Professor or Researcher Immigrant Petition (in the U.S., I-140 EB-1) allows universities or private employers to sponsor foreign nationals who are internationally recognized as outstanding in their academic field. Applicants must demonstrate at least three years of experience in teaching or research and show evidence of significant achievements. Applicants must demonstrate international recognition for your outstanding achievements in a particular academic field, have at least three years of experience in teaching or research in that academic area, and be entering the United States to pursue tenure or a tenure-track teaching position or a comparable research position at a university, institution of higher education, or private employer." ;
    skos:prefLabel "I-140 EB-1" .

