<RCSpXc6PHeSrP9MhtQTdWrV> a owl:Class ;
    rdfs:label "Penance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RD3Y189V579xUOPZVOl4bdH> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RsNCuDHhcBOYuucDj6oqxT> ],
        <R9jhu7lDqKrv2ybkSS5mgxV> ;
    skos:altLabel "Penitential Act"^^xsd:string ;
    skos:definition "Penance means a penitent’s concrete acts of repentance — such as prayer, fasting, almsgiving, restitution, or other works — offered to repair sin’s harm and foster conversion. In the Sacrament of Penance and Reconciliation, penance often names the satisfaction a confessor assigns and the penitent performs after absolution."^^xsd:string ;
    skos:example "During Lent, she fasted on Fridays as penance for habitual impatience."^^xsd:string,
        "He performed almsgiving as penance by paying a neighbor’s grocery bill anonymously."^^xsd:string,
        "The confessor assigned three decades of the rosary as penance, and the penitent completed it that evening."^^xsd:string,
        "The penitent made restitution by returning the money taken and adding an apology as penance."^^xsd:string .

