    skos:hiddenLabel "PIPT" .

<R8p15egW5el3Go9V1L4obop> a owl:Class ;
    rdfs:label "Strict Product Liability" ;
    rdfs:subClassOf <R7MsH9WtTPf14W1GB1m8zrB>,
        <RdN6a66644QYTrLMGgEar> ;
    skos:altLabel "Strenge Produkthaftung"@de-de,
        "Strict Product Liability"@en-gb,
        "Responsabilidad objetiva del producto"@es-es,
        "Responsabilidad objetiva del producto"@es-mx,
        "Responsabilité stricte du fabricant"@fr-fr,
        "אחריות מוצר קפדנית"@he-il,
        "सख्त उत्पाद दायित्व"@hi-in,
        "厳格な製品責任"@ja-jp,
        "Responsabilidade objetiva do fabricante"@pt-br,
        "严格产品责任"@zh-cn ;
    skos:definition "Strict Product Liability is a legal concept that holds manufacturers and sellers responsible for any harm caused by their products, regardless of fault or negligence, if the product is found to be defective." .

<R8pNPutX0TN6DlEqkyZuxSw> a owl:Class ;
