    skos:hiddenLabel "ACCT" .

<RB7ogMztssZDBweltNO6kVb> a owl:Class ;
    rdfs:label "Race Discrimination" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RC50Vs3pkDyvqMHRukXE98O> ],
        <R8UnJ8s91KxQbW7GpGgIhsP> ;
    skos:altLabel "Rassendiskriminierung"@de-de,
        "Race Discrimination"@en-gb,
        "Discriminación racial"@es-es,
        "Discriminación por raza"@es-mx,
        "Discrimination raciale"@fr-fr,
        "Discrimination by race"@he-il,
        "जाति भेदभाव"@hi-in,
        "人種差別"@ja-jp,
        "Discriminação racial"@pt-br,
        "种族歧视"@zh-cn ;
    skos:definition "The concept of Race Discrimination refers to the unfair treatment or prejudice against an individual or group based on their race or ethnicity, which is prohibited by law and can be the basis for a discrimination claim." ;
    skos:prefLabel "Racial Discrimination" .

<RB9zzoSs7UGZstS4ptLmvxR> a owl:Class ;
    rdfs:label "Plants" ;
    rdfs:subClassOf <RDS8DPtuFReTFfJ5nGCczD5> ;
    skos:definition "Plants are multicellular organisms belonging to the kingdom Plantae, characterized by their ability to perform photosynthesis using chlorophyll to convert sunlight into energy. They are essential components of ecosystems, providing oxygen, food, and habitat, and include a wide range of species such as trees, shrubs, herbs, grasses, ferns, and mosses." .

<RBBNGfCRL0x4GSTGGrYx0e> a owl:Class ;
    rdfs:label "Tribes" ;
    dc:source "United States Census" ;
    rdfs:subClassOf <RBQGborh1CfXanGZipDL0Qo> ;
    skos:definition "In the legal and societal context, tribes refer to groups of people sharing a common culture, language, or ancestry, often organized around familial or kinship structures and governed by customary laws or tribal chiefs. Tribal governance and jurisdiction may operate within, alongside, or outside the legal framework of a surrounding nation, with varying degrees of recognized sovereignty and legal authority" .

<RBDPzIFUWJsqqM1kkNffPeu> a owl:Class ;
    rdfs:label "Professional Limited Liability Company" ;
    dc:identifier "ENTITY-PLLC" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7eNtj44HIHIEfl5hdN415d> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDGUE77tzDuRstdi916e1Vv> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R98E2kVwPFwTnP6oxYUt9HR> ],
        <R7oBWHStfmqTLn2MypkW3Pj> ;
    skos:altLabel "PLLC",
        "Professional Limited Liability Company",
        "Gesellschaft mit beschränkter Haftung für Freiberufler"@de-de,
        "Société à responsabilité limitée professionnelle"@fr-fr,
        "プロフェッショナル有限責任会社"@ja-jp,
        "Sociedade Limitada Profissional"@pt-br,
        "专业有限责任公司"@zh-cn ;
    skos:definition "A professional limited liability company ('PLLC') is a U.S. business entity designed for licensed professionals, such as lawyers, doctors, architects, engineers, accountants, and chiropractors. While many businesses choose to form a limited liability company ('LLC') because of the tax, limited liability, and other benefits, some states don't allow LLCs to be owned by professionals whose occupation requires a license. In these states, licensed professionals who want the benefits of an LLC must form a PLLC instead." ;
    skos:hiddenLabel "PLLC" .

<RBEfQXg8uUIsk2iZbk8Z2gR> a owl:Class ;
    rdfs:label "Financial Advisor" ;
    rdfs:subClassOf <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Finanzberater"@de-de,
        "Financial Adviser"@en-gb,
        "Asesor financiero"@es-es,
        "Asesor financiero"@es-mx,
        "Conseiller financier"@fr-fr,
        "יועץ פיננסי"@he-il,
        "वित्तीय सलाहकार"@hi-in,
        "ファイナンシャルアドバイザー"@ja-jp,
        "Consultor financeiro"@pt-br,
        "财务顾问"@zh-cn ;
    skos:definition "A professional adviser offering financial counsel, sometimes charging fees and/or earning commissions. Rockhill  v.  William  M.  Jeude  &  Univest,  Inc. (W.D. Wash. 2012)",
        "From U.S. Bankruptcy Court PACER" ;
    skos:prefLabel "Investment Advisor" .

<RBFekEKQaSd09pc3gg6DYwE> a owl:Class ;
