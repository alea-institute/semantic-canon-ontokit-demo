    rdfs:subClassOf <R7oBWHStfmqTLn2MypkW3Pj> ;
    skos:altLabel "Politische Partei"@de-de,
        "Parti politique"@fr-fr,
        "政党"@ja-jp,
        "Partido político"@pt-br,
        "政党"@zh-cn ;
    skos:definition "A political party is an organized group of individuals who share similar political beliefs and goals, seeking to influence public policy and gain control of government through the electoral process." .

<R7obzFRN58WoEDO4rf137uE> a owl:Class ;
    rdfs:label "Educational Benefits" ;
