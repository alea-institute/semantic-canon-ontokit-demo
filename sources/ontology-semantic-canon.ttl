<R6qmvmSLCVT8s8UsvQGXKQ> a owl:Class ;
    rdfs:label "Nonmaleficence" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Do No Harm"^^xsd:string,
        "Negative Moral Duty"^^xsd:string,
        "Prohibition of Harm"^^xsd:string,
        "Risk Minimization"^^xsd:string ;
    skos:definition "Nonmaleficence is the ethical principle that obliges persons to avoid causing harm to others. Nonmaleficence restrains action by requiring that foreseeable injury, injustice, or damage not be inflicted without morally proportionate reason."^^xsd:string ;
    skos:example "Nonmaleficence guides researchers to design studies that minimize risk to participants."^^xsd:string,
        "Nonmaleficence limits the use of force to what is strictly necessary."^^xsd:string,
        "Nonmaleficence prohibits actions that foreseeably injure innocent persons."^^xsd:string,
        "Nonmaleficence requires careful evaluation of side effects before approving an intervention."^^xsd:string,
        "Nonmaleficence restrains a physician from providing treatment that would cause disproportionate harm."^^xsd:string ;
    skos:prefLabel "Harm Avoidance"^^xsd:string .

