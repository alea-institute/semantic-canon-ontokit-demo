    skos:definition "This U.S. industry comprises establishments primarily engaged in growing grains and/or producing grain(s) seeds (except wheat, corn, rice, and oilseed(s) and grain(s) combinations)." ;
    skos:example "Barley farming",
        "Oat farming",
        "Rye farming",
        "Sorghum farming",
        "Wild rice farming" .

<AKbiNvq0SJquriQ5LfwLEw> a owl:Class ;
    rdfs:label "Fish and Seafood Merchant Wholesalers" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=424460> ;
    rdfs:subClassOf <BWPuh4YOSEqfI3IWii_ywQ> ;
    skos:definition "This industry comprises establishments primarily engaged in the merchant wholesale distribution of fish and seafood (except canned or packaged frozen)." .

<AKzCx29rRSuZK6h9bCOUng> a owl:Class ;
