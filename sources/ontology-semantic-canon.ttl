<R7zoECzj7hnZY0W6HNu28xm> a owl:Class ;
    rdfs:label "Dignity" ;
    rdfs:subClassOf <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Human Dignity"^^xsd:string,
        "Humans' Intrinsic Value"^^xsd:string,
        "Inherent Worth"^^xsd:string,
        "Personal Worth"^^xsd:string ;
    skos:definition "Dignity is the inherent worth of every human person by reason of being human, not dependent on status, capacity, or achievement. Dignity grounds moral obligations to respect, protect, and promote the person in all circumstances."^^xsd:string ;
    skos:example "Dignity demands humane treatment of prisoners regardless of their crimes."^^xsd:string,
        "Dignity forbids treating a person merely as a means to achieve an outcome."^^xsd:string,
        "Dignity grounds opposition to torture, slavery, and human trafficking."^^xsd:string,
        "Dignity requires respectful care for persons with disabilities or diminished capacity."^^xsd:string,
        "Dignity shapes ethical limits on medical experimentation involving human subjects."^^xsd:string .

