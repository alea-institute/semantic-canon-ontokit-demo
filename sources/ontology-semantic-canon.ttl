<RCmuig88QJ7hFTNdW3SBrrZ> a owl:Class ;
    rdfs:label "Age-Related Cognitive Decline" ;
    rdfs:subClassOf <RnmmbswQcOryRPEoDnHIbC> ;
    skos:altLabel "Age-Related Memory Loss",
        "Cognitive Aging",
        "Senile Cognitive Decline" ;
    skos:definition "Age-related cognitive decline is the gradual loss of cognitive functions such as memory, attention, and problem-solving skills, which typically occurs as part of the natural aging process. It is not as severe as dementia but can impact daily activities and quality of life, often necessitating lifestyle adjustments and cognitive therapies to manage symptoms." ;
    skos:prefLabel "Senility" .

