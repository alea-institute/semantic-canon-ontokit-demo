<R74qtGrajLRLamHOPJfsFhS> a owl:Class ;
    rdfs:label "Sexual Orientation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R80nTp0xPWvxkJonwMOIvBA> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9ZfQLUD6x5jCYfUMTaf8m9> ],
        <R7sHH7RvjZ6aZS7ZExDpYmR> ;
    skos:altLabel "sexuelle Orientierung"@de-de,
        "orientation sexuelle"@fr-fr,
        "性的指向"@ja-jp,
        "orientação sexual"@pt-br,
        "性取向"@zh-cn ;
    skos:definition "Sexual orientation refers to an individual's enduring pattern of emotional, romantic, and/or sexual attractions to men, women, both genders, or neither. It is distinct from a person's gender identity, which refers to one's internal sense of being male, female, or something else. Sexual orientation is often a protected characteristic under anti-discrimination laws, which aim to ensure that individuals are treated fairly and equally regardless of their orientation. In many jurisdictions, these laws prohibit discrimination based on sexual orientation in areas such as employment, housing, education, and public services." .

<R79ZnCKDSoLOn17LGjAF6G6> a owl:Class ;
    rdfs:label "Patent Subject-Matter Classifications" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8W98AqFMMolqQMvARHGyoP> ],
        <Rzy5rvrKtuL8AwKrBTFfBQ> ;
    skos:definition "Patent Subject-Matter Classifications are a system of categorizing patents and patent applications based on the technical fields or subject matter they pertain to, such as chemical, mechanical, electrical, and life sciences. This classification system facilitates the organization, search, and examination of patents by grouping similar inventions together." .

<R7D81edCD2d848A515dCCe2f> a owl:Class ;
