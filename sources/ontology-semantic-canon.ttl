        "Congresswoman",
        "Member of Parliament" ;
    skos:definition "A National Lower House Legislator is an elected official who serves as a member of the lower chamber in a bicameral national legislature. This individual is typically responsible for initiating legislation, representing local constituencies, and providing democratic accountability through more frequent elections compared to the upper house." ;
    skos:example "U.S. Representative" ;
    skos:prefLabel "U.S. Representative" .

<R7VytRdXoJzs9aO8OQmI3l1> a owl:Class ;
