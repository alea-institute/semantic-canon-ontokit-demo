    skos:example "Mass unites the Church in worship and communion."^^xsd:string,
        "The Eucharistic prayer forms the heart of the Mass."^^xsd:string,
        "The Mass culminates in the reception of Holy Communion."^^xsd:string,
        "The Mass makes present the sacrifice of Christ on the altar."^^xsd:string,
        "The faithful gather each Sunday for Mass."^^xsd:string ;
    skos:prefLabel "Eucharistic Liturgy"^^xsd:string .

