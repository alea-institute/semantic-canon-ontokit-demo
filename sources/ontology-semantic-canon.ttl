        <RDroRAFhNybTCHv1WlHGerL> ;
    skos:altLabel "Official Warning",
        "Written Reprimand" ;
    skos:definition "An Employment Written Warning is a formal document issued by an employer to an employee, outlining specific instances of misconduct or performance issues. It serves as an official notice that continued violations may result in further disciplinary action, including termination." ;
    skos:prefLabel "Documented Reprimand" .

<R8JWsBlOUIiJEyedJWcxIeU> a owl:Class ;
