        "Sick room supply retailers",
        "Vitamin retailers",
        "Wheelchair retailers" .

<u9JLdQviRaOv5g2EhgY8Vg> a owl:Class ;
    rdfs:label "Office Supplies, Stationery, and Gift Retailers" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=4594> ;
    rdfs:subClassOf <RncNeMNwQvKMaiI19YLhFk> ;
