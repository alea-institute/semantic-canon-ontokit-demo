<RBypJHdXoQQwqYlG95KCDCQ> a owl:Class ;
    rdfs:label "Religious Events" ;
    rdfs:subClassOf <R73hoH1RXYjBTYiGfolpsAF> ;
    skos:altLabel "Ecclesial Events"^^xsd:string,
        "Events of Religious Practice"^^xsd:string,
        "Liturgical and Devotional Events"^^xsd:string,
        "Sacred Events"^^xsd:string ;
    skos:definition "Religious Events are actions, rites, or practices that have religious significance within the life of the Church and the faith of the faithful. Religious Events order worship, devotion, sacramental life, and communal prayer according to ecclesial norms and tradition."^^xsd:string ;
    skos:example "A bishop presides at the Rite of Confirmation for candidates."^^xsd:string,
        "A family participates in a blessing of their home."^^xsd:string,
        "A parish holds a communal rosary during the month of October."^^xsd:string,
        "A procession marks a major feast day in the liturgical calendar."^^xsd:string,
        "The faithful gather for the celebration of the Eucharist on Sunday."^^xsd:string .

<RBz2aCAIZMshK7S6EKsCHmX> a owl:Class ;
    rdfs:label "Familial Status" ;
