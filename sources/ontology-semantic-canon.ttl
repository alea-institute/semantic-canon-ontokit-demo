    skos:definition "Supreme Pontiff"^^xsd:string,
        "The Pope is the Bishop of Rome who, by virtue of his office, holds supreme, full, immediate, and universal authority in the Church. He serves as successor of Saint Peter and visible principle of unity for the bishops and the faithful."^^xsd:string ;
