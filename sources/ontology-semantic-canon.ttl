    skos:altLabel "Living Water"^^xsd:string ;
    skos:definition "Natural Water is water derived from nature and suitable for true washing, required as the sacramental matter of Baptism. Its use signifies cleansing, rebirth, and participation in Christ’s death and resurrection."^^xsd:string ;
    skos:example "Natural water is required for the valid celebration of baptism."^^xsd:string,
