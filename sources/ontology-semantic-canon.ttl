<R760QOBO6MuiwDnJAHu5RwX> a owl:Class ;
    rdfs:label "Catholic Social Teaching" ;
    rdfs:subClassOf <RDJCVxMdg9nG7TJxLsDHfRB> ;
    skos:altLabel "Catholic Social Doctrine"^^xsd:string,
        "Social Doctrine of the Church"^^xsd:string,
        "Social Magisterium"^^xsd:string,
        "The Church’s Social Doctrine"^^xsd:string ;
    skos:definition "Catholic Social Teaching is the Church’s body of doctrine that applies the Gospel and the natural moral law to social, economic, and political life. Catholic Social Teaching guides conscience and action toward the common good, justice, and human dignity in personal conduct and public institutions."^^xsd:string ;
    skos:example "Catholic Social Teaching shaped the parish’s adult-education series on the common good."^^xsd:string,
        "She used Catholic Social Teaching to evaluate whether her investments aligned with human dignity."^^xsd:string,
        "The Catholic hospital adopted a procurement policy that reflected Catholic Social Teaching’s dignity-of-work principle."^^xsd:string,
        "The diocesan justice office cited Catholic Social Teaching when it supported humane treatment of migrants."^^xsd:string,
        "The pastor applied Catholic Social Teaching when he urged fair wages for local workers."^^xsd:string ;
    skos:prefLabel "CST"^^xsd:string .

