        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Participant",
        "Stakeholder" ;
    skos:definition "A Member is an individual or entity that holds an ownership or participatory interest in an organization or association. In business contexts, such as in a Limited Liability Company (LLC), members contribute capital or assets, and share in the management and profits according to organizational agreements." .

<RCmkrESHrcL7bKILqkwAG1J> a owl:Class ;
    rdfs:label "Expiration Event" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R74TUaDuXhtfgwnBtY34zgP> ],
        <ReoekaIFkvXuZDtiEVwWPe> ;
    skos:definition "An Expiration Event in legal terms refers to the occurrence that triggers the end of a legal privilege (e.g., regulatory permission) or obligation (e.g., contract), rendering its terms no longer enforceable. It marks the conclusion of the legal permission or obligation." .

<RCoVC6WY5Cc00C8Q9AaBFQo> a owl:Class ;
