<RCWSIxv3w4brTM90zAAJUSy> a owl:Class ;
    rdfs:label "Parable of the Prodigal Son" ;
    rdfs:subClassOf <R9rCbt2Rlk0Nw3UJ6rbp5gB> ;
    skos:altLabel "Parable of the Merciful Father"^^xsd:string,
        "Parable of the Two Sons"^^xsd:string,
        "Prodigal Son Parable"^^xsd:string ;
    skos:definition "Parable of the Prodigal Son means the teaching in which Jesus Christ describes a father who mercifully receives his repentant son and restores him to sonship. Parable of the Prodigal Son reveals the Father’s boundless mercy, the call to repentance, and the challenge of fraternal forgiveness."^^xsd:string ;
    skos:example "Christian theology interprets the parable of the prodigal son as a central revelation of divine mercy."^^xsd:string,
        "The Gospel of Luke recounts a father embracing his returning son after a period of sin and exile."^^xsd:string .

