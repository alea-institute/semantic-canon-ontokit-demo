<R7Jows5YP8imYL7zA2abXZE> a owl:Class ;
    rdfs:label "Instant Runoff Electoral System" ;
    dc:source <https://en.wikipedia.org/wiki/Instant-runoff_voting> ;
    rdfs:subClassOf <RB2K2E9rftRKciKOqkr1BeV> ;
    skos:altLabel "Alternative Vote",
        "IRV",
        "Instant Runoff Voting",
        "Preferential Balloting System",
        "Preferential Voting",
        "Ranked Voting",
        "Sequential Runoff Voting" ;
    skos:definition "The instant runoff electoral system, also known as ranked-choice voting, is a voting method where voters rank candidates by preference. If no candidate wins a majority of first-preference votes, the candidate with the fewest votes is eliminated, and their votes are redistributed according to the voters' next preferences, continuing until one candidate achieves a majority." ;
    skos:example "Multi-Winner IRV: Minneapolis city council elections",
        "Proportional IRV: Australian Senate elections",
        "Single-Winner IRV: San Francisco mayoral elections" ;
    skos:prefLabel "Ranked-Choice Voting" .

