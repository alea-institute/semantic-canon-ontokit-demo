    skos:example "Catholic theology attributes sanctification to the work of God the Holy Spirit."^^xsd:string,
        "Confirmation seals the faithful with the gift of the Holy Spirit."^^xsd:string,
        "The Church invokes God the Holy Spirit at Pentecost."^^xsd:string,
        "The Nicene Creed professes belief in the Holy Spirit, the Lord and giver of life."^^xsd:string,
