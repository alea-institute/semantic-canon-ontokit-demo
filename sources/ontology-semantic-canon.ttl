        "Ear piercing services",
        "Hair replacement (except by offices of physicians) or weaving services",
        "Permanent makeup salons",
        "Saunas",
        "Steam baths",
        "Tanning salons",
        "Tattoo parlors" .

<Ih8EI2O3Rr2VB1b2JLaHwA> a owl:Class ;
    rdfs:label "Other Commercial Equipment Merchant Wholesalers" ;
