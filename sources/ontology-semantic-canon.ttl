    rdfs:subClassOf <0K_BMejJS72mVDXFcz_QSw> ;
    skos:definition "This industry comprises establishments primarily engaged in performing real estate related services (except lessors of real estate, offices of real estate agents and brokers, real estate property managers, and offices of real estate appraisers)." ;
    skos:example "Landman services",
        "Real estate escrow agencies",
        "Real estate fiduciaries' offices",
        "Real estate listing services" .

<uWsJEyDhQ3K5WR8utgab7w> a owl:Class ;
