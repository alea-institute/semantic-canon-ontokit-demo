<R2Kr3kWHR9cR4zALXqt1nM> a owl:Class ;
    rdfs:label "Structured Certificate" ;
    rdfs:subClassOf <RBVQj7fYsBw67yNXs4WI6RX> ;
    skos:definition "A Structured Certificate is a financial instrument that combines features of fixed income securities and derivatives to offer customized risk-return profiles based on the performance of underlying assets. It typically provides exposure to various asset classes while offering some form of principal protection or enhanced returns under specific market conditions." .

