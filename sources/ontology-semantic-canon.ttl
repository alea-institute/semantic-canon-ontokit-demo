    rdfs:subClassOf <RDgGcpXGlTkoTivF8Ol8w09> ;
    skos:altLabel "Member of State Senate" ;
    skos:definition "A State Senator is an elected official who serves as a member of the upper chamber of a state's bicameral legislature. This individual is responsible for proposing, debating, and voting on state laws, policies, and budgets, as well as representing the interests of constituents from their specific senatorial district." ;
    skos:prefLabel "State Senator" .

<Rey3om0qyVpfVyN29qkAQg> a owl:Class ;
    rdfs:label "Thesis" ;
    rdfs:subClassOf <R9abezigCOxFsNH1QItgXgB> ;
    skos:altLabel "Theological Proposition"^^xsd:string ;
    skos:definition "A Thesis is a proposition or claim advanced for affirmation, defense, or demonstration within argument, theology, or philosophy. In Catholic theology, a thesis often articulates a position to be examined in light of scripture, tradition, and reason."^^xsd:string ;
    skos:example "A theological thesis proposes that grace heals and elevates human nature."^^xsd:string,
        "A thesis asserts that divine law perfects natural law."^^xsd:string .

<Rf4Hdwp3Dxznbg6fQzXGm9> a owl:Class ;
    rdfs:label "Holy Orders" ;
    rdfs:subClassOf <RBJKz2efB8oGem9X7vJ672s> ;
    skos:altLabel "Sacrament of Holy Orders"^^xsd:string,
        "Sacred Ordination"^^xsd:string ;
    skos:definition "Holy Orders is the sacrament by which the mission entrusted by Christ to his apostles continues in the Church through ordained ministry. It confers a sacred power and an indelible character for service as bishop, priest, or deacon."^^xsd:string ;
    skos:example "A bishop ordains priests and deacons through holy orders."^^xsd:string,
        "Holy orders confers authority for ordained ministry."^^xsd:string,
        "Holy orders serves the communion and mission of the Church."^^xsd:string ;
    skos:prefLabel "Ordination"^^xsd:string .

