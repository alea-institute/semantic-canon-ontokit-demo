    skos:definition "This U.S. industry comprises establishments primarily engaged in manufacturing fabricated metal products (except forgings and stampings, cutlery and handtools, architectural and structural metals, boilers, tanks, shipping containers, hardware, spring and wire products, machine shop products, turned products, screws, nuts and bolts, metal valves, ball and roller bearings, ammunition, small arms and other ordnances and accessories, and fabricated pipes and pipe fittings)." ;
    skos:example "Foil containers (except bags) manufacturing",
        "Industrial pattern manufacturing",
        "Metal hair curlers manufacturing",
        "Metal ironing boards manufacturing",
        "Metal pallets manufacturing",
        "Metal pipe hangers and supports manufacturing",
        "Metal safes manufacturing",
        "Metal vaults (except burial) manufacturing",
        "Permanent metallic magnets manufacturing",
        "Portable metal ladders manufacturing",
        "Sanitary ware (e.g., bathtubs, lavatories, sinks), metal and enameled metal, manufacturing",
        "Steel wool manufacturing" .

<z8c5DL99SOCh-FEIdYL8XA> a owl:Class ;
    rdfs:label "Tree Nut Farming" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=111335> ;
    rdfs:subClassOf <SMxNxWmNRdaY3reO9Yl_2A> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in growing tree nuts." ;
