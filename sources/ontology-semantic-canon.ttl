        "発行者"@ja-jp,
        "Emissor"@pt-br,
        "发行人"@zh-cn ;
    skos:definition "An issuer is a legal entity that develops, registers and sells securities to finance its operations. Issuers may be corporations, investment trusts, or domestic or foreign governments." ;
    skos:hiddenLabel "ISSU" .

<RDMIFgVwND9pPCV8Mb2eseF> a owl:Class ;
