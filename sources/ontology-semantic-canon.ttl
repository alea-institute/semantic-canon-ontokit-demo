        <R7gKTQpOKfQ2tOdPu6cLN3w> ;
    skos:altLabel "Entry/Exit Record" ;
    skos:definition "Arrival / Departure Record (in the U.S., I-94 form) is a document used by the national immigration agency (e.g., U.S. Customs and Border Protection (CBP)) to track the arrival and departure dates of foreign visitors entering and leaving the destination country (e.g, United States). It contains information such as the visitor's name, birth date, country of citizenship, visa classification, and the authorized period of stay." ;
    skos:prefLabel "I-94" .

<RCKXOOo5LLglnx6v9IwNxYy> a owl:Class ;
    rdfs:label "Assumption of Mary"^^xsd:string ;
    dc:source <https://marian.org/mary/rosary/glorious-mysteries> ;
    rdfs:subClassOf <R78g2Psn6TygAlkIoCnXqdd>,
        <ROaU08jUOgsbTbTXXNTIXX> ;
    skos:altLabel "Assumption of the Blessed Virgin"^^xsd:string,
        "Assumption of the Mother of God"^^xsd:string,
        "Assumption of the Virgin Mary"^^xsd:string,
        "The Assumption"^^xsd:string ;
    skos:definition "The Assumption of the Blessed Virgin Mary is the belief that Mary, at the completion of her earthly life, was taken up body and soul into heavenly glory. The Church proclaims this as a definitive doctrine and celebrates it as a major Marian solemnity."^^xsd:string ;
    skos:example "A catechist explained that the Assumption teaches Mary’s glorification in body and soul at the end of her earthly life."^^xsd:string,
        "The faithful prayed a Marian devotion in honor of the Assumption."^^xsd:string,
        "The homily connected the Assumption to hope in the resurrection of the body."^^xsd:string,
        "The parish celebrated the Assumption of the Blessed Virgin Mary with a solemn Mass and Marian hymns."^^xsd:string,
        """You are the glory of Jerusalem … you are the splendid boast of our people … God is pleased with what you have wrought. May you be blessed by the Lord Almighty forever and ever.
(Judith 15:9-10)"""^^xsd:string ;
    skos:prefLabel "Assumption of the Blessed Virgin Mary" .

