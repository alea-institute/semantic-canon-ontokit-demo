    rdfs:label "Employment Benefits" ;
    rdfs:subClassOf <R8aNhIN6jIIVcj5Cbh8Bduw> ;
    skos:altLabel "Job Benefits" ;
    skos:definition "Employment Benefits are additional compensations or advantages provided to employees over and above their regular salary, often as part of an employment contract. These benefits may include healthcare, retirement plans, paid time off, and other perks designed to attract and retain employees." ;
    skos:prefLabel "Fringe Benefits" .

<RCDx1OyD4xo9Pj6dWOBMStt> a owl:ObjectProperty ;
    rdfs:label "folio:temporalChanges" ;
    rdfs:domain <RDt4vQCYDfY0R9fZ5FNnTbj> ;
    skos:definition "\"Temporal Changes\" in legal contexts refer to the various time-related aspects and milestones that affect the status, applicability, or relevance of legal documents, agreements, or decisions." .

<RCEx7g3wSm7TRkpl2WQko0s> a owl:Class ;
    rdfs:label "Foundation and Competency Objections" ;
    rdfs:subClassOf <R9Bk5v9AAJmhb4WcgIQjy29> ;
    skos:definition "Foundation and Competency Objections are raised when a party in a legal proceeding believes that evidence lacks the necessary groundwork for admissibility (foundation) or when a witness lacks the qualifications to provide reliable testimony (competency). These objections aim to ensure that evidence and testimony meet legal standards for relevance, reliability, and expertise." .

<RCKOcs51IQGZ9MeUqtONIlc> a owl:Class ;
    rdfs:label "Unearned Income" ;
    rdfs:subClassOf <RLrqGkP9fi5OO2RhpttmVI> ;
    skos:altLabel "Investment Income",
        "Non-Earned Income",
        "Passive Income" ;
    skos:definition "Unearned income refers to money received by an individual from sources other than employment, such as interest, dividends, rental income, or certain government benefits. Unlike earned income, which results from active work, unearned income comes from investments, inheritances, or other passive sources." ;
    skos:prefLabel "Passive Earnings" .

<RCMBmtgbWlLDL3wM3Mv5eOp> a owl:Class ;
    rdfs:label "Privacy Law Regulatory Objectives" ;
    rdfs:subClassOf <RCDwLiS22z6MzQaQHS08hvk> ;
    skos:altLabel "Ziele der Datenschutzregulierung"@de-de,
        "Privacy Law Regulatory Objectives"@en-gb,
        "Objetivos Regulatorios de la Ley de Privacidad"@es-es,
        "Objetivos Regulatorios de la Ley de Privacidad"@es-mx,
        "Objectifs réglementaires en matière de protection de la vie privée"@fr-fr,
        "מטרות רגולציה של חוק הפרטיות"@he-il,
        "गोपनीयता कानून नियामक उद्देश्य"@hi-in,
        "プライバシー法規制の目的"@ja-jp,
        "Objetivos regulatórios da lei de privacidade"@pt-br,
        "隐私法规目标"@zh-cn .

<RCNdhIWpodXkmuDPUE0YLKX> a owl:Class ;
    rdfs:label "Governance Agreement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBLOT3utnNtA6pYPhY1sHFH> ],
        <RCBtDyjzrPbQyhvU5V64Irn> ;
    skos:altLabel "Governing Document" ;
    skos:definition "A Governance Agreement is a document that outlines the framework, procedures, and policies guiding the management and oversight of an organization, ensuring alignment with its goals and objectives." ;
    skos:prefLabel "Operating Agreement" .

<RCQJU54O6qCvotCfmDwYZwj> a owl:Class ;
    rdfs:label "Matrimonial Emergency Applications" ;
    rdfs:subClassOf <RBOczjtsHXQh2ojzTubbrxI>,
        <RCUXzL8Z4Ddh2CK6TBhofjU> ;
    skos:altLabel "Anträge auf Ehe-Notfälle"@de-de,
        "Matrimonial Emergency Applications"@en-gb,
        "Solicitudes de emergencia matrimonial"@es-es,
        "Solicitudes de emergencia matrimonial"@es-mx,
        "Demandes d'urgence matrimoniale"@fr-fr,
        "בקשות חירום בנושא זוגיות"@he-il,
        "वैवाहिक आपातकालीन अनुप्रयोग"@hi-in,
        "夫婦の緊急申請"@ja-jp,
        "Pedidos de emergência matrimonial"@pt-br,
        "婚姻紧急申请"@zh-cn ;
    skos:definition "Matrimonial Emergency Applications refer to legal requests made in family law and matrimonial claims for temporary relief, such as maintenance, child support, custody, and protection orders, to address urgent and pressing issues that require immediate attention." .

<RCQY0EFoRWFu0qcub25sBj8> a owl:Class ;
    rdfs:label "Construction Industry" ;
    dc:identifier "CON" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=23> ;
    rdfs:subClassOf <RDIwFaFcH4KY0gwEY0QlMTp> ;
    skos:altLabel "Construction",
        "Bauindustrie"@de-de,
        "Construction Industry"@en-gb,
        "Industria de la construcción"@es-es,
        "Industria de la construcción"@es-mx,
        "Industrie de la construction"@fr-fr,
        "תעשיית הבנייה"@he-il,
        "निर्माण उद्योग"@hi-in,
        "建設業"@ja-jp,
        "Indústria da construção"@pt-br,
        "建筑业"@zh-cn ;
    skos:definition "The Construction industry group comprises establishments primarily engaged in the construction of buildings or engineering projects (e.g., highways and utility systems). Establishments primarily engaged in the preparation of sites for new construction and establishments primarily engaged in subdividing land for sale as building sites also are included in this sector." ;
    skos:hiddenLabel "CON" ;
    skos:prefLabel "Infrastructure Industry" .

<RCcQHyZbjBHsXsm0zrZGme5> a owl:Class ;
    rdfs:label "Tortious Interference Claims" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8viNe7dpcLA9kGH5gl7YE6> ],
        <RDqSn32zsjxExcBFzIYxT2D>,
        <RZ1dOPJ6HH6lMJGSLNxfwV> ;
    skos:altLabel "Ansprüche wegen unerlaubter Einmischung"@de-de,
        "Tortious Interference Claims"@en-gb,
        "Reclamaciones por interferencia ilícita"@es-es,
        "Reclamaciones por interferencia ilícita"@es-mx,
        "Actions en interférence délictuelle"@fr-fr,
        "תביעות על הפרת חובה עוינת"@he-il,
        "अनैतिक हस्तक्षेप दावे"@hi-in,
        "不法介入請求"@ja-jp,
        "Reivindicações de interferência ilícita"@pt-br,
        "侵权干扰索赔"@zh-cn ;
    skos:definition "Tortious Interference Claims refer to legal claims made by a party against another for intentionally interfering with their contractual or business relationships, resulting in economic harm or loss." .

<RCnTNVCQ1VndGxskbMoaLr8> a owl:Class ;
    rdfs:label "Deposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8qItBwG2pRMFhUq1HQEMnb> ],
        <R9XqhlDRrcrbyXu5YJVhaoW> ;
    skos:altLabel "Aussage"@de-de,
        "Deposition"@en-gb,
        "Declaración jurada"@es-es,
        "Declaración jurada"@es-mx,
        "Déposition"@fr-fr,
        "הצהרה תחת חתימה"@he-il,
        "गवाही"@hi-in,
        "証言"@ja-jp,
        "Depoimento"@pt-br,
        "证言"@zh-cn ;
    skos:definition "A deposition is a legal discovery event where a witness is questioned under oath by attorneys from both sides of a case, and the testimony is recorded for use in court proceedings." .

<RCuw9Co5aqGGoEIUhnvjRXK> a owl:Class ;
    rdfs:label "Moral Concepts" ;
    rdfs:subClassOf <RDQC6BrYjcS3V0gZcYzqc8O> ;
    skos:altLabel "Concepts of Morality"^^xsd:string,
        "Moral Categories"^^xsd:string,
        "Moral Notions"^^xsd:string ;
    skos:definition "Moral Concepts are foundational ideas that describe good and evil, right and wrong, and the moral quality of human acts, habits, and intentions. Moral Concepts structure moral reasoning by naming the realities that shape conscience, virtue, and moral responsibility."^^xsd:string ;
    skos:example "Moral concepts ground moral accountability and repentance."^^xsd:string,
        "Moral concepts guide the formation of conscience."^^xsd:string,
        "Moral concepts help distinguish virtuous actions from sinful ones."^^xsd:string,
        "Moral concepts provide language to evaluate human intentions and acts."^^xsd:string,
        "Moral concepts structure moral teaching and catechesis."^^xsd:string .

<RD1C77b5D46361ED0cbA4f20> a owl:Class ;
    rdfs:label "Securities, Commodity Contracts, and Other Financial Investments and Related Activities Industry" ;
    dc:identifier "FNS-SECC" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=523> ;
    rdfs:subClassOf <RCksXAlY9lRN16wERqZZ8Tk> ;
    skos:altLabel "Securities, Commodities and Financial Investments",
        "Wertpapier-, Rohstoff- und Finanzinvestitionsbranche"@de-de,
        "Industrie des valeurs mobilières, des matières premières et des investissements financiers"@fr-fr,
        "証券、商品、金融投資産業"@ja-jp,
        "Indústria de Valores Mobiliários, Commodities e Investimentos Financeiros"@pt-br,
        "证券、商品和金融投资行业"@zh-cn ;
    skos:definition "Industries in the Securities, Commodity Contracts, and Other Financial Investments and Related Activities subsector group establishments that are primarily engaged in one of the following: (1) underwriting securities issues and/or making markets for securities and commodities; (2) acting as agents (i.e., brokers) between buyers and sellers of securities and commodities; (3) providing securities and commodity exchange services; and (4) providing other services, such as managing portfolios of assets; providing investment advice; and trust, fiduciary, and custody services." ;
    skos:hiddenLabel "SECC" ;
    skos:prefLabel "Securities, Commodities and Financial Investments" .

<RD2KAbcnrk0vfpUCEog3N9F> a owl:Class ;
    rdfs:label "Immigration and Border Control Role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8N4pMIOhTNbqcmDczSephq> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RJ4c5efwPEoWH1XeoJxiB4> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RqWYmNLhfvzysGhC75yUNw> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9ODLnhxFt38FQNV4BUbRSD> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBEXxc9B6kR2p0BMwGjhWGW> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:definition "Immigration and Border Control Role refers to the specific status or category under which an individual is entering or leaving a country, as determined by immigration laws and regulations. Examples include immigrants seeking permanent residence, Heads of State on official visits, or H-1B visa holders entering for specialized work; each role comes with its own set of rules, privileges, and restrictions" .

<RD3CNG3ecVo2oIloP4lYFoX> a owl:Class ;
    rdfs:label "Election Ballot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R78PKqeEIORKpYVwEfC4aG4> ],
        <RBCzyIAi2Hjl80hfQr8wAMR> ;
    skos:definition "A ballot is a device or medium, such as a piece of paper or an electronic system, used to record an individual's choice in an election or a vote. Ballots list the candidates or options available for selection, and voters indicate their preferences by marking the ballot in a specified manner. Once completed, the ballot is submitted for counting to determine the outcome of the voting process." ;
    skos:prefLabel "Ballot" .

<RD7F48101C57b4D8d5aAEe1f> a owl:Class ;
    rdfs:label "Pennsylvania" ;
    dc:identifier "NAM-US-US+PA" ;
    rdfs:subClassOf <R1E70ce4D699e90144cB32b8> ;
    skos:hiddenLabel "US+PA" ;
    skos:prefLabel "Pennsylvania" .

<RDAy5MQTYwrACj2yao4MGbA> a owl:Class ;
    rdfs:label "Contractor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDT5IoSIx0PT2VoHSIgl2w2> ],
        <RBY4j5UKZ7L8gp0q9Wrxyge> ;
    skos:definition "A Contractor is an individual or entity that provides services to a company under the terms of a contract, rather than being an employee of the organization. Contractors are typically responsible for their own taxes, benefits, and liabilities, and they usually have a greater degree of flexibility and independence than employees." ;
    skos:prefLabel "Independent Contractor" .

<RDE31b2AF49a59EE24276760> a owl:Class ;
    rdfs:label "California Court of Appeal" ;
    dc:identifier "USCTS-STCOUS-CA-CALCTAPP" ;
    rdfs:subClassOf <R688d7293074eA6C38b47f71> ;
    skos:definition "Cal. Ct. App." ;
    skos:hiddenLabel "CALCTAPP" ;
    skos:prefLabel "California Court of Appeal" .

<RDJgy4NDLgsP7qaqied5k5c> a owl:Class ;
    rdfs:label "Interactive Media" ;
    rdfs:subClassOf <RCR0Wfb4Zz9V56W2ri7JeTU> ;
    skos:altLabel "Digital Interactive Work",
        "Interactive Content" ;
    skos:definition "Interactive Media refers to digital content that requires user interaction to deliver its content, such as video games, virtual reality experiences, and interactive websites. Protected under copyright law, interactive media grants the creators exclusive rights to reproduce, distribute, and display the content." .

<RDdgYa5ZbqVnS9aGrOwQu5h> a owl:Class ;
    rdfs:label "Corporation" ;
    dc:identifier "ENTITY-CORP" ;
    rdfs:subClassOf <R7oBWHStfmqTLn2MypkW3Pj> ;
    skos:altLabel "Corporation",
        "Korporation"@de-de,
        "Société"@fr-fr,
        "法人"@ja-jp,
        "Corporação"@pt-br,
        "公司"@zh-cn ;
    skos:definition "An organization formed with state governmental approval to act as an artificial person that is empowered with legal rights usually only reserved for individuals, such as to sue and be sued, issue shares of stock to raise funds (unless it is non-profit), own property, hire employees or loan and borrow money." ;
    skos:hiddenLabel "CORP" .

<RDhTbfA9WACnFGtRuw8v57e> a owl:Class ;
    rdfs:label "Divorce" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R4v8Gjbx7j17UCiLuGL3mF> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R83h4k9Hrvl8nKaSH4G3ry6> ],
        <R7widavYhXmyfw9WvR9ahBs> ;
    skos:altLabel "Ehescheidung"@de-de,
        "Marriage Dissolution"@en-gb,
        "Disolución del matrimonio"@es-es,
        "Disolución del matrimonio"@es-mx,
        "Dissolution du mariage"@fr-fr,
        "פירוק נישואים"@he-il,
        "विवाह विघटन"@hi-in,
        "離婚"@ja-jp,
        "Dissolução do casamento"@pt-br,
        "婚姻解除"@zh-cn ;
    skos:definition "The legal process of ending a marriage, either due to fault or without fault, including issues such as property division, child custody, and spousal support." ;
    skos:prefLabel "Marriage Dissolution" .

<RDkKltCs6qv3E5GLBaSJ8H4> a owl:Class ;
    rdfs:label "Election" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RD3CNG3ecVo2oIloP4lYFoX> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R78PKqeEIORKpYVwEfC4aG4> ],
        <RCvV18Mbbb9FYFXbHt1inuL> ;
    skos:definition "An election is a formal decision-making process in which eligible individuals, often referred to as voters, select a choice or representative from among multiple candidates or options. Elections are used in democracies to fill various public offices or decide on legislation and public policy issues, ensuring that the will of the people is reflected in governance and leadership." .

<RDr6DXAcukDYZgOiiRN8qtf> a owl:Class ;
    rdfs:label "14th Amendment Claim" ;
    rdfs:subClassOf <R7MGQ9xUx0PxGLp5yxprdpZ> ;
    skos:altLabel "Fourteenth Amendment Claim",
        "Anspruch auf den 14. Zusatzartikel"@de-de,
        "14th Amendment Claim"@en-gb,
        "Reclamo de la Decimocuarta Enmienda"@es-es,
        "Reclamo de la Decimocuarta Enmienda"@es-mx,
        "Réclamation fondée sur le 14ème amendement"@fr-fr,
        "תביעת התיקון הארבע-עשרה"@he-il,
        "14वीं संशोधन दावा"@hi-in,
        "第14改正請求"@ja-jp,
        "Reivindicação da 14ª Emenda"@pt-br,
        "第14修正案索赔"@zh-cn ;
    skos:definition "Fourteenth Amendment claims are legal actions initiated by an individual alleging that their rights under the Fourteenth Amendment of the United States Constitution have been violated by the government or a government actor. The Fourteenth Amendment guarantees equal protection under the law and due process of law to all persons, and applies to actions taken by state and local governments. Fourteenth Amendment claims may arise in various contexts, such as when an individual is discriminated against on the basis of race, gender, national origin, or other protected categories, when an individual is deprived of their liberty or property without due process of law, or when an individual is denied equal protection of the law." .

<RDspRIwoJTlopUDjSgLRduf> a owl:Class ;
    rdfs:label "Elements of Claim" ;
    rdfs:subClassOf <R9q7GJc1zsYT0P4Xdp6l9Oz> ;
    skos:altLabel "Anspruchselemente"@de-de,
        "Elements of Claim"@en-gb,
        "Elementos de la Demanda"@es-es,
        "Elementos de la Demanda"@es-mx,
        "Éléments de la demande"@fr-fr,
        "אלמנטים של טענה"@he-il,
        "दावे के तत्व"@hi-in,
        "請求要素"@ja-jp,
        "Elementos da reivindicação"@pt-br,
        "要素要求"@zh-cn ;
    skos:definition "Elements of Claim: The essential components that must be proven in a legal action in order to establish a valid claim, including but not limited to the specific facts, legal theories, and evidence necessary to support the claim." .

<RDuglENJJNibMF8YDtmXkpE> a owl:Class ;
    rdfs:label "Probate Claims" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7yZIgA7OiFZCN0zGIsguvf> ],
        <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Nachlassforderungen"@de-de,
        "Probate Claims"@en-gb,
        "Reclamaciones de sucesión"@es-es,
        "Reclamaciones testamentarias"@es-mx,
        "Réclamations successorales"@fr-fr,
        "תביעות ירושה"@he-il,
        "प्रोबेट दावे"@hi-in,
        "相続請求"@ja-jp,
        "Reivindicações de inventário"@pt-br,
        "遗嘱认证索赔"@zh-cn ;
    skos:definition "A probate claim is a legal action brought to settle the estate of a deceased person, including the distribution of assets and payment of debts, and is a type of civil claim." .

<RH73qlQGajAwUFNMEkH9T2> a owl:ObjectProperty ;
    rdfs:label "folio:binaryOperators" ;
    rdfs:subPropertyOf <RBeF5svD5xdsZlF7cggOBUa> ;
    skos:definition "A category of operators that use two operands, such as the comparison of numerical values (e.g., GreaterThan, LessThan, EqualTo, NotEqualTo)." .

<RHwCmZ2yKrJobzC86GC6Ep> a owl:Class ;
    rdfs:label "Information Industry" ;
    dc:identifier "INF" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=51> ;
    rdfs:subClassOf <RDIwFaFcH4KY0gwEY0QlMTp> ;
    skos:altLabel "Information",
        "Informationsindustrie"@de-de,
        "Information Industry"@en-gb,
        "Industria de la Información"@es-es,
        "Industria de la Información"@es-mx,
        "Industrie de l'information"@fr-fr,
        "תעשיית המידע"@he-il,
        "सूचना उद्योग"@hi-in,
        "情報産業"@ja-jp,
        "Indústria da informação"@pt-br,
        "信息产业"@zh-cn ;
    skos:definition "The Information industry group comprises establishments engaged in the following processes: producing and distributing information and cultural products, providing the means to transmit or distribute these products as well as data or communications, and processing data." ;
    skos:hiddenLabel "INF" .

<RKUCwOJGfYiSc7zU1qkhAS> a owl:Class ;
    rdfs:label "Cybersecurity Incident" ;
    rdfs:subClassOf <R4VkvTQ3bdGYvonRh8VkvN> ;
    skos:altLabel "IT Security Breach",
        "Network Security Incident" ;
    skos:definition "A Cybersecurity Incident is an event that compromises the confidentiality, integrity, or availability of information systems, data, or networks. These incidents can result from malicious activities such as data breaches, data tampering, denial of service attacks, malware infections, phishing attacks, or ransomware attacks." ;
    skos:prefLabel "Information Security Event" .

<RLdgWVNya1F84PAUEqTftE> a owl:Class ;
    rdfs:label "Bishop" ;
    rdfs:subClassOf <RChKPk9K152BirrIYgAREsY> ;
    skos:altLabel "Catholic Bishop"^^xsd:string,
        "Ordained Bishop"^^xsd:string,
        "Successor of the Apostles"^^xsd:string ;
    skos:definition "A Bishop is an ordained minister who possesses the fullness of the sacrament of Holy Orders and serves as a successor of the apostles. He teaches, sanctifies, and governs a particular church in communion with the Roman Pontiff."^^xsd:string .

<RLrqGkP9fi5OO2RhpttmVI> a owl:Class ;
    rdfs:label "Personal Income" ;
    rdfs:subClassOf <RhBgnef56iLBXYfPqWQE41> ;
    skos:definition "Personal income refers to the total earnings an individual receives from various sources, including wages, salaries, investments, and business activities. It encompasses all monetary inflows before taxes and deductions and serves as the basis for calculating tax liabilities and evaluating financial well-being." .

<RO1j8FWXas50yVNMQcEmtu> a owl:Class ;
    rdfs:label "U.S. Federal Courts" ;
    rdfs:subClassOf <R211876CC3565144782A52d8>,
        <RF9A23e15C1cfD0540b8Afae> ;
    skos:definition "U.S. Federal Courts are a subset of the U.S. Courts and include the U.S. Courts of Appeal, U.S. Federal Courts - Specialty, U.S. Bankruptcy Courts, U.S. Bankruptcy Appellate Panels, U.S. District Courts, and the U.S. Supreme Court." .

<ROgocFufRBHZKkFfPDYyYh> a owl:Class ;
    rdfs:label "Noahic Covenant Events" ;
    rdfs:subClassOf <R7hvAdBWgqXF4EHGunMyE3W> ;
    skos:altLabel "Noah's Covenant Events"^^xsd:string,
        "Post-Diluvian Covenant Events"^^xsd:string ;
    skos:definition "Noahic Covenant Events comprise the specific occasions surrounding God's covenant with Noah after the flood, establishing divine promises to all creation. These events include the flood's conclusion, God's pledge never to destroy the earth again by water, the rainbow sign, and blessings upon Noah and his descendants."^^xsd:string ;
    skos:example "Catechetical materials use Noahic Covenant events to teach children about God's mercy and faithfulness after judgment."^^xsd:string,
        "Catholic liturgy references Noahic Covenant events in baptismal rites, connecting flood waters to baptismal regeneration."^^xsd:string,
        "Environmental Catholic teachings draw upon Noahic Covenant events to emphasize humanity's stewardship responsibilities toward creation."^^xsd:string,
        "Theologians often interpret Noahic Covenant events as God's first universal covenant, extending divine care beyond a chosen people to all creation."^^xsd:string .

<RVG1zLys64KOCQFR2MhzS7> a owl:Class ;
    rdfs:label "European Union" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <RCtXcXKz9zo5jk9QW5UpTyg> ;
            owl:someValuesFrom <RF6Cba46B3af69A47244E9ef> ],
        [ a owl:Restriction ;
            owl:onProperty <RCtXcXKz9zo5jk9QW5UpTyg> ;
