<RDhTcHUNxUGDRmxL1iJYtw8> a owl:Class ;
    rdfs:label "Agoraphobia" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RDKGeTDagCQ714D5C4sASPP> ;
    skos:altLabel "Anxiety Disorder with Avoidance Behavior",
        "Fear of Crowded Places",
        "Fear of Open Spaces" ;
    skos:definition "Agoraphobia is an anxiety disorder characterized by an intense fear of being in situations where escape might be difficult or help unavailable during a panic attack. This fear often leads to avoidance of a variety of situations, such as being outside alone, being in a crowd, or traveling in a vehicle, which can significantly impair daily functioning and social interactions." .

<RDi3Lq2bR8EsG5eTnSk9xkC> a owl:Class ;
