    rdfs:subClassOf <R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Zivilprozessrechtliche Theorien"@de-de,
        "Litigation Civil Legal Theories"@en-gb,
        "Teorías legales civiles de litigación"@es-es,
        "Teorías legales civiles de litigio"@es-mx,
        "Théories juridiques civiles en matière de litiges"@fr-fr,
        "תאוריות משפטיות אזרחיות של תביעה"@he-il,
        "लिटिगेशन सिविल कानूनी सिद्धांत"@hi-in,
        "民事訴訟法的法的理論"@ja-jp,
        "Teorias jurídicas civis de litígio"@pt-br,
        "民事诉讼法律理论"@zh-cn ;
    skos:definition "Litigation Civil Legal Theories refer to the various legal arguments and principles that are used in civil litigation cases, such as the doctrine of collateral estoppel or comparative negligence, to support a party's claim or defense." .

<R7mMPoEuA9Ja4rODr1LGXcR> a owl:Class ;
    rdfs:label "Copyright Work Types" ;
    rdfs:subClassOf <R8O3PoolmgHAy2hrZsguhqy> ;
    skos:definition "Copyright Work Types encompass various forms of creative works such as Derivative Work, Collective Work, and Joint Work, each with unique characteristics and legal implications. Derivative Works are based on pre-existing works, Collective Works involve the assembly of independent works into a single publication, and Joint Works are created by collaboration with merged contributions." .

<R7p3ZBGzc1BxDrCwYJnsTo> a owl:Class ;
    rdfs:label "Structured Finance Agreement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCJWm2dFjUplXz5eRhdcD2k> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RZBGdq2Y9YEuAvMqpgUbGy> ],
        <R7xqVevh0JKSwX977TRIZQV> ;
    skos:definition "A Structured Finance Agreement pertains to complex financial transactions that pool and repackage financial assets, often for the purpose of risk diversification and enhanced returns. These agreements govern the terms, parties involved, and the structure of such transactions." .

<R7qicnAOVCTYIaiJHt9KmIy> a owl:Class ;
    rdfs:label "Medical Test" ;
    rdfs:subClassOf <RBOz1UXsX4cnOePooNnJ6Xc> ;
    skos:altLabel "Clinical Test",
        "Health Examination Procedure" ;
    skos:definition "A Medical Test is a clinical procedure performed to detect, diagnose, or monitor diseases, disease processes, susceptibility, or to determine a course of treatment. Examples include blood tests, DNA tests, drug tests, and paternity tests." ;
    skos:prefLabel "Diagnostic Test" .

<R7wBHDda7bW9qL2BawI6mDA> a owl:Class ;
