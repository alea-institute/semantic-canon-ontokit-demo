<R7pgWczDcp7em4Tl5BCtMsl> a owl:Class ;
    rdfs:label "Non-Responsive Objection" ;
    dc:source "Fed. R. Evid. 403",
        "Fed. R. Evid. 611" ;
    rdfs:subClassOf <R7NB9WJzAFK6tIIGmfIj5Ay>,
        <RBMlUtTtbQUQxrZrkeF8Fpm> ;
    skos:altLabel "Irrelevant Response Objection",
        "Objection to Unrelated Answer" ;
    skos:definition "A Non-Responsive Objection is raised when a party in a legal proceeding believes that a witness's response does not directly address the question asked. This objection seeks to ensure that the testimony remains relevant and focused on the issues at hand." ;
    skos:prefLabel "Objection to Irrelevant Answer" .

