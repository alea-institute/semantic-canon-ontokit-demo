    rdfs:subClassOf <xLHw6gf6RjugSp9uLEXVdw> ;
    skos:definition "This industry comprises establishments primarily engaged in waste management services (except waste collection, waste treatment and disposal, remediation, operation of materials recovery facilities, and waste management consulting services)." ;
