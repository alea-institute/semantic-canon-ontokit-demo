    skos:example "Jesus explains that the different soils represent varied responses to the word of God."^^xsd:string,
        "Seed Among Thorns"^^xsd:string,
        "Seed on Good Soil"^^xsd:string,
        "Seed on Rocky Ground"^^xsd:string,
        "Seed on the Path"^^xsd:string,
        "The Gospels record Jesus teaching the parable of the sower to a large crowd by the sea."^^xsd:string ;
