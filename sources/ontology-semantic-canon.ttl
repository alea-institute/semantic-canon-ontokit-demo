<R3xGk43rf0ke0B2TzL14hC> a owl:Class ;
    rdfs:label "Parish (Actor)" ;
    rdfs:subClassOf <RDMsL8T3t9qIU3TOdiJvQBN> ;
    skos:altLabel "Local Parish"^^xsd:string,
        "Parish Community"^^xsd:string,
        "Parochial Church"^^xsd:string ;
    skos:definition "A Parish is a stable community of the faithful within a particular church, entrusted to a pastor under the authority of the diocesan bishop. It functions as a juridic person responsible for local pastoral care, worship, and catechesis."^^xsd:string ;
    skos:example "A parish provides regular access to the sacraments for the faithful."^^xsd:string,
        "The pastor governs the parish under the bishop’s authority."^^xsd:string .

