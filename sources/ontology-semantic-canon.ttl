    rdfs:subClassOf <R8LxIR1bsgFd3td2G24G3mq> ;
    skos:altLabel "Trisomy X" ;
    skos:definition "Trisomy X Syndrome, also known as XXX Syndrome, is a genetic condition where a female has three X chromosomes instead of the usual two. This extra chromosome affects development and can lead to a range of physical, cognitive, and behavioral symptoms." ;
    skos:prefLabel "XXX Syndrome" .

<RCXoaxDQzImfLTr6iEUwNW1> a owl:Class ;
