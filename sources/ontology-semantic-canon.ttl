    rdfs:subClassOf <uCdCZ9mWR8KaGSkIOI05kQ> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in providing waste management services (except waste collection, waste treatment and disposal, remediation, operation of materials recovery facilities, septic tank pumping and related services, and waste management consulting services)." ;
