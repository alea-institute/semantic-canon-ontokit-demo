<R8LxIR1bsgFd3td2G24G3mq> a owl:Class ;
    rdfs:label "Congenital Disorders that Affect Multiple Body Systems" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/10.00-MultipleBody-Adult.htm> ;
    rdfs:subClassOf <RD12xMI38C0qkkx19ISgWWD> ;
    skos:definition "Congenital disorders that affect multiple body systems are conditions present from birth that impact several organ systems. These disorders often lead to a range of physical and developmental abnormalities affecting the functioning of multiple systems in the body." .

<R8O3PoolmgHAy2hrZsguhqy> a owl:Class ;
    rdfs:label "Copyright Concept Objectives" ;
    rdfs:subClassOf <RCzs34uEQI9f4cuWp3bQO0P>,
        <RhRZrC0x98pp0kpwiGgwSD> ;
    skos:definition "Copyright Concept Objectives refer to the criteria that a work must meet to be eligible for copyright protection. These objectives can include originality, expression in a tangible medium, and creativity, ensuring the work is a unique creation of the author." .

<R8XMs89zuZc9chn6WQ9Fgbm> a owl:Class ;
