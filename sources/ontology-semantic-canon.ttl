    rdfs:subClassOf <RDECjssxw76vdlahxiUTb4L> ;
    skos:definition "Missouri Circuit Court - Holt County refers to a specific court within the Missouri Circuit Court system that has jurisdiction over legal matters within Holt County, Missouri." .

<RzQ5gwUabt1mu60F6pstMJ> a owl:Class ;
    rdfs:label "Tiv" ;
    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Tiv"@de-de,
        "Tiv"@fr-fr,
        "ティブ"@ja-jp,
        "Tiv"@pt-br,
        "蒂夫"@zh-cn ;
    skos:definition "Tiv (Language) is a structured system of communication that consists of grammar and vocabulary, and is spoken in Nigeria by the Tiv people." .

<RzRvQLXgcqPkW5S6dyNZCP> a owl:Class ;
    rdfs:label "Creoles and pidgins, French-based" ;
    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Französisch-basierte Kreol- und Pidgin-Sprachen"@de-de,
        "Créoles et pidgins basés sur le français"@fr-fr,
        "フランス語ベースのクレオール語およびピジン語"@ja-jp,
        "Crioulos e pidgins baseados em francês"@pt-br,
        "法语为基础的克里奥尔语和皮钦语"@zh-cn ;
    skos:definition "A French-based Creole or Pidgin language, which is a simplified language that develops as a means of communication between groups who do not share a common language, but have frequent contact with each other, and which has evolved from French." .

<RzS5kQCctIh5w09UGh8ahy> a owl:Class ;
    rdfs:label "Administrative Negligence" ;
    rdfs:subClassOf <R9b5fs8QJuliSZYeaJLJU2t>,
        <RCfunX4u69LUQ3gbhckE0oI> ;
    skos:altLabel "Verwaltungspflichtverletzung"@de-de,
        "Administrative Negligence"@en-gb,
        "Negligencia Administrativa"@es-es,
        "Negligencia Administrativa"@es-mx,
        "Négligence administrative"@fr-fr,
        "הזנחה מנהלית"@he-il,
        "प्रशासनिक लापरवाही"@hi-in,
        "行政上の過失"@ja-jp,
        "Negligência administrativa"@pt-br,
        "行政疏忽"@zh-cn ;
    skos:definition "Administrative Negligence is a legal concept that refers to the failure of a government agency or official to perform their duties with reasonable care, resulting in harm or injury to individuals or the public." .

<RzWHx3gJWwaAVC6eqJEZVF> a owl:Class ;
