<RDTk2HkCDoobuZxiZmytMwx> a owl:Class ;
    rdfs:label "Psychotic Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RBOBgLFktExGekPrKF5oWmr> ;
    skos:definition "Psychotic Disorder is a broad category of mental health conditions characterized by a loss of contact with reality, which can manifest through symptoms such as hallucinations, delusions, disorganized thinking, and impaired insight. Individuals with psychotic disorders may experience significant disturbances in perception, thought processes, and behavior, affecting their ability to function in daily life." ;
    skos:prefLabel "Psychosis" .

