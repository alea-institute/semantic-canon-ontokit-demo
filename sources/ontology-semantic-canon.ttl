<RLoMwtVZOH407TSzI4gtgp> a owl:Class ;
    rdfs:label "Employment Leave" ;
    rdfs:subClassOf <RBila9ckW95W84Tk54tGfZO> ;
    skos:definition "\"Employment Leave\" refers to authorized periods of time when an employee is permitted to be absent from work while retaining their employment status. This can include various types of leave, such as vacation leave, sick leave, parental leave, or other forms of time off that employees may be entitled to based on their employment contracts or labor laws." .

<RNw3wCvXyyjEPknfOpicmf> a owl:Class ;
