<RceM7BMd4OmxX00dRlAprg> a owl:Class ;
    rdfs:label "Nephrotic Syndrome" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/6.00-Genitourinary-Adult.htm#6_06> ;
    rdfs:subClassOf <R7z8IPBHMwVOHP53OFYeSZN> ;
    skos:altLabel "Nephrotic Disorder",
        "Proteinuria Syndrome" ;
    skos:definition "Nephrotic Syndrome is a kidney disorder characterized by excessive protein loss in the urine, low blood protein levels, high cholesterol, and swelling (edema). This condition results from damage to the kidney's filtering units (glomeruli) and can lead to complications requiring medical management." ;
    skos:prefLabel "Nephrosis" .

<RceZ38f0Kx5YV2ri1nUyMf> a owl:Class ;
    rdfs:label "Misfeasance in Public Office" ;
    rdfs:subClassOf <RDqSn32zsjxExcBFzIYxT2D> ;
    skos:altLabel "Abuse Of Public Office",
        "Malfeasance In Public Office",
        "Public Officer Misconduct" ;
    skos:definition "Misfeasance in public office is a legal cause of action in some jurisdictions (e.g., United Kingdom), where a public officer abuses their position by acting unlawfully with malice or reckless disregard for the harm caused. This tort requires proof of deliberate wrongful conduct by the officer, resulting in damage to the claimant." ;
    skos:prefLabel "Official Misconduct" .

<RcedW7umYlqo0ua5vLpBub> a owl:Class ;
    rdfs:label "Affiliate Non-Debtor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R77pHybcEdlO9OmqSuiyWi1> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Affiliated Non-Debtor",
        "Associated Non-Debtor",
        "Connected Non-Debtor",
        "Related Non-Debtor" ;
    skos:definition "An affiliate non-debtor is a company or entity related to a debtor through common ownership, control, or significant financial interest, but which itself is not undergoing bankruptcy proceedings. Such entities may be involved in the bankruptcy case due to financial ties, guarantees, or shared obligations with the debtor." .

<Rcfgxuij0em7k0pjQKFJCm> a owl:Class ;
    rdfs:label "Recreational Immunity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDSBerlLWg1ntpLqDQn1eVn> ],
        <RCzs34uEQI9f4cuWp3bQO0P> ;
    skos:altLabel "Haftungsausschluss für Freizeitaktivitäten"@de-de,
        "Recreational Immunity"@en-gb,
        "Inmunidad recreativa"@es-es,
        "Inmunidad recreativa"@es-mx,
        "Immunité récréative"@fr-fr,
        "חסינות רפואית"@he-il,
        "मनोरंजन अवरोध"@hi-in,
        "レクリエーショナル免責"@ja-jp,
        "Imunidade recreativa"@pt-br,
        "娱乐豁免"@zh-cn ;
    skos:definition "Recreational immunity exists as a defense for owners and/or occupiers of land as long as the plaintiff's recreational use was uninvited, used without fee, and there was no unreasonable risks that the owner/occupier should have known or knew existed." .

<Rcg25mdkNuZujwumYxjJUt> a owl:Class ;
    rdfs:label "New York City Court - New Rochelle" ;
    rdfs:subClassOf <RCz0OhGJQscjwPvw2jQBP63> ;
    skos:definition "A court located in New Rochelle that operates under the jurisdiction of the New York City Court." .

<RcjE7ZFthlfdvlhZ5GCJyj> a owl:Class ;
    rdfs:label "Spousal Support Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDeWjTZogrlt1XvduSP1R8s> ],
        <R7widavYhXmyfw9WvR9ahBs> ;
    skos:definition "A Spousal Support Claim is a legal request made by one spouse to receive financial assistance from the other spouse following a divorce or separation. This claim is typically based on factors such as income disparity, the length of the marriage, and each spouse's financial needs and contributions during the marriage. Spousal support, also known as alimony, is designed to provide financial support to the lower-earning spouse to help them maintain their standard of living or become financially independent." ;
    skos:prefLabel "Alimony Claim" .

<Rck2jHWol8s1ZYn5aZWzk> a owl:Class ;
    rdfs:label "Arkansas Circuit Court - Pike Cty." ;
    rdfs:subClassOf <RCEWWtS3nM8GE8R4en1abRz> ;
    skos:definition "A court located in Pike County, Arkansas that has jurisdiction over certain legal matters within its geographical boundaries." .

<RcsmW8Wmu47y1GzwWHiFl1> a owl:Class ;
    rdfs:label "Testator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <RCDOABUr8ZTMQ7N7Rydeius> ;
            owl:someValuesFrom <RDK3ploePpyFDgIkSzbOCtX> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Testatrix",
        "Will-maker" ;
    skos:definition "A Testator is an individual who creates and executes a valid will, specifying how their estate should be distributed after their death. This person must have the legal capacity to make a will and clearly express their intentions regarding the disposition of their property and assets." .

<RcutwK5AAUoSsZbULJMTlE> a owl:Class ;
    rdfs:label "Delaware Justice of the Peace Court" ;
    rdfs:subClassOf <RFED426F2C97b94Fa28DA94e> ;
    skos:definition "The Delaware Justice of the Peace Court is a court within the Delaware State Courts system that has jurisdiction over civil and criminal cases involving minor offenses and disputes." .

<RcwQtGZrohiyAqPHf1j0JE> a owl:Class ;
    rdfs:label "Personally Identifiable Information" ;
    rdfs:subClassOf <R8Ov4MbOJULZY0aLe1KoP3Z> ;
    skos:definition "Personally Identifiable Information (PII) is any data that can be used to identify, contact, or locate a specific individual. This includes names, addresses, phone numbers, email addresses, social security numbers, and other identifiers that can be linked to a particular person." ;
    skos:prefLabel "PII" .

<Rcy81XCcFSQOGSZR4McUGh> a owl:Class ;
    rdfs:label "Parable of the Weeds Among the Wheat" ;
    rdfs:subClassOf <R9UCFdrDU3BruofWcw9xAr5> ;
    skos:altLabel "Parable of the Tares"^^xsd:string,
        "Weeds and Wheat Parable"^^xsd:string ;
    skos:definition "Parable of the Weeds Among the Wheat means the teaching in which Jesus Christ compares the Kingdom of God to a field where wheat and weeds grow together until the harvest. Parable of the Weeds Among the Wheat reveals God’s patience, the coexistence of good and evil in the present age, and the certainty of final judgment."^^xsd:string ;
    skos:example "Christian theology interprets the parable of the weeds among the wheat as teaching divine patience and ultimate justice."^^xsd:string,
        "The Gospel of Matthew records Jesus explaining why the wheat and weeds must grow together until harvest."^^xsd:string .

<RcyQuaYdvmOmAVROvfH6sk> a owl:Class ;
    rdfs:label "Impounding Property to Pay Debt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R77pHybcEdlO9OmqSuiyWi1> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7PHFZzZmVmczzNQl6iZKsa> ],
        <RWS7oVs9s2563KGt41Lsta> ;
    skos:altLabel "Beschlagnahme von Eigentum zur Begleichung von Schulden"@de-de,
        "Impounding Property to Pay Debt"@en-gb,
        "Embargo de bienes para pagar deudas"@es-es,
        "Embargo de propiedad para pagar deudas"@es-mx,
        "Saisie de biens pour payer une dette"@fr-fr,
        "מילוי פקדון על נכסים לשם תשלום חוב"@he-il,
        "ऋण चुकाने के लिए संपत्ति को जब्त करना"@hi-in,
        "債務の支払いのための財産の差し押さえ"@ja-jp,
        "Apreensão de propriedade para pagar dívida"@pt-br,
        "扣押财产以偿还债务"@zh-cn ;
    skos:definition "The concept of \"Impounding Property to Pay Debt\" refers to the legal process of seizing and holding property as collateral to satisfy a debt owed by the property owner, typically in cases of equitable claims." .

<RczeqLCiQcpcD5zzteMw71> a owl:Class ;
    rdfs:label "Mission of the Apostles" ;
    rdfs:subClassOf <ROaU08jUOgsbTbTXXNTIXX> ;
    skos:altLabel "Apostolic Mission"^^xsd:string,
        "Evangelizing Mission of the Apostles"^^xsd:string,
        "Great Commission"^^xsd:string ;
    skos:definition "Mission of the Apostles means the sending forth of the apostles by Jesus Christ, empowered by the Holy Spirit, to proclaim the Gospel to all nations. Mission of the Apostles establishes the Church’s universal, evangelical, and sacramental mission in history."^^xsd:string ;
    skos:example "Christian theology understands the mission of the apostles as the foundation of the Church’s evangelizing work in every age."^^xsd:string,
        "The Acts of the Apostles records the apostles preaching the Gospel throughout the Mediterranean world."^^xsd:string .

<Rd2J0V6Magzui25PaTTJ5n> a owl:Class ;
    rdfs:label "Promissory Fraud" ;
    rdfs:subClassOf <R8Eq21fpzUIBqpXfAaS2Xbo> ;
    skos:altLabel "Verschuldensbetrug"@de-de,
        "Promissory Fraud"@en-gb,
        "Fraude promisorio"@es-es,
        "Fraude promisorio"@es-mx,
        "Fraude promesse de paiement"@fr-fr,
        "הונאת חיוב"@he-il,
        "प्रतिज्ञात्मक धोखाधड़ी"@hi-in,
        "約束不履行詐欺"@ja-jp,
        "Fraude promissória"@pt-br,
        "允诺欺诈"@zh-cn ;
    skos:definition "The concept of Promissory Fraud refers to a type of fraudulent misrepresentation where a party makes a promise with no intention of keeping it, in order to induce another party to enter into a contract or take some other action to their detriment." .

<Rd3Z1kCqjqGfSSXLxegvvd> a owl:Class ;
    rdfs:label "Economic Community of West African States" ;
    rdfs:subClassOf <R9H0HvybK6M3RpFebn0SDLu> ;
    skos:definition "ECOWAS (Economic Community of West African States): A regional group of fifteen West African countries, founded to promote economic integration across the region." ;
    skos:prefLabel "ECOWAS" .

<Rd4I2kGzK469bAj33d1mGk> a owl:Class ;
    rdfs:label "Hail, Joseph" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RyTfHxUQPVMUQrtIt1Mycz> ;
    skos:altLabel "Prayer to Saint Joseph"^^xsd:string ;
    skos:definition "Hail, Joseph is a devotional prayer honoring Saint Joseph and seeking his intercession, protection, and guidance. It praises Joseph’s righteousness and fidelity while entrusting personal and familial needs to his care."^^xsd:string ;
    skos:example "Before beginning work, he recited Hail, Joseph seeking guidance and protection."^^xsd:string,
        "During the Year of Saint Joseph, parishes encouraged the faithful to pray Hail, Joseph daily."^^xsd:string,
        """Hail, Joseph, image of the Eternal Father;
Hail, Joseph, guardian of the Eternal Son;
Hail, Joseph, temple of the Eternal Spirit;
Hail, Joseph, beloved of the Trinity.
Hail, Joseph, spouse and companion of the Mother of God.
Hail, Joseph, friend of angels.
Hail, Joseph, believer in miracles.
Hail, Joseph, follower of dreams.
Hail, Joseph, lover of simplicity.
Hail, Joseph, exemplar of righteousness;
Hail, Joseph, model of meekness and patience;
Hail, Joseph, model of humility and obedience.
Blessed are the eyes that have seen what you saw.
Blessed are the ears that have heard what you heard.
Blessed are the arms that have embraced what you embraced.
Blessed is the lap that has held what you held.
Blessed is the heart that has loved what you loved.
Blessed is the Father who chose you;
Blessed is the Son who loved you:
Blessed is the Spirit who sanctified you.
Blessed is Mary, your spouse, who honored and loved you.
Blessed is the angel who guarded and led you.
And blessed be forever all who remember and honor you."""^^xsd:string .

<Rd5fNypp3e7sdvAs1Xmm4O> a owl:Class ;
    rdfs:label "Emergency Medical Treatment and Active Labor Act Claim" ;
    rdfs:subClassOf <RCidddiy9X9fqxmBCyYguuE> ;
    skos:altLabel "EMTALA Claim",
        "Emergency Medical Care Claim",
        "Emergency Medical Treatment Claim" ;
    skos:definition "An EMTALA Claim arises when a healthcare provider fails to comply with the obligations under the Emergency Medical Treatment and Active Labor Act, which requires hospitals to provide emergency medical treatment to all individuals regardless of their ability to pay. This claim involves allegations that the hospital did not provide appropriate medical screening, necessary stabilizing treatment, or an appropriate transfer of an unstable patient." ;
    skos:prefLabel "EMTALA Violation Claim" .

