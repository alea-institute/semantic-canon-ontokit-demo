        "Code des réglementations fédérales des États-Unis"@fr-fr,
        "米国連邦規則集"@ja-jp,
        "Código de Regulamentações Federais dos EUA"@pt-br,
        "美国联邦法规"@zh-cn ;
    skos:definition "Rules or orders issued by a United States governmental regulatory agency and having the force of law." .

<R9H4TEsEcgxSg5BEzliohZS> a owl:Class ;
    rdfs:label "Penalty Proceeding" ;
    rdfs:subClassOf <RBV3MQlbGLIUVo5fSiBZ2V4> ;
    skos:altLabel "Strafverfahren"@de-de,
        "Penalty Proceeding"@en-gb,
        "Procedimiento sancionador"@es-es,
        "Procedimiento de sanción"@es-mx,
        "Procédure pénale"@fr-fr,
        "הליך עונש"@he-il,
        "जुर्माना प्रक्रिया"@hi-in,
        "罰則手続き"@ja-jp,
        "Processo penal"@pt-br,
        "处罚程序"@zh-cn ;
    skos:definition "A penalty proceeding is a legal process that deals specifically with the determination and imposition of punishment for a criminal offense." .

<R9H9E6iCIt9ve7Bbyoyt1vR> a owl:Class ;
    rdfs:label "Do This in Remembrance of Me" ;
    rdfs:subClassOf <R83qv1lc6haj7YdVbcf75oC> ;
    skos:altLabel "Anamnesis Command"^^xsd:string,
        "Eucharistic Memorial Command"^^xsd:string ;
    skos:definition "“Do This in Remembrance of Me” is the directive given by Jesus at the Last Supper commanding the repetition of the meal he instituted. It establishes the memorial character of the Eucharistic action as an ongoing participation in his self-giving."^^xsd:string ;
    skos:example "A catechetical lesson connected “Do This in Remembrance of Me” to the concept of anamnesis."^^xsd:string,
        "A theology class explained “Do This in Remembrance of Me” as grounding the repeated celebration of the Eucharist."^^xsd:string,
        "During the Eucharistic Prayer, the memorial command “Do This in Remembrance of Me” was recalled."^^xsd:string .

<R9H9OMSGtJ376F4xzlqj2js> a owl:Class ;
