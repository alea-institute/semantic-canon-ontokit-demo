<RuidEWPhqdnezHnYG0X8LX> a owl:Class ;
    rdfs:label "Claim for Falling on Grease" ;
    rdfs:subClassOf <R6BgoOCiXfPfFeBgDhUcP3> ;
    skos:altLabel "Anspruch auf Sturz durch Fett"@de-de,
        "Claim for Falling on Grease"@en-gb,
        "Reclamación por caída en grasa"@es-es,
        "Reclamo por caída en grasa"@es-mx,
        "Réclamation pour chute sur de la graisse"@fr-fr,
        "תביעה על נפילה על שומן"@he-il,
        "ग्रीस पर गिरने के दावे"@hi-in,
        "グリースで転倒した場合の請求"@ja-jp,
        "Reivindicação por queda em gordura"@pt-br,
        "滑倒在油脂上的索赔"@zh-cn ;
    skos:definition "A claim for falling on grease is a legal assertion made by a plaintiff who has suffered injury due to slipping on a surface contaminated with grease, and is a subcategory of the broader concept of slip-and-fall negligence." .

<Ruiy0zsIf3NYCzYWb5tsLa> a owl:Class ;
    rdfs:label "Voter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDkKltCs6qv3E5GLBaSJ8H4> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9L7kPrkn8q0VbbyH4lv1VJ> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R78PKqeEIORKpYVwEfC4aG4> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RD3CNG3ecVo2oIloP4lYFoX> ],
        <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:altLabel "Constituency Member",
        "Eligible Voter",
        "Registered Voter" ;
    skos:definition "A voter, also known as an Elector, is an individual who is eligible to vote in an election. This term can also refer to a member of an electoral college, who has the formal responsibility to cast votes for the selection of certain public officials, such as the President of the United States." ;
    skos:prefLabel "Elector" .

<RulqnGleVcEjHpYjMlCpEr> a owl:Class ;
    rdfs:label "Christ's Ascension" ;
    rdfs:comment "In a worldwide Catholic ontology, the Ascension marks the definitive entry of Jesus’ humanity into divine glory. This event concludes the visible earthly mission of the Son and serves as the necessary precursor to the outpouring of the Holy Spirit at Pentecost."^^xsd:string ;
    rdfs:subClassOf <R7oT3qg4wZmB5K3qC79EVID> ;
    skos:altLabel "Ascensio Domini"^^xsd:string,
        "Exaltation of Jesus"^^xsd:string,
        "Glorification of the Son"^^xsd:string ;
    skos:definition "The Ascension is the event where Jesus, forty days after his resurrection, was taken up body and soul into heaven in the presence of his apostles. This mystery signifies the exaltation of human nature to the right hand of the Father and the inauguration of Christ’s kingdom as the eternal High Priest and King."^^xsd:string ;
    skos:example "Meditating on the second Glorious Mystery of the Rosary helps the soul focus on the hope for heaven opened by Christ's Ascension."^^xsd:string,
        "Observing the Solemnity of Christ's Ascension as a Holy Day of Obligation affirms the belief in his bodily return to the Father."^^xsd:string,
        "Reciting the Apostles' Creed reminds the faithful that after Christ's Ascension, he sits at the right hand of God the Father Almighty."^^xsd:string .

<Rut-9YyvT3OL__I9r1Z7lg> a owl:Class ;
    rdfs:label "Nuclear Electric Power Generation" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=221113> ;
    rdfs:subClassOf <SGahJEz_Tfqwxxi7eSpqlA> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in operating nuclear electric power generation facilities. These facilities use nuclear power to produce electric energy. The electric energy produced in these establishments is provided to electric power transmission systems or to electric power distribution systems." .

<RuyZNixKnG2371yxDSwvf1> a owl:Class ;
