<RCEWELscWeQgFlaCSP4lGWU> a owl:Class ;
    rdfs:label "Social Sin" ;
    rdfs:subClassOf <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Collective Moral Disorder"^^xsd:string,
        "Cultural Sin"^^xsd:string,
        "Institutional Sin"^^xsd:string,
        "Structural Sin"^^xsd:string,
        "Systemic Injustice"^^xsd:string ;
    skos:definition "Social Sin is sin that arises from, is embedded in, or is sustained by social structures, institutions, or collective behaviors that contradict justice and charity. Social Sin does not remove personal moral responsibility, but it names the ways personal sins accumulate and become normalized within communities and systems."^^xsd:string ;
    skos:example "Social sin appears when institutions conceal wrongdoing to preserve power or reputation."^^xsd:string,
        "Social sin calls for both personal conversion and structural reform."^^xsd:string,
        "Social sin develops when widespread indifference allows injustice to persist unchecked."^^xsd:string,
        "Social sin exists when economic systems systematically deny just wages to workers."^^xsd:string,
        "Social sin operates where laws or policies normalize discrimination against certain groups."^^xsd:string .

