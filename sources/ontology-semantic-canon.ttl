<RCthbEuajfX7qrWV1Yxx8Ta> a owl:Class ;
    rdfs:label "Employment Authorization Document" ;
    rdfs:subClassOf <R7gKTQpOKfQ2tOdPu6cLN3w> ;
    skos:altLabel "E-Verify Document" ;
    skos:definition "Employment Authorization Documents (EADs) are permits granted by a country's immigration authority to allow foreign nationals to work legally within its borders. Types of EADs can include those for students, refugees or asylum seekers, dependents of primary visa holders, and individuals under special humanitarian or temporary protection programs." ;
    skos:prefLabel "EAD" .

<RCvUeqSzQeb2dseyMDNAJxp> a owl:Class ;
