        "国家海洋和大气管理局"@zh-cn ;
    skos:definition "The National Oceanic and Atmospheric Administration (NOAA) is an American scientific agency within the United States Department of Commerce that focuses on the conditions of the oceans, major waterways, and the atmosphere." ;
    skos:hiddenLabel "NOAA" ;
    skos:prefLabel "National Oceanic and Atmospheric Administration" .

<RDBNvrjRMjhGoNQzmzCt1Zh> a owl:Class ;
