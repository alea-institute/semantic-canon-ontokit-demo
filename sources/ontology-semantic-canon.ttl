    rdfs:subClassOf <iFgJwLD8TVCnTgHg1Aj4WQ> ;
    skos:definition "This industry comprises establishments primarily engaged in preparing and serving meals and snacks for immediate consumption from motorized vehicles or nonmotorized carts. The establishment is the central location from which the caterer route is serviced, not each vehicle or cart. Included in this industry are establishments primarily engaged in providing food services from vehicles, such as hot dog carts and ice cream trucks." ;
    skos:example "Ice cream truck vendors",
        "Mobile canteens",
        "Mobile food carts and trucks",
