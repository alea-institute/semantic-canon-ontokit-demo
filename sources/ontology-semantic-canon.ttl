    rdfs:subClassOf <R7NB9WJzAFK6tIIGmfIj5Ay> ;
    skos:altLabel "Lawyer Testifying",
        "Leading Question Objection",
        "Suggestive Question Objection" ;
    skos:definition "An objection to a leading question is raised when a party in a legal proceeding believes that a question posed by the opposing counsel improperly suggests an answer to the witness. Leading questions are generally not allowed during direct examination but may be permitted during cross-examination." ;
    skos:prefLabel "Lawyer Testifying Objection" .

<RVcCszu01sLSiXW2CvBBE7> a owl:ObjectProperty ;
