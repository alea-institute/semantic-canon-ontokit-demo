<R9mTGKaFostHJfLRPz7vsst> a owl:Class ;
    rdfs:label "Armed Conflict" ;
    rdfs:comment "In a global Catholic ontology, Armed Conflict denotes the use of physical force and weaponry between organized groups or nations. It represents a grave failure of social order that the Church seeks to limit and ultimately resolve through the application of the \"tranquillity of order\" described by Saint Augustine."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7qVMTAfVUMCpr6LhRZ23eF> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7iSh4AXN4oJuPPGv1KQDnD> ],
        <R8G6kTX09ac1e8BHuaPSHc3> ;
    skos:altLabel "Armed Discord"^^xsd:string,
        "Armed Warfare"^^xsd:string,
        "Hostilities"^^xsd:string,
        "Military Hostilities"^^xsd:string,
        "Violent Contention"^^xsd:string,
        "Warfare"^^xsd:string ;
    skos:definition "Armed Conflict is a state of open, physical hostility between two or more parties employing lethal force to achieve political, social, or religious objectives. It triggers the immediate application of international humanitarian law and the specific ethical constraints of the Just War tradition to protect human life."^^xsd:string ;
    skos:example "Deploying peacekeepers to separate two warring factions and establish a humanitarian corridor."^^xsd:string,
        "Engaging in naval skirmishes over disputed international shipping lanes."^^xsd:string,
        "Invoking the right of self-defense against an unprovoked cross-border military incursion."^^xsd:string ;
    skos:prefLabel "Combat"^^xsd:string .

