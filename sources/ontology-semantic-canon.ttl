    skos:altLabel "Kriminelle Absicht"@de-de,
        "Criminal Intent"@en-gb,
        "Intención Criminal"@es-es,
        "Intención Criminal"@es-mx,
        "Intention criminelle"@fr-fr,
        "כוונה פלילית"@he-il,
        "अपराधी इरादा"@hi-in,
        "犯罪意図"@ja-jp,
        "Intenção criminosa"@pt-br,
        "犯罪意图"@zh-cn ;
    skos:definition "The mental state of a person when they commit a crime, including the intention to commit the act and knowledge of its wrongfulness." .

<RBp9ycllxg1PqalOMlG8bdV> a owl:Class ;
    rdfs:label "Sound Recording" ;
    rdfs:subClassOf <RVaHiNBU68DENmeHicnzro> ;
    skos:altLabel "Recorded Audio" ;
    skos:definition "A Sound Recording is a captured audio performance of sounds, whether musical, spoken, or otherwise, stored in a medium that can be played back, such as digital files, CDs, or vinyl records." ;
    skos:prefLabel "Audio Recording" .

<RBpPod3eNjfLujqcKrmjwq9> a owl:Class ;
    rdfs:label "Value Added Tax Payment" ;
    rdfs:subClassOf <R7NkMt6XJKd4fSolKqqOy5B> ;
    skos:altLabel "VAT",
        "Value Added Taxes",
        "Value-Added Tax Settlement",
        "Value-Added Taxation" ;
    skos:definition "Value Added Tax (VAT) Payment encompasses all general consumption taxes charged on the value added to goods and services, irrespective of the method of deduction and the stages at which the taxes are levied. Typically, VAT allows for the immediate deduction of taxes on purchases by all entities except the final consumer and is imposed at all stages of production and distribution. In some countries, this category may include taxes on financial and insurance activities due to the difficulty in separating these receipts from general VAT collections or because they are considered integral to the VAT system." ;
    skos:prefLabel "VAT Remittance" .

<RBqllOhzLheS3cnSiDAJ5H0> a owl:Class ;
