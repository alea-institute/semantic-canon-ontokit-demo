    skos:altLabel "Grabesrecht"@de-de,
        "Right of Sepulcher"@en-gb,
        "Derecho de Sepultura"@es-es,
        "Derecho de Sepultura"@es-mx,
        "Droit de sépulture"@fr-fr,
        "זכות הקבורה"@he-il,
        "समाधि का अधिकार"@hi-in,
        "墓地使用権"@ja-jp,
        "Direito de sepultamento"@pt-br,
        "墓地使用权"@zh-cn ;
    skos:definition "The Right of Sepulcher is a legal claim that grants a person the right to control the burial and funeral arrangements of a deceased loved one." .

<R8TdEzcPmKmlt57CbOAlm7> a owl:Class ;
    rdfs:label "Not Guilty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBf9jW3bWpfP4TPEFOvvZEv> ],
        <RB3ZDkOj3NY83VeYDOB98XR> ;
    skos:definition "\"Not guilty\" is a legal determination made by a court in a criminal case when the defendant has been acquitted or found not responsible for the charges brought against them. It indicates that the prosecution failed to prove the defendant's guilt, and as a result, the defendant is not subject to criminal penalties or convictions for the alleged crime." .

<R8WVl8JMk7gYU2NB0NpirR> a owl:Class ;
