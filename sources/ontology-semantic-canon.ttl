<Rz9N1etzkn69qEZxXM9u8y> a owl:Class ;
    rdfs:label "Copyright Registration Document" ;
    rdfs:subClassOf <R7KdQLWwrvkyzohDgf48st7> ;
    skos:definition "A Copyright Registration Document is the official certificate issued by a copyright office, such as the U.S. Copyright Office, confirming the registration of a specific work. The document serves as public record of the copyright claim and provides prima facie evidence of copyright ownership, facilitating the enforcement of rights in legal disputes." .

<RzGXWT98X1MCqqF7qmUX9p> a owl:Class ;
    rdfs:label "Indiana Circuit Court - Montgomery County" ;
    rdfs:subClassOf <RCeiXNGpqL4H3jo1g1NobSm> ;
    skos:definition "The Indiana Circuit Court - Montgomery County is a specific court within the Indiana Circuit Court system that has jurisdiction over legal proceedings in Montgomery County, Indiana." .

<RzIJZXc6tTGicYzJN2DGNJ> a owl:Class ;
    rdfs:label "Protected Timberland" ;
    rdfs:subClassOf <R9BC2mdYLFmSyLcCkV4odRX>,
        <R9I2QOa7u8LwCRqKo4FKdPd> ;
    skos:altLabel "Conservation Forest",
        "Reserved Woodland" ;
    skos:definition "Protected Timberland refers to forested land that is designated for conservation and protection from logging and other forms of exploitation. This designation is often made to preserve biodiversity, protect wildlife habitats, and maintain ecological balance." ;
    skos:prefLabel "Protected Forest" .

<RzJaP103NpVYmpWyxwyzXl> a owl:Class ;
    rdfs:label "Prisoner of War" ;
    rdfs:comment "In a global Catholic ontology, the concept of a Prisoner of War is viewed through the lens of human dignity and the requirements of justice during and after armed conflict. The Church asserts that even in captivity, a person never loses their inherent rights or their status as a child of God."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBJlYzE4ZY14dTEghzbbMHg> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Ruy2YPvV0BMCjA7etGq56l> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7q90spH4wsRFATpgyr6hx0> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RPh8aR0hguQPyn0Z23MfNo> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R0TZk2qCI4HPwDl3e9FoOo> ],
        <RCExQDQMRV5lwxQZb0jTcDH> ;
    skos:altLabel "Captive Combatant"^^xsd:string,
        "Detained Belligerent"^^xsd:string,
        "Enemy Combatant"^^xsd:string ;
    skos:definition "A Prisoner of War is a member of the armed forces or an associated combatant who falls into the power of an enemy during an international armed conflict. This status requires that the detaining power treat the individual humanely and protect them from all acts of violence, insults, and public curiosity."^^xsd:string ;
    skos:example "Allowing a military chaplain access to detention facilities to administer the Sacraments to those held in captivity."^^xsd:string,
        "Organizing the safe return of detainees to their home country once active hostilities have ceased."^^xsd:string,
        "Providing adequate food and medical care to captured soldiers regardless of their national origin."^^xsd:string ;
    skos:prefLabel "POW"^^xsd:string .

<RzPFpJps5y0LYrU19fPgDl> a owl:Class ;
