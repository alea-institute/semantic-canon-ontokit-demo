<RuliWeVDE8CQi4AATMNab1> a owl:Class ;
    rdfs:label "Abstention Doctrines" ;
    rdfs:subClassOf <RB7BB00LuJawNLM8CZW6z7U> ;
    skos:altLabel "Enthaltungsdoktrinen"@de-de,
        "Abstention Doctrines"@en-gb,
        "Doctrinas de Abstención"@es-es,
        "Doctrinas de Abstención"@es-mx,
        "Doctrines d'abstention"@fr-fr,
        "תאוריות המניעה"@he-il,
        "अल्पविराम नीतियाँ"@hi-in,
        "棄権主義"@ja-jp,
        "Doutrinas de abstenção"@pt-br,
        "弃权原则"@zh-cn ;
    skos:definition "Abstention Doctrines refer to legal theories that allow federal courts to abstain from exercising jurisdiction over a case in deference to state court proceedings, including Pullman Abstention, Brillhart-Wilton Abstention, Younger Abstention, Burford Abstention, and Colorado River Abstention." .

<RwipRpN2mP7u4u1N74MVzK> a owl:Class ;
    rdfs:label "Commerce Clause Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R78bV0IQasgnKfZBYYexReQ> ],
        <RB0OjYiZ6X1hMIZOMK1KqhB>,
        <RDkqXQLaqeFlhG4isnkHJuv> ;
    skos:altLabel "Handelsklauselanspruch"@de-de,
        "Commerce Clause Claim"@en-gb,
        "Reclamación de la Cláusula de Comercio"@es-es,
        "Reclamación de la Cláusula de Comercio"@es-mx,
        "Revendication de la clause de commerce"@fr-fr,
        "תביעת סעיף המסחר"@he-il,
        "वाणिज्य धारा दावा"@hi-in,
        "商業条項請求"@ja-jp,
        "Reivindicação da Cláusula de Comércio"@pt-br,
        "商务条款索赔"@zh-cn ;
    skos:definition "A Commerce Clause claim is a legal argument centered on the interpretation of the Commerce Clause in the United States Constitution, which grants Congress the power to regulate interstate commerce. These claims often involve disputes over the scope of federal authority to regulate economic activities or address issues that may impact multiple states, and can have implications for the balance of power between the federal government and state governments." .

<RxmjoCAyfDHKhwXHlwikL> a owl:Class ;
    rdfs:label "Insurance Agreements" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RB2MwY72GbUZH9ccu7omcmE> ],
        [ a owl:Restriction ;
