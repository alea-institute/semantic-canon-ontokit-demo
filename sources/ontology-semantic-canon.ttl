<R9Tyn1myNHR9ZL14Xk8j972> a owl:Class ;
    rdfs:label "Substance Abuse Policy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8xSzwRnuQy4kqrATCJ6awq> ],
        [ a owl:Restriction ;
