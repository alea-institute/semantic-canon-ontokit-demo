<R8N4pMIOhTNbqcmDczSephq> a owl:Class ;
    rdfs:label "Immigration Status" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RYR2drZu94msrQ4RDFyPoU> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8GuYn7yMmfL0coiNQ0OE8f> ],
        <R9ODLnhxFt38FQNV4BUbRSD> ;
    skos:definition "Immigration Status refers to the legal condition that defines an individual's right to reside, work, or study in a country other than their country of origin. This status can vary widely, including categories such as citizen, permanent resident, temporary worker, or undocumented immigrant, and dictates the individual's rights, obligations, and limitations within the host country." .

<R8QBuMoK1uPFeLW0sg40CdA> a owl:Class ;
