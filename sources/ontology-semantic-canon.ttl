<RBFSAt4xs2BlU2AYCt5lNob> a owl:Class ;
    rdfs:label "Color Blindness" ;
    rdfs:subClassOf <R8aoLYQoIooB9xRkhiMtgR4> ;
    skos:definition "Color Blindness is a visual impairment that affects an individual's ability to perceive colors accurately, typically due to a deficiency or absence of certain color-sensitive photoreceptors in the retina. This condition can range from difficulty distinguishing between specific colors to complete inability to see any colors." ;
    skos:prefLabel "Color Vision Impairment" .

<RBFSyAy4VY1rETaHMaRwOpo> a owl:Class ;
