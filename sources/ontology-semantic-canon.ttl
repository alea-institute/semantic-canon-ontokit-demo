<R77fqr5miBDHdl6nvSiWPiN> a owl:Class ;
    rdfs:label "Myasthenia Gravis" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/11.00-Neurological-Adult.htm#11_12> ;
    rdfs:subClassOf <R7M8wW11LJaLtWjQS7DmTQH> ;
    skos:altLabel "Autoimmune Neuromuscular Disorder",
        "MG" ;
    skos:definition "Myasthenia Gravis (MG) is a chronic autoimmune neuromuscular disorder characterized by weakness and rapid fatigue of voluntary muscles. It occurs when the immune system produces antibodies that interfere with the communication between nerves and muscles, leading to muscle weakness, especially after periods of activity." .

<R77n3Z14OcgllZTAx8sw9xZ> a owl:Class ;
    rdfs:label "Legal Argument" ;
    rdfs:subClassOf <RB3kSReNB4kis0pHfnZeHCa> ;
    skos:definition "A legal argument is a structured presentation of facts and law aimed at persuading a court to reach a specific ruling or judgment. It can be made orally in court, written in briefs, or submitted electronically, and typically includes citations to statutes, regulations, and case law to support the position taken." .

<R77zwCEC3rQgFNALnni6eGm> a owl:Class ;
    rdfs:label "Sales Commission" ;
    rdfs:subClassOf <Ry9hX7PSumXkvA5dFwO49X> ;
    skos:definition "A sales commission is a form of payment that individuals receive based on a percentage of the sales they generate or the business they bring in. It serves as an incentive for salespeople and others to actively promote products or services and is directly tied to their sales performance" .

