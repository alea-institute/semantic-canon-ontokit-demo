            owl:someValuesFrom <Rx7CkM9fjahTS5lZtG21ZR> ],
        <RCvV18Mbbb9FYFXbHt1inuL> ;
    skos:altLabel "Uninhabited Property",
        "Unoccupied Property",
        "Vacant Premises" ;
    skos:definition "Vacancy refers to the state of a property or space being unoccupied or not in use. This can occur in both residential and commercial real estate, indicating that no tenant or occupant currently resides or operates in the property." ;
    skos:prefLabel "Unoccupied Real Estate" .

<RDeT3IwQX4XRp2NQltDXY4r> a owl:Class ;
