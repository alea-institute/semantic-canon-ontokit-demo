<R8Gzr9WKsdck4rRcLAqMHej> a owl:Class ;
    rdfs:label "Nuisance" ;
    rdfs:subClassOf <RBeZkopwGsxt3K5BXOgNBNF>,
        <RDSBerlLWg1ntpLqDQn1eVn>,
        <RDqSn32zsjxExcBFzIYxT2D> ;
    skos:altLabel "Belästigung"@de-de,
        "Nuisance"@en-gb,
        "Molestia"@es-es,
        "Molestia"@es-mx,
        "Nuisance"@fr-fr,
        "הטרדה"@he-il,
        "उपद्रव"@hi-in,
        "迷惑行為"@ja-jp,
        "Incomodo"@pt-br,
        "骚扰"@zh-cn ;
    skos:definition "A nuisance is a legal claim that arises from the use of one's property or conduct that interferes with another's use or enjoyment of their property, resulting in harm or annoyance." .

<R8ItOPdbcc8mA2sYecRl3cu> a owl:Class ;
    rdfs:label "Criminal Incarceration" ;
    rdfs:subClassOf <R0tJKDoGSixec7FgGKnAAl> ;
    skos:altLabel "Strafhaft"@de-de,
        "Criminal Incarceration"@en-gb,
        "Encarcelamiento Criminal"@es-es,
        "Encarcelamiento Criminal"@es-mx,
        "Incarcération criminelle"@fr-fr,
        "הכלאה הפלילית"@he-il,
        "अपराधी बंदी रखना"@hi-in,
        "刑務所収容"@ja-jp,
        "Encarceramento criminal"@pt-br,
        "刑事监禁"@zh-cn ;
    skos:definition "The concept of Criminal Incarceration refers to the punishment of a person who has been convicted of a crime by being confined to a prison or jail for a specified period of time, as a penalty for their wrongdoing." .

<R8KhmyuiGXDz10apLAPbLJV> a owl:Class ;
    rdfs:label "HIV / AIDS" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_00F1>,
        <https://www.ssa.gov/disability/professionals/bluebook/14.00-Immune-Adult.htm#14_11> ;
    rdfs:subClassOf <RBJ0dgV4Z2Xk7aGfJt2nSj7>,
        <REFNhmFYG6yk3W0RPLFV6g> ;
    skos:altLabel "Immunodeficiency Virus Infection" ;
    skos:definition "HIV (Human Immunodeficiency Virus) is a virus that attacks the body's immune system, specifically the CD4 cells (T cells), leading to a weakened immune response. If not treated, HIV can progress to AIDS (Acquired Immunodeficiency Syndrome), the final stage of HIV infection, where the immune system is severely damaged, and the body becomes vulnerable to opportunistic infections and cancers." .

<R8LtU1k4pyiSD639zaq4vrM> a owl:Class ;
    rdfs:label "Arbitration Forum" ;
    rdfs:isDefinedBy <https://www.americanbar.org/groups/dispute_resolution/resources/DisputeResolutionProcesses/arbitration/> ;
    rdfs:subClassOf <RC8gGTL4dazXLDWuElLZLjI> ;
    skos:definition "An Arbitration Forum is a specific type of Alternative Dispute Resolution (ADR) Forum where disputes are resolved outside of the court system by a neutral third party or panel of experts." .

<R8Ov4MbOJULZY0aLe1KoP3Z> a owl:Class ;
    rdfs:label "Personal Information" ;
    rdfs:subClassOf <R89ziIl0nXs5c4ONtS7qXTP> ;
    skos:altLabel "Private Information" ;
    skos:definition "Personal Information refers to any data that relates to an identified or identifiable individual. This includes both sensitive personal information, which requires greater protection due to its potential to cause harm if disclosed, and personally identifiable information (PII), which can be used to identify, contact, or locate a specific individual." .

<R8QRLB1gnbhfJrE1S4mh8Tp> a owl:Class ;
    rdfs:label "Antitrust - Market Allocation Claims" ;
    rdfs:subClassOf <RCFPWMbdFLbplboOqvI77Jh> ;
    skos:altLabel "Kartellrecht - Ansprüche auf Marktzuweisung"@de-de,
        "Antitrust - Market Allocation Claims"@en-gb,
        "Antimonopolio - Reclamaciones de asignación de mercado"@es-es,
        "Antimonopolio - Reclamaciones de asignación de mercado"@es-mx,
        "Antitrust - Revendications d'allocation de marché"@fr-fr,
        "אנטיטרוסט - טענות חלוקת שוקים"@he-il,
        "एंटीट्रस्ट - मार्केट वितरण दावे"@hi-in,
        "独占禁止法 - 市場配分請求"@ja-jp,
        "Antitruste - Reivindicações de Alocação de Mercado"@pt-br,
        "反垄断 - 市场分配索赔"@zh-cn ;
    skos:definition "Antitrust - Market Allocation Claims: A legal claim alleging that competitors in a market have colluded to divide the market among themselves, thereby reducing competition and harming consumers." .

<R8REFEtDy732ovlT7nI0DGr> a owl:Class ;
    rdfs:label "Gasoline Stations and Fuel Dealers Industry" ;
    dc:identifier "RET-GASS" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=457> ;
    rdfs:subClassOf <RDfdmGR6iPi4k2t6ecIUBkP> ;
    skos:altLabel "Gasoline Stations",
        "Tankstellenbranche"@de-de,
        "Petrol Station Industry"@en-gb,
        "Industria de Estaciones de Servicio"@es-es,
        "Industria de Estaciones de Gasolina"@es-mx,
        "Industrie des stations-service"@fr-fr,
        "תעשיית תחנות דלק"@he-il,
        "गैसोलीन स्टेशन उद्योग"@hi-in,
        "ガソリンスタンド業界"@ja-jp,
        "Indústria de postos de gasolina"@pt-br,
        "加油站行业"@zh-cn ;
    skos:definition "Industries in the Gasoline Stations and Fuel Dealers subsector retail automotive fuels (e.g., gasoline, diesel fuel, gasohol, alternative fuels) and automotive oils, without or in combination with convenience store items; or retail heating oil, liquefied petroleum (LP) gas, and other fuels via direct selling (i.e., home delivery).  Gasoline stations have specialized equipment for storing and dispensing automotive fuels." ;
    skos:hiddenLabel "GASS" .

<R8THIhCQDpX9BgtDhsfKsQ5> a owl:Class ;
    rdfs:label "Inflammatory Bowel Disease" ;
    rdfs:subClassOf <RB6mWlc1WihUbnT7ztVcao5> ;
    skos:definition "Inflammatory bowel disease (IBD) refers to a group of chronic conditions characterized by inflammation of the gastrointestinal (GI) tract. The primary forms of IBD are Crohn's disease and ulcerative colitis, both of which can cause symptoms such as abdominal pain, diarrhea, and weight loss, and may require ongoing medical management and, in severe cases, surgical intervention." .

<R8UUYr65AhViLWlYXV3jzVb> a owl:Class ;
    rdfs:label "Statute of Repose" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDKJ7nEqeDxNDRxI2Wqil1N> ],
        <RDJM7d52FqDzFaBbtRdhECs> ;
    skos:altLabel "Verjährungsgesetz"@de-de,
        "Statute of Repose"@en-gb,
        "Ley de prescripción"@es-es,
        "Ley de prescripción"@es-mx,
        "Loi de prescription"@fr-fr,
        "חוק הפסקת התביעה"@he-il,
        "रिपोज कानून"@hi-in,
        "時効法"@ja-jp,
        "Lei de Repouso"@pt-br,
        "时效法规"@zh-cn ;
    skos:definition "A Statute of Repose is a legal time limit that restricts the period within which a lawsuit can be filed, regardless of when the injury or harm occurred or was discovered. It is usually tied to the completion of a specific event or transaction, such as the sale of a product or the completion of construction." .

<R8UY7a51FHRoPnKMKs41jQv> a owl:Class ;
    rdfs:label "Sexual Harassment" ;
    rdfs:subClassOf <RwadSStLIBnmEe8euTpNYP> ;
    skos:altLabel "Sexuelle Belästigung"@de-de,
        "Sexual Harassment"@en-gb,
        "Acoso Sexual"@es-es,
        "Acoso Sexual"@es-mx,
        "Harcèlement sexuel"@fr-fr,
        "הטרדה מינית"@he-il,
        "लैंगिक उत्पीड़न"@hi-in,
        "セクシャルハラスメント"@ja-jp,
        "Assédio sexual"@pt-br,
        "性骚扰"@zh-cn ;
    skos:definition "Sexual Harassment: Unwelcome sexual advances, requests for sexual favors, and other verbal or physical conduct of a sexual nature that creates a hostile or offensive work environment." .

<R8UeNXhrXWQi2aJsTtDx3zk> a owl:Class ;
    rdfs:label "Self-Incrimination Clause Claim" ;
