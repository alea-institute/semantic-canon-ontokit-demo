<R7ROqnkjkzSNTuRIsd5OPqw> a owl:Class ;
    rdfs:label "Catastrophe Bonds" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCksXAlY9lRN16wERqZZ8Tk> ],
        <RCwe6IUx1b5fuhKW0fivDZu> ;
    skos:altLabel "Disaster Bonds",
        "Insurance-Linked Securities",
        "Risk-Linked Securities" ;
    skos:definition "Catastrophe bonds, commonly known as cat bonds, are high-yield debt instruments designed to raise money for insurance companies in the event of a natural disaster. These bonds provide insurers with an alternative source of capital to cover significant losses from catastrophes, transferring some of the financial risk to investors who receive regular coupon payments unless a specified catastrophe event occurs." ;
    skos:prefLabel "Cat Bonds" .

<R7RVsUzm4bIEJNxG96zKz1E> a owl:Class ;
    rdfs:label "Privacy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <Rd7uelGFqCTWSgf9lWki5N> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9EVjzRqoWF8yrXjG5tL8jV> ],
        <RBw3WR4CSREciBCYef3H9wI> ;
    skos:altLabel "Confidentiality"^^xsd:string,
        "Informational Privacy"^^xsd:string,
        "Personal Privacy"^^xsd:string,
        "Personal Secrecy"^^xsd:string,
        "Right to Privacy"^^xsd:string ;
    skos:definition "Privacy is the ethical principle that protects a person’s rightful control over personal information, personal space, and intimate aspects of life. Privacy safeguards human dignity by limiting intrusion, exposure, and misuse of what properly belongs to the person."^^xsd:string ;
    skos:example "Privacy limits surveillance that intrudes unjustifiably into personal life."^^xsd:string,
        "Privacy protects the confidentiality of spiritual conversations outside the sacramental forum."^^xsd:string,
        "Privacy requires safeguarding personal medical information from unauthorized disclosure."^^xsd:string,
        "Privacy respects personal boundaries in living, working, and pastoral settings."^^xsd:string,
        "Privacy supports a person’s control over how personal data is collected and used."^^xsd:string .

