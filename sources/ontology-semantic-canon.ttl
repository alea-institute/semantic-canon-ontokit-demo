    rdfs:subClassOf <RCHYAaMF4QRHH9QwmNKGN8Y> ;
    skos:altLabel "Nonverbal Learning Disorder" ;
    skos:definition "Nonverbal Learning Disability (NVLD) is a neurological condition characterized by significant difficulties with visual-spatial, motor, and social skills, despite strong verbal abilities. Individuals with NVLD may struggle with tasks requiring coordination, interpreting nonverbal cues, and spatial awareness, impacting their academic and social functioning." ;
    skos:prefLabel "Nonverbal Cognitive Disorder" .

