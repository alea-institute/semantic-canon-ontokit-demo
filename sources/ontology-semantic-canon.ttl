    skos:hiddenLabel "BANK" .

<RBZcHfpwTv94silyPjBatn1> a owl:Class ;
    rdfs:label "Premise" ;
    rdfs:subClassOf <RB3kSReNB4kis0pHfnZeHCa> ;
    skos:altLabel "Ground"^^xsd:string,
        "Justifying Statement"^^xsd:string,
        "Reason"^^xsd:string,
        "Supporting Proposition"^^xsd:string ;
    skos:definition "Premise is a proposition offered as a reason that supports or helps justify a conclusion within an argument. It functions as a foundational claim from which inference proceeds."^^xsd:string ;
    skos:example "Actions that intentionally harm the innocent are wrong."^^xsd:string,
        "Every contingent being requires a cause."^^xsd:string,
        "God has revealed himself in history."^^xsd:string,
        "Human life possesses inherent dignity."^^xsd:string .

<RBcdN3ccRk1SftZVzCrFRw0> a owl:Class ;
    rdfs:label "Nativity" ;
    rdfs:subClassOf <R7oT3qg4wZmB5K3qC79EVID> ;
    skos:altLabel "Nativity of the Lord"^^xsd:string ;
    skos:definition "Nativity means the birth of Jesus Christ in Bethlehem of Judea, as narrated in the Gospels of Matthew and Luke. Nativity reveals the Incarnation’s historical manifestation and inaugurates Christ’s earthly life within salvation history."^^xsd:string ;
    skos:example "Christian liturgy commemorates the nativity annually at Christmas."^^xsd:string,
        "The Gospel of Luke describes the nativity of Jesus in Bethlehem during the reign of Caesar Augustus."^^xsd:string,
        "The Gospel of Matthew recounts the visit of the Magi following the birth of Jesus."^^xsd:string .

<RBgvM3CLfhaoq2TagoUDUBG> a owl:Class ;
    rdfs:label "Bibliographic Research Classification" ;
    rdfs:subClassOf <RDSepz944v79Sc4zhy0qy2X> ;
    skos:altLabel "Bibliographic Nature"^^xsd:string,
        "Research Source Typology"^^xsd:string ;
    skos:definition "Bibliographic Research Classification is a system for categorizing sources according to their proximity to original material, analysis, or synthesis. Bibliographic Research Classification clarifies how a source contributes to knowledge by distinguishing original evidence, interpretive commentary, and reference compilation."^^xsd:string .

<RBoQmbBINbNwazijSzgsexi> a owl:ObjectProperty ;
    rdfs:label "oasis:applies" .

<RBoyPCQL9cRuwbjeNvSO55y> a owl:Class ;
    rdfs:label "Article 6 Claim" ;
    rdfs:subClassOf <R7MGQ9xUx0PxGLp5yxprdpZ> ;
    skos:altLabel "Article VI Claim",
        "Anspruch aus Artikel 6"@de-de,
        "Article 6 Claim"@en-gb,
        "Reclamación del artículo 6"@es-es,
        "Reclamación del artículo 6"@es-mx,
        "Demande fondée sur l'article 6"@fr-fr,
        "תביעת סעיף 6"@he-il,
        "अनुच्छेद 6 दावा"@hi-in,
        "第6条請求"@ja-jp,
        "Reivindicação do Artigo 6"@pt-br,
        "第6条索赔"@zh-cn ;
    skos:definition "An Article VI claim refers to a legal argument grounded in Article VI of the U.S. Constitution, which includes the Supremacy Clause, declaring federal laws and treaties to be the supreme law of the land. Such a claim may arise in disputes involving the precedence of federal law over state law, or the constitutionality of treaties." .

