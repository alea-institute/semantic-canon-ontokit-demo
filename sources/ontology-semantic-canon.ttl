<R8uaOTdTaAuNmWKOgiGiD9t> a owl:Class ;
    rdfs:label "Lost Capacity in Living Resulting from Tort" ;
    rdfs:subClassOf <R8alUnZrt8GVEzHYhh1KTva>,
        <RBgykmvlnXtCsXRVIBMbLrV> ;
    skos:altLabel "Verlorene Lebensqualität aufgrund von Folter"@de-de,
        "Lost Capacity in Living Resulting from Tort"@en-gb,
        "Pérdida de capacidad de vivir como resultado de un delito"@es-es,
        "Pérdida de capacidad de vivir como resultado de un delito"@es-mx,
        "Perte de capacité de vivre résultant de la torture"@fr-fr,
        "פגיעה ביכולת לחיות כתוצאה מפשע"@he-il,
        "तोड़फोड़ से होने वाली जीवन में क्षमता का नुकसान"@hi-in,
        "拷問による生活能力の喪失"@ja-jp,
        "Perda de capacidade de viver resultante de tortura"@pt-br,
        "因酷刑而导致的生活能力丧失"@zh-cn ;
    skos:definition "The concept of Lost Capacity in Living Resulting from Tort refers to the reduction in a person's ability to enjoy life due to injuries caused by someone else's wrongful act, for which compensation may be sought in a personal injury claim under the category of non-economic damages." .

<R8ucHOT4J1VQ7KZTWxIoth3> a owl:Class ;
    rdfs:label "Fruit of the Poisonous Tree" ;
    rdfs:subClassOf <R8mREFTbCVNHGAdqneLSd0d> ;
    skos:altLabel "Exclusion of Unfair Evidence",
        "Tainted Evidence" .

<R8utefjaPVm1ooWgvWHaZ8p> a owl:Class ;
    rdfs:label "Social Anxiety Disorder" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1> ;
    rdfs:subClassOf <RDKGeTDagCQ714D5C4sASPP> ;
    skos:definition "Social Anxiety Disorder, also known as social phobia, is a mental health condition characterized by an intense, persistent fear of social or performance situations where one may be scrutinized or judged by others. This fear often leads to significant distress and avoidance of social interactions, affecting daily functioning and quality of life." ;
    skos:example "Public Speaking Anxiety: An individual experiences severe anxiety and avoidance when required to speak in front of a group.",
        "Social Interaction Anxiety: An individual fears and avoids social gatherings or interactions due to fear of being negatively evaluated or embarrassed." ;
    skos:prefLabel "Social Phobia" .

<R8uuvxRrK0Eet2bpHbBGjGp> a owl:Class ;
    rdfs:label "Lettuce" ;
    rdfs:subClassOf <R74NaktGSuv9KJ3aBnw26GP> ;
    skos:altLabel "Lactuca Sativa" ;
    skos:definition "Lettuce is a leafy vegetable from the Lactuca sativa species, known for its crisp texture and mild, refreshing flavor. It is commonly consumed raw in salads and sandwiches and is valued for its low-calorie content and nutritional benefits, including vitamins A, C, and K, as well as fiber." .

<R8v6tFfln3S9d5Ob6qMKdgQ> a owl:Class ;
    rdfs:label "Florida Circuit Court - Flagler County - 7th Circuit Court" ;
    rdfs:subClassOf <R3Q1HDu5jO8nvhdbr2Uj0c> ;
    skos:definition "A court located in Flagler County, Florida that is part of the larger Florida Circuit Court system, which is responsible for administering legal proceedings within the state." .

<R8vCImjU4kpMk3JflXOl51K> a owl:Class ;
    rdfs:label "Profit Margin" ;
    rdfs:subClassOf <RDw3C0Q9SA9H8y85Zz4cMvz> ;
    skos:altLabel "Margin" ;
    skos:definition "Profit Margin is a financial metric that measures the profitability of a business or a product. It is calculated by dividing net profit by total revenue and is usually expressed as a percentage, serving as a universal measure of business profitability." .

<R8vFZmDq3YytR7qotGijkXT> a owl:Class ;
    rdfs:label "Classical Newari; Old Newari; Classical Nepal Bhasa" ;
    rdfs:subClassOf <RDOvAHsvY8TKJ1O1orXPM9o> ;
    skos:altLabel "Klassisches Newari; Altes Newari; Klassisches Nepal Bhasa"@de-de,
