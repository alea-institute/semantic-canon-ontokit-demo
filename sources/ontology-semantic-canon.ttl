<RCFs8eqGTlY90gkX2NFNLTH> a owl:Class ;
    rdfs:label "Interference with Contracts and Business Relationships" ;
    rdfs:subClassOf <RCcQHyZbjBHsXsm0zrZGme5>,
        <RHSZPHkLvnB6N4bgIo6kuX>,
        <RZ1dOPJ6HH6lMJGSLNxfwV> ;
    skos:altLabel "Störung von Verträgen und Geschäftsbeziehungen"@de-de,
        "Interference with Contracts and Business Relationships"@en-gb,
        "Interferencia con Contratos y Relaciones Comerciales"@es-es,
        "Interferencia en Contratos y Relaciones Comerciales"@es-mx,
        "Ingérence dans les contrats et les relations commerciales"@fr-fr,
        "הפרעה בחוזים וביחסי עסקים"@he-il,
        "अनुबंधों और व्यापारिक संबंधों में हस्तक्षेप"@hi-in,
        "契約やビジネス関係への干渉"@ja-jp,
        "Interferência em contratos e relações comerciais"@pt-br,
        "干涉合同和商业关系"@zh-cn ;
    skos:definition "Interference with Contracts and Business Relationships refers to the intentional and unjustified interference with a contractual or business relationship between two parties, resulting in economic harm to one or both parties." ;
    skos:prefLabel "Tortious Interference with Contratual Relations" .

<RCHbjppawvAlt5WcUyfjeN8> a owl:Class ;
    rdfs:label "Governmental Immunity for Condition of Public Property" ;
    rdfs:subClassOf <RBvhPeoPwTNYsc19VBpYjSV> ;
    skos:altLabel "Regierungsimmunität für den Zustand öffentlicher Einrichtungen"@de-de,
        "Governmental Immunity for Condition of Public Property"@en-gb,
        "Inmunidad gubernamental por la condición de la propiedad pública"@es-es,
        "Inmunidad gubernamental por la condición de la propiedad pública"@es-mx,
        "Immunité gouvernementale pour l'état des biens publics"@fr-fr,
        "חסינות ממשלתית עבור מצב הנכס הציבורי"@he-il,
        "सार्वजनिक संपत्ति की स्थिति के लिए सरकारी संविदा"@hi-in,
        "公共財産の状態に対する政府免責"@ja-jp,
        "Imunidade governamental para condição de propriedade pública"@pt-br,
        "公共财产状况的政府豁免权"@zh-cn ;
    skos:definition "Governmental Immunity for Condition of Public Property: A legal concept that shields government entities from liability for injuries or damages caused by the condition of public property, unless the government entity failed to take reasonable steps to correct the dangerous condition." .

<RCIQtHHdQl861KZaBklud18> a owl:Class ;
    rdfs:label "Provider Timekeeper Level" ;
    rdfs:subClassOf <R7tihKK0L440nkLIrRcdCkh> ;
    skos:altLabel "Anbieter-Zeitnehmer-Ebene"@de-de,
        "Provider Timekeeper Level"@en-gb,
        "Nivel de cronometrador de tiempo del proveedor"@es-es,
        "Nivel de cronometrador de tiempo del proveedor"@es-mx,
        "Niveau de chronométreur de fournisseur"@fr-fr,
        "רמת מדד זמן ספק"@he-il,
        "רמת מדי זמן של תורם"@he-il,
        "प्रदाता समय रखरखाव स्तर"@hi-in,
        "プロバイダータイムキーパーレベル"@ja-jp,
        "Nível de cronometrista de provedor"@pt-br,
        "提供商计时器级别"@zh-cn ;
    skos:definition "Provider Timekeeper Level refers to the classification of legal service providers based on their level of expertise and experience, including paralegals, lawyers, and limited license legal technicians (LLLTs)." .

<RCOt1w05pKqV4V4gwFEKcfs> a owl:Class ;
    rdfs:label "Motor Vehicle and Parts Dealers Industry" ;
    dc:identifier "RET-MVPD" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=441> ;
    rdfs:subClassOf <RDfdmGR6iPi4k2t6ecIUBkP> ;
    skos:altLabel "Motor Vehicle and Parts Dealers",
        "Kfz- und Teilehändlerbranche"@de-de,
        "Motor Vehicle and Parts Dealer Industry"@en-gb,
        "Industria de Concesionarios de Vehículos y Piezas"@es-es,
        "Industria de Distribuidores de Vehículos y Partes"@es-mx,
        "Industrie des concessionnaires de véhicules automobiles et de pièces détachées"@fr-fr,
        "תעשיית סוחרי רכבים וחלקים"@he-il,
        "मोटर वाहन और पार्ट डीलर उद्योग"@hi-in,
        "自動車および部品販売業界"@ja-jp,
        "Indústria de revendedores de veículos automotores e peças"@pt-br,
        "汽车及零部件经销商行业"@zh-cn ;
    skos:definition """Industries in the Motor Vehicle and Parts Dealers subsector retail motor vehicles and parts.  Establishments in this subsector often operate from a showroom and/or an open lot where the vehicles are on display.  The display of vehicles and the related parts require little by way of display equipment.  The personnel generally include both the sales and sales support staff familiar with the requirements for registering and financing a vehicle as well as a staff of parts experts and mechanics trained to provide repair and maintenance services for the vehicles.  Specific industries included in this subsector identify the type of vehicle being retailed.

Sales of capital or durable nonconsumer goods, such as medium- and heavy-duty trucks, are always included in wholesale trade.""" ;
    skos:hiddenLabel "MVPD" .

<RCR0Wfb4Zz9V56W2ri7JeTU> a owl:Class ;
    rdfs:label "Audiovisual Work" ;
    rdfs:subClassOf <RVaHiNBU68DENmeHicnzro> ;
    skos:altLabel "AV Work",
        "Audio-Visual Creation",
        "Audiovisual Media",
        "Multimedia Work" ;
    skos:definition "An Audiovisual Work is a creation that combines both visual and auditory elements, such as films, television shows, and videos, intended to be experienced simultaneously. Protected under copyright law, audiovisual works grant the creator exclusive rights to reproduce, distribute, and publicly display the content." .

<RCRVBAzI4EaLARuVLhgDBTB> a owl:Class ;
    rdfs:label "Post-Conviction Modification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCdJXw1Ml7DIBqmouWarZm2> ],
        <R0tJKDoGSixec7FgGKnAAl> ;
    skos:altLabel "Post-Conviction Relief",
        "Post-Conviction Remedies" ;
    skos:definition "Post-conviction modification refers to the legal processes available to an individual after a conviction to alter, reduce, or eliminate the consequences of that conviction. Examples include expungement, where the criminal record is sealed or erased; and pardon, where the individual is formally forgiven for the crime. These modifications can help restore rights and opportunities lost due to the initial conviction." ;
    skos:prefLabel "Clemency" .

<RCcWasK7LnVMXipm7uQAOA2> a owl:Class ;
    rdfs:label "Visitor" ;
    rdfs:subClassOf <RCEDL3kMYgjFUEOhOyGp3IE> ;
    skos:definition "A visitor is an individual who temporarily enters a specific location, such as a country, city, or residence, for various purposes. Visitors can include tourists, who travel for leisure and exploration; business visitors, who come for work-related activities; or guests invited to a residence for social or personal reasons. The nature of the visit and applicable regulations, such as visa requirements or entry permissions, can differ based on the visitor's purpose and destination." .

<RCfOoWbuAOqLv617rVNcHYh> a owl:Class ;
    rdfs:label "Eating Disorders" ;
    dc:source <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_00B1>,
        <https://www.ssa.gov/disability/professionals/bluebook/12.00-MentalDisorders-Adult.htm#12_13> ;
    rdfs:subClassOf <RN3TubQIlusDFnPgrNAk8D> ;
    skos:definition "Eating Disorders are characterized by disturbances in eating behavior and preoccupation with, and excessive self-evaluation of, body weight and shape. Symptoms and signs may include, but are not limited to, restriction of energy consumption when compared with individual requirements; recurrent episodes of binge eating or behavior intended to prevent weight gain, such as self-induced vomiting, excessive exercise, or misuse of laxatives; mood disturbances, social withdrawal, or irritability; amenorrhea; dental problems; abnormal laboratory findings; and cardiac abnormalities." .

<RCjaPxLpNSWz91c3fJzxweU> a owl:Class ;
    rdfs:label "Asylum Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCjf3VBil5V7nwAGjhEkGIC> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBCV26gN63NNAmGIxsKVAi7> ],
        <RB5tNYSDrxEoYAqZ3sy0rae>,
        <RqWYmNLhfvzysGhC75yUNw> ;
    skos:altLabel "Asylantrag"@de-de,
        "Asylum Claim"@en-gb,
        "Solicitud de Asilo"@es-es,
        "Solicitud de Asilo"@es-mx,
        "Demande d'asile"@fr-fr,
        "בקשת מקלט"@he-il,
        "शरण याचिका"@hi-in,
        "亡命申請"@ja-jp,
        "Pedido de asilo"@pt-br,
        "避难申请"@zh-cn ;
    skos:definition "An asylum claim is a request made by an individual to a foreign government for protection due to fear of persecution or harm in their home country. That fear is often based on race, religion, nationality, membership of a particular social group, or political opinion." .

<RCjf3VBil5V7nwAGjhEkGIC> a owl:Class ;
    rdfs:label "Refugee Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCjaPxLpNSWz91c3fJzxweU> ],
        <RB5tNYSDrxEoYAqZ3sy0rae>,
        <RqWYmNLhfvzysGhC75yUNw> ;
    skos:definition "A Refugee Claim is a formal request made by an individual seeking protection in a foreign country on the grounds of persecution or well-founded fear of persecution in their home country due to race, religion, nationality, political opinion, or membership in a particular social group. The claim initiates a legal process that may involve interviews, hearings, and documentation to determine eligibility for refugee status" .

<RCjgFvO2VxpIklnhZMbSD9k> a owl:Class ;
    rdfs:label "Health Insurance Policy" ;
    rdfs:subClassOf <R9uTFHGFCMBjtYw5MOmpotJ> ;
    skos:definition "A health insurance policy is an agreement between an insurer and a policyholder wherein the insurer covers part or all of the policyholder's healthcare costs in exchange for premium payments. The policy specifies what medical services are covered, the network of healthcare providers, and any co-payments, deductibles, or other financial responsibilities for the insured." .

<RCoXvGg5LXK9dGHQMqGPNCe> a owl:Class ;
    rdfs:label "Originality" ;
    rdfs:subClassOf <R8O3PoolmgHAy2hrZsguhqy> ;
    skos:altLabel "Creative" ;
    skos:definition "Originality in copyright law requires that a work must be independently created and possess a minimum degree of creativity. This concept ensures that copyright protection is granted only to works that reflect the author's own intellectual effort and not mere copies or trivial variations of existing works." .

<RCqCSXkXFjhbokGf5IHmJ6a> a owl:Class ;
    rdfs:label "Degree of Payment Completeness" ;
    dc:source <https://nna.jse.co.za/Help/cfi.htm> ;
    rdfs:subClassOf <R9sdPQV8kCK3BNF8jcPV5cD> ;
    skos:altLabel "Payment Completion Degree",
        "Payment Fulfillment Level",
        "Payment Progress" ;
    skos:definition "Degree of Payment Completeness refers to the extent to which a financial obligation or transaction has been fulfilled. This attribute encompasses varying levels of payment completion, such as nothing paid, partial payment (including installment payments), and full payment." ;
    skos:prefLabel "Payment Status" .

<RCqg8Edym0NbyFXA5DXor8w> a owl:Class ;
    rdfs:label "Financial Account" ;
    rdfs:comment "From LIST: Legal Issues Taxonomy — https://taxonomy.legal/" ;
    rdfs:subClassOf <RhBgnef56iLBXYfPqWQE41> ;
    skos:definition "An account in a financial context, such as a bank or investment firm, is a contractual arrangement that allows individuals or entities to deposit, withdraw, or manage money and financial assets. Accounts can come in various forms, such as savings accounts, checking accounts, or investment accounts, each with their own rules, benefits, and limitations." ;
    skos:prefLabel "Bank Account" .

<RCrOThiq2BioEVHnqev8KdQ> a owl:Class ;
    rdfs:label "Retirement Income" ;
    rdfs:subClassOf <RLrqGkP9fi5OO2RhpttmVI> .

<RCve9Byd0sPTUxFRAugXTrX> a owl:Class ;
    rdfs:label "Normative Text" ;
    rdfs:subClassOf <RBkL8I5saFF7mqpLTI7GxSh> ;
    skos:definition "Normative Text is a magisterial document or discrete portion thereof that establishes binding doctrine, discipline, or authoritative norms for the universal Church. It carries ecclesial authority and governs belief, practice, or obligation within its proper scope."^^xsd:string .

<RCy69ZSLkXNMIWCj0nv9qzO> a owl:Class ;
    rdfs:label "Employee Termination Event" ;
    rdfs:subClassOf <RBila9ckW95W84Tk54tGfZO> ;
    skos:definition "Employee Termination refers to the formal end of an employment relationship between an employee and an employer. This can occur for various reasons, including but not limited to, voluntary resignation, layoffs, or dismissal for cause, and typically involves the completion of exit procedures and documentation." ;
    skos:prefLabel "Employment Termination Event" .

<RCzQzQSPRAB9cLkvDtBJFn> a owl:Class ;
    rdfs:label "Water Rights" ;
    rdfs:subClassOf <RCkPc0XIMxDInzRipCUUZ1q> ;
    skos:definition "Water rights are legal entitlements allowing the holder to use water from a particular source (like a river, stream, or underground source). The allocation and usage of water rights can be complex and are often based on historic use, need, and regional laws." .

<RCzxVprwB3RwZ8EMewt18Jt> a owl:Class ;
    rdfs:label "Investment Funds" ;
    rdfs:subClassOf <RBVQj7fYsBw67yNXs4WI6RX> ;
    skos:altLabel "Baskets",
        "Funds",
        "Pooled Investment Vehicles" ;
    skos:definition "Investment Funds are pooled investment vehicles that collect capital from multiple investors to invest in a diversified portfolio of assets. These funds include various types such as mutual funds, hedge funds, and real estate investment trusts (REITs), each with distinct investment strategies and regulatory structures." ;
    skos:prefLabel "Collective Investment Vehicles" .

<RD0eI0kZbrRDzdWWH6WoOGN> a owl:Class ;
    rdfs:label "Government Official" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8gPVPSW76auMkhwuIg1CBc> ],
        <RDlMwQ5nSrgZMByjzjtXnUO> ;
    skos:definition "A government official is an individual who holds a position of authority within a governmental organization, either elected or appointed. Their responsibilities vary widely depending on their role and the level of government they serve, but they are generally tasked with implementing laws, managing public services, and representing the interests of their constituents or the state." .

<RD56727CABa3aB066e948fc1> a owl:Class ;
    rdfs:label "Insurance Carriers and Related Activities Industry" ;
    dc:identifier "FNS-INSU" ;
    rdfs:isDefinedBy <https://www.naics.com/six-digit-naics/?code=524> ;
    rdfs:subClassOf <RCksXAlY9lRN16wERqZZ8Tk> ;
    skos:altLabel "Insurance",
        "Versicherungsbranche"@de-de,
        "Insurance Industry"@en-gb,
        "Industria de Seguros"@es-es,
        "Industria de Seguros"@es-mx,
        "Industrie de l'assurance"@fr-fr,
        "תעשיית הביטוח"@he-il,
        "बीमा उद्योग"@hi-in,
        "保険業"@ja-jp,
        "Indústria de seguros"@pt-br,
        "保险业"@zh-cn ;
    skos:definition "Industries in the Insurance Carriers and Related Activities subsector group establishments that are primarily engaged in one of the following: (1) underwriting (assuming the risk, assigning premiums, and so forth) annuities and insurance policies or (2) facilitating such underwriting by selling insurance policies and by providing other insurance and employee benefit related services." ;
    skos:hiddenLabel "INSU" ;
    skos:prefLabel "Insurance" .

<RD686c783A09b6C4c794564b> a owl:Class ;
    rdfs:label "Minnesota State Courts" ;
    dc:identifier "USCTS-STCOUS-MN" ;
    rdfs:subClassOf [ a owl:Restriction ;
