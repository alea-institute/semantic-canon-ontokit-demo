<R75YPIEG1RlVwp3PhmAdeCm> a owl:Class ;
    rdfs:label "Gender Rights" ;
    dc:source "International Bill of Human Rights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R8BHWSISpza9Q9QLVKBZf7U> ],
        [ a owl:Restriction ;
