<RURlVraNO3ry0CN36a1faN> a owl:Class ;
    rdfs:label "Feed the Hungry" ;
    rdfs:subClassOf <RBlfLOh5T3hwTWxMPyHfXBx>,
        <Ru9TAhxYKI0ZIOxJGezsYK> ;
    skos:altLabel "Emergency Hunger Relief"^^xsd:string,
