<R93GqMiwxX3jOSOdVbqNG7q> a owl:Class ;
    rdfs:label "Capital Goods Tax Payment" ;
    rdfs:subClassOf <R9L4OY7QCBEVJpav2Da6Gef> ;
    skos:altLabel "Capital Equipment Tax Payment",
        "Industrial Equipment Tax Payment",
        "Investment Goods Tax Payment",
        "Machinery Tax Payment" ;
    skos:definition "Capital Goods Tax Payment, also known as Taxes on Investment Goods, refers to taxes levied on investment goods such as machinery. These taxes can be imposed for an extended period or temporarily for counter-cyclical purposes. Unlike taxes on industrial inputs that are also levied on consumers, capital goods taxes specifically target goods used for investment purposes in industries and businesses." ;
    skos:prefLabel "Investment Asset Tax Payment",
        "Taxes on Investment Goods" .

<R93IYJCdKr3BoQolxyKNTC8> a owl:Class ;
    rdfs:label "Urban Market Segment" ;
    rdfs:subClassOf <RVu433XojPQPseoDXhidgO> ;
    skos:altLabel "City Market Segment" ;
    skos:definition "The urban market segment refers to a group of consumers or businesses located in cities or metropolitan areas, characterized by higher population density and a diverse range of lifestyle and consumption patterns. This segmentation allows businesses to tailor their products and marketing strategies to the specific needs and preferences of urban dwellers, who often have different purchasing behavior compared to rural or suburban consumers." ;
    skos:prefLabel "Metropolitan Market Segment" .

<R93JnQow2QQV1vhV6ojhBLE> a owl:Class ;
    rdfs:label "Vice" ;
    rdfs:subClassOf <RCuw9Co5aqGGoEIUhnvjRXK> ;
    skos:altLabel "Habitual Sinfulness"^^xsd:string,
        "Moral Defect"^^xsd:string,
        "Moral Vice"^^xsd:string ;
    skos:definition "Vice is a habitual disposition toward moral evil that inclines a person to act against right reason and the good. Vice forms through repeated sinful choices and weakens freedom by making disordered action easier and virtue more difficult."^^xsd:string ;
    skos:example "Vice can become socially reinforced through cultural normalization of wrongdoing."^^xsd:string,
        "Vice develops when repeated dishonest acts form a settled pattern of deception."^^xsd:string,
        "Vice inclines a person toward selfish choices even when better options are known."^^xsd:string,
        "Vice requires deliberate effort, grace, and practice of virtue to overcome."^^xsd:string,
        "Vice weakens moral judgment by dulling sensitivity to good and evil."^^xsd:string .

<R93LiMMwQRvmuNEufxPJLd2> a owl:Class ;
    rdfs:label "Paragraph (Textual Unit)" ;
    rdfs:subClassOf <R7SWDfYuq2ExnV9WkGTLhyA> ;
    skos:altLabel "Numbered Paragraph"^^xsd:string,
        "Prose Unit"^^xsd:string,
        "Textual Paragraph"^^xsd:string ;
    skos:definition "Paragraph is a discrete block of text that develops a single idea or closely related set of ideas within a larger structure. In ecclesial and legal texts, paragraphs often serve as stable units for citation and reference."^^xsd:string ;
    skos:example "Catechism of the Catholic Church, paragraph 27."^^xsd:string,
        "Dei Verbum, paragraph 10."^^xsd:string .

<R93OdKzhkBwWJmRDfunXDkI> a owl:Class ;
    rdfs:label "Trial Before Pilate" ;
    rdfs:subClassOf <RD0JfBltrTwUJkeYjw8iN1P> ;
    skos:altLabel "Hearing Before Pilate"^^xsd:string,
        "Judgment Before Pontius Pilate"^^xsd:string,
        "Roman Trial of Jesus"^^xsd:string ;
    skos:definition "Trial Before Pilate means the judicial proceeding in which Jesus Christ was examined by the Roman prefect Pontius Pilate after being handed over by the Jewish authorities. Trial Before Pilate centers on charges of kingship and sedition and results in Jesus being condemned to crucifixion."^^xsd:string ;
    skos:example "Christian theology interprets the trial before Pilate as the decisive legal act leading to Jesus’ crucifixion."^^xsd:string,
        "The Gospels recount Pilate questioning Jesus about whether he is the king of the Jews."^^xsd:string .

<R93SGZlivQyshkPtiqtm24G> a owl:Class ;
    rdfs:label "Equilibrium Disorder" ;
    rdfs:subClassOf <RTSI7ogxo4mf2wErPNxZDK> ;
    skos:altLabel "Balance Condition",
        "Dizziness" ;
    skos:definition "Equilibrium Disorder (also known as Dizziness or a balance condition) encompass a range of disorders that cause sensations of spinning (vertigo), lightheadedness, unsteadiness, or a loss of balance. These conditions often require medical evaluation and treatment to manage symptoms and address underlying causes such as inner ear disorders, neurological conditions, or cardiovascular issues." ;
    skos:prefLabel "Vertigo" .

