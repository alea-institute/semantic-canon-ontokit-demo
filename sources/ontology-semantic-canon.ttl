    skos:example "Passenger car rental or leasing",
        "Passenger truck (light duty) rental or leasing",
        "Passenger van rental or leasing",
        "Sport utility vehicle rental or leasing" .

<JCIrz7g3SPCsw1TVxFKW7g> a owl:Class ;
    rdfs:label "Rolling and Drawing of Purchased Steel" ;
