            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDSBerlLWg1ntpLqDQn1eVn> ],
        <R7u1GstOpfAmZ3mI7yFcbgU> ;
    skos:altLabel "Vermögensdelikte"@de-de,
        "Crimes Against Property"@en-gb,
        "Delitos contra la propiedad"@es-es,
        "Delitos contra la propiedad"@es-mx,
        "Crimes contre les biens"@fr-fr,
        "פשעים נגד המוניות"@he-il,
        "संपत्ति के खिलाफ अपराध"@hi-in,
        "財産犯罪"@ja-jp,
        "Crimes contra a propriedade"@pt-br,
        "财产犯罪"@zh-cn ;
    skos:definition "To willfully or maliciously destroy, damage, deface, or otherwise injure real or personal property without the consent of the owner or the person having custody or control of it." ;
    skos:prefLabel "Offences Involving Property" .

<R8xoAbLw9cOhM7q4iRXRmXu> a owl:Class ;
    rdfs:label "Entity Groups" ;
    rdfs:subClassOf <R7L5eLIzH0CpOUE74uJvSjL> ;
    skos:altLabel "Entitätsgruppen"@de-de,
        "Groupes d'entités"@fr-fr,
        "エンティティグループ"@ja-jp,
        "Grupos de entidades"@pt-br,
        "实体组"@zh-cn ;
    skos:definition "Entity Groups are a subset of Legal Entities and refer to groups of individuals or organizations that come together for a specific purpose, such as a Board of Directors or Joint Defense Group." ;
    skos:prefLabel "Organizational Groups" .

<R9Dxh7cqKFFJ2jKNTvICMhf> a owl:Class ;
    rdfs:label "Armed Services" ;
    rdfs:subClassOf <RBQGborh1CfXanGZipDL0Qo> ;
    skos:altLabel "Armed Forces",
        "Defense Forces",
        "Military Forces",
        "Military Services",
        "National Military" ;
    skos:definition "Armed Services, or a Military Body, refers to the organized, trained, and equipped forces maintained by a state for national defense, security, and military operations. These forces are typically divided into distinct branches, each specializing in different domains of warfare and national security." .

<R9L4OY7QCBEVJpav2Da6Gef> a owl:Class ;
    rdfs:label "Specific Goods and Services Tax Payment" ;
    rdfs:subClassOf <R7f6bqEjMQDMYjlvg0WINGf> ;
    skos:altLabel "Special Consumption Tax Payment",
        "Targeted Goods and Services Tax",
        "Taxes on specific goods and services" ;
    skos:definition "Specific Goods and Services Tax Payment includes excises, profits generated and transferred from fiscal monopolies, customs and import duties, as well as taxes on exports, foreign exchange transactions, investment goods, betting stakes, and special taxes on services. These taxes do not form part of a general consumption tax but are instead targeted at specific goods and services." .

<R9VpyiXQxLbATS2mPSOlbqT> a owl:Class ;
    rdfs:label "Christ's Public Ministry Events" ;
    rdfs:subClassOf <REYZrQdidTmIiJf5n7mz2B> ;
    skos:altLabel "Events of Jesus’ Ministry"^^xsd:string,
        "Galilean and Judean Ministry Events"^^xsd:string ;
    skos:definition "Christ’s Public Ministry Events means the events during which Jesus Christ publicly proclaimed the Kingdom of God through teaching, preaching, signs, and miracles. Christ’s Public Ministry Events reveal Christ’s authority, mission, and identity prior to his Passion."^^xsd:string ;
    skos:example "The Gospels recount Jesus preaching the Kingdom of God throughout Galilee."^^xsd:string,
        "The calling of the first disciples marks the beginning of Christ’s public ministry."^^xsd:string ;
    skos:prefLabel "Public Ministry of Jesus"^^xsd:string .

<R9WRFGVqE913fnyJVUGR8Xg> a owl:Class ;
    rdfs:label "Cereal Crops" ;
    rdfs:subClassOf <R70EVLsDqbyH67OcMFU5d1p> ;
    skos:altLabel "Grains" ;
    skos:definition "Cereal Crops are a category of cultivated grasses grown primarily for their edible grains or seeds, which are staple foods for a significant portion of the global population. These crops provide essential carbohydrates, proteins, and other nutrients, forming the basis of many diets and playing a vital role in food security and agriculture." ;
    skos:prefLabel "Grain Crops" .

<R9iUJ1YX0zK3V9D0RbQKTP4> a owl:Class ;
    rdfs:label "Equitable Relief" ;
    rdfs:subClassOf <RDbz1PVc6y57oOb9jAIl0eN> ;
    skos:altLabel "Non-Pecuniary Remedies",
        "Ermessensmaßnahmen"@de-de,
        "Equitable Relief"@en-gb,
        "Medidas equitativas"@es-es,
        "Medidas equitativas"@es-mx,
        "Mesures équitables"@fr-fr,
        "סיוע משפטי הוגן"@he-il,
        "न्यायसंगत सहायता"@hi-in,
        "公正な救済"@ja-jp,
        "Remédio equitativo"@pt-br,
        "公平救济"@zh-cn ;
    skos:definition "Equitable Relief refers to a type of legal remedy sought in civil cases that aims to provide fairness and justice to the parties involved, often through actions such as injunctions, specific performance, or rescission." ;
    skos:prefLabel "Equitable Damages" .

<R9o7849l09skEBQqbxSItaV> a owl:Class ;
    rdfs:label "Old Testament Events" ;
    rdfs:subClassOf <R7TITXLXKEsSewVpYpMw3tL> ;
    skos:altLabel "Events of Israel’s Salvation History"^^xsd:string,
        "Events of the Old Covenant"^^xsd:string,
        "Hebrew Scripture Events"^^xsd:string ;
    skos:definition "Old Testament Events means the events recorded in the Old Testament that recount God’s actions in creation, covenant, law, prophecy, and the history of Israel. Old Testament Events reveal God’s salvific plan and prepare for its fulfillment in Jesus Christ."^^xsd:string ;
    skos:example "The Book of Exodus recounts the liberation of Israel from slavery in Egypt."^^xsd:string,
        "The Book of Genesis describes God creating the heavens and the earth."^^xsd:string,
        "The giving of the Law at Sinai establishes the covenant between God and Israel."^^xsd:string .

<R9pQxz2fUIrk1LjvVP8hikg> a owl:Class ;
