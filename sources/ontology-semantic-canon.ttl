<RDMNx0AK0j8Rc7MLtq2cQqK> a owl:Class ;
    rdfs:label "Obscenity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RLvhxz3b1k2IU3MaAgeRtF> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R9mSfKgf9j4vIGxmQrnBd1I> ],
        <RCqBiJAwLT5iG2nvk12tNKW>,
        <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Indecent Expression"^^xsd:string,
        "Lewdness"^^xsd:string,
        "Sexually Explicit"^^xsd:string,
        "Obszönität"@de-de,
        "Obscenity"@en-gb,
        "Obscenidad"@es-es,
        "Obscenidad"@es-mx,
        "Obscénité"@fr-fr,
        "פוגעניות"@he-il,
        "अश्लीलता"@hi-in,
        "わいせつ"@ja-jp,
        "Obscenidade"@pt-br,
        "淫秽"@zh-cn ;
    skos:definition "Obscenity is expression or conduct that a governing normative system classifies as grossly offensive to sexual, moral, or human-dignity standards. Legal systems often define obscenity by reference to explicit sexual content, community standards, and lack of serious value."^^xsd:string ;
    skos:example "A public performance included graphic sexual content and triggered obscenity sanctions."^^xsd:string,
        "A publication depicting explicit sexual acts without artistic value was labeled obscene."^^xsd:string,
        "A statute prohibited the public display of obscene material."^^xsd:string,
        "A video distribution violated community standards and was prosecuted as obscenity."^^xsd:string ;
    skos:prefLabel "Morally Offensive"^^xsd:string .

<RDMQShne0roBAywNtu6pHl> a owl:Class ;
    rdfs:label "Golden Calf and Covenant Breaking"^^xsd:string ;
    rdfs:subClassOf <R7hUqSzjreR3vfFZVZniVs4> ;
    skos:altLabel "Aaron's Golden Calf Incident"^^xsd:string,
        "Covenant Violation at Horeb"^^xsd:string,
        "Golden Calf Apostasy"^^xsd:string ;
    skos:definition "Golden Calf and Covenant Breaking represents the catastrophic apostasy when Israel fashioned and worshiped a golden calf while Moses received the Law on Mount Sinai, violating the freshly established covenant. This event marked Israel's first major rebellion against exclusive Yahweh worship, provoking divine anger, Moses's intercession, the shattering of the covenant tablets, and eventual covenant restoration through divine mercy."^^xsd:string ;
    skos:example "Jewish commentators throughout history examined golden calf and covenant breaking to understand Aaron's complicity and subsequent priesthood appointment."^^xsd:string,
        "Medieval moralists used golden calf and covenant breaking to warn against idolatrous attachment to wealth and material possessions."^^xsd:string,
        "Spiritual directors referenced golden calf and covenant breaking when guiding penitents through serious sin and restoration processes."^^xsd:string .

