<RBNSxnBEXxZJecAZFrag5CQ> a owl:Class ;
    rdfs:label "Employer Authority" ;
    rdfs:subClassOf <Rbu3eo1hVQwnxZ4CADqtBw> ;
    skos:altLabel "Business Leadership Authority"^^xsd:string,
        "Directorial Authority"^^xsd:string,
        "Managerial Authority"^^xsd:string,
        "Organizational Authority of Employers"^^xsd:string,
        "Workplace Governance Authority"^^xsd:string ;
    skos:definition "Employer Authority is the moral and contractual authority exercised by an employer to direct the work of employees within an enterprise. Employer Authority obliges the employer to respect workers’ dignity, ensure just conditions, and order labor toward both the common good and the enterprise’s legitimate aims."^^xsd:string ;
    skos:example "A business owner establishes workplace policies that protect safety and dignity."^^xsd:string,
        "A manager evaluates employee performance to support improvement and accountability."^^xsd:string,
        "An employer disciplines misconduct according to established procedures."^^xsd:string,
        "An employer sets work schedules consistent with labor agreements and just practices."^^xsd:string .

