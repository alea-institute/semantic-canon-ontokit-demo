<RHqthPE9sVZoY4ohq1VaN1> a owl:Class ;
    rdfs:label "Blasphemy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <R7n9rAWIq1fi7qGb3xRynWG> ],
        <Riu7KFtjL04HtrAlMuymaB> ;
    skos:altLabel "Contempt of the Sacred"^^xsd:string,
        "Profane Utterance"^^xsd:string,
        "Sacrilege"^^xsd:string,
        "Sacrilege by Speech"^^xsd:string ;
    skos:definition "Blasphemy is speech, expression, or conduct that shows contempt, disrespect, or irreverence toward what a religious or sacred legal system holds as divine or holy. Treatment ranges from moral condemnation to civil or religious sanctions, depending on jurisdiction and governing authority."^^xsd:string ;
    skos:example "A jurisdiction imposed penalties for public blasphemy under its religious legal code."^^xsd:string,
        "A protest used sacred symbols in a contemptuous manner and triggered blasphemy allegations."^^xsd:string,
        "A speaker publicly mocked a sacred name and committed blasphemy under religious law."^^xsd:string,
        "A written publication ridiculed a revered figure and was accused of blasphemy."^^xsd:string .

<RIBBxK4TkYe8LDSOqtHTwF> a owl:Class ;
    rdfs:label "Pardon" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RCdJXw1Ml7DIBqmouWarZm2> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RBbjLAZo9jkKxwlZAq4fZWY> ],
        [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDp74c34xALuehr10JADSM2> ],
        <RCRVBAzI4EaLARuVLhgDBTB> ;
    skos:definition "A pardon is an official act by a government authority, typically the executive branch, that absolves an individual of any legal consequences for a crime they have been convicted of. It effectively erases the conviction from the individual's criminal record, signifying forgiveness and allowing the individual to regain rights lost due to the conviction." .

<RICvcZa71w8UKH411jzdmf> a owl:Class ;
    rdfs:label "Prosecutorial Misconduct" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty rdfs:seeAlso ;
            owl:someValuesFrom <RDWrlAT5y1sm1PdlKJzlEwj> ],
        <R8mREFTbCVNHGAdqneLSd0d> ;
    skos:definition "Prosecutorial misconduct refers to unethical or illegal actions committed by a prosecutor during a criminal case. This misconduct can include hiding evidence, making false statements, engaging in improper witness coaching, or other actions that violate a defendant's rights or the rules of legal ethics. When proven, prosecutorial misconduct can lead to the dismissal of charges, mistrial, or disciplinary action against the prosecutor." ;
    skos:prefLabel "Prosecutor Misconduct" .

