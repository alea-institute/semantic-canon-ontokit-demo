<RDnp9NKepBKQZMZciSrs19W> a owl:Class ;
    rdfs:label "We stand before You, Holy Spirit" ;
    dc:source <https://www.xavier.edu/jesuitresource/online-resources/prayer-index/catholic-prayers> ;
    rdfs:subClassOf <RyTfHxUQPVMUQrtIt1Mycz> ;
    skos:altLabel "Prayer to the Holy Spirit for Guidance"^^xsd:string ;
    skos:definition "We Stand Before You, Holy Spirit is an invocation prayer that asks the Holy Spirit for guidance, unity, and right judgment as a community discerns and acts together. It seeks divine assistance to avoid error, partiality, and disorder, and to remain faithful to truth in communion with the Father and the Son."^^xsd:string ;
    skos:example "At the opening of the synodal assembly, the participants prayed We Stand Before You, Holy Spirit to seek unity and guidance."^^xsd:string,
        "Before a parish council meeting, the chair invited the group to recite We Stand Before You, Holy Spirit."^^xsd:string,
        """We stand before You, Holy Spirit,
  as we gather together in Your name.

With You alone to guide us,
  make Yourself at home in our hearts;

Teach us the way we must go
  and how we are to pursue it.

We are weak and sinful;
  do not let us promote disorder.

Do not let ignorance lead us down the wrong path
  nor partiality influence our actions.

Let us find in You our unity
  so that we may journey together to eternal life
  and not stray from the way of truth
  and what is right.

All this we ask of You,
  who are at work in every place and time,
  in the communion of the Father and the Son,
  forever and ever."""^^xsd:string .

<RDnw9I361nvhldGAargiPkp> a owl:Class ;
    rdfs:label "Tertiary Source" ;
    rdfs:subClassOf <RBgvM3CLfhaoq2TagoUDUBG> ;
    skos:altLabel "Compilatory Source"^^xsd:string,
        "Indexing Source"^^xsd:string,
        "Reference Source"^^xsd:string,
        "Summary Reference"^^xsd:string ;
    skos:definition "Tertiary Source is a reference work that compiles, summarizes, or indexes information drawn from primary and secondary sources. A Tertiary Source facilitates access to established knowledge without offering original evidence or extended analysis."^^xsd:string ;
    skos:example "A dictionary defines terms based on authoritative sources rather than original research."^^xsd:string,
        "A subject index directs readers to primary and secondary sources on a topic."^^xsd:string,
        "An encyclopedia article summarizes established scholarship on a theological topic."^^xsd:string .

<RDo0CW96yRvaIo64VE03mfw> a owl:Class ;
    rdfs:label "Qualified Privilege" ;
    rdfs:subClassOf <Rxkyjui3De88JNN2ZCqKrt> ;
    skos:altLabel "Qualifiziertes Privileg"@de-de,
        "Qualified Privilege"@en-gb,
        "Privilegio Calificado"@es-es,
        "Privilegio Calificado"@es-mx,
        "Privilège qualifié"@fr-fr,
        "פרסום רשאי"@he-il,
        "योग्य विशेषाधिकार"@hi-in,
        "限定特権"@ja-jp,
        "Privilégio qualificado"@pt-br,
        "合格特权"@zh-cn ;
    skos:definition "Qualified Privilege: A legal protection that allows a person to make a statement without fear of being sued for defamation, as long as the statement was made in good faith and for a legitimate purpose." .

<RDoAYtOFBgrl2hbZwVUSR1J> a owl:Class ;
    rdfs:label "Canon (Textual Unit)" ;
    rdfs:subClassOf <R7SWDfYuq2ExnV9WkGTLhyA> ;
    skos:altLabel "Canonical Norm"^^xsd:string,
        "Canonical Provision"^^xsd:string,
        "Canonical Rule"^^xsd:string,
        "Law Canon"^^xsd:string ;
    skos:definition "Canon is a numbered, normative textual unit within canon law that states a specific legal rule, principle, or definition. It serves as an authoritative reference for governance, rights, and obligations in the Church."^^xsd:string ;
    skos:example "Canon 1055 §1."^^xsd:string,
        "Canon 915"^^xsd:string,
        "Canons 208–223."^^xsd:string .

<RDoBt2Jgqz0zeHUEjLHirvP> a owl:Class ;
    rdfs:label "Class Size" ;
    rdfs:subClassOf <R9VgIGcn57gilWLqtXc5cNb> ;
    skos:altLabel "Class Composition",
        "Number of Class Members" ;
    skos:definition "The number of individuals or entities included in a putative class action, representing the potential members of the class if the class is certified by the court. Class size affects both the scope of the lawsuit and the procedural requirements for class certification." ;
    skos:prefLabel "Class Membership Size" .

<RDoGqog9X0YSf54QEUTmyKz> a owl:Class ;
    rdfs:label "Family-Based Immigration Request" ;
    rdfs:subClassOf <RB5tNYSDrxEoYAqZ3sy0rae> ;
    skos:definition "A Family-Based Immigration Request is a type of immigration application where an individual seeks to enter or remain in a destination country based on their familial relationship to a citizen or legal resident of that country. This usually involves sponsorship by the relative and can include spouses, children, parents, and sometimes more extended family, depending on the country's immigration laws" .

<RDoLvqqUYFVe32IFsV2zUnM> a owl:Class ;
