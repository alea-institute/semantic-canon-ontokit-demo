    rdfs:subClassOf <aVATO1h8Q7yGC9sLbSm7jw> ;
    skos:definition "This U.S. industry comprises establishments primarily engaged in marketing and promoting communities and facilities to businesses and leisure travelers through a range of activities, such as assisting organizations in locating meeting and convention sites; providing travel information on area attractions, lodging accommodations, restaurants; providing maps; and organizing group tours of local historical, recreational, and cultural attractions." .

<IJgqXPZlTrCBhCrfXJJEEw> a owl:Class ;
