            owl:someValuesFrom <RLvhxz3b1k2IU3MaAgeRtF> ],
        <RCqBiJAwLT5iG2nvk12tNKW> ;
    skos:altLabel "Insobriety",
        "Öffentliche Trunkenheit"@de-de,
        "Public Intoxication"@en-gb,
        "Intoxicación pública"@es-es,
        "Ebriedad en la vía pública"@es-mx,
        "Ivresse publique"@fr-fr,
        "שכרות ציבורית"@he-il,
        "सार्वजनिक मतवाद"@hi-in,
