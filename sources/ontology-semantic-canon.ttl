<RjyrEeVCNNYOvBglcN5zxT> a owl:Class ;
    rdfs:label "Bear Wrongs Patiently" ;
    rdfs:subClassOf <RB3vkqIG4fsRfjNZyWvQk6U> ;
    skos:altLabel "Forbearing Wrongs"^^xsd:string,
        "Long-Suffering"^^xsd:string,
        "Meek Endurance"^^xsd:string,
        "Non-Retaliation"^^xsd:string,
        "Patient Endurance of Injury"^^xsd:string,
        "Patient Forbearance"^^xsd:string,
        "Redemptive Endurance"^^xsd:string ;
    skos:definition "Bear Wrongs Patiently is a spiritual work of mercy that consists in enduring injury, injustice, or offense without resentment or retaliation. Bear Wrongs Patiently imitates Christ’s meekness by responding to harm with charity, perseverance, and trust in God’s justice."^^xsd:string ;
    skos:example "A Christian unites endured wrongs with Christ’s suffering in prayer."^^xsd:string,
        "A believer accepts personal insult while praying for the offender."^^xsd:string,
        "A family member absorbs hurtful words to preserve peace and charity."^^xsd:string,
        "A person endures unfair criticism without responding in anger."^^xsd:string,
        "A worker bears mistreatment patiently while seeking just remedies without hatred."^^xsd:string .

